/* Product panel only overrides.
   Loaded after styles.css so these rules win without affecting other pages. */

.product-status-shell .product-panel-grid__inventory {
  gap: 12px !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
}

.product-status-shell .product-panel-grid__inventory-tools {
  grid-template-columns: minmax(220px, 1fr) minmax(180px, 240px) !important;
  gap: 12px !important;
  margin-bottom: 6px !important;
}

.product-status-shell .dashboard-content > .hero--product-list {
  position: sticky !important;
  top: var(--admin-heading-sticky-top, 4px) !important;
  z-index: 220;
  background: var(--dashboard-page-background, #f3f4f6);
}

.product-status-shell .product-list {
  display: grid !important;
  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  grid-auto-flow: row;
  gap: 12px !important;
  align-items: stretch;
  overflow: visible;
}

.product-status-shell .product-card,
.product-status-shell .product-card.is-inactive,
.product-status-shell .product-card--add-product {
  position: relative;
  z-index: 0;
  display: grid !important;
  grid-template-rows: auto minmax(0, 1fr) auto;
  min-width: 0;
  min-height: 0;
  height: 100% !important;
  gap: 0 !important;
  align-items: stretch;
  padding: 8px !important;
  overflow: visible !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 6px !important;
  background: #ffffff !important;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05) !important;
  outline: none !important;
  transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease !important;
  isolation: isolate;
}

.product-status-shell .product-card:hover,
.product-status-shell .product-card.is-inactive:hover,
.product-status-shell .product-card--add-product:hover {
  z-index: 20;
  border-color: #d1d5db !important;
  box-shadow: 0 7px 18px rgba(15, 23, 42, 0.08) !important;
  outline: none !important;
  transform: translateY(-1px) !important;
}

.product-status-shell .product-card::before,
.product-status-shell .product-card--add-product::before {
  display: none !important;
}

.product-status-shell .product-card--expired-batch,
.product-status-shell .product-card--expired-batch:hover,
.product-status-shell .product-card--expired-batch.is-inactive,
.product-status-shell .product-card--expired-batch.is-inactive:hover {
  border-color: #dc2626 !important;
}

.product-status-shell .product-card--expired-batch:hover {
  box-shadow: 0 12px 26px rgba(220, 38, 38, 0.16) !important;
}

.product-status-shell .product-card--pending-request,
.product-status-shell .product-card--pending-request:hover,
.product-status-shell .product-card--pending-request.is-inactive,
.product-status-shell .product-card--pending-request.is-inactive:hover {
  border-color: #f59e0b !important;
  background: #ffffff !important;
  outline: none !important;
}

.product-status-shell .product-card--pending-request:hover {
  box-shadow: 0 12px 26px rgba(245, 158, 11, 0.18) !important;
}

.product-status-shell .product-image,
.product-status-shell .product-image--add-product,
.product-status-shell .product-card__photo-button {
  display: grid !important;
  width: 100% !important;
  height: auto !important;
  aspect-ratio: 1 / 1;
  flex: 0 0 auto;
  place-items: center;
  overflow: hidden !important;
  border-radius: 5px !important;
  background: #f3f4f6 !important;
  color: #94a3b8;
}

.product-status-shell .product-card__photo-button {
  padding: 0 !important;
  border: 0 !important;
  box-shadow: none !important;
  cursor: pointer !important;
}

.product-status-shell .product-card__photo-button:hover,
.product-status-shell .product-card__photo-button:active,
.product-status-shell .product-card__photo-button:focus-visible {
  background: #f3f4f6 !important;
  box-shadow: none !important;
  outline: none !important;
  transform: none !important;
}

.product-status-shell .product-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top !important;
}

.product-status-shell .product-image--add-product {
  border: 1px dashed #cbd5e1 !important;
}

.product-status-shell .product-image__plus {
  width: 46px;
  height: 46px;
  border-radius: 999px;
  font-size: 26px;
  box-shadow: none;
}

.product-status-shell .product-image__meta {
  left: 7px;
  right: auto;
  bottom: 7px;
  z-index: 4;
  gap: 5px;
  max-width: calc(100% - 52px);
}

.product-status-shell .product-image__count {
  box-sizing: border-box;
  min-width: 30px;
  min-height: 22px;
  gap: 4px;
  padding: 4px 7px;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 999px !important;
  background: rgba(17, 24, 39, 0.86) !important;
  color: #ffffff;
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  cursor: pointer !important;
  transform: none !important;
  transition: background 140ms ease !important;
}

.product-status-shell .product-image__count:hover {
  background: rgba(15, 23, 42, 0.94) !important;
  transform: none !important;
}

.product-status-shell .product-image__count i,
.product-status-shell .product-image__count svg {
  width: 12px;
  height: 12px;
  flex: 0 0 12px;
  font-size: 12px;
}

.product-status-shell .product-card__status-row {
  position: absolute;
  top: 15px;
  left: 15px;
  right: 15px;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  pointer-events: none;
}

.product-status-shell .product-card__badge--status {
  display: inline-flex;
  align-items: center;
  width: auto;
  min-width: 0;
  max-width: calc(100% - 48px);
  min-height: 18px;
  height: auto;
  padding: 3px 6px;
  border: 1px solid color-mix(in srgb, var(--accent) 58%, #ffffff);
  border-radius: 999px;
  background: var(--accent);
  color: var(--accent-contrast, #ffffff);
  box-shadow: none;
  font-size: 11px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
  text-transform: none;
  pointer-events: auto;
}

.product-status-shell .product-card__badge--status::after {
  content: attr(title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-card__badge--status.is-inactive {
  border-color: #fecaca;
  background: #dc2626;
  color: #ffffff;
}

.product-status-shell .product-card--pending-request .product-card__badge--status {
  border-color: transparent;
  background: #f59e0b;
  color: #ffffff;
}

.product-status-shell .product-card--expired-batch .product-card__badge--status {
  border-color: #fecaca;
  background: #dc2626;
  color: #ffffff;
}

.product-status-shell .product-card__visibility-toggle {
  min-height: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  pointer-events: auto;
}

.product-status-shell .product-card__visibility-toggle:hover,
.product-status-shell .product-card__visibility-toggle:focus-visible,
.product-status-shell .product-card__visibility-toggle:active {
  background: transparent;
  box-shadow: none;
  outline: none;
  transform: none;
}

.product-status-shell .product-card__visibility-toggle-track {
  width: 34px;
  height: 18px;
  padding: 2px;
  border: 1px solid rgba(255, 255, 255, 0.52);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.66);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  transition: background 220ms cubic-bezier(0.22, 1, 0.36, 1) !important;
}

.product-status-shell .product-card__visibility-toggle-thumb {
  width: 12px;
  height: 12px;
  box-shadow: none;
}

.product-status-shell .product-card__visibility-toggle.is-active .product-card__visibility-toggle-track {
  background-color: var(--accent) !important;
  background-image: var(--accent-button-gradient-bg) !important;
  background-size: 100% 100% !important;
  background-repeat: no-repeat !important;
}

.product-status-shell .product-card__visibility-toggle.is-active .product-card__visibility-toggle-thumb {
  transform: translateX(16px);
}

.product-status-shell .product-card__body {
  display: grid;
  min-width: 0;
  min-height: 0;
  align-content: start;
  flex: none !important;
  gap: 5px;
  padding: 10px 3px 0 !important;
}

.product-status-shell .product-card__body--add-product {
  gap: 8px;
}

.product-status-shell .product-name {
  display: block;
  overflow: hidden;
  min-height: 16px;
  margin: 0;
  color: #111827;
  font-size: 16px;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-name__category {
  display: none;
}

.product-status-shell .product-card__category {
  display: block;
  overflow: hidden;
  width: fit-content;
  max-width: 100%;
  min-height: 14px;
  padding: 2px 6px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-card__price-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 6px;
  overflow: hidden;
  white-space: nowrap;
}

.product-status-shell .product-card__price {
  flex: 0 0 auto;
  overflow: hidden;
  color: #1f2937;
  font-size: 14px;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
}

.product-status-shell .product-card__original-price {
  min-width: 0;
  overflow: hidden;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 500;
  line-height: 1;
  text-decoration: line-through;
  text-overflow: ellipsis;
}

.product-status-shell .product-card__highlights {
  gap: 5px;
  margin-top: 1px;
}

.product-status-shell .product-card__highlight-badge {
  min-height: 18px;
  padding: 3px 6px;
  border-radius: 999px !important;
  font-size: 10px;
  font-weight: 600;
  line-height: 1;
}

.product-status-shell .product-card__batch-note,
.product-status-shell .product-card__pending-note,
.product-status-shell .product-card__body--add-product .product-meta {
  overflow: hidden;
  color: #64748b;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.35;
}

.product-status-shell .product-card__footer {
  display: grid;
  width: 100%;
  margin-top: auto !important;
  padding: 9px 3px 0 !important;
  border-top: 1px solid #eef0f3 !important;
  background: transparent !important;
}

.product-status-shell .product-card--expired-batch .product-card__footer {
  background: transparent !important;
}

.product-status-shell .product-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 32px 32px;
  align-items: center;
  width: 100%;
  gap: 7px;
  margin: 0;
}

.product-status-shell .product-actions .icon-action-button {
  display: inline-grid;
  width: 32px;
  min-width: 32px;
  min-height: 32px;
  height: 32px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 5px;
  background: transparent;
  box-shadow: none;
  color: #475569;
  transform: none !important;
  transition: background 140ms ease, color 140ms ease, border-color 140ms ease !important;
}

.product-status-shell .product-actions .product-card__overview-button {
  display: inline-flex;
  justify-content: center;
  width: 100%;
  min-width: 0;
  padding: 0 8px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: var(--accent-text, var(--accent));
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-actions .product-card__overview-button i {
  display: none;
}

.product-status-shell .product-actions .product-card__overview-button span {
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-status-shell .product-actions .icon-action-button:hover,
.product-status-shell .product-actions .icon-action-button:focus-visible {
  background: rgba(var(--accent-rgb), 0.06);
  color: var(--accent-text, var(--accent));
  box-shadow: none;
  outline: none;
  transform: none !important;
}

.product-status-shell .product-actions .delete-button,
.product-status-shell .product-actions .icon-action-button--danger {
  color: #df4d58;
}

.product-status-shell .product-actions .delete-button:hover,
.product-status-shell .product-actions .delete-button:focus-visible,
.product-status-shell .product-actions .icon-action-button--danger:hover,
.product-status-shell .product-actions .icon-action-button--danger:focus-visible {
  background: #ffe0e3;
  color: #bd2633;
}

.product-status-shell .product-actions .icon-action-button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
  transform: none !important;
}

.product-status-shell .product-actions .icon-action-button i,
.product-status-shell .product-actions .icon-action-button svg {
  display: block;
  width: 18px;
  height: 18px;
  font-size: 18px;
  line-height: 1;
}

@media (max-width: 1520px) {
  .product-status-shell .product-list {
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 1280px) {
  .product-status-shell .product-list {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 980px) {
  .product-status-shell .product-list {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 700px) {
  .product-status-shell .product-panel-grid__inventory-tools {
    grid-template-columns: 1fr !important;
  }

  .product-status-shell .product-list {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 560px) {
  .product-status-shell .product-list {
    grid-template-columns: 1fr !important;
  }
}

/* Listing command and Add Product workspace modal. */
.product-status-shell .product-panel-grid__inventory-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-width: 0;
  padding: 2px 0 4px;
}

.product-status-shell .product-panel-grid__inventory-heading .section-label {
  margin: 0 0 2px;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

.product-status-shell .product-panel-grid__inventory-heading h2 {
  margin: 0;
  color: #111827;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.2;
}

.product-status-shell .product-listing-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 4px 0 2px;
}

.product-status-shell .product-listing-summary__card {
  --listing-summary-color: #2563eb;
  --listing-summary-soft: #eff6ff;
  display: grid;
  min-width: 0;
  min-height: 108px;
  grid-template-columns: 42px minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  overflow: hidden;
  border: 1px solid #e3e7ec;
  border-radius: 6px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
}

.product-status-shell .product-listing-summary__card--active {
  --listing-summary-color: #0f9f78;
  --listing-summary-soft: #e8f8f4;
}

.product-status-shell .product-listing-summary__card--inactive {
  --listing-summary-color: #64748b;
  --listing-summary-soft: #f1f5f9;
}

.product-status-shell .product-listing-summary__card--restricted {
  --listing-summary-color: #dc4c64;
  --listing-summary-soft: #fff0f3;
}

.product-status-shell .product-listing-summary__icon {
  display: inline-grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 6px;
  background: var(--listing-summary-soft);
  color: var(--listing-summary-color);
  font-size: 20px;
}

.product-status-shell .product-listing-summary__content {
  display: grid;
  min-width: 0;
  align-content: center;
  gap: 2px;
}

.product-status-shell .product-listing-summary__label,
.product-status-shell .product-listing-summary__note {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-listing-summary__label {
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
}

.product-status-shell .product-listing-summary__value {
  color: #111827;
  font-size: 27px;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}

.product-status-shell .product-listing-summary__note {
  margin-top: 3px;
  color: #7b8796;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.25;
}

.product-status-shell .product-panel-add-button {
  display: inline-flex;
  min-width: 0;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 16px;
  border: 1px solid var(--accent, #0f9f78);
  border-radius: 6px;
  background: var(--accent, #0f9f78);
  color: var(--accent-contrast, #ffffff);
  box-shadow: 0 5px 12px rgba(var(--accent-rgb, 15, 159, 120), 0.16);
  font-size: 13px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-panel-add-button:hover,
.product-status-shell .product-panel-add-button:focus-visible {
  border-color: var(--accent-hover, var(--accent, #0f9f78));
  background: var(--accent-hover, var(--accent, #0f9f78));
  box-shadow: 0 7px 16px rgba(var(--accent-rgb, 15, 159, 120), 0.22);
  outline: none;
  transform: translateY(-1px);
}

.product-status-shell .product-composer-modal-overlay[hidden] {
  display: none !important;
}

.product-status-shell .product-composer-modal-overlay {
  position: fixed !important;
  inset: 0 !important;
  z-index: 1000 !important;
  display: grid !important;
  width: 100% !important;
  height: 100% !important;
  padding: 16px !important;
  place-items: center;
  overflow: hidden !important;
  background: rgba(15, 23, 42, 0.5) !important;
  backdrop-filter: blur(2px);
  animation: product-composer-overlay-in 180ms ease-out;
}

.product-status-shell .product-composer-modal--workspace {
  display: grid !important;
  width: min(1480px, calc(100vw - 32px)) !important;
  max-width: 1480px !important;
  height: min(900px, calc(100vh - 32px)) !important;
  max-height: calc(100vh - 32px) !important;
  min-height: 0 !important;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  border: 1px solid #dfe4ea !important;
  border-radius: 7px !important;
  background: #ffffff !important;
  box-shadow: 0 28px 70px rgba(15, 23, 42, 0.28) !important;
  animation: product-composer-dialog-in 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.product-status-shell .product-composer-modal--workspace:focus {
  outline: none;
}

.product-status-shell .product-composer-modal__topbar {
  position: relative;
  z-index: 5;
  display: flex;
  min-width: 0;
  min-height: 74px;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 13px 18px;
  border-bottom: 1px solid #e5e7eb;
  background: #ffffff;
}

.product-status-shell .product-composer-modal__identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
}

.product-status-shell .product-composer-modal__identity > div {
  min-width: 0;
}

.product-status-shell .product-composer-modal__brand-icon {
  display: inline-grid;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  place-items: center;
  border-radius: 6px;
  background: #e8f8f4;
  color: #0f9f78;
  font-size: 20px;
}

.product-status-shell .product-composer-modal__topbar .section-label {
  display: none;
}

.product-status-shell .product-composer-modal__topbar h2 {
  overflow: hidden;
  margin: 0;
  color: #111827;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: 0;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-composer-modal__subtitle {
  overflow: hidden;
  margin: 3px 0 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-composer-modal__header-actions {
  display: inline-flex;
  width: auto !important;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end !important;
  gap: 10px;
  margin: 0;
}

.product-status-shell .product-composer-modal__header-actions .status-pill {
  min-height: 28px;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 11px;
}

.product-status-shell .product-composer-modal__close {
  display: inline-grid;
  width: 38px;
  min-width: 38px;
  height: 38px;
  min-height: 38px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 5px;
  background: transparent;
  box-shadow: none;
  color: #475569;
  font-size: 18px;
}

.product-status-shell .product-composer-modal__close:hover,
.product-status-shell .product-composer-modal__close:focus-visible {
  background: #f1f5f9;
  box-shadow: none;
  color: #111827;
  outline: none;
  transform: none;
}

.product-status-shell .product-composer-form {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-rows: minmax(0, 1fr) auto;
  gap: 0;
  overflow: hidden;
}

.product-status-shell .product-composer-modal__workspace {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-columns: 190px minmax(0, 1fr);
  overflow: hidden;
}

.product-status-shell .product-composer-nav {
  display: flex;
  min-width: 0;
  min-height: 0;
  flex-direction: column;
  gap: 4px;
  padding: 14px 10px;
  overflow-x: hidden;
  overflow-y: auto;
  border-right: 1px solid #e5e7eb;
  background: #f8fafc;
}

.product-status-shell .product-composer-nav__item,
.product-status-shell .product-composer-nav__item.is-active {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 42px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  padding: 0 11px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  box-shadow: none;
  color: #475569;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  text-align: left;
  white-space: normal;
  transform: none;
}

.product-status-shell .product-composer-nav__item::after {
  display: none !important;
}

.product-status-shell .product-composer-nav__item i {
  display: inline-grid;
  width: 18px;
  flex: 0 0 18px;
  place-items: center;
  color: #64748b;
  font-size: 14px;
}

.product-status-shell .product-composer-nav__item:hover,
.product-status-shell .product-composer-nav__item:focus-visible {
  background: #eef3f7;
  box-shadow: none;
  color: #111827;
  outline: none;
  transform: none !important;
}

.product-status-shell .product-composer-nav__item.is-active,
.product-status-shell .product-composer-nav__item.is-active:hover,
.product-status-shell .product-composer-nav__item.is-active:focus-visible {
  background: #e8f8f4;
  color: #087a5e;
}

.product-status-shell .product-composer-nav__item.is-active i {
  color: #0f9f78;
}

.product-status-shell .product-composer-canvas {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  align-content: start;
  gap: 12px;
  padding: 14px;
  overflow-x: hidden;
  overflow-y: auto;
  overflow-anchor: none;
  scroll-behavior: smooth;
  background: #f4f6f8;
}

.product-status-shell .product-composer-canvas > [hidden]:not(.product-composer-compatibility-preview) {
  display: block !important;
}

.product-status-shell .product-composer-section {
  min-width: 0;
  padding: 14px !important;
  border: 1px solid #e1e6eb !important;
  border-radius: 6px !important;
  background: #ffffff !important;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04) !important;
  scroll-margin-top: 14px;
}

.product-status-shell .product-composer-section--photo {
  grid-column: span 7;
}

.product-status-shell .product-composer-section--video {
  grid-column: span 5;
}

.product-status-shell .product-composer-section--details {
  grid-column: span 7;
}

.product-status-shell .product-composer-section--variants {
  grid-column: span 5;
}

.product-status-shell .product-composer-section--barcode {
  grid-column: span 5;
}

.product-status-shell .product-composer-section--image-search {
  grid-column: span 7;
}

.product-status-shell .product-composer-section--model {
  grid-column: 1 / -1;
}

.product-status-shell .product-composer-section__heading {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 9px;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #edf0f3;
}

.product-status-shell .product-composer-section__number {
  display: inline-grid;
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  place-items: center;
  border-radius: 4px;
  background: #e8f8f4;
  color: #0f9f78;
  font-size: 11px;
  font-weight: 800;
  line-height: 1;
}

.product-status-shell .product-composer-section__heading > div {
  min-width: 0;
}

.product-status-shell .product-composer-section__heading h3 {
  margin: 0;
  color: #1f2937;
  font-size: 14px;
  font-weight: 750;
  letter-spacing: 0;
  line-height: 1.25;
}

.product-status-shell .product-composer-section__heading p {
  margin: 3px 0 0;
  color: #7b8796;
  font-size: 10px;
  line-height: 1.35;
}

.product-status-shell .product-composer-section .product-image-upload-group__footer {
  margin-top: 10px;
}

.product-status-shell .product-composer-section .product-image-upload-group__add-button {
  min-height: 34px;
  padding: 0 11px;
  border-radius: 5px;
  font-size: 11px;
}

.product-status-shell .product-composer-section .form-grid {
  gap: 10px;
}

.product-status-shell .product-composer-section label,
.product-status-shell .product-composer-section legend {
  color: #475569;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0;
}

.product-status-shell .product-composer-section input,
.product-status-shell .product-composer-section textarea,
.product-status-shell .product-composer-section .product-category-multiselect__trigger,
.product-status-shell .product-composer-section .product-partner-selection__trigger {
  border-radius: 5px;
  font-size: 12px;
}

.product-status-shell .product-composer-section textarea {
  min-height: 90px;
  resize: vertical;
}

.product-status-shell .product-composer-compatibility-preview,
.product-status-shell #android-preview-stage.product-composer-compatibility-preview {
  display: none !important;
}

.product-status-shell .product-composer-modal__footer {
  position: relative;
  z-index: 6;
  display: flex;
  min-width: 0;
  min-height: 68px;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin: 0 !important;
  padding: 11px 16px !important;
  border-top: 1px solid #e5e7eb;
  background: #ffffff;
}

.product-status-shell .product-composer-modal__footer .helper-text {
  overflow: hidden;
  min-width: 0;
  margin: 0;
  color: #64748b;
  font-size: 11px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-composer-modal__footer-actions {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
}

.product-status-shell .product-composer-modal__footer-actions > button {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 15px;
  border-radius: 5px;
  font-size: 12px;
  font-weight: 700;
}

.product-status-shell .product-composer-modal__footer-actions > button[hidden] {
  display: none !important;
}

.product-status-shell .product-composer-modal__footer-actions #submit-button {
  min-width: 142px;
  background: var(--accent, #0f9f78);
  color: var(--accent-contrast, #ffffff);
}

@keyframes product-composer-overlay-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes product-composer-dialog-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 1180px) {
  .product-status-shell .product-listing-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-status-shell .product-composer-modal__workspace {
    grid-template-columns: 166px minmax(0, 1fr);
  }

  .product-status-shell .product-composer-section--photo,
  .product-status-shell .product-composer-section--video {
    grid-column: span 6;
  }

  .product-status-shell .product-composer-section--details,
  .product-status-shell .product-composer-section--variants,
  .product-status-shell .product-composer-section--barcode,
  .product-status-shell .product-composer-section--image-search {
    grid-column: 1 / -1;
  }
}

@media (max-width: 820px) {
  .product-status-shell .product-composer-modal-overlay {
    padding: 0 !important;
    place-items: stretch;
  }

  .product-status-shell .product-composer-modal--workspace {
    width: 100vw !important;
    max-width: none !important;
    height: 100vh !important;
    max-height: 100vh !important;
    border: 0 !important;
    border-radius: 0 !important;
  }

  .product-status-shell .product-composer-modal__topbar {
    min-height: 68px;
    padding: 10px 12px;
  }

  .product-status-shell .product-composer-modal__brand-icon {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
  }

  .product-status-shell .product-composer-modal__subtitle {
    max-width: min(58vw, 430px);
  }

  .product-status-shell .product-composer-modal__header-actions .status-pill {
    display: none;
  }

  .product-status-shell .product-composer-modal__workspace {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }

  .product-status-shell .product-composer-nav {
    position: relative;
    z-index: 4;
    flex-direction: row;
    gap: 6px;
    padding: 8px 10px;
    overflow-x: auto;
    overflow-y: hidden;
    border-right: 0;
    border-bottom: 1px solid #e5e7eb;
    scrollbar-width: none;
  }

  .product-status-shell .product-composer-nav::-webkit-scrollbar {
    display: none;
  }

  .product-status-shell .product-composer-nav__item,
  .product-status-shell .product-composer-nav__item.is-active {
    width: auto;
    min-height: 38px;
    padding: 0 12px;
    white-space: nowrap;
  }

  .product-status-shell .product-composer-canvas {
    padding: 10px;
  }

  .product-status-shell .product-composer-section--photo,
  .product-status-shell .product-composer-section--video,
  .product-status-shell .product-composer-section--details,
  .product-status-shell .product-composer-section--variants,
  .product-status-shell .product-composer-section--barcode,
  .product-status-shell .product-composer-section--image-search,
  .product-status-shell .product-composer-section--model {
    grid-column: 1 / -1;
  }

  .product-status-shell .product-composer-modal__footer {
    min-height: 62px;
    padding: 9px 10px !important;
  }

  .product-status-shell .product-composer-modal__footer .helper-text {
    display: none;
  }

  .product-status-shell .product-composer-modal__footer-actions {
    width: 100%;
  }

  .product-status-shell .product-composer-modal__footer-actions > button {
    flex: 1 1 auto;
  }
}

@media (max-width: 560px) {
  .product-status-shell .product-panel-grid__inventory-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .product-status-shell .product-panel-add-button {
    width: 100%;
  }

  .product-status-shell .product-listing-summary {
    gap: 8px;
  }

  .product-status-shell .product-listing-summary__card {
    min-height: 86px;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 8px;
    padding: 10px;
  }

  .product-status-shell .product-listing-summary__icon {
    width: 34px;
    height: 34px;
    font-size: 16px;
  }

  .product-status-shell .product-listing-summary__label {
    font-size: 10px;
  }

  .product-status-shell .product-listing-summary__value {
    font-size: 23px;
  }

  .product-status-shell .product-listing-summary__note {
    display: none;
  }

  .product-status-shell .product-composer-modal__topbar h2 {
    font-size: 17px;
  }

  .product-status-shell .product-composer-modal__subtitle {
    display: none;
  }

  .product-status-shell .product-composer-section {
    padding: 12px !important;
  }

  .product-status-shell .product-composer-section .form-grid,
  .product-status-shell .product-composer-section .form-grid--triple,
  .product-status-shell .product-composer-section .product-partner-selection {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .product-status-shell .product-composer-modal__footer-actions #submit-button {
    min-width: 0;
  }

  .product-status-shell .product-composer-modal__footer-actions > button {
    padding-inline: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .product-status-shell .product-composer-modal-overlay,
  .product-status-shell .product-composer-modal--workspace {
    animation: none;
  }

  .product-status-shell .product-composer-canvas {
    scroll-behavior: auto;
  }
}

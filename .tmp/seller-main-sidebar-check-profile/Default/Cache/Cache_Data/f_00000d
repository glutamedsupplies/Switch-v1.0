      transparent 0%,
      var(--main-orders-progress-accent) 35%,
      var(--main-orders-progress-accent) 65%,
      transparent 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 50%;
    animation-name: main-orders-progress-loading-vertical;
  }

  body.main-orders-embedded .main-orders-detail-progress__step strong,
  body.main-orders-embedded .main-orders-detail-progress__step small {
    max-width: 100%;

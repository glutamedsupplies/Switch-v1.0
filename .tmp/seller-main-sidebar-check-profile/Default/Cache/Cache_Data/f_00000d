  body.main-orders-embedded .main-orders-detail-progress.has-timeline-lottie .main-orders-detail-progress__marker {
    justify-self: center;
  }

  body.main-orders-embedded .main-orders-detail-progress.has-timeline-lottie .main-orders-detail-progress__step::before,
  body.main-orders-embedded .main-orders-detail-progress.has-timeline-lottie .main-orders-detail-progress__step::after {
    top: auto;
    left: 15px;
  }

  body.main-orders-embedded .main-orders-detail-progress.has-timeline-lottie .main-orders-detail-progress__step::before {
    top: 0;
  }

  body.main-orders-embedded .main-orders-detail-progress.has-timeline-lottie .main-orders-detail-progress__step::after {
    top: 50%;
  }

  body.main-orders-embedded .main-orders-detail-progress__step.is-loading-connector::after {

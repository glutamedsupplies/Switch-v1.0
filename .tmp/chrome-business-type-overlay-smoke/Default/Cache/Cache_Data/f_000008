  function getProductRequestPageSize() {
    const statePageSize = Math.trunc(Number(state.productRequestPageSize));
    if (Number.isFinite(statePageSize) && statePageSize > 0) {
      return statePageSize;
    }

    const selectedPageSize = Math.trunc(Number(elements.productRequestPageSize?.value));
    if (Number.isFinite(selectedPageSize) && selectedPageSize > 0) {
      return selectedPageSize;
    }

    return 10;
  }

  // Builds the compact page controls used by the review grid.
  function renderProductRequestPagination(totalItems) {
    const total = Math.max(0, Number(totalItems) || 0);
    const pageSize = getProductRequestPageSize();
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    state.productRequestPage = Math.min(Math.max(1, Number(state.productRequestPage) || 1), totalPages);
    const start = total > 0 ? (state.productRequestPage - 1) * pageSize + 1 : 0;
    const end = total > 0 ? Math.min(total, start + pageSize - 1) : 0;

    if (elements.productRequestPageMeta) {
      elements.productRequestPageMeta.textContent =
        `Showing ${numberText(start)} to ${numberText(end)} of ${numberText(total)} results`;
    }
    if (elements.productRequestPageSize instanceof HTMLSelectElement) {
      elements.productRequestPageSize.value = String(pageSize);
    }
    if (!(elements.productRequestPagination instanceof HTMLElement)) {
      return;
    }

    const pagination = elements.productRequestPagination;
    pagination.innerHTML = "";
    const createPageButton = (label, page, options = {}) => {
      const button = document.createElement("button");
      button.type = "button";
      button.dataset.productRequestPage = String(page);
      button.setAttribute("aria-label", options.ariaLabel || `Page ${page}`);
      button.classList.toggle("is-active", options.active === true);
      if (options.active === true) {
        button.setAttribute("aria-current", "page");
      }
      button.disabled = options.disabled === true;
      button.innerHTML = label;
      return button;
    };

    pagination.append(createPageButton(
      createIconSvg('<path d="m15 18-6-6 6-6"></path>'),
      state.productRequestPage - 1,
      { ariaLabel: "Previous page", disabled: state.productRequestPage <= 1 },
    ));

    const firstVisiblePage = Math.max(1, Math.min(state.productRequestPage - 2, totalPages - 4));
    const lastVisiblePage = Math.min(totalPages, firstVisiblePage + 4);
    for (let page = firstVisiblePage; page <= lastVisiblePage; page += 1) {
      pagination.append(createPageButton(numberText(page), page, {
        active: page === state.productRequestPage,
      }));
    }

    pagination.append(createPageButton(
      createIconSvg('<path d="m9 18 6-6-6-6"></path>'),
      state.productRequestPage + 1,
      { ariaLabel: "Next page", disabled: state.productRequestPage >= totalPages },
    ));
  }

  function renderProductRequestLoadingSkeletons(count = getProductRequestPageSize()) {
    if (!elements.productRequestList) {
      return;
    }

    const normalizedCount = Math.trunc(Number(count));
    const skeletonCount = Number.isFinite(normalizedCount) && normalizedCount >= 0
      ? normalizedCount
      : getProductRequestPageSize();
    elements.productRequestList.innerHTML = "";
    elements.productRequestList.classList.add("is-loading");
    for (let index = 0; index < skeletonCount; index += 1) {
      const card = document.createElement("article");
      card.className = "super-admin-product-request-skeleton-card";
      card.setAttribute("aria-hidden", "true");
      card.innerHTML = `
        <span class="super-admin-product-request-skeleton-card__media"></span>
        <span class="super-admin-product-request-skeleton-card__line super-admin-product-request-skeleton-card__line--strong"></span>
        <span class="super-admin-product-request-skeleton-card__line"></span>
        <span class="super-admin-product-request-skeleton-card__line super-admin-product-request-skeleton-card__line--short"></span>
      `;
      elements.productRequestList.append(card);
    }
  }

  function getProductRequestPageSkeletonCount(totalItems, pageSize = getProductRequestPageSize()) {
    const total = Math.max(0, Math.trunc(Number(totalItems)) || 0);
    const normalizedPageSize = Math.max(1, Math.trunc(Number(pageSize)) || getProductRequestPageSize());
    if (total <= 0) {
      return 0;
    }

    const totalPages = Math.max(1, Math.ceil(total / normalizedPageSize));
    const page = Math.min(Math.max(1, Number(state.productRequestPage) || 1), totalPages);
    const pageStart = (page - 1) * normalizedPageSize;
    return Math.max(0, Math.min(normalizedPageSize, total - pageStart));
  }

  function getProductRequestLoadingSkeletonCount(filteredRequests, pageSize = getProductRequestPageSize()) {
    const currentVisibleCount = Array.isArray(filteredRequests) ? filteredRequests.length : 0;
    if (currentVisibleCount > 0) {
      return getProductRequestPageSkeletonCount(currentVisibleCount, pageSize);
    }

    const cachedVisibleCount = getCachedProductRequestVisibleCount(state.productRequestView);
    if (cachedVisibleCount !== null) {
      return getProductRequestPageSkeletonCount(cachedVisibleCount, pageSize);
    }

    return pageSize;
  }

  // Renders product requests from the latest state.
  function renderProductRequests() {
    const requests = getActiveProductRequestCollection();
    const filteredRequests = getFilteredProductRequests(requests);
    syncProductRequestView();
    syncProductRequestStats();
    syncProductRequestCount(state.productRequests.length, filteredRequests.length);

    if (!elements.productRequestList || !elements.productRequestEmpty) {
      return;
    }

    const pageSize = getProductRequestPageSize();
    const loadingSkeletonCount = getProductRequestLoadingSkeletonCount(filteredRequests, pageSize);
    closeRejectedProductQuickMenu();
    elements.productRequestList.innerHTML = "";
    elements.productRequestList.classList.remove("is-loading");
    if (state.productRequestsLoading) {
      elements.productRequestEmpty.hidden = true;
      if (elements.productRequestPageMeta) {
        elements.productRequestPageMeta.textContent = loadingSkeletonCount > 0
          ? `Loading ${numberText(loadingSkeletonCount)} products...`
          : "Loading products...";
      }
      if (elements.productRequestPagination instanceof HTMLElement) {
        elements.productRequestPagination.innerHTML = "";
      }
      if (elements.productRequestPageSize instanceof HTMLSelectElement) {
        elements.productRequestPageSize.value = String(pageSize);
      }
      renderProductRequestLoadingSkeletons(loadingSkeletonCount);
      return;
    }

    elements.productRequestEmpty.hidden = filteredRequests.length > 0;
    renderProductRequestPagination(filteredRequests.length);
    if (state.productRequestSearchTerm.trim()) {
      elements.productRequestEmpty.textContent = "No products match your search.";
    } else if (hasActiveProductRequestFilters()) {
      elements.productRequestEmpty.textContent = "No products match these filters.";
    } else if (state.productRequestView === "rejected") {
      elements.productRequestEmpty.textContent = "No products yet.";
    } else if (state.productRequestView === "live") {
      elements.productRequestEmpty.textContent = "No live listings yet.";
    } else if (state.productRequestView === "approved") {
      elements.productRequestEmpty.textContent = "No products yet.";
    } else {
      elements.productRequestEmpty.textContent = "No products in review.";
    }

    const pageStart = (state.productRequestPage - 1) * pageSize;
    const pagedRequests = filteredRequests.slice(pageStart, pageStart + pageSize);
    cacheProductRequestVisibleCount(state.productRequestView, filteredRequests.length);
    for (const product of pagedRequests) {
      elements.productRequestList.append(createProductRequestCard(product));
    }
    syncProductDetectionEditState();
  }

  // Reads the active account filter page size for the company list.
  function getCompanyPageSizeForAccountFilter(accountFilter, totalItems) {
    const normalizedFilter = normalizeCompanyAccountFilter(accountFilter);
    if (normalizedFilter === "restricted" || normalizedFilter === "banned") {
      return companyRestrictedPageSize;
    }
    if (normalizedFilter === "suspended") {
      return companyRestrictedPageSize;
    }
    if (normalizedFilter === "low-risk") {
      return companyDefaultPageSize;
    }
    return Math.max(1, Number(totalItems) || 1);
  }

  // Renders company pagination from the latest state.
  function renderCompanyPagination(totalItems) {
    if (!elements.companyPagination || !elements.companyPageMeta) {
      return {
        pageStart: 0,
        pageSize: Math.max(1, Number(totalItems) || 1),
        hasPageNavigation: false,
        shouldPaginate: false,
      };
    }

    const total = Math.max(0, Number(totalItems) || 0);
    const activeAccountFilter = normalizeCompanyAccountFilter(state.companyFilters.accountState);
    const shouldPaginate = activeAccountFilter !== "all";
    const pageSize = getCompanyPageSizeForAccountFilter(activeAccountFilter, total);
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    state.companyPageSize = pageSize;
    state.companyPage = shouldPaginate
      ? Math.min(Math.max(1, Number(state.companyPage) || 1), totalPages)
      : 1;
    const pageStart = shouldPaginate ? (state.companyPage - 1) * pageSize : 0;
    const start = total > 0 ? pageStart + 1 : 0;

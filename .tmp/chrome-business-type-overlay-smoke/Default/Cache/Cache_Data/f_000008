    syncSuperAdminNavToggleLabel();
  }

  // Captures all active scroll containers touched by the drawer state change.
  function getSuperAdminScrollSnapshot() {
    const panelContainer = document.querySelector(".super-admin-panel-container");
    return {
      windowX: window.scrollX || window.pageXOffset || 0,
      windowY: window.scrollY || window.pageYOffset || 0,
      documentLeft: document.documentElement?.scrollLeft || 0,
      documentTop: document.documentElement?.scrollTop || 0,
      bodyLeft: document.body?.scrollLeft || 0,
      bodyTop: document.body?.scrollTop || 0,
      panelContainer,
      panelLeft: panelContainer?.scrollLeft || 0,
      panelTop: panelContainer?.scrollTop || 0,
    };
  }

  // Restores scroll after opening the drawer so sticky header position does not jump.
  function restoreSuperAdminScrollSnapshot(snapshot) {
    if (!snapshot) {
      return;
    }
    window.scrollTo(snapshot.windowX, snapshot.windowY);
    if (document.documentElement) {
      document.documentElement.scrollLeft = snapshot.documentLeft;
      document.documentElement.scrollTop = snapshot.documentTop;
    }
    if (document.body) {
      document.body.scrollLeft = snapshot.bodyLeft;
      document.body.scrollTop = snapshot.bodyTop;
    }
    if (snapshot.panelContainer instanceof HTMLElement) {
      snapshot.panelContainer.scrollLeft = snapshot.panelLeft;
      snapshot.panelContainer.scrollTop = snapshot.panelTop;
    }
  }

  function restoreSuperAdminScrollSnapshotStable(snapshot) {
    restoreSuperAdminScrollSnapshot(snapshot);
    window.requestAnimationFrame(() => restoreSuperAdminScrollSnapshot(snapshot));
  }

  function focusWithoutScroll(element) {
    if (!(element instanceof HTMLElement)) {
      return;
    }
    try {
      element.focus({ preventScroll: true });
    } catch (error) {
      element.focus();
    }
  }

  // Updates super admin nav open and synchronizes related UI state.
  function setSuperAdminNavOpen(isOpen, options = {}) {
    const shouldOpen = Boolean(isOpen);
    const scrollSnapshot = getSuperAdminScrollSnapshot();
    document.body.classList.toggle("super-admin-nav-open", shouldOpen);
    if (options.persist !== false) {
      saveSuperAdminNavOpen(shouldOpen);
    }
    if (!shouldOpen) {
      document.body.classList.remove("super-admin-nav-collapsed");
    } else if (Object.prototype.hasOwnProperty.call(options, "collapsed")) {
      setSuperAdminNavCollapsed(Boolean(options.collapsed));
    }
    if (elements.navToggle) {
      syncSuperAdminNavToggleLabel();
    }
    if (elements.navBackdrop) {
      elements.navBackdrop.hidden = !shouldOpen;
    }
    restoreSuperAdminScrollSnapshot(scrollSnapshot);
    window.requestAnimationFrame(() => restoreSuperAdminScrollSnapshot(scrollSnapshot));
  }

  // Toggles super admin nav between open and closed states.
  function toggleSuperAdminNav() {
    const isOpen = document.body.classList.contains("super-admin-nav-open");
    if (!isOpen) {
      setSuperAdminNavOpen(true, { collapsed: false });
      return;
    }
    setSuperAdminNavOpen(false);
  }

  // Reads root session from source data safely.
  function readRootSession() {
    try {
      const rawSession = window.sessionStorage.getItem(sessionKey);
      return rawSession ? JSON.parse(rawSession) : null;
    } catch (error) {
      return null;
    }
  }

  // Guards the super admin page by redirecting visitors without a valid root session.
  function requireRootSession() {
    const session = readRootSession();
    if (!session || !session.token) {
      window.location.replace(loginPath);
      return null;
    }
    return session;
  }

  const rootSession = requireRootSession();
  if (!rootSession) {
    return;
  }


  function createProductDetailPricingSection(product) {
    const displayPrice = product?.salesPrice ?? product?.originalPrice ?? product?.price;
    const approvalStatus = String(product?.approvalStatus || "").trim().toLowerCase();
    const isReviewListing =
      !isProductInLiveListing(product) &&
      ["pending", "in review", "in_review", "review", "submitted"].includes(approvalStatus);
    const listingTypeLabel = getProductDetailListingTypeLabel(product);
    const listingTypeTone = listingTypeLabel.toLowerCase().includes("edit") ? "edited" : "new";
    const listingTypeValue = document.createElement("span");
    listingTypeValue.className = `super-admin-product-detail-modal__listing-type-text is-${listingTypeTone}`;
    listingTypeValue.textContent = listingTypeLabel;
    const fields = [
      createProductDetailField("Listing Type", listingTypeValue),
      createProductDetailField("Listing ID", product?.sku || product?.code || product?.productCode || product?.id),
      createProductDetailField("Original Price", formatProductDetailMoney(product?.originalPrice ?? product?.price)),
      createProductDetailField("Sales Price", formatProductDetailMoney(product?.salesPrice)),
      createProductDetailField("Display Price", formatProductDetailMoney(displayPrice)),
      createProductDetailField("Seller / Store", product?.storeName || product?.businessName || product?.companyName || product?.adminId || "-"),
      createProductDetailField("Discount", getProductDetailDiscountLabel(product)),
      createProductDetailField("Expiry Date", formatProductDetailDateDay(product?.expiryDate)),
      createProductDetailField("Barcode", product?.barcode || "Not set"),

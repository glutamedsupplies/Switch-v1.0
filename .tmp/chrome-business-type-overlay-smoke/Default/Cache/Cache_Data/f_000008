    activityCell.innerHTML = `
      <span class="super-admin-company-activity-log__icon${activityTone ? ` is-${activityTone}` : ""}"></span>
      <span class="super-admin-company-activity-log__activity-label"></span>
    `;
    activityCell.querySelector(".super-admin-company-activity-log__icon").innerHTML =
      createCompanyActivityIconSvg(activity?.kind);
    activityCell.querySelector(".super-admin-company-activity-log__activity-label").textContent =
      String(activity?.activity || "Seller Activity").trim();

    const userCell = document.createElement("div");
    userCell.className = "super-admin-company-activity-log__cell super-admin-company-activity-log__cell--user";
    userCell.setAttribute("role", "cell");
    const userName = document.createElement("strong");
    userName.textContent = String(activity?.userName || "Unknown user").trim();
    const userEmail = document.createElement("span");
    userEmail.textContent = String(activity?.userEmail || "No email").trim();
    userCell.append(userName, userEmail);

    const detailsCell = document.createElement("div");
    detailsCell.className = "super-admin-company-activity-log__cell super-admin-company-activity-log__cell--details";
    detailsCell.setAttribute("role", "cell");
    detailsCell.textContent = String(activity?.details || "Activity recorded.").trim();

    const ipCell = document.createElement("div");
    ipCell.className = "super-admin-company-activity-log__cell super-admin-company-activity-log__cell--ip";
    ipCell.setAttribute("role", "cell");
    ipCell.textContent = String(activity?.ipAddress || "No IP").trim();

    const dateCell = document.createElement("div");
    dateCell.className = "super-admin-company-activity-log__cell super-admin-company-activity-log__cell--date";
    dateCell.setAttribute("role", "cell");
    const [dateLabel, timeLabel] = getCompanyActivityDateParts(activity?.createdAt);
    const dateLine = document.createElement("span");
    dateLine.textContent = dateLabel;
    const timeLine = document.createElement("span");
    timeLine.textContent = timeLabel;
    dateCell.append(dateLine, timeLine);

    row.append(activityCell, userCell, detailsCell, ipCell, dateCell);
    return row;

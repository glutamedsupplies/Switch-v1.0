  // Renders integrated partners from the latest state.
  function renderIntegratedPartners(type) {
    const config = getIntegratedPartnerConfig(type);
    if (!config.list) {
      return;
    }

    const allPartners = Array.isArray(state[config.stateKey]) ? state[config.stateKey] : [];
    const visiblePartners = getVisibleIntegratedPartners(type);
    config.list.replaceChildren();
    config.list.classList.toggle("is-delivery-partners", type === "delivery");
    updateIntegratedPartnerSummary(config, allPartners);

    const resultStart = visiblePartners.length ? 1 : 0;
    if (config.pageMeta) {
      config.pageMeta.textContent = `Showing ${numberText(resultStart)} to ${numberText(visiblePartners.length)} of ${numberText(visiblePartners.length)} results`;
    }

    if (!visiblePartners.length) {
      const empty = document.createElement("div");
      empty.className = "buyer-data-empty partner-data-list-empty";
      empty.textContent = state[config.searchKey]
        ? `No ${config.pluralLabel.toLowerCase()} match your search.`
        : `No ${config.pluralLabel.toLowerCase()} found.`;
      config.list.append(createIntegratedPartnerTableHeader(type), empty);
      return;
    }

    config.list.append(
      createIntegratedPartnerTableHeader(type),
      ...visiblePartners.map((partner) => createIntegratedPartnerRow(type, partner)),
    );

    syncIntegratedSelection(type);
  }


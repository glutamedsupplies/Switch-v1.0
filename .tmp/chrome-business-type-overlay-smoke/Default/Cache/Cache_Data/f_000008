  async function handleSaveStoreTypeCategories({
    closeModal = true,
    includePendingCategory = true,
    requirePendingCategory = false,
    showSuccess = true,
  } = {}) {
    const storeTypeName = normalizeCategoryName(state.categoryModalStoreTypeName);
    if (!storeTypeName) {
      setFeedback("Select a business type first.", "error");
      return;
    }

    const pendingCategoryName = normalizeCategoryName(elements.storeTypeCategoryInput?.value);
    const hasPendingCategoryAssets =
      state.storeTypeCategoryDraftImageFile instanceof File
      || state.storeTypeCategoryDraftIconFile instanceof File
      || Boolean(state.storeTypeCategoryDraftImageUrl)
      || Boolean(state.storeTypeCategoryDraftIconUrl);
    if (includePendingCategory && !pendingCategoryName && hasPendingCategoryAssets) {
      setFeedback("Enter a category name before saving its image and icon.", "error");
      elements.storeTypeCategoryInput?.focus();
      return;
    }
    if (includePendingCategory && requirePendingCategory && !pendingCategoryName) {
      setFeedback("Enter a category name first.", "error");
      elements.storeTypeCategoryInput?.focus();
      return;
    }
    if (includePendingCategory && pendingCategoryName && !addStoreTypeDraftCategory({ focusInput: false })) {
      return;
    }

    try {
      if (elements.addStoreTypeCategoryButton) {
        elements.addStoreTypeCategoryButton.disabled = true;
      }
      const categoryDetails = await uploadStoreTypeCategoryDetails();
      state.storeTypeDraftCategoryDetails = categoryDetails.map((detail) => ({ ...detail }));
      renderStoreTypeDraftCategories();
      setFeedback(`Updating categories for ${storeTypeName}...`);
      const response = await fetch("/api/super-admin/store-types", {
        method: "PUT",
        headers: rootHeaders({
          "Content-Type": "application/json",
          Accept: "application/json",
        }),
        body: JSON.stringify({
          oldName: storeTypeName,
          name: storeTypeName,
          categories: state.storeTypeDraftCategories,
          categoryDetails,
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to update categories.");
      }

      setStoreTypeData(
        Array.isArray(data.storeTypes) ? data.storeTypes : state.storeTypes,
        Array.isArray(data.storeTypeDetails) ? data.storeTypeDetails : null,
      );
      if (closeModal) {
        setStoreTypeCategoryModalOpen(false, { restoreFocus: false });
      }
      const successMessage = `Categories for ${storeTypeName} updated.`;
      setFeedback(successMessage, "success");
      if (showSuccess) {
        showSuccessValidationModal("Categories Updated", successMessage);
      }
      return true;
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to update categories.", "error");
      elements.storeTypeCategoryInput?.focus();
      return false;
    } finally {
      if (elements.addStoreTypeCategoryButton) {
        elements.addStoreTypeCategoryButton.disabled = false;
      }
    }
  }


  // Reads or derives company drawer status descriptor for the current super admin flow.
  function getCompanyDrawerStatusDescriptor(admin) {
    return isCompanyAdminOnline(admin)
      ? { label: "Online", tone: "success" }
      : { label: "Offline", tone: "neutral" };
  }

  // Reads or derives company drawer verification descriptor for the current super admin flow.
  function getCompanyDrawerVerificationDescriptor(admin) {
    const isVerified = [
      admin?.isVerified,
      admin?.verified,
      admin?.faceVerified,
      admin?.emailVerified,
      admin?.businessVerified,
    ].some(readTruthyFlag) || Boolean(
      admin?.verifiedAt ||
      admin?.verificationDate ||
      admin?.emailVerifiedAt ||
      admin?.businessVerifiedAt,
    );
    return isVerified
      ? { label: "Verified", tone: "success" }
      : { label: "Pending", tone: "warning" };
  }

  // Reads or derives company drawer restriction level for the current super admin flow.
  function getCompanyDrawerRestrictionLevel(admin) {
    const accountState = getCompanyAccountState(admin);
    const warningCount = getCompanyWarningCount(admin);
    const warningLevel = getCompanyRestrictionLevelFromWarningCount(warningCount);
    if (accountState === "banned") {
      return { label: "High", tone: "danger", meter: 3 };
    }
    if (accountState === "suspended") {
      return { label: "High", tone: "danger", meter: 3 };
    }
    if (warningCount > 0) {
      return warningLevel;
    }
    if (accountState !== "restricted") {
      return { label: "Low", tone: "neutral", meter: 1 };
    }

    return { label: "High", tone: "danger", meter: 3 };
  }

  // Reads or derives company drawer address lines for the current super admin flow.
  function getCompanyDrawerAddressLines(admin) {
    const rawAddress =
      admin?.address ??
      admin?.businessAddress ??
      admin?.companyAddress ??
      admin?.storeAddress ??
      admin?.registeredAddress ??
      "";
    const addressParts = [];

    if (rawAddress && typeof rawAddress === "object") {
      addressParts.push(
        rawAddress.street,
        rawAddress.addressLine1,
        rawAddress.addressLine2,
        rawAddress.barangay,
        rawAddress.city,
        rawAddress.municipality,
        rawAddress.province,
        rawAddress.region,
        rawAddress.postalCode,
        rawAddress.country,
      );
    } else if (rawAddress) {
      addressParts.push(rawAddress);
    }

    if (!addressParts.filter(Boolean).length) {
      addressParts.push(
        admin?.streetAddress,
        admin?.barangay,
        admin?.city,
        admin?.municipality,
        admin?.province,
        admin?.postalCode,
        admin?.country,
      );
    }

    const normalizedParts = addressParts
      .map((value) => String(value || "").replace(/\s+/g, " ").trim())
      .filter(Boolean);
    if (!normalizedParts.length) {
      return ["No address provided"];
    }
    if (normalizedParts.length === 1) {
      return [normalizedParts[0]];
    }

    const midpoint = Math.max(1, Math.ceil(normalizedParts.length / 2));
    return [
      normalizedParts.slice(0, midpoint).join(", "),
      normalizedParts.slice(midpoint).join(", "),
    ].filter(Boolean);
  }

  // Reads or derives company drawer admin subject for the current super admin flow.
  function getCompanyDrawerAdminSubject(admin) {
    return getCompanyName(admin) || "Company";
  }

  // Reads or derives company business type label for the current super admin flow.
  function getCompanyBusinessTypeLabel(admin) {
    return normalizeStoreTypeValues([
      admin?.storeType,
      admin?.storeTypeName,
      admin?.businessType,
      admin?.companyType,
      admin?.type,
    ])[0] || "Business Type";
  }

  // Supports the convert admin facing description branch of the super admin UI.
  function convertAdminFacingDescription(value, admin, fallback = "") {
    const subject = getCompanyDrawerAdminSubject(admin);
    const possessiveSubject = /s$/i.test(subject) ? `${subject}'` : `${subject}'s`;
    const source = String(value || fallback || "").replace(/\s+/g, " ").trim();
    if (!source) {
      return "No description provided.";
    }
    return source
      .replace(/\byou are\b/gi, `${subject} is`)
      .replace(/\byou have\b/gi, `${subject} has`)
      .replace(/\byour account\b/gi, `${possessiveSubject} account`)
      .replace(/\byour company\b/gi, `${possessiveSubject} company`)
      .replace(/\byour\b/gi, possessiveSubject)
      .replace(/\byou\b/gi, subject);
  }

  // Reads or derives company drawer warning descriptor for the current super admin flow.
  function getCompanyDrawerWarningDescriptor(admin) {
    const accountState = getCompanyAccountState(admin);
    const metrics = getCompanyBanMetrics([admin]);
    const subject = getCompanyDrawerAdminSubject(admin);
    const possessiveSubject = /s$/i.test(subject) ? `${subject}'` : `${subject}'s`;
    if (accountState === "restricted") {
      const reason = String(admin?.restrictionReason ?? admin?.restrictReason ?? "").trim() || "Account access restricted";
      const description = convertAdminFacingDescription(
        admin?.restrictionDescription ?? admin?.restrictDescription,
        admin,
        `${possessiveSubject} account is restricted. Reason: ${reason}.`,
      );
      const date = admin?.restrictedAt ?? admin?.statusUpdatedAt ?? admin?.updatedAt ?? "";
      const actor = String(admin?.restrictedBy || "Super Admin").trim();
      const expiresAt = getCompanyRestrictExpiresAt(admin);
      const limitLabels = getCompanyRestrictionLimitLabels(admin);
      return {
        heading: "Reason for Restriction",
        reason,
        description,
        meta: `Restricted ${date ? formatDateTime(date) : "on an unknown date"} by ${actor}`,
        details: [
          ...(expiresAt ? [{ label: "Expires", value: formatDateTime(expiresAt) }] : []),
          ...(limitLabels.length ? [{ label: "Access limits", value: limitLabels.join(", ") }] : []),
        ],
        tone: "warning",
      };
    }
    if (accountState === "banned") {
      const reason = String(admin?.banReason ?? admin?.lastBanReason ?? "").trim() || "Company account banned";
      const description = convertAdminFacingDescription(
        admin?.banDescription ?? admin?.banDetails,
        admin,
        `${possessiveSubject} account is banned. Reason: ${reason}.`,
      );
      const date = admin?.bannedAt ?? admin?.lastBannedAt ?? admin?.statusUpdatedAt ?? "";
      const actor = String(admin?.bannedBy ?? admin?.lastBannedBy ?? "Super Admin").trim();
      return {
        heading: "Reason for Ban",
        reason,
        description,
        meta: `Banned ${date ? formatDateTime(date) : "on an unknown date"} by ${actor}`,
        details: [],
        tone: "danger",
      };
    }
    if (accountState === "suspended") {
      const date = getCompanyAccountStateDate(admin, "suspended");
      return {
        heading: "Reason for Suspension",
        reason: "Company account suspended",
        description: `${possessiveSubject} account is suspended and cannot currently access protected admin features.`,
        meta: date ? `Suspended ${formatDateTime(date)}` : "Suspension date unavailable",
        details: [],
        tone: "danger",
      };
    }
    const warningCount = getCompanyWarningCount(admin);
    if (warningCount > 0) {
      const reason = String(
        admin?.lastWarningReason ??
          admin?.lastSuperAdminNotificationReason ??
          admin?.superAdminNotificationReason ??
          "",
      ).trim() || "Super admin warning";
      const notifiedAt = admin?.lastWarningAt ?? admin?.lastSuperAdminNotifiedAt ?? "";
      const warningLabel = getCompanyRestrictionLevelFromWarningCount(warningCount).label;
      return {
        heading: "Warning Notice",
        reason,
        description: `${possessiveSubject} seller account has ${numberText(warningCount)} active warning${warningCount === 1 ? "" : "s"}.`,
        meta: notifiedAt ? `Notified ${formatDateTime(notifiedAt)}` : `${warningLabel} warning level`,
        details: [{ label: "Restriction level", value: `${warningLabel} (${numberText(warningCount)} of 3)` }],
        tone: warningCount >= 3 ? "danger" : "warning",
      };
    }
    if (metrics.violations > 0 || metrics.reports > 0) {
      const reason = `${numberText(metrics.violations)} violation${metrics.violations === 1 ? "" : "s"} and ${numberText(metrics.reports)} report${metrics.reports === 1 ? "" : "s"}`;
      return {
        heading: "Warning / Penalty Reason",
        reason,
        description: `${possessiveSubject} account requires a compliance review because of recorded reports or policy violations.`,
        meta: "Review this company for possible policy action.",
        details: [],
        tone: "warning",
      };
    }
    return {
      heading: "Account Standing",
      reason: "No active warning or penalty",
      description: `${possessiveSubject} account currently has a clear record with no active warning or penalty.`,
      meta: "No policy action is currently required.",
      details: [],
      tone: "clear",
    };
  }

  // Builds the DOM structure for company drawer overview row.
  function createCompanyDrawerOverviewRow(iconPath, label, descriptor) {
    const row = document.createElement("div");
    row.className = "super-admin-company-drawer__overview-row";

  // Sends a seller notification from the Notify action.
  async function notifyCompanySeller(adminIds) {
    const normalizedAdminIds = normalizeCompanyActionTargetIds(adminIds);
    if (!normalizedAdminIds.length) {
      return;
    }
    await performCompanyControlAction("notify", normalizedAdminIds, {
      payload: createCompanySellerWarningPayload(normalizedAdminIds),
    });
  }

  // Sends company control actions to the API and updates local company state.
  async function performCompanyControlAction(action, adminIds, options = {}) {
    const normalizedAction = String(action || "").trim().toLowerCase();
    const normalizedAdminIds = normalizeCompanyActionTargetIds(adminIds);
    const label = getCompanyActionTargetLabel(normalizedAdminIds);

    if (!normalizedAdminIds.length) {
      return;
    }

    let actionPayload = {
      action: normalizedAction,
      ...(options.payload && typeof options.payload === "object" ? options.payload : {}),
    };
    if (["ban", "restrict", "unban", "unrestrict"].includes(normalizedAction)) {
      const banSelection = await showCompanyBanModal(normalizedAdminIds, normalizedAction);
      if (!banSelection) {
        return;
      }
      actionPayload = {
        ...actionPayload,
        ...banSelection,
      };
    }

    const confirmations = {};

    const confirmation = confirmations[normalizedAction];
    if (confirmation) {
      const confirmed = await showValidationModal({
        mode: "notice",
        iconVariant: normalizedAction === "ban" ? "delete" : "notice",
        title: confirmation.title,
        copy: confirmation.copy,
        actionLabel: confirmation.actionLabel,
        secondaryActionLabel: "Cancel",
      });
      if (!confirmed) {
        return;
      }
    }

    const progressLabels = {
      notify: `Notifying ${label}...`,
      restrict: `Restricting ${label}...`,
      unrestrict: `Unrestricting ${label}...`,
      ban: `Banning ${label}...`,
      unban: `Unbanning ${label}...`,
    };
    setFeedback(progressLabels[normalizedAction] || `Updating ${label}...`);

    try {
      const updatedAdmins = [];
      const actionMessages = [];
      for (const normalizedAdminId of normalizedAdminIds) {
        const response = await fetch(
          `/api/super-admin/admins/${encodeURIComponent(normalizedAdminId)}/action`,
          {
            method: "PATCH",
            headers: rootHeaders({
              Accept: "application/json",
              "Content-Type": "application/json",
            }),
            body: JSON.stringify(actionPayload),
          },
        );
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.message || "Unable to update company.");
        }
        if (data.message) {
          actionMessages.push(String(data.message));
        }
        const updatedAdmin = data.admin || findCompanyById(normalizedAdminId);
        if (updatedAdmin) {
          updatedAdmins.push(applyCompanyControlActionResult(updatedAdmin, normalizedAction));
        }
      }

      if (updatedAdmins.length) {
        for (const updatedAdmin of updatedAdmins) {
          const updatedAdminId = getCompanyId(updatedAdmin);
          companyActivityLogsByAdminId.delete(updatedAdminId);
          companyActivityLogsErrors.delete(updatedAdminId);
          state.admins = state.admins.map((admin) =>
            getCompanyId(admin) === updatedAdminId ? { ...admin, ...updatedAdmin } : admin,
          );
        }
        renderAdmins(state.admins);
        if (state.productRequests.length > 0) {
          renderProductRequests();
        }
      }
      let successMessage = normalizedAdminIds.length > 1
        ? `${numberText(normalizedAdminIds.length)} companies updated.`
        : `${label} updated.`;
      if (normalizedAction === "notify") {
        const notifiedCount = actionMessages.length || normalizedAdminIds.length;
        successMessage = actionMessages.length === 1
          ? actionMessages[0]
          : `${numberText(notifiedCount)} seller warnings sent.`;
      }
      setFeedback(successMessage, "success");
      const controlSuccessTitles = {
        ban: normalizedAdminIds.length > 1 ? "Companies Banned" : "Company Banned",
        restrict: normalizedAdminIds.length > 1 ? "Companies Restricted" : "Company Restricted",
        unban: normalizedAdminIds.length > 1 ? "Companies Unbanned" : "Company Unbanned",
        unrestrict: normalizedAdminIds.length > 1 ? "Companies Unrestricted" : "Company Unrestricted",
      };
      if (controlSuccessTitles[normalizedAction]) {
        showSuccessValidationModal(controlSuccessTitles[normalizedAction], successMessage);
      }
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to update company.", "error");
    }
  }

  // Opens company detail drawer from the dropdown View action.
  function openCompanyDetailsFromAction(adminId) {
    const normalizedAdminId = String(adminId || "").trim();
    const admin = findCompanyById(normalizedAdminId);
    if (!admin) {
      setFeedback("Company details are not available yet.", "error");
      return;
    }

    openCompanyDrawer(getCompanyId(admin));
  }

  // Routes company action menu selections into the correct control flow.
  async function handleCompanyAction(action, adminId) {
    const normalizedAction = String(action || "").trim().toLowerCase();
    const targetAdminIds = getCompanyActionTargetIds(adminId);

    if (!targetAdminIds.length) {
      return;
    }

    if (normalizedAction === "view") {
      closeCompanyActionMenus();
      openCompanyDetailsFromAction(targetAdminIds[0]);
      return;
    }

    if (normalizedAction === "activity-logs" || normalizedAction === "reports") {
      closeCompanyActionMenus();
      openCompanyActivityModal(targetAdminIds[0]);
      return;
    }

    if (["notify", "restrict", "unrestrict", "ban", "banned", "unban", "unbanned"].includes(normalizedAction)) {
      const controlAction = normalizedAction === "banned"
        ? "ban"
        : normalizedAction === "unbanned"
          ? "unban"
          : normalizedAction;
      if (controlAction === "notify") {
        await notifyCompanySeller(targetAdminIds);
        return;
      }
      await performCompanyControlAction(controlAction, targetAdminIds);
      return;
    }

    const admin = findCompanyById(targetAdminIds[0]);
    const label = admin ? getCompanyName(admin) : "company";
    setFeedback(`${label} ${normalizedAction.replace(/-/g, " ")} is not available yet.`, "error");
  }


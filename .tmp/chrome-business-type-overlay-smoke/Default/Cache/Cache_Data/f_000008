  // Derives the company account state used by cards, drawers, filters, and actions.
  function getCompanyAccountState(admin) {
    const statusToken = [
      admin?.status,
      admin?.accountStatus,
      admin?.accountState,
      admin?.adminStatus,
      admin?.userStatus,
    ]
      .map((value) => String(value || "").trim().toLowerCase())
      .filter(Boolean)
      .join(" ");
    const temporaryBanExpired = isCompanyTemporaryBanExpired(admin);
    const temporaryRestrictionExpired = isCompanyTemporaryRestrictionExpired(admin);

    if (
      !temporaryBanExpired &&
      (
        readTruthyFlag(admin?.isBanned) ||
        readTruthyFlag(admin?.banned) ||
        Boolean(admin?.bannedAt) ||
        statusToken.includes("banned")
      )
    ) {
      return "banned";
    }

    if (
      !temporaryRestrictionExpired &&
      (
      readTruthyFlag(admin?.isRestricted) ||
      readTruthyFlag(admin?.restricted) ||
      Boolean(admin?.restrictedAt) ||
      statusToken.includes("restricted") ||
      statusToken.includes("restrict")
      )
    ) {
      return "restricted";
    }

    if (
      !temporaryBanExpired &&
      !temporaryRestrictionExpired &&
      (
        readTruthyFlag(admin?.isSuspended) ||
        readTruthyFlag(admin?.suspended) ||
        readTruthyFlag(admin?.disabled) ||
        Boolean(admin?.suspendedAt) ||
        Boolean(admin?.deactivatedAt) ||
        Boolean(admin?.disabledAt) ||
        statusToken.includes("suspended") ||
        statusToken.includes("suspend") ||
        statusToken.includes("deactivated") ||
        statusToken.includes("inactive") ||
        statusToken.includes("disabled")
      )
    ) {
      return "suspended";
    }

    return "active";
  }

  // Reads or derives company account state date for the current super admin flow.
  function getCompanyAccountStateDate(admin, metric) {
    if (metric === "banned") {
      return admin?.bannedAt || admin?.statusUpdatedAt || admin?.updatedAt || getCompanyCreatedAt(admin);
    }
    if (metric === "restricted") {
      return admin?.restrictedAt || admin?.statusUpdatedAt || admin?.updatedAt || getCompanyCreatedAt(admin);
    }
    if (metric === "suspended") {
      return (
        admin?.suspendedAt ||
        admin?.deactivatedAt ||
        admin?.disabledAt ||
        admin?.statusUpdatedAt ||
        admin?.updatedAt ||
        getCompanyCreatedAt(admin)
      );
    }
    return getCompanyCreatedAt(admin) || admin?.statusUpdatedAt || admin?.updatedAt;
  }

  // Counts company metric by period for dashboard metrics.
  function countCompanyMetricByPeriod(admins, metric, startDate, endDate) {
    return admins.filter((admin) => {
      if (metric === "online") {
        return isCompanyAdminOnline(admin);
      }
      if (metric !== "total" && getCompanyAccountState(admin) !== metric) {
        return false;
      }
      const date = parseCompanyDate(getCompanyAccountStateDate(admin, metric));
      return Boolean(date && date >= startDate && date < endDate);
    }).length;
  }

  // Reads or derives company metric trend for the current super admin flow.
  function getCompanyMetricTrend(admins, metric) {
    if (metric === "online") {
      return {
        direction: "neutral",
        valueText: "Live",
        periodText: "real-time",
      };
    }

    const now = new Date();
    const currentMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
    const nextMonthStart = new Date(now.getFullYear(), now.getMonth() + 1, 1);
    const previousMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);
    const currentCount = countCompanyMetricByPeriod(admins, metric, currentMonthStart, nextMonthStart);
    const previousCount = countCompanyMetricByPeriod(admins, metric, previousMonthStart, currentMonthStart);
    const rawPercent = previousCount > 0
      ? ((currentCount - previousCount) / previousCount) * 100
      : currentCount > 0
        ? 100
        : 0;
    const direction = rawPercent < 0 ? "down" : rawPercent > 0 ? "up" : "neutral";
    const arrow = direction === "down" ? "\u2193" : "\u2191";

    return {
      direction,
      valueText: `${arrow} ${Math.abs(rawPercent).toFixed(1)}%`,
      periodText: "this month",
    };
  }

  // Renders company stats from the latest state.
  function renderCompanyStats(admins = state.admins) {
    const adminList = Array.isArray(admins) ? admins : [];
    const totals = adminList.reduce(
      (summary, admin) => {
        const accountState = getCompanyAccountState(admin);
        summary.total += 1;
        summary[accountState] += 1;
        if (isCompanyAdminOnline(admin)) {
          summary.online += 1;
        }
        return summary;
      },
      {
        total: 0,
        active: 0,
        online: 0,
        suspended: 0,
        banned: 0,
        restricted: 0,
      },
    );

    for (const card of elements.companyStatCards) {
      const metric = String(card.dataset.superAdminCompanyStat || "").trim();
      const valueTarget = card.querySelector("[data-super-admin-company-stat-value]");
      const trendTarget = card.querySelector("[data-super-admin-company-stat-trend]");
      if (valueTarget) {
        valueTarget.textContent = numberText(totals[metric] || 0);
      }
      if (trendTarget) {
        const trend = getCompanyMetricTrend(adminList, metric);
        trendTarget.textContent = "";
        const trendValue = document.createElement("span");
        trendValue.className = "super-admin-stat__trend-value";
        trendValue.textContent = trend.valueText;
        const trendPeriod = document.createElement("span");
        trendPeriod.className = "super-admin-stat__trend-period";
        trendPeriod.textContent = trend.periodText;
        trendTarget.append(trendValue, trendPeriod);
        trendTarget.classList.toggle("is-up", trend.direction === "up");
        trendTarget.classList.toggle("is-down", trend.direction === "down");
        trendTarget.classList.toggle("is-neutral", trend.direction === "neutral");
      }
    }
  }

  // Finds company by id in local state.
  function findCompanyById(adminId) {
    const normalizedAdminId = String(adminId || "").trim();
    if (!normalizedAdminId) {
      return null;
    }
    return state.admins.find((admin) => getCompanyId(admin) === normalizedAdminId) || null;
  }

  // Reads or derives company image url for the current super admin flow.
  function getCompanyImageUrl(admin) {
    return [
      admin?.profileImageUrl,
      admin?.avatarUrl,
      admin?.photoUrl,
      admin?.profilePhotoUrl,
      admin?.pictureUrl,
      admin?.imageUrl,
      admin?.logoUrl,
    ]
      .map((value) => String(value || "").trim())
      .find(Boolean) || "";
  }

  // Reads or derives company initials for the current super admin flow.
  function getCompanyInitials(admin) {
    const companyName = getCompanyName(admin);
    return companyName
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part.charAt(0).toUpperCase())
      .join("") || "CO";
  }

  // Reads or derives company tone index for the current super admin flow.
  function getCompanyToneIndex(admin) {
    const source = String(admin?.adminId || admin?.id || admin?.email || getCompanyName(admin));
    let hash = 0;
    for (const char of source) {
      hash = (hash + char.charCodeAt(0)) % 6;
    }
    return hash + 1;
  }

  // Checks whether company admin online is true for the current record or UI state.
  function isCompanyAdminOnline(admin) {
    const statusToken = String(
      admin?.presenceStatus ??
        admin?.onlineStatus ??
        admin?.sessionStatus ??
        admin?.loginStatus ??
        admin?.status ??
        "",
    )
      .trim()
      .toLowerCase();

    const hasOnlineSignal = Boolean(
      admin?.isOnline === true ||
        admin?.online === true ||
        admin?.loggedIn === true ||
        admin?.isLoggedIn === true ||
        admin?.sessionActive === true ||
        statusToken === "online" ||
        statusToken === "logged-in" ||
        statusToken === "logged in" ||
        statusToken.includes("online"),
    );
    return hasOnlineSignal && isCompanyPresenceFresh(admin);
  }

  // Reads or derives company search text for the current super admin flow.
  function getCompanySearchText(admin) {
    const counts = getAdminCounts(admin);
    return [
      getCompanyName(admin),
      getAdminName(admin),
      admin?.email,
      admin?.adminId,
      admin?.id,
      admin?.mobileNumber,
      `${counts.followers} followers`,
      `${counts.rating.toFixed(1)} rating`,
      `${counts.commentCount} reviews`,
      `${counts.employees} employees`,
      `${counts.orders} orders`,
      `${counts.chats} chats`,
    ].map((value) => String(value || "").toLowerCase()).join(" ");
  }

  function normalizeCompanyFilterValue(type, value) {
    const normalized = String(value || "").trim();
    if (type === "accountState") {
      return normalizeCompanyAccountFilter(normalized);
    }
    if (type === "workspace") {
      return ["with-products", "no-products", "with-orders", "with-chats"].includes(normalized)
        ? normalized
        : "all";
    }
    if (type === "team") {
      return ["no-staff", "small", "growing"].includes(normalized) ? normalized : "all";
    }
    if (type === "activity") {
      return ["online", "active", "quiet"].includes(normalized) ? normalized : "all";
    }
    return "all";
  }

  // Supports the matches company filters branch of the super admin UI.
  function matchesCompanyFilters(admin) {
    const counts = getAdminCounts(admin);
    const filters = state.companyFilters || {};
    const workspaceFilter = normalizeCompanyFilterValue("workspace", filters.workspace);
    const teamFilter = normalizeCompanyFilterValue("team", filters.team);
    const activityFilter = normalizeCompanyFilterValue("activity", filters.activity);

    if (workspaceFilter === "with-products" && counts.products <= 0) {
      return false;
    }
    if (workspaceFilter === "no-products" && counts.products > 0) {
      return false;
    }
    if (workspaceFilter === "with-orders" && counts.orders <= 0) {
      return false;
    }
    if (workspaceFilter === "with-chats" && counts.chats <= 0) {
      return false;
    }
    if (teamFilter === "no-staff" && counts.employees > 0) {
      return false;
    }
    if (teamFilter === "small" && (counts.employees < 1 || counts.employees > 10)) {
      return false;
    }
    if (teamFilter === "growing" && counts.employees < 11) {
      return false;
    }
    if (activityFilter === "online" && !isCompanyAdminOnline(admin)) {
      return false;
    }
    if (activityFilter === "active" && counts.products + counts.orders + counts.chats <= 0) {
      return false;
    }
    if (activityFilter === "quiet" && counts.products + counts.orders + counts.chats > 0) {
      return false;
    }

    const accountStateFilter = normalizeCompanyAccountFilter(filters.accountState);
    const accountState = getCompanyAccountState(admin);
    if (accountStateFilter === "low-risk" && accountState !== "active") {
      return false;
    }
    if (accountStateFilter === "banned" && accountState !== "banned") {
      return false;
    }
    if (accountStateFilter === "restricted" && accountState !== "restricted") {
      return false;
    }
    if (accountStateFilter === "suspended" && accountState !== "suspended") {
      return false;
    }

    return true;
  }

  // Reads or derives filtered admins for the current super admin flow.
  function getFilteredAdmins(admins = state.admins) {
    const searchTerm = state.companySearchTerm.trim().toLowerCase();
    return admins.filter((admin) => {
      if (searchTerm && !getCompanySearchText(admin).includes(searchTerm)) {
        return false;
      }
      return matchesCompanyFilters(admin);
    });
  }

  function normalizeCompanySortValue(value) {
    const normalized = String(value || "").trim().toLowerCase();
    return [
      "created-asc",
      "company-asc",
      "products-desc",
      "employees-desc",
      "orders-desc",
      "rating-desc",
      "reviews-desc",
      "followers-desc",
    ].includes(normalized)
      ? normalized
      : "created-desc";
  }

  function normalizeCompanySortValues(value) {
    return normalizeSortValues(value, normalizeCompanySortValue, "created-desc");
  }

  function compareCompanyNames(left, right) {
    return getCompanyName(left).localeCompare(getCompanyName(right), undefined, {
      sensitivity: "base",
    });
  }

  function compareAdminsBySortValue(left, right, leftCounts, rightCounts, sortValue) {
    if (sortValue === "company-asc") {
      return compareCompanyNames(left, right);
    }
    if (sortValue === "created-asc") {
      return String(left?.createdAt || "").localeCompare(String(right?.createdAt || ""));
    }
    if (sortValue === "products-desc") {
      return rightCounts.products - leftCounts.products;
    }
    if (sortValue === "employees-desc") {
      return rightCounts.employees - leftCounts.employees;
    }
    if (sortValue === "orders-desc") {
      return rightCounts.orders - leftCounts.orders;
    }
    if (sortValue === "rating-desc") {
      return rightCounts.rating - leftCounts.rating;
    }
    if (sortValue === "reviews-desc") {
      return rightCounts.commentCount - leftCounts.commentCount;
    }
    if (sortValue === "followers-desc") {
      return rightCounts.followers - leftCounts.followers;
    }
    return String(right?.createdAt || "").localeCompare(String(left?.createdAt || ""));
  }

  // Supports the sort admins branch of the super admin UI.
  function sortAdmins(admins) {
    const sortedAdmins = [...admins];
    sortedAdmins.sort((left, right) => {
      const leftCounts = getAdminCounts(left);
      const rightCounts = getAdminCounts(right);
      for (const sortValue of normalizeCompanySortValues(state.companySort)) {
        const compareResult = compareAdminsBySortValue(left, right, leftCounts, rightCounts, sortValue);
        if (compareResult !== 0) {
          return compareResult;
        }
      }

      return compareCompanyNames(left, right);
    });
    return sortedAdmins;
  }


  // Keeps company restriction limit dropdown synchronized with current state.
  function syncCompanyRestrictionLimitDropdown() {
    const isRestrict = companyControlModalMode === "restrict";
    const selectedLimits = getSelectedCompanyRestrictionLimits();
    const selectedLabels = getSelectedCompanyRestrictionLimitLabels();
    const limitReached = selectedLimits.length >= companyRestrictionLimitMaxSelection;
    const labelText = selectedLabels.length
      ? selectedLabels.join(", ")
      : String(companyRestrictionLimitMaxSelection);

    if (elements.companyRestrictionLimitLabel instanceof HTMLElement) {

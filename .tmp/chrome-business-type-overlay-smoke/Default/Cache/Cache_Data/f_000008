  // Returns copy, imagery, and an icon suited to the business type name.
  function getBusinessTypePresentation(storeTypeName) {
    const key = normalizeCategoryName(storeTypeName).toLowerCase();
    const defaultPresentation = {
      iconClass: "fa-store",
      tagline: "Products, services, and customer experiences",
      description: "Manage categories, company assignments, and catalog activity for this business type.",
      imageUrl: "/assets/business-types/restaurant-hero.webp",
    };

    if (/(restaurant|food|cafe|coffee|bakery|dining)/.test(key)) {
      return {
        iconClass: "fa-utensils",
        tagline: "Food, drinks, and dining experiences",
        description: "Manage restaurant categories, organize menu items, and monitor connected catalog activity.",
        imageUrl: "/assets/business-types/restaurant-hero.webp",
      };
    }
    if (/(grocery|market|supermarket|produce)/.test(key)) {
      return {
        iconClass: "fa-basket-shopping",
        tagline: "Fresh goods and everyday essentials",
        description: "Organize grocery categories, products, and participating companies from one place.",
        imageUrl: "/assets/business-types/produce.jpg",
      };
    }
    if (/(pharmacy|health|wellness|medical)/.test(key)) {
      return {
        iconClass: "fa-capsules",
        tagline: "Health, wellness, and personal care",
        description: "Manage health-focused categories, catalog items, and connected companies.",
        imageUrl: "/assets/business-types/produce.jpg",
      };
    }
    if (/(fashion|apparel|clothing)/.test(key)) {
      return {
        ...defaultPresentation,
        iconClass: "fa-shirt",
        tagline: "Apparel, accessories, and personal style",
      };
    }
    if (/(electronic|technology|gadget)/.test(key)) {
      return {
        ...defaultPresentation,
        iconClass: "fa-laptop",
        tagline: "Devices, accessories, and technology",
      };
    }

    return defaultPresentation;
  }

  const businessTypeCategoryIconPalette = Object.freeze([
    { tone: "blue", background: "#eaf2ff", color: "#236bcf" },
    { tone: "rose", background: "#fdebf1", color: "#c63d70" },
    { tone: "mint", background: "#e7f8ef", color: "#16905b" },
    { tone: "violet", background: "#f3eafe", color: "#8c3fc1" },
    { tone: "amber", background: "#fff5d8", color: "#c27a0b" },
    { tone: "aqua", background: "#e6f7f8", color: "#168a91" },
    { tone: "red", background: "#fee2e2", color: "#dc2626" },
    { tone: "indigo", background: "#e0e7ff", color: "#4f46e5" },
    { tone: "lime", background: "#ecfccb", color: "#65a30d" },
    { tone: "fuchsia", background: "#fae8ff", color: "#c026d3" },
    { tone: "orange", background: "#ffedd5", color: "#ea580c" },
    { tone: "teal", background: "#ccfbf1", color: "#0f766e" },
  ]);

  function getBusinessTypeCategoryIconColors(categoryName, index) {
    const normalizedIndex = Number.isFinite(index) ? Math.max(0, Math.trunc(index)) : 0;
    const paletteIndex = (normalizedIndex * 5) % businessTypeCategoryIconPalette.length;
    return businessTypeCategoryIconPalette[paletteIndex] || businessTypeCategoryIconPalette[0];
  }

  // Chooses a category image, icon, and color treatment from its label.
  function getBusinessTypeCategoryVisual(categoryName, index, presentation) {
    const key = normalizeCategoryName(categoryName).toLowerCase();
    const iconColors = getBusinessTypeCategoryIconColors(categoryName, index);
    if (/(drink|beverage|coffee|tea|juice|shake)/.test(key)) {
      return {
        ...iconColors,
        imageUrl: "/assets/business-types/drinks.png",
      };
    }
    if (/(fruit|produce|vegetable|fresh)/.test(key)) {
      return {
        ...iconColors,
        imageUrl: "/assets/business-types/produce.jpg",
      };
    }
    if (/(dessert|cake|sweet|pastry)/.test(key)) {
      return {
        ...iconColors,
        imageUrl: "/assets/business-types/meals.webp",
      };
    }
    if (/(meal|food|burger|snack|breakfast|lunch|dinner)/.test(key)) {
      return {
        ...iconColors,
        imageUrl: "/assets/business-types/meals.webp",
      };
    }

    const fallbackVisuals = [
      { imageUrl: presentation.imageUrl },
      { imageUrl: "/assets/business-types/drinks.png" },
      { imageUrl: "/assets/business-types/produce.jpg" },
    ];
    return {
      ...iconColors,
      ...fallbackVisuals[index % fallbackVisuals.length],
    };
  }

  // Finds optional category-level usage details without requiring them from older APIs.
  function getBusinessTypeCategoryStat(storeTypeRecord, categoryName) {
    const key = normalizeCategoryName(categoryName).toLowerCase();
    return (Array.isArray(storeTypeRecord.categoryStats) ? storeTypeRecord.categoryStats : [])
      .find((category) => category.name.toLowerCase() === key) || null;
  }

  // Replaces an unavailable dynamic image with the bundled visual asset.
  function setBusinessTypeImageFallback(image, fallbackImageUrl, missingTarget) {
    image.addEventListener("error", () => {
      if (!fallbackImageUrl) {
        image.hidden = true;
        missingTarget?.classList.add("is-image-missing");
        return;
      }
      if (image.dataset.fallbackApplied === "true") {
        image.hidden = true;
        missingTarget?.classList.add("is-image-missing");
        return;
      }
      image.dataset.fallbackApplied = "true";
      image.src = fallbackImageUrl;
    });
  }

  function getBusinessTypeActionMenu(dropdown) {
    if (!(dropdown instanceof HTMLElement)) {
      return null;
    }
    const localMenu = dropdown.querySelector("[data-business-type-action-menu]");
    if (localMenu instanceof HTMLElement) {
      return localMenu;
    }
    const dropdownId = dropdown.dataset.businessTypeDropdownId || "";
    if (!dropdownId) {
      return null;
    }
    return Array.from(document.querySelectorAll("[data-business-type-action-menu]"))
      .find((menu) =>
        menu instanceof HTMLElement &&
        menu.dataset.businessTypeDropdownId === dropdownId
      ) || null;
  }

  function ensureBusinessTypeDropdownId(dropdown, menu = null) {
    if (!(dropdown instanceof HTMLElement)) {
      return "";
    }
    if (!dropdown.dataset.businessTypeDropdownId) {
      businessTypeActionDropdownIdCounter += 1;
      dropdown.dataset.businessTypeDropdownId = `business-type-action-dropdown-${businessTypeActionDropdownIdCounter}`;
    }
    if (menu instanceof HTMLElement) {
      menu.dataset.businessTypeDropdownId = dropdown.dataset.businessTypeDropdownId;
    }
    return dropdown.dataset.businessTypeDropdownId;
  }

  function isBusinessTypeFloatingMenu(menu) {
    return menu instanceof HTMLElement && menu.hasAttribute("data-business-type-floating-menu");
  }

  function mountBusinessTypeFloatingMenu(dropdown, menu) {
    if (!isBusinessTypeFloatingMenu(menu)) {
      return;
    }
    ensureBusinessTypeDropdownId(dropdown, menu);
    if (menu.parentElement !== document.body) {
      document.body.append(menu);
    }
  }

  function detachBusinessTypeFloatingMenu(menu) {
    if (isBusinessTypeFloatingMenu(menu) && menu.parentElement === document.body) {
      delete menu.dataset.businessTypeFloatingPlacement;
      menu.remove();
    }
  }

  function hasOpenBusinessTypeActionMenu() {
    return typeof document !== "undefined"
      && Boolean(document.querySelector("[data-business-type-action-dropdown].is-open"));
  }

  function closeBusinessTypeActionMenus(exceptDropdown = null) {
    for (const dropdown of document.querySelectorAll("[data-business-type-action-dropdown]")) {
      if (!(dropdown instanceof HTMLElement) || dropdown === exceptDropdown) {
        continue;
      }
      dropdown.classList.remove("is-open");
      const trigger = dropdown.querySelector("[data-business-type-action-trigger]");
      const menu = getBusinessTypeActionMenu(dropdown);
      if (trigger instanceof HTMLElement) {
        trigger.setAttribute("aria-expanded", "false");
      }
      if (menu instanceof HTMLElement) {
        menu.hidden = true;
        detachBusinessTypeFloatingMenu(menu);
      }
    }
  }

  function positionBusinessTypeFloatingMenu(dropdown, options = {}) {
    if (!(dropdown instanceof HTMLElement) || !dropdown.classList.contains("is-open")) {
      return;
    }
    const trigger = dropdown.querySelector("[data-business-type-action-trigger]");
    const menu = getBusinessTypeActionMenu(dropdown);
    if (!(trigger instanceof HTMLElement) || !(menu instanceof HTMLElement) || menu.hidden) {
      return;
    }
    mountBusinessTypeFloatingMenu(dropdown, menu);

    const viewportPadding = 10;
    const gap = 8;
    const triggerRect = trigger.getBoundingClientRect();
    const menuWidth = Math.min(menu.offsetWidth || 248, Math.max(160, window.innerWidth - (viewportPadding * 2)));
    const menuHeight = Math.min(menu.offsetHeight || 180, Math.max(140, window.innerHeight - (viewportPadding * 2)));
    const triggerCenterX = triggerRect.left + (triggerRect.width / 2);
    const left = Math.min(
      Math.max(viewportPadding, triggerCenterX - (menuWidth / 2)),
      Math.max(viewportPadding, window.innerWidth - menuWidth - viewportPadding),
    );
    const belowTop = triggerRect.bottom + gap;
    const aboveTop = triggerRect.top - menuHeight - gap;
    const savedPlacement = menu.dataset.businessTypeFloatingPlacement;
    const shouldReusePlacement = options.recalculatePlacement !== true
      && (savedPlacement === "above" || savedPlacement === "below");
    const shouldOpenAbove = shouldReusePlacement
      ? savedPlacement === "above"
      : belowTop + menuHeight > window.innerHeight - viewportPadding && aboveTop >= viewportPadding;
    const top = shouldOpenAbove ? aboveTop : belowTop;
    const arrowInset = 14;
    const arrowLeft = Math.min(
      Math.max(triggerCenterX - left, arrowInset),
      Math.max(arrowInset, menuWidth - arrowInset),
    );
    const arrowTop = shouldOpenAbove
      ? Math.round(top + menuHeight - 1)
      : Math.round(top - 7);

    menu.style.setProperty("--business-type-floating-menu-left", `${Math.round(left)}px`);
    menu.style.setProperty("--business-type-floating-menu-top", `${Math.round(top)}px`);
    menu.style.setProperty("--business-type-floating-menu-arrow-left", `${Math.round(left + arrowLeft)}px`);
    menu.style.setProperty("--business-type-floating-menu-arrow-top", `${arrowTop}px`);
    menu.dataset.businessTypeFloatingPlacement = shouldOpenAbove ? "above" : "below";
    menu.classList.toggle("is-positioned-above", shouldOpenAbove);
  }

  function positionOpenBusinessTypeFloatingMenus(options = {}) {
    document.querySelectorAll("[data-business-type-action-dropdown].is-open")
      .forEach((dropdown) => positionBusinessTypeFloatingMenu(dropdown, options));
  }

  function scheduleBusinessTypeFloatingMenuPosition(options = {}) {
    if (options.recalculatePlacement === true) {
      businessTypeFloatingMenuPlacementRefreshPending = true;
    }
    if (businessTypeFloatingMenuPositionFrame) {
      return;
    }
    businessTypeFloatingMenuPositionFrame = window.requestAnimationFrame(() => {
      businessTypeFloatingMenuPositionFrame = 0;
      const recalculatePlacement = businessTypeFloatingMenuPlacementRefreshPending;
      businessTypeFloatingMenuPlacementRefreshPending = false;
      positionOpenBusinessTypeFloatingMenus({ recalculatePlacement });
    });
  }

  function scheduleBusinessTypeFloatingMenuPlacementRefresh() {
    scheduleBusinessTypeFloatingMenuPosition({ recalculatePlacement: true });
  }

  function createBusinessTypeActionDropdown(label, actions = [], options = {}) {
    const dropdown = document.createElement("span");
    dropdown.className = `business-type-showcase__action-dropdown ${options.className || ""}`.trim();
    dropdown.dataset.businessTypeActionDropdown = "";

    const trigger = document.createElement("button");
    trigger.type = "button";
    trigger.className = "business-type-showcase__icon-button business-type-showcase__menu-button";
    trigger.dataset.businessTypeActionTrigger = "";
    trigger.setAttribute("aria-label", label);
    trigger.setAttribute("aria-haspopup", "menu");
    trigger.setAttribute("aria-expanded", "false");
    trigger.innerHTML = createIconSvg(
      '<path d="M12 6.2h.01M12 12h.01M12 17.8h.01" stroke-linecap="round" stroke-width="3"></path>',
    );

    const menu = document.createElement("span");
    menu.className = "business-type-showcase__action-menu";
    menu.dataset.businessTypeActionMenu = "";
    menu.setAttribute("role", "menu");
    menu.hidden = true;

    for (const action of actions) {
      const item = document.createElement("button");
      item.type = "button";
      item.className = `business-type-showcase__action-item ${action.tone ? `is-${action.tone}` : ""}`.trim();
      item.setAttribute("role", "menuitem");
      item.innerHTML = `${createIconSvg(action.icon)}<span></span>`;
      item.querySelector("span").textContent = action.label;
      item.addEventListener("click", (event) => {
        event.stopPropagation();
        closeBusinessTypeActionMenus();
        action.onSelect?.();
      });
      menu.append(item);
    }

    trigger.addEventListener("click", (event) => {
      event.stopPropagation();
      const shouldOpen = !dropdown.classList.contains("is-open");
      closeBusinessTypeActionMenus(dropdown);
      dropdown.classList.toggle("is-open", shouldOpen);
      trigger.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
      menu.hidden = !shouldOpen;
    });

    dropdown.append(trigger, menu);
    return dropdown;
  }

  function getBusinessTypeAssetAccept(type = "image") {
    return type === "icon" ? "image/png,image/svg+xml" : "image/jpeg,image/png,image/webp";
  }

  function validateInlineBusinessTypeAssetFile(file, type = "image", label = "Business type") {
    const isIcon = type === "icon";
    const maxBytes = isIcon ? 2 * 1024 * 1024 : 4 * 1024 * 1024;
    if (!(file instanceof File)) {
      return false;
    }
    if (!isSupportedBusinessTypeAssetFile(file, type)) {
      setFeedback(
        isIcon ? `Choose a PNG or SVG ${label.toLowerCase()} icon.`
          : `Choose a JPG, PNG, or WEBP ${label.toLowerCase()} photo.`,
        "error",
      );
      return false;
    }
    if (file.size > maxBytes) {
      setFeedback(
        isIcon ? `${label} icon must be 2MB or smaller.` : `${label} photo must be 4MB or smaller.`,
        "error",
      );
      return false;
    }
    return true;
  }

  function promptInlineBusinessTypeAssetFile(type = "image") {
    return new Promise((resolve) => {
      const input = document.createElement("input");
      input.type = "file";
      input.accept = getBusinessTypeAssetAccept(type);
      input.tabIndex = -1;
      input.style.position = "fixed";
      input.style.left = "-9999px";
      input.style.width = "1px";
      input.style.height = "1px";
      input.style.opacity = "0";
      document.body.append(input);

      let settled = false;
      const cleanup = () => {
        window.removeEventListener("focus", handleWindowFocus);
        input.remove();
      };
      const settle = (file = null) => {
        if (settled) return;
        settled = true;
        cleanup();
        resolve(file);
      };
      const handleWindowFocus = () => {
        window.setTimeout(() => {
          if (!settled && !input.files?.length) settle(null);
        }, 350);
      };

      input.addEventListener("change", () => settle(input.files?.[0] || null), { once: true });
      window.addEventListener("focus", handleWindowFocus);
      input.click();
    });
  }

  function getStoreTypeCategoryDetailsForSave(storeTypeRecord, categories = storeTypeRecord?.categories) {
    const categoryNames = normalizeCategoryValues(categories);
    const categoryStats = normalizeStoreTypeCategoryStats(storeTypeRecord?.categoryStats);
    return categoryNames.map((categoryName) => {
      const existingDetail = categoryStats.find((detail) => isSameCategoryName(detail.name, categoryName));
      return {
        name: categoryName,
        productCount: Math.trunc(normalizeStoreTypeNumber(existingDetail?.productCount)),
        imageUrl: normalizeBusinessTypeImageUrl(existingDetail?.imageUrl),
        iconImageUrl: normalizeBusinessTypeImageUrl(existingDetail?.iconImageUrl),
        iconName: normalizeLucideCategoryIconName(existingDetail?.iconName),
        status: normalizeStoreTypeCategoryStatus(existingDetail?.status),
      };
    });
  }

  function resetInlineStoreTypeAssetDraft() {
      state.inlineStoreTypeAssetDraft = {
        storeTypeName: "",
        heroImageUrl: "",
        iconImageUrl: "",
        iconName: "",
        hasIconImageUrl: false,
        hasIconName: false,
        categoryImageUrls: [],
        categoryIcons: [],
      };
  }

  function ensureInlineStoreTypeAssetDraft(storeTypeName) {
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    if (!isSameStoreTypeName(state.inlineStoreTypeAssetDraft.storeTypeName, normalizedStoreTypeName)) {
      state.inlineStoreTypeAssetDraft = {
        storeTypeName: normalizedStoreTypeName,
        heroImageUrl: "",
        iconImageUrl: "",
        iconName: "",
        hasIconImageUrl: false,
        hasIconName: false,
        categoryImageUrls: [],
        categoryIcons: [],
      };
    }
    return state.inlineStoreTypeAssetDraft;
  }

  function getInlineStoreTypeAssetDraft(storeTypeName) {
    return isSameStoreTypeName(state.inlineStoreTypeAssetDraft.storeTypeName, storeTypeName)
      ? state.inlineStoreTypeAssetDraft
      : null;
  }

  function setInlineStoreTypeAssetDraftValue(storeTypeName, key, value) {
    const draft = ensureInlineStoreTypeAssetDraft(storeTypeName);
    draft[key] = normalizeBusinessTypeImageUrl(value);
    if (key === "iconImageUrl") {
      draft.hasIconImageUrl = true;
      draft.iconName = "";
      draft.hasIconName = true;
    }
  }

  function setInlineStoreTypeIconNameDraft(storeTypeName, iconName) {
    const draft = ensureInlineStoreTypeAssetDraft(storeTypeName);
    draft.iconName = normalizeLucideCategoryIconName(iconName);
    draft.iconImageUrl = "";
    draft.hasIconName = true;
    draft.hasIconImageUrl = true;
  }

  function setInlineStoreTypeCategoryImageDraft(storeTypeName, categoryName, imageUrl) {
    const draft = ensureInlineStoreTypeAssetDraft(storeTypeName);
    const normalizedCategoryName = normalizeCategoryName(categoryName);
    const categoryKey = normalizedCategoryName.toLowerCase();
    const nextImageUrl = normalizeBusinessTypeImageUrl(imageUrl);
    const existingDraft = draft.categoryImageUrls.find((item) =>
      isSameCategoryName(item.categoryName, normalizedCategoryName)
    );
    if (existingDraft) {
      existingDraft.categoryName = normalizedCategoryName;
      existingDraft.imageUrl = nextImageUrl;
    } else {
      draft.categoryImageUrls.push({ categoryName: normalizedCategoryName, categoryKey, imageUrl: nextImageUrl });
    }
  }

  function setInlineStoreTypeCategoryIconDraft(storeTypeName, categoryName, patch = {}) {
    const draft = ensureInlineStoreTypeAssetDraft(storeTypeName);
    const normalizedCategoryName = normalizeCategoryName(categoryName);
    const categoryKey = normalizedCategoryName.toLowerCase();
    const existingDraft = draft.categoryIcons.find((item) =>
      isSameCategoryName(item.categoryName, normalizedCategoryName)
    );
    const nextDraft = existingDraft || {
      categoryName: normalizedCategoryName,
      categoryKey,
      iconImageUrl: "",
      iconName: "",
      hasIconImageUrl: false,
      hasIconName: false,
    };
    nextDraft.categoryName = normalizedCategoryName;
    nextDraft.categoryKey = categoryKey;
    if (Object.prototype.hasOwnProperty.call(patch, "iconImageUrl")) {
      nextDraft.iconImageUrl = normalizeBusinessTypeImageUrl(patch.iconImageUrl);
      nextDraft.iconName = "";
      nextDraft.hasIconImageUrl = true;
      nextDraft.hasIconName = true;
    }
    if (Object.prototype.hasOwnProperty.call(patch, "iconName")) {
      nextDraft.iconName = normalizeLucideCategoryIconName(patch.iconName);
      nextDraft.iconImageUrl = "";
      nextDraft.hasIconName = true;
      nextDraft.hasIconImageUrl = true;
    }
    if (!existingDraft) {
      draft.categoryIcons.push(nextDraft);
    }
  }

  function getInlineStoreTypeCategoryImageDraft(storeTypeName, categoryName) {
    const draft = getInlineStoreTypeAssetDraft(storeTypeName);
    if (!draft) {
      return "";
    }
    const categoryDraft = draft.categoryImageUrls.find((item) => isSameCategoryName(item.categoryName, categoryName));
    return normalizeBusinessTypeImageUrl(categoryDraft?.imageUrl);
  }

  function getInlineStoreTypeCategoryIconDraft(storeTypeName, categoryName) {
    const draft = getInlineStoreTypeAssetDraft(storeTypeName);
    if (!draft) {
      return null;
    }
    return draft.categoryIcons.find((item) => isSameCategoryName(item.categoryName, categoryName)) || null;
  }

  function buildInlineStoreTypeAssetDraftPatch(storeTypeRecord, storeTypeName) {
    const draft = getInlineStoreTypeAssetDraft(storeTypeName);
    const patch = {};
    let hasChanges = false;
    if (!draft) {
      return { patch, hasChanges };
    }

    if (draft.heroImageUrl) {
      patch.heroImageUrl = draft.heroImageUrl;
      hasChanges = true;
    }
    if (draft.hasIconImageUrl) {
      patch.iconImageUrl = draft.iconImageUrl;
      hasChanges = true;
    }
    if (draft.hasIconName) {
      patch.iconName = draft.iconName;
      hasChanges = true;
    }
    if (draft.categoryImageUrls.length || draft.categoryIcons.length) {
      patch.categoryDetails = getStoreTypeCategoryDetailsForSave(storeTypeRecord).map((detail) => {
        const categoryDraft = draft.categoryImageUrls.find((item) =>
          isSameCategoryName(item.categoryName, detail.name)
        );
        const categoryIconDraft = draft.categoryIcons.find((item) =>
          isSameCategoryName(item.categoryName, detail.name)
        );
        return {
          ...detail,
          ...(categoryDraft?.imageUrl ? { imageUrl: categoryDraft.imageUrl } : {}),
          ...(categoryIconDraft?.hasIconImageUrl ? { iconImageUrl: categoryIconDraft.iconImageUrl } : {}),
          ...(categoryIconDraft?.hasIconName ? { iconName: categoryIconDraft.iconName } : {}),
        };
      });
      hasChanges = true;
    }
    return { patch, hasChanges };
  }

  function buildStoreTypeInlinePayload(storeTypeRecord, patch = {}) {
    const categories = normalizeCategoryValues(patch.categories ?? storeTypeRecord?.categories);
    const patchedRecord = {
      ...(storeTypeRecord || {}),
      ...patch,
      categories,
      categoryStats: patch.categoryDetails ?? patch.categoryStats ?? storeTypeRecord?.categoryStats,
    };
    return {
      name: normalizeCategoryName(patch.name ?? storeTypeRecord?.name),
      categories,
      status: normalizeStoreTypeStatus(patch.status ?? storeTypeRecord?.status),
      commissionRate: normalizeStoreTypeNumber(patch.commissionRate ?? storeTypeRecord?.commissionRate),
      serviceFee: normalizeStoreTypeNumber(patch.serviceFee ?? storeTypeRecord?.serviceFee),
      heroImageUrl: normalizeBusinessTypeImageUrl(patch.heroImageUrl ?? storeTypeRecord?.heroImageUrl),
      iconImageUrl: normalizeBusinessTypeImageUrl(patch.iconImageUrl ?? storeTypeRecord?.iconImageUrl),
      iconName: normalizeLucideCategoryIconName(patch.iconName ?? storeTypeRecord?.iconName),
      categoryDetails: getStoreTypeCategoryDetailsForSave(patchedRecord, categories),
    };
  }

  async function saveInlineStoreTypePatch(previousStoreTypeValue, patch = {}, options = {}) {
    const previousStoreTypeName = normalizeCategoryName(previousStoreTypeValue);
    const storeTypeRecord = getStoreTypeRecordByName(previousStoreTypeName) || normalizeStoreTypeRecord({
      name: previousStoreTypeName,
    });
    const payload = buildStoreTypeInlinePayload(storeTypeRecord, patch);
    const nextStoreTypeName = normalizeCategoryName(payload.name);
    const focusTarget = options.focusTarget instanceof HTMLElement ? options.focusTarget : null;

    if (!previousStoreTypeName || !nextStoreTypeName) {
      setFeedback("Enter a business type first.", "error");
      focusTarget?.focus?.();
      return false;
    }

    try {
      if (focusTarget) {
        focusTarget.setAttribute("aria-busy", "true");
        if ("disabled" in focusTarget) focusTarget.disabled = true;
      }
      setFeedback(options.pendingMessage || "Updating business type...");
      const response = await fetch("/api/super-admin/store-types", {
        method: "PUT",
        headers: rootHeaders({
          "Content-Type": "application/json",
          Accept: "application/json",
        }),
        body: JSON.stringify({
          oldName: previousStoreTypeName,
          ...payload,
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to update business type.");
      }

      if (isSameStoreTypeName(state.selectedStoreTypeNavName, previousStoreTypeName)) {
        state.selectedStoreTypeNavName = nextStoreTypeName;
      }
      if (isSameStoreTypeName(state.editingStoreTypeName, previousStoreTypeName)) {
        state.editingStoreTypeName = options.keepStoreTypeEditing === false ? "" : nextStoreTypeName;
      }
      if (isSameStoreTypeName(state.inlineEditingCategoryStoreTypeName, previousStoreTypeName)) {
        state.inlineEditingCategoryStoreTypeName = nextStoreTypeName;
      }
      if (options.inlineCategoryName !== undefined) {
        state.inlineEditingCategoryStoreTypeName = options.inlineCategoryName
          ? nextStoreTypeName
          : "";
        state.inlineEditingCategoryName = normalizeCategoryName(options.inlineCategoryName);
      }
      if (options.clearInlineSettingEdit) {
        state.inlineEditingStoreTypeSettingName = "";
        state.inlineEditingStoreTypeSettingKey = "";
      }

      setStoreTypeData(
        Array.isArray(data.storeTypes) ? data.storeTypes : state.storeTypes,
        Array.isArray(data.storeTypeDetails) ? data.storeTypeDetails : null,
      );
      setFeedback(options.successMessage || data.message || "Business type updated.", "success");
      return true;
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to update business type.", "error");
      return false;
    } finally {
      if (focusTarget) {
        focusTarget.removeAttribute("aria-busy");
        if ("disabled" in focusTarget) focusTarget.disabled = false;
      }
    }
  }

  async function commitInlineStoreTypeNameEdit(storeTypeName, input) {
    if (!(input instanceof HTMLInputElement) || input.dataset.inlineSaving === "true") {
      return;
    }
    const previousStoreTypeName = normalizeCategoryName(storeTypeName);
    const nextStoreTypeName = normalizeCategoryName(input.value);
    if (!nextStoreTypeName) {
      setFeedback("Enter a business type first.", "error");
      input.focus();
      return;
    }
    input.value = nextStoreTypeName;
    if (isSameStoreTypeName(previousStoreTypeName, nextStoreTypeName)) {
      return;
    }
    input.dataset.inlineSaving = "true";
    await saveInlineStoreTypePatch(
      previousStoreTypeName,
      { name: nextStoreTypeName },
      {
        focusTarget: input,
        pendingMessage: "Renaming business type...",
        successMessage: "Business type name updated.",
      },
    );
    delete input.dataset.inlineSaving;
  }

  function getStoreTypeSettingEditConfig(settingKey) {
    const key = String(settingKey || "").trim();
    if (key === "commissionRate") {
      return {
        key,
        label: "Commission",
        inputLabel: "commission rate",
        pendingMessage: "Updating commission rate...",
        successMessage: "Commission rate updated.",
        suffix: "%",
      };
    }
    if (key === "serviceFee") {
      return {
        key,
        label: "Service fee",
        inputLabel: "service fee",
        pendingMessage: "Updating service fee...",
        successMessage: "Service fee updated.",
        prefix: "PHP",
      };
    }
    return null;
  }

  function startInlineStoreTypeSettingEdit(storeTypeName, settingKey) {
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    const settingConfig = getStoreTypeSettingEditConfig(settingKey);
    if (!normalizedStoreTypeName || !settingConfig) {
      return;
    }

    state.editingStoreTypeName = "";
    state.inlineEditingCategoryStoreTypeName = "";
    state.inlineEditingCategoryName = "";
    state.inlineEditingStoreTypeSettingName = normalizedStoreTypeName;
    state.inlineEditingStoreTypeSettingKey = settingConfig.key;
    closeBusinessTypeActionMenus();
    renderStoreTypes();
    window.requestAnimationFrame(() => {
      const targetElement = getStoreTypeElementByName(normalizedStoreTypeName);
      const input = targetElement?.querySelector(`[data-business-type-setting-input="${settingConfig.key}"]`);
      if (input instanceof HTMLInputElement) {
        input.focus({ preventScroll: true });
        input.select();
      }
    });
  }

  async function commitInlineStoreTypeSettingEdit(storeTypeName, settingKey, input) {
    const settingConfig = getStoreTypeSettingEditConfig(settingKey);
    if (!(input instanceof HTMLInputElement) || input.dataset.inlineSaving === "true" || !settingConfig) {
      return;
    }
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    const storeTypeRecord = getStoreTypeRecordByName(normalizedStoreTypeName);
    if (!storeTypeRecord) {
      return;
    }
    if (!String(input.value || "").trim()) {
      setFeedback(`Enter a ${settingConfig.inputLabel} first.`, "error");
      input.focus();
      return;
    }

    const nextValue = normalizeStoreTypeNumber(input.value);
    const previousValue = normalizeStoreTypeNumber(storeTypeRecord[settingConfig.key]);
    input.value = String(nextValue);

    if (nextValue === previousValue) {
      state.inlineEditingStoreTypeSettingName = "";
      state.inlineEditingStoreTypeSettingKey = "";
      renderStoreTypes();
      return;
    }

    input.dataset.inlineSaving = "true";
    const didSave = await saveInlineStoreTypePatch(
      normalizedStoreTypeName,
      { [settingConfig.key]: nextValue },
      {
        focusTarget: input,
        clearInlineSettingEdit: true,
        pendingMessage: settingConfig.pendingMessage,
        successMessage: settingConfig.successMessage,
      },
    );
    if (!didSave) {
      delete input.dataset.inlineSaving;
      input.focus();
      input.select();
    }
  }

  async function handleInlineStoreTypeImageUpload(storeTypeName) {
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    if (!isSameStoreTypeName(state.editingStoreTypeName, normalizedStoreTypeName)) {
      return;
    }
    const file = await promptInlineBusinessTypeAssetFile("image");
    if (!validateInlineBusinessTypeAssetFile(file, "image", "Business type")) {
      return;
    }
    const loadingTarget = getStoreTypeElementByName(normalizedStoreTypeName)
      ?.querySelector(".business-type-showcase__media");
    try {
      setBusinessTypeImageUploadLoading(loadingTarget, true);
      setFeedback("Uploading business type photo...");
      const heroImageUrl = await uploadSuperAdminProductImageFile(file);
      setInlineStoreTypeAssetDraftValue(normalizedStoreTypeName, "heroImageUrl", heroImageUrl);
      renderStoreTypes();
      setFeedback("Business type photo ready. Press Save to apply.", "success");
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to upload business type photo.", "error");
    } finally {
      setBusinessTypeImageUploadLoading(loadingTarget, false);
    }
  }

  function renderInlineBusinessTypeLucideIconPicker(panel, storeTypeName, searchTerm = "", options = {}) {
    if (!(panel instanceof HTMLElement)) {
      return;
    }
    const shouldRestoreSearchFocus = Boolean(options.focusSearch) || isIconPickerSearchFocused(panel);
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    const assetDraft = getInlineStoreTypeAssetDraft(normalizedStoreTypeName);
    const storeTypeRecord = getStoreTypeRecordByName(normalizedStoreTypeName) || {};
    const selectedIconName = normalizeLucideCategoryIconName(
      assetDraft?.hasIconName ? assetDraft.iconName : storeTypeRecord.iconName,
    );
    setIconPickerCurrentSearchTerm(panel, searchTerm);
    const iconOptions = getFilteredIconPickerOptions(searchTerm);
    const visibleCount = getPanelIconPickerVisibleCount(panel, iconOptions, searchTerm);
    const visibleIconOptions = getIconPickerVisibleOptions(iconOptions, visibleCount, selectedIconName);

    panel.innerHTML = "";
    const searchInput = document.createElement("input");
    searchInput.type = "search";
    searchInput.className = "business-type-showcase__icon-picker-search";
    searchInput.placeholder = "Search icon";
    searchInput.value = searchTerm;
    searchInput.setAttribute("aria-label", "Search icons");
    searchInput.addEventListener("click", (event) => event.stopPropagation());
    searchInput.addEventListener("input", () => {
      const nextSearchTerm = searchInput.value;
      setIconPickerCurrentSearchTerm(panel, nextSearchTerm);
      scheduleIconPickerSearchRender(panel, () => {
        renderInlineBusinessTypeLucideIconPicker(panel, normalizedStoreTypeName, nextSearchTerm, {
          focusSearch: true,
        });
      });
    });

    const grid = document.createElement("span");
    grid.className = "business-type-showcase__icon-picker-grid";
    for (const { iconName, label } of visibleIconOptions) {
      const iconButton = document.createElement("button");
      iconButton.type = "button";
      iconButton.className = "business-type-showcase__icon-picker-option";
      iconButton.classList.toggle("is-selected", selectedIconName === iconName);
      iconButton.setAttribute("aria-label", label);
      iconButton.title = label;
      iconButton.innerHTML = createLucideCategoryIconSvg(iconName, { queueTablerRefresh: false });
      iconButton.addEventListener("click", (event) => {
        event.stopPropagation();
        setInlineStoreTypeIconNameDraft(normalizedStoreTypeName, iconName);
        closeBusinessTypeActionMenus();
        renderStoreTypes();
        setFeedback("Business type icon ready. Press Save to apply.", "success");
      });
      grid.append(iconButton);
    }

    if (visibleCount < iconOptions.length || hasUndiscoveredTablerIcons()) {
      grid.append(createIconPickerShowMoreButton(Math.max(iconOptions.length - visibleCount, 0), async () => {
        await ensureTablerIconCatalog();
        const nextIconOptions = getFilteredIconPickerOptions(searchTerm);
        setPanelIconPickerVisibleCount(
          panel,
          getIconPickerNextVisibleCount(nextIconOptions, visibleCount),
        );
        renderInlineBusinessTypeLucideIconPicker(panel, normalizedStoreTypeName, searchTerm);
      }));
    }

    if (!iconOptions.length) {
      const empty = document.createElement("span");
      empty.className = "business-type-showcase__icon-picker-empty";
      empty.textContent = "No icons found.";
      grid.append(empty);
    }
    panel.append(searchInput, grid);
    if (shouldRestoreSearchFocus) {
      focusIconPickerSearchInput(panel);
    }
    hydrateIconPickerOptions(panel, visibleIconOptions, searchTerm, () => {
      renderInlineBusinessTypeLucideIconPicker(panel, normalizedStoreTypeName, searchTerm);
    });
  }


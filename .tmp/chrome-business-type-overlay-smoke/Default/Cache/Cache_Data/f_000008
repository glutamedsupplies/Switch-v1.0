    return grid;
  }

  function createProductDetailSection(title, children, options = {}) {
    const visibleChildren = (Array.isArray(children) ? children : [])
      .filter((child) => child instanceof Node);
    if (!visibleChildren.length && options.showEmpty !== true) {
      return null;
    }

    const section = document.createElement("section");
    section.className = "super-admin-product-detail-modal__section";
    if (options.className) {
      section.classList.add(...String(options.className).trim().split(/\s+/).filter(Boolean));
    }
    const heading = document.createElement("h3");
    heading.textContent = title;
    section.append(heading);
    if (visibleChildren.length) {
      section.append(...visibleChildren);
    } else {
      const empty = document.createElement("p");
      empty.className = "super-admin-product-detail-modal__empty";
      empty.textContent = options.emptyText || "No details saved.";
      section.append(empty);
    }
    return section;
  }

  function normalizeProductDetailUrlList(values) {
    const urls = [];
    const seen = new Set();
    const append = (value) => {
      if (Array.isArray(value)) {
        for (const item of value) {
          append(item);
        }
        return;
      }
      const url = String(value || "").trim();
      const key = url.toLowerCase();
      if (!url || seen.has(key)) {
        return;
      }
      seen.add(key);
      urls.push(url);
    };
    append(values);
    return urls;
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function getProductRevisionOption(value) {
    const normalizedValue = String(value || "").trim().toLowerCase();
    return productRevisionOptions.find((option) => option.value === normalizedValue) || null;
  }

  function normalizeProductRevisionFields(values) {
    const rawValues = Array.isArray(values)
      ? values
      : values === null || values === undefined
        ? []
        : [values];
    const seen = new Set();
    const fields = [];
    rawValues.forEach((value) => {
      const option = getProductRevisionOption(value);
      if (!option || seen.has(option.value)) {
        return;
      }
      seen.add(option.value);
      fields.push(option.value);
    });
    return fields;
  }

  function getProductRevisionFieldLabels(fields) {
    return normalizeProductRevisionFields(fields)
      .map((field) => getProductRevisionOption(field)?.label || field)
      .filter(Boolean);
  }

  function getSuggestedProductRevisionFields(revisionSignal) {
    if (!revisionSignal || typeof revisionSignal !== "object") {
      return [];
    }

    const fields = [];
    const matchType = String(revisionSignal.matchType || "").trim().toLowerCase();
    const hasImageEvidence =
      Array.isArray(revisionSignal.images) && revisionSignal.images.length > 0 ||
      Array.isArray(revisionSignal.imageUrls) && revisionSignal.imageUrls.length > 0 ||
      String(revisionSignal.imageUrl || "").trim();
    const hasCategoryEvidence =
      Array.isArray(revisionSignal.categoryEvidence) && revisionSignal.categoryEvidence.length > 0 ||
      Array.isArray(revisionSignal.categoryAlerts) && revisionSignal.categoryAlerts.length > 0 ||
      Array.isArray(revisionSignal.categoryMismatches) && revisionSignal.categoryMismatches.length > 0;

    if (Array.isArray(revisionSignal.fields) || Array.isArray(revisionSignal.revisionFields)) {
      fields.push(...normalizeProductRevisionFields(revisionSignal.fields || revisionSignal.revisionFields));
    }
    if (hasImageEvidence || matchType.includes("media") || matchType.includes("visual")) {
      fields.push("image");
    }
    if (matchType.includes("name")) {
      fields.push("name");
    }
    if (hasCategoryEvidence || matchType.includes("category")) {
      fields.push("category");
    }
    return normalizeProductRevisionFields(fields);
  }


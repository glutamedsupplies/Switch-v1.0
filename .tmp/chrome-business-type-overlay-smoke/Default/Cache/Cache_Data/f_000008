  // Updates store type data and synchronizes related UI state.
  function setStoreTypeData(storeTypes = [], storeTypeDetails = null) {
    const sourceDetails = Array.isArray(storeTypeDetails) && storeTypeDetails.length
      ? storeTypeDetails
      : storeTypes;
    state.storeTypeDetails = normalizeStoreTypeRecords(sourceDetails);
    renderStoreTypes(
      Array.isArray(storeTypes) && storeTypes.length
        ? storeTypes
      : state.storeTypeDetails,
    );
  }

  function normalizeStoreTypeFilterValue(type, value) {
    const normalized = String(value || "").trim().toLowerCase();
    if (type === "status") {
      return ["active", "inactive"].includes(normalized) ? normalized : "all";
    }
    if (type === "usage") {
      return ["companies", "products", "unused"].includes(normalized) ? normalized : "all";
    }
    if (type === "setup") {
      return ["complete", "missing-categories", "missing-assets"].includes(normalized) ? normalized : "all";
    }
    return "all";
  }

  function normalizeStoreTypeSortValue(value) {
    const normalized = String(value || "").trim().toLowerCase();
    return [
      "products-desc",
      "companies-desc",
      "categories-desc",
      "commission-desc",
      "service-fee-desc",
    ].includes(normalized)
      ? normalized
      : "name-asc";
  }

  function normalizeStoreTypeSortValues(value) {
    return normalizeSortValues(value, normalizeStoreTypeSortValue, "name-asc");
  }

  function getStoreTypeFilterRecord(storeTypeName) {
    return getStoreTypeRecordByName(storeTypeName) || normalizeStoreTypeRecord(storeTypeName);
  }

  function getStoreTypeSearchText(record) {
    return [
      record?.name,
      record?.status,
      ...(Array.isArray(record?.categories) ? record.categories : []),
      record?.companiesUsing > 0 ? "companies used in use" : "unused",
      record?.productCount > 0 ? "products" : "no products",
      record?.heroImageUrl ? "image" : "missing image",
      record?.iconImageUrl || record?.iconName ? "icon" : "missing icon",
    ].join(" ").toLowerCase();
  }

  function storeTypeMatchesFilters(record) {
    const filters = state.storeTypeFilters || {};
    const statusFilter = normalizeStoreTypeFilterValue("status", filters.status);
    const usageFilter = normalizeStoreTypeFilterValue("usage", filters.usage);
    const setupFilter = normalizeStoreTypeFilterValue("setup", filters.setup);
    const categories = Array.isArray(record?.categories) ? record.categories : [];
    const hasCategories = categories.length > 0;
    const hasHeroImage = Boolean(record?.heroImageUrl);
    const hasIcon = Boolean(record?.iconImageUrl || record?.iconName);
    const companiesUsing = Math.max(0, Math.trunc(normalizeStoreTypeNumber(record?.companiesUsing)));
    const productCount = Math.max(0, Math.trunc(normalizeStoreTypeNumber(record?.productCount)));

    if (statusFilter !== "all" && normalizeStoreTypeStatus(record?.status) !== statusFilter) {
      return false;
    }
    if (usageFilter === "companies" && companiesUsing <= 0) {
      return false;
    }
    if (usageFilter === "products" && productCount <= 0) {
      return false;
    }
    if (usageFilter === "unused" && (companiesUsing > 0 || productCount > 0)) {
      return false;
    }
    if (setupFilter === "complete" && !(hasCategories && hasHeroImage && hasIcon)) {
      return false;
    }
    if (setupFilter === "missing-categories" && hasCategories) {
      return false;
    }
    if (setupFilter === "missing-assets" && hasHeroImage && hasIcon) {
      return false;
    }
    return true;
  }

  function compareStoreTypeNames(left, right, leftName, rightName) {
    return String(left?.name || leftName).localeCompare(
      String(right?.name || rightName),
      undefined,
      { sensitivity: "base" },
    );
  }

  function compareStoreTypesBySortValue(left, right, sortValue) {
    if (sortValue === "products-desc") {
      return (right?.productCount || 0) - (left?.productCount || 0);
    }
    if (sortValue === "companies-desc") {
      return (right?.companiesUsing || 0) - (left?.companiesUsing || 0);
    }
    if (sortValue === "categories-desc") {
      const rightCount = Array.isArray(right?.categories) ? right.categories.length : 0;
      const leftCount = Array.isArray(left?.categories) ? left.categories.length : 0;
      return rightCount - leftCount;
    }
    if (sortValue === "commission-desc") {
      return normalizeStoreTypeNumber(right?.commissionRate) - normalizeStoreTypeNumber(left?.commissionRate);
    }
    if (sortValue === "service-fee-desc") {
      return normalizeStoreTypeNumber(right?.serviceFee) - normalizeStoreTypeNumber(left?.serviceFee);
    }
    return 0;
  }

  function compareStoreTypesBySort(leftName, rightName) {
    const left = getStoreTypeFilterRecord(leftName);
    const right = getStoreTypeFilterRecord(rightName);

    for (const sortValue of normalizeStoreTypeSortValues(state.storeTypeSort)) {
      if (sortValue === "name-asc") {
        const nameResult = compareStoreTypeNames(left, right, leftName, rightName);
        if (nameResult !== 0) {
          return nameResult;
        }
        continue;
      }
      const compareResult = compareStoreTypesBySortValue(left, right, sortValue);
      if (compareResult !== 0) {
        return compareResult;
      }
    }
    return compareStoreTypeNames(left, right, leftName, rightName);
  }

  function hasActiveStoreTypeFilters() {
    const filters = state.storeTypeFilters || {};
    return normalizeStoreTypeFilterValue("status", filters.status) !== "all" ||
      normalizeStoreTypeFilterValue("usage", filters.usage) !== "all" ||
      normalizeStoreTypeFilterValue("setup", filters.setup) !== "all" ||
      !isDefaultSortSelection(state.storeTypeSort, normalizeStoreTypeSortValue, "name-asc");
  }

  function getStoreTypeFilterLabel(type, value) {
    const labels = {
      status: {
        active: "Active",
        inactive: "Inactive",
      },
      usage: {
        companies: "Used by companies",
        products: "Has products",
        unused: "Unused",
      },
      setup: {
        complete: "Complete setup",
        "missing-categories": "Missing categories",
        "missing-assets": "Missing image or icon",
      },
    };
    return labels[type]?.[value] || "All";
  }

  function getStoreTypeSortLabel(value) {
    const labels = {
      "products-desc": "Most products",
      "companies-desc": "Most companies",
      "categories-desc": "Most categories",
      "commission-desc": "Highest commission",
      "service-fee-desc": "Highest service fee",
      "name-asc": "Name A-Z",
    };
    return labels[normalizeStoreTypeSortValue(value)] || "Name A-Z";
  }

  function getStoreTypeSortSummaryLabel(values) {
    return normalizeStoreTypeSortValues(values).map(getStoreTypeSortLabel).join(", ");
  }

  function syncStoreTypeFilterSummary() {
    const selectedLabels = [];
    const status = getCheckedStoreTypeFilterValue("status");
    const usage = getCheckedStoreTypeFilterValue("usage");
    const setup = getCheckedStoreTypeFilterValue("setup");

    if (status !== "all") selectedLabels.push(getStoreTypeFilterLabel("status", status));
    if (usage !== "all") selectedLabels.push(getStoreTypeFilterLabel("usage", usage));
    if (setup !== "all") selectedLabels.push(getStoreTypeFilterLabel("setup", setup));
    if (!selectedLabels.length) selectedLabels.push("All");

    const sortLabel = getStoreTypeSortSummaryLabel(getCheckedStoreTypeSortValues());
    if (elements.storeTypeFilterSummary) {
      elements.storeTypeFilterSummary.textContent = `${selectedLabels.join(", ")}, ${sortLabel}`;
    }
  }

  function getCheckedStoreTypeFilterValue(type) {
    const checked = document.querySelector(`[data-super-admin-store-type-filter="${type}"]:checked`);
    return normalizeStoreTypeFilterValue(type, checked?.value);
  }

  function getCheckedStoreTypeSortValues() {
    return readCheckedSortValues(
      "[data-super-admin-store-type-sort]",
      normalizeStoreTypeSortValue,
      "name-asc",
    );
  }

  function setStoreTypeRadioChecked(selector, value) {
    const control = document.querySelector(`${selector}[value="${value}"]`);
    if (control instanceof HTMLInputElement) {
      control.checked = true;
    }
  }

  function setStoreTypeSortControlsChecked(values) {
    setSortControlsChecked(
      "[data-super-admin-store-type-sort]",
      values,
      normalizeStoreTypeSortValue,
      "name-asc",
    );
  }

  function applyStoreTypeFiltersFromControls() {
    state.storeTypeFilters = {
      status: getCheckedStoreTypeFilterValue("status"),
      usage: getCheckedStoreTypeFilterValue("usage"),
      setup: getCheckedStoreTypeFilterValue("setup"),
    };
    state.storeTypeSort = getCheckedStoreTypeSortValues();
    syncStoreTypeFilterSummary();
    renderStoreTypes();
    toggleStoreTypeFilterDropdown(false);
  }

  function clearStoreTypeFilters() {
    setStoreTypeRadioChecked('[data-super-admin-store-type-filter="status"]', "all");
    setStoreTypeRadioChecked('[data-super-admin-store-type-filter="usage"]', "all");
    setStoreTypeRadioChecked('[data-super-admin-store-type-filter="setup"]', "all");
    setStoreTypeSortControlsChecked(["name-asc"]);
    state.storeTypeFilters = {
      status: "all",
      usage: "all",
      setup: "all",
    };
    state.storeTypeSort = ["name-asc"];
    syncStoreTypeFilterSummary();
    renderStoreTypes();
  }

  // Renders store types from the latest state.
  function renderStoreTypes(storeTypes = state.storeTypes) {
    const nextStoreTypes = normalizeStoreTypeValues(storeTypes);
    state.storeTypes = nextStoreTypes;
    renderStoreTypeSubNav(nextStoreTypes);
    const searchTerm = state.storeTypeSearchTerm.trim().toLowerCase();
    const visibleStoreTypes = nextStoreTypes
      .filter((storeType) => {
        const record = getStoreTypeFilterRecord(storeType);
        if (!record) {
          return false;
        }
        return (!searchTerm || getStoreTypeSearchText(record).includes(searchTerm)) &&
          storeTypeMatchesFilters(record);
      })
      .sort(compareStoreTypesBySort);
    if (elements.storeTypeTotalLabel) {
      elements.storeTypeTotalLabel.textContent = `(${numberText(visibleStoreTypes.length)})`;
    }

    if (!elements.storeTypeList) {
      return;
    }

    closeBusinessTypeActionMenus();
    elements.storeTypeList.innerHTML = "";
    elements.storeTypeList.classList.toggle("is-list-view", state.storeTypeView === "list");

    if (!visibleStoreTypes.length) {
      const emptyState = document.createElement("div");
      emptyState.className = "empty-state";
      emptyState.textContent = searchTerm || hasActiveStoreTypeFilters()
        ? "No business types match your filters."
        : "No saved business types yet.";
      elements.storeTypeList.append(emptyState);
      return;
    }

    if (state.storeTypeView === "list") {
      elements.storeTypeList.append(createBusinessTypeTableHeader());
    }

    for (const storeType of visibleStoreTypes) {
      elements.storeTypeList.append(createStoreTypeChip(storeType));
    }
  }

  // Loads business type data and related category details.
  async function loadStoreTypes({ quiet = false } = {}) {
    state.storeTypesLoading = true;
    if (!quiet) {
      setFeedback("Loading business types...");
    }

    try {
      const response = await fetch("/api/super-admin/store-types", {
        cache: "no-store",
        headers: rootHeaders({
          Accept: "application/json",
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to load business types.");
      }

      setStoreTypeData(
        Array.isArray(data.storeTypes) ? data.storeTypes : [],
        Array.isArray(data.storeTypeDetails) ? data.storeTypeDetails : null,
      );
      if (!quiet) {
        setFeedback(
          `${numberText(state.storeTypes.length)} ${state.storeTypes.length === 1 ? "business type" : "business types"} loaded.`,
          "success",
        );
      }
    } catch (error) {
      if (!quiet || isStoreTypeDrawerVisible()) {
        setFeedback(error instanceof Error ? error.message : "Unable to load business types.", "error");
      }
    } finally {
      state.storeTypesLoading = false;
    }
  }

  // Handles the add store type interaction flow.
  async function handleAddStoreType() {
    let storeTypeDraft = getCurrentStoreTypeDraft();
    const storeTypeName = storeTypeDraft.name;

    if (!storeTypeName) {
      setFeedback("Enter a business type first.", "error");
      elements.storeTypeNameInput?.focus();
      return;
    }
    if (!(state.storeTypeDraftImageFile instanceof File) && !storeTypeDraft.heroImageUrl) {
      setFeedback("Choose a business type image.", "error");
      elements.storeTypeImageInput?.focus();
      return;
    }
    if (!(state.storeTypeDraftIconFile instanceof File) && !storeTypeDraft.iconImageUrl && !storeTypeDraft.iconName) {
      setFeedback("Choose a business type icon.", "error");
      elements.storeTypeIconSearchInput?.focus();
      return;
    }

    try {
      if (elements.addStoreTypeButton) {
        elements.addStoreTypeButton.disabled = true;
      }
      storeTypeDraft = await uploadStoreTypeDraftAssets(storeTypeDraft);
      setFeedback("Adding business type...");

      const response = await fetch("/api/super-admin/store-types", {
        method: "POST",
        headers: rootHeaders({
          "Content-Type": "application/json",
          Accept: "application/json",
        }),
        body: JSON.stringify(storeTypeDraft),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to add business type.");
      }

      state.selectedStoreTypeNavName = storeTypeName;
      setStoreTypeData(
        Array.isArray(data.storeTypes)
          ? data.storeTypes
          : [...state.storeTypes, data.storeType || storeTypeName],
        Array.isArray(data.storeTypeDetails) ? data.storeTypeDetails : null,
      );
      resetStoreTypeEditor();
      setStoreTypeModalOpen(false, { restoreFocus: false });
      const successMessage = data.message || `Business type "${storeTypeName}" added.`;
      setFeedback(successMessage, "success");
      showSuccessValidationModal("Business Type Added", successMessage);
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to add business type.", "error");
      elements.storeTypeNameInput?.focus();
    } finally {
      if (elements.addStoreTypeButton) {
        elements.addStoreTypeButton.disabled = false;
      }
    }
  }

  // Handles the update store type interaction flow.
  async function handleUpdateStoreType(previousStoreTypeValue, nextStoreTypeValue, options = {}) {
    const previousStoreTypeName = normalizeCategoryName(previousStoreTypeValue || state.editingStoreTypeName);
    const nextStoreTypeName = normalizeCategoryName(nextStoreTypeValue);
    const focusTarget =
      options.focusTarget instanceof HTMLInputElement
        ? options.focusTarget
        : elements.storeTypeNameInput;
    const shouldUseModalDraft = isStoreTypeModalVisible() && focusTarget === elements.storeTypeNameInput;
    let storeTypeDraft = shouldUseModalDraft
      ? getCurrentStoreTypeDraft()
      : { name: nextStoreTypeName };
    const primaryButton =
      options.primaryButton instanceof HTMLButtonElement
        ? options.primaryButton
        : elements.addStoreTypeButton;
    const secondaryButton =
      options.secondaryButton instanceof HTMLButtonElement
        ? options.secondaryButton
        : elements.cancelStoreTypeEditButton;

    if (!previousStoreTypeName) {
      resetStoreTypeEditor();
      return;
    }

    if (!nextStoreTypeName) {
      setFeedback("Enter a business type first.", "error");
      focusTarget?.focus();
      return;
    }

    if (previousStoreTypeName === nextStoreTypeName && !shouldUseModalDraft) {
      resetStoreTypeEditor();
      setFeedback(`Business type "${previousStoreTypeName}" unchanged.`, "success");
      return;
    }

    try {
      if (primaryButton) {
        primaryButton.disabled = true;
      }
      if (secondaryButton) {
        secondaryButton.disabled = true;
      }
      if (focusTarget) {
        focusTarget.disabled = true;
      }
      setFeedback("Updating business type...");

      if (shouldUseModalDraft) {
        storeTypeDraft = await uploadStoreTypeDraftAssets(storeTypeDraft);
      }

      const response = await fetch("/api/super-admin/store-types", {
        method: "PUT",
        headers: rootHeaders({
          "Content-Type": "application/json",
          Accept: "application/json",
        }),
        body: JSON.stringify({
          oldName: previousStoreTypeName,
          ...storeTypeDraft,
          name: nextStoreTypeName,
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to update business type.");
      }

      if (isSameStoreTypeName(state.selectedStoreTypeNavName, previousStoreTypeName)) {
        state.selectedStoreTypeNavName = nextStoreTypeName;
      }
      setStoreTypeData(
        Array.isArray(data.storeTypes)
          ? data.storeTypes
          : state.storeTypes.map((storeType) =>
              isSameStoreTypeName(storeType, previousStoreTypeName)
                ? nextStoreTypeName
                : storeType,
            ),
        Array.isArray(data.storeTypeDetails) ? data.storeTypeDetails : null,
      );
      resetStoreTypeEditor();
      if (isStoreTypeModalVisible()) {
        setStoreTypeModalOpen(false, { restoreFocus: false });
      }

      const updatedAdmins = Number(data.updatedAdmins || 0);
      const successMessage =
        updatedAdmins > 0
          ? `Business type updated. ${numberText(updatedAdmins)} admin${updatedAdmins === 1 ? "" : "s"} updated.`
          : data.message || "Business type updated.";
      setFeedback(successMessage, "success");
      showSuccessValidationModal("Business Type Updated", successMessage);
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to update business type.", "error");
      if (focusTarget) {
        focusTarget.disabled = false;
        syncStoreTypeInputCasing(focusTarget);
        focusTarget.focus();
        focusTarget.select();
      }
    } finally {
      if (primaryButton) {
        primaryButton.disabled = false;
      }
      if (secondaryButton) {
        secondaryButton.disabled = false;
      }
      if (focusTarget) {
        focusTarget.disabled = false;
      }
    }
  }

  // Handles the store type submit interaction flow.
  async function handleStoreTypeSubmit() {
    if (state.editingStoreTypeName) {
      return handleUpdateStoreType(state.editingStoreTypeName, elements.storeTypeNameInput?.value);
    }

    return handleAddStoreType();
  }

  // Handles the delete store type interaction flow.
  async function handleDeleteStoreType(storeTypeValue) {
    const storeTypeName = normalizeCategoryName(storeTypeValue);
    if (!storeTypeName) {
      return;
    }

    const confirmed = await openBusinessTypeDeleteModal(storeTypeName);
    if (!confirmed) {
      return;
    }

    try {
      setFeedback("Deleting business type...");
      const response = await fetch(
        `/api/super-admin/store-types?name=${encodeURIComponent(storeTypeName)}`,
        {
          method: "DELETE",
          headers: rootHeaders({
            Accept: "application/json",
          }),
        },
      );
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to delete business type.");
      }

      if (isSameStoreTypeName(state.selectedStoreTypeNavName, storeTypeName)) {
        state.selectedStoreTypeNavName = "";
      }
      setStoreTypeData(
        Array.isArray(data.storeTypes)
          ? data.storeTypes
          : state.storeTypes.filter((storeType) => !isSameStoreTypeName(storeType, storeTypeName)),
        Array.isArray(data.storeTypeDetails) ? data.storeTypeDetails : null,
      );
      if (isSameStoreTypeName(state.editingStoreTypeName, storeTypeName)) {
        resetStoreTypeEditor();
      }

      const clearedAdmins = Number(data.clearedAdmins || 0);
      const successMessage =
        clearedAdmins > 0
          ? `Business type deleted. ${numberText(clearedAdmins)} admin${clearedAdmins === 1 ? "" : "s"} cleared.`
          : data.message || "Business type deleted.";
      setFeedback(successMessage, "success");
      showSuccessValidationModal("Business Type Deleted", successMessage);
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to delete business type.", "error");
    }
  }

  // Loads product requests from the backend for the review branch.
  async function loadProductRequests({ quiet = false, showLoading = true } = {}) {
    const shouldShowLoading = showLoading !== false;
    if (shouldShowLoading) {
      state.productRequestsLoading = true;
    }
    if (shouldShowLoading && state.activeSection === "product-requests") {
      renderProductRequests();
    }
    if (!quiet) {
      setFeedback("Loading products in review...");
    }

    try {
      const response = await fetch("/api/super-admin/product-requests", {
        cache: "no-store",
        headers: rootHeaders({
          Accept: "application/json",
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to load products in review.");
      }

      state.productRequests = Array.isArray(data.products) ? data.products : [];
      state.rejectedProductRequests = Array.isArray(data.rejectedProducts) ? data.rejectedProducts : [];
      state.approvedProductRequests = Array.isArray(data.approvedProducts) ? data.approvedProducts : [];
      state.liveProductRequests = Array.isArray(data.liveProducts)
        ? data.liveProducts
        : [];
      state.productRequestStats = {
        submitted: Math.max(0, Number(data.stats?.submitted) || 0),
        inReview: Math.max(0, Number(data.stats?.inReview) || 0),
        approved: Math.max(0, Number(data.stats?.approved) || 0),
        rejected: Math.max(0, Number(data.stats?.rejected) || 0),
      };
      state.yoloInspectionConfig = {
        configured: data.yoloInspection?.configured === true,
        model: String(data.yoloInspection?.model || "yolo-product-inspection"),
        autoReject: false,
      };
      state.productRequestsLoading = false;
      renderProductRequests();
      if (!quiet) {
        setFeedback("");
      }
    } catch (error) {
      state.productRequestsLoading = false;
      if (state.activeSection === "product-requests") {
        renderProductRequests();
      }
      setFeedback(error instanceof Error ? error.message : "Unable to load products in review.", "error");
    }
  }

  // Supports the approve product request branch of the super admin UI.
  async function approveProductRequest(productId, button = null) {
    const normalizedProductId = String(productId || "").trim();
    if (!normalizedProductId) {
      return false;
    }

    const targetProduct = findProductRequestById(normalizedProductId);
    const productName = String(targetProduct?.name || "product").trim();

    try {
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.classList.add("is-loading");
        button.setAttribute("aria-busy", "true");
      }
      setFeedback(`Approving ${productName}...`);

      const response = await fetch(
        `/api/super-admin/products/${encodeURIComponent(normalizedProductId)}/approve`,
        {
          method: "PATCH",
          headers: rootHeaders({
            Accept: "application/json",
          }),
        },
      );
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to approve product in review.");
      }

      await loadProductRequests({ quiet: true, showLoading: false });
      const successMessage = data.message || `${productName} approved.`;
      setFeedback(successMessage, "success");
      showSuccessValidationModal("Product Approved", successMessage);
      void loadAdmins();
      return true;
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to approve product in review.", "error");
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.classList.remove("is-loading");
        button.removeAttribute("aria-busy");
      }
      return false;
    }
  }

  // Checks whether the current interaction can cancel product request.
  async function cancelProductRequest(productId, button = null) {
    const normalizedProductId = String(productId || "").trim();
    if (!normalizedProductId) {
      return false;
    }

    const targetProduct = findProductRequestById(normalizedProductId);
    const productName = String(targetProduct?.name || "product").trim();
    const rejectEvidenceItems = getProductRejectEvidenceImageItems(targetProduct);
    let rejectedEvidenceImageUrls = [];
    if (rejectEvidenceItems.length > 1) {
      const selection = await openRejectEvidenceModal(targetProduct, rejectEvidenceItems);
      if (!selection) {
        return false;
      }
      rejectedEvidenceImageUrls = selection;
    } else if (rejectEvidenceItems.length === 1) {
      rejectedEvidenceImageUrls = rejectEvidenceItems.map((item) => item.url);
    } else {
      const confirmed = window.confirm(`Reject product request for ${productName}?`);
      if (!confirmed) {
        return false;
      }
      rejectedEvidenceImageUrls = rejectEvidenceItems.map((item) => item.url);
    }

    try {
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.classList.add("is-loading");
        button.setAttribute("aria-busy", "true");
      }
      setFeedback(`Rejecting ${productName}...`);

      const response = await fetch(
        `/api/super-admin/products/${encodeURIComponent(normalizedProductId)}/cancel`,
        {
          method: "PATCH",
          headers: rootHeaders({
            Accept: "application/json",
            "Content-Type": "application/json",
          }),
          body: JSON.stringify(
            rejectedEvidenceImageUrls.length
              ? { rejectedEvidenceImageUrls }
              : {},
          ),
        },
      );
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to reject product in review.");
      }

      await loadProductRequests({ quiet: true, showLoading: false });
      const successMessage = data.message || `${productName} rejected.`;
      setFeedback(successMessage, "success");
      showSuccessValidationModal("Product Rejected", successMessage);
      void loadAdmins();
      return true;
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to reject product in review.", "error");
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.classList.remove("is-loading");
        button.removeAttribute("aria-busy");
      }
      return false;
    }
  }

  async function unrejectProductRequest(productId, button = null) {
    const normalizedProductId = String(productId || "").trim();
    if (!normalizedProductId) {
      return;
    }

    const confirmed = window.confirm("Return this rejected product to In Review?");
    if (!confirmed) {

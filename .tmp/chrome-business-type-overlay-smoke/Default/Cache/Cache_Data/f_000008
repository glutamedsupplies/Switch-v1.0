      const menuToggle = event.target.closest("[data-integrated-partner-menu-toggle]");
      if (menuToggle instanceof HTMLButtonElement) {
        event.preventDefault();
        event.stopPropagation();
        const dropdown = menuToggle.closest(".partner-data-action-dropdown");
        const shouldOpen = menuToggle.getAttribute("aria-expanded") !== "true";
        closeCompanyActionMenus(dropdown);
        setCompanyActionMenuOpen(dropdown, shouldOpen, { anchorElement: menuToggle });
        return;
      }
      const actionButton = event.target.closest("[data-integrated-partner-action]");
      if (!(actionButton instanceof HTMLButtonElement)) {
        return;
      }
      event.preventDefault();
      event.stopPropagation();
      if (actionButton.disabled) {
        return;
      }
      const type = actionButton.dataset.integratedPartnerType;
      const partnerId = actionButton.dataset.integratedPartnerId;
      const action = actionButton.dataset.integratedPartnerAction;
      const partner = findIntegratedPartner(type, partnerId);
      if (!partner) {
        return;
      }
      closeCompanyActionMenus();

      if (type === "delivery" && action === "edit") {
        setDeliveryPartnerModalOpen(true, { partnerId });
        return;
      }
      if (type === "delivery" && action === "api-key") {
        setDeliveryPartnerApiKeyModalOpen(true, { partnerId });
        return;
      }

      actionButton.disabled = true;
      actionButton.setAttribute("aria-busy", "true");
      const actionPromise = action === "toggle"
        ? updateIntegratedPartnerActiveState(type, partnerId, !readIntegratedEnabledFlag(partner))
        : action === "delete"
          ? deleteIntegratedPartner(type, partnerId)
          : Promise.resolve();
      void actionPromise.finally(() => {
        if (actionButton.isConnected) {
          actionButton.disabled = false;
          actionButton.removeAttribute("aria-busy");
        }
      });
    });
  }

  for (const partnerList of [elements.paymentPartnerList, elements.deliveryPartnerList]) {

  function playStoreTypeShowcasePop(targetElement) {
    if (!(targetElement instanceof HTMLElement)) {
      return;
    }
    targetElement.classList.remove("is-subnav-popping");
    targetElement.getBoundingClientRect();
    targetElement.classList.add("is-subnav-popping");
    window.setTimeout(() => {
      if (targetElement.isConnected) {
        targetElement.classList.remove("is-subnav-popping");
      }
    }, 720);
  }

  function waitForStoreTypeShowcaseArrival(targetElement, onArrive) {
    if (!(targetElement instanceof HTMLElement)) {
      return;
    }
    const popToken = ++storeTypeShowcasePopToken;
    const startTime = window.performance?.now?.() || Date.now();
    let lastTop = null;
    let stableVisibleFrames = 0;

    const tick = () => {
      if (popToken !== storeTypeShowcasePopToken || !targetElement.isConnected) {
        return;
      }

      const rect = targetElement.getBoundingClientRect();
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
      const now = window.performance?.now?.() || Date.now();
      const isVisible = rect.bottom > Math.min(120, viewportHeight * 0.2)
        && rect.top < viewportHeight * 0.7;
      const isStable = lastTop !== null && Math.abs(rect.top - lastTop) < 1.5;

      stableVisibleFrames = isVisible && isStable ? stableVisibleFrames + 1 : 0;
      lastTop = rect.top;

      if (stableVisibleFrames >= 5 || now - startTime > 1800) {
        onArrive?.();
        return;
      }

      window.requestAnimationFrame(tick);
    };

    window.requestAnimationFrame(tick);
  }


  function setupProductDetailDescriptionToggle(container) {
    const description = container?.querySelector?.("[data-product-detail-description-text]");
    const toggle = container?.querySelector?.("[data-product-detail-description-toggle]");
    if (!(description instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) {
      return;
    }

    const getCollapsedHeight = () => {
      const lineHeight = Number.parseFloat(window.getComputedStyle(description).lineHeight);
      return Math.ceil((Number.isFinite(lineHeight) ? lineHeight : 20) * 3);
    };

    const syncToggle = () => {
      const isExpanded = description.classList.contains("is-expanded");
      const isOverflowing = description.scrollHeight > description.clientHeight + 1;
      if (!isExpanded && !isOverflowing) {
        toggle.hidden = true;
        return;
      }
      toggle.hidden = false;
      toggle.textContent = isExpanded ? "Show less" : "Show more";
      if (isExpanded) {
        description.style.maxHeight = `${description.scrollHeight}px`;
      }
    };

    toggle.addEventListener("click", () => {
      const isExpanded = description.classList.contains("is-expanded");
      const collapsedHeight = getCollapsedHeight();
      if (isExpanded) {
        description.style.maxHeight = `${description.scrollHeight}px`;
        description.getBoundingClientRect();
        toggle.textContent = "Show more";
        window.requestAnimationFrame(() => {
          description.style.maxHeight = `${collapsedHeight}px`;
          window.setTimeout(() => {
            description.classList.remove("is-expanded");
            description.style.maxHeight = "";
            syncToggle();
          }, 220);
        });
        return;
      }

      description.style.maxHeight = `${collapsedHeight}px`;
      description.getBoundingClientRect();
      description.classList.add("is-expanded");
      toggle.textContent = "Show less";
      window.requestAnimationFrame(() => {
        description.style.maxHeight = `${description.scrollHeight}px`;
        window.setTimeout(syncToggle, 220);
      });
    });
    window.requestAnimationFrame(syncToggle);
    window.setTimeout(syncToggle, 120);
  }


    const isRestriction = accountState === "restricted";
    const reason = isRestriction
      ? String(
          admin?.restrictionReason ??
            admin?.restrictReason ??
            admin?.restriction_reason ??
            admin?.restrict_reason ??
            "",
        ).trim() || "No restriction reason provided."
      : String(admin?.banReason ?? admin?.lastBanReason ?? admin?.ban_reason ?? "").trim() ||
        "No ban reason provided.";
    const actionAt = isRestriction
      ? admin?.restrictedAt ?? admin?.lastRestrictedAt ?? admin?.restricted_at ?? ""
      : admin?.bannedAt ?? admin?.lastBannedAt ?? admin?.banned_at ?? "";
    const actionBy = String(
      isRestriction
        ? admin?.restrictedBy ?? admin?.lastRestrictedBy ?? admin?.restricted_by ?? "Super Admin"
        : admin?.bannedBy ?? admin?.lastBannedBy ?? admin?.banned_by ?? "Super Admin",
    ).trim() ||

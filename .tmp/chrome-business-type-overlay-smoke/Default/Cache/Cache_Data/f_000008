              menuId: reasonMenuId,
              icon: '<path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>',
            })}
          </label>
          <label class="super-admin-product-listing-restriction-modal__field">
            <span>Restriction Duration <b class="super-admin-product-listing-restriction-modal__required-dot" aria-hidden="true"></b></span>
            ${createListingRestrictionDropdown({
              name: "durationDays",
              placeholder: "Select Duration",
              options: listingRestrictionDurations,
              menuId: durationMenuId,
              icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock-icon lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>',
            })}
          </label>
          <label class="super-admin-product-listing-restriction-modal__field">
            <span>Notes for Seller</span>
            <textarea name="sellerNote" rows="3" maxlength="500" placeholder="Add notes (optional)"></textarea>
          </label>
          <label class="super-admin-product-listing-restriction-modal__notify">
            <span>Notify seller about this restriction</span>
            <input type="checkbox" name="notifySeller" checked />
            <span class="super-admin-product-listing-restriction-modal__toggle" aria-hidden="true"></span>
          </label>
          <p class="super-admin-product-listing-restriction-modal__status" role="status" aria-live="polite"></p>
          <div class="super-admin-product-listing-restriction-modal__actions">
            <button type="button" class="super-admin-product-listing-restriction-modal__cancel">Cancel</button>
            <button type="submit" class="super-admin-product-listing-restriction-modal__confirm">
              ${createIconSvg('<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>')}
              <span>Restrict Product</span>
            </button>
          </div>
        </form>
      </section>
    `;

    const dialog = overlay.querySelector(".super-admin-product-listing-restriction-modal");
    const form = overlay.querySelector(".super-admin-product-listing-restriction-modal__form");
    const closeButton = overlay.querySelector(".super-admin-product-listing-restriction-modal__close");
    const cancelButton = overlay.querySelector(".super-admin-product-listing-restriction-modal__cancel");
    const confirmButton = overlay.querySelector(".super-admin-product-listing-restriction-modal__confirm");
    const status = overlay.querySelector(".super-admin-product-listing-restriction-modal__status");
    const productImage = overlay.querySelector(".super-admin-product-listing-restriction-modal__product-image img");
    const restrictionDropdowns = Array.from(overlay.querySelectorAll("[data-product-listing-restriction-dropdown]"));

    if (productImage instanceof HTMLImageElement) {
      productImage.addEventListener("error", () => {
        productImage.closest(".super-admin-product-listing-restriction-modal__product-image")?.replaceChildren(
          createElement("span", "super-admin-product-listing-restriction-modal__product-placeholder"),
        );
        const placeholder = overlay.querySelector(".super-admin-product-listing-restriction-modal__product-placeholder");
        if (placeholder instanceof HTMLElement) {
          placeholder.setAttribute("aria-hidden", "true");
          placeholder.innerHTML = createIconSvg('<path d="M6 2h12a2 2 0 0 1 2 2v16l-8-4-8 4V4a2 2 0 0 1 2-2z"></path>');
        }
      }, { once: true });
    }

    const getRestrictionDropdownParts = (dropdown) => ({
      select: dropdown?.querySelector?.("select"),
      trigger: dropdown?.querySelector?.("[data-product-listing-restriction-dropdown-trigger]"),
      menu: dropdown?.querySelector?.("[data-product-listing-restriction-dropdown-menu]"),
      label: dropdown?.querySelector?.("[data-product-listing-restriction-dropdown-label]"),
      options: Array.from(dropdown?.querySelectorAll?.("[data-product-listing-restriction-dropdown-option]") || []),
    });
    const closeRestrictionDropdowns = (exceptDropdown = null) => {
      for (const dropdown of restrictionDropdowns) {
        if (!(dropdown instanceof HTMLElement) || dropdown === exceptDropdown) {
          continue;
        }
        const { trigger, menu } = getRestrictionDropdownParts(dropdown);
        dropdown.classList.remove("is-open");
        if (trigger instanceof HTMLElement) {
          trigger.setAttribute("aria-expanded", "false");
        }
        if (menu instanceof HTMLElement) {
          menu.hidden = true;
        }
      }
    };
    const syncRestrictionDropdown = (dropdown) => {
      const { select, label, options } = getRestrictionDropdownParts(dropdown);
      if (!(select instanceof HTMLSelectElement)) {
        return;
      }
      const selectedOption = select.selectedOptions?.[0];
      const fallbackLabel = select.options?.[0]?.textContent || "Select";
      const labelText = select.value && selectedOption ? selectedOption.textContent || select.value : fallbackLabel;
      if (label instanceof HTMLElement) {
        label.textContent = labelText;
        label.title = select.value ? labelText : "";
      }
      for (const option of options) {
        const isSelected = option.dataset.productListingRestrictionDropdownOption === select.value;
        option.classList.toggle("is-selected", isSelected);
        option.setAttribute("aria-checked", String(isSelected));
      }
    };
    const setRestrictionDropdownOpen = (dropdown, isOpen) => {
      if (!(dropdown instanceof HTMLElement)) {
        return;
      }
      const shouldOpen = Boolean(isOpen);
      if (shouldOpen) {
        closeRestrictionDropdowns(dropdown);
      }
      const { trigger, menu } = getRestrictionDropdownParts(dropdown);
      dropdown.classList.toggle("is-open", shouldOpen);
      if (trigger instanceof HTMLElement) {
        trigger.setAttribute("aria-expanded", String(shouldOpen));
      }
      if (menu instanceof HTMLElement) {
        menu.hidden = !shouldOpen;
      }
    };
    const setRestrictionDropdownValue = (dropdown, value) => {
      const { select } = getRestrictionDropdownParts(dropdown);
      if (select instanceof HTMLSelectElement) {
        select.value = String(value || "");
      }
      syncRestrictionDropdown(dropdown);
    };
    const focusRestrictionDropdownOption = (menu, nextIndex = 0) => {
      const items = Array.from(menu?.querySelectorAll?.("[data-product-listing-restriction-dropdown-option]") || [])
        .filter((item) => item instanceof HTMLElement && !item.hidden);
      if (!items.length) {
        return;
      }
      const normalizedIndex = ((nextIndex % items.length) + items.length) % items.length;
      items[normalizedIndex].focus();
    };

    for (const dropdown of restrictionDropdowns) {
      if (!(dropdown instanceof HTMLElement)) {
        continue;
      }
      const { trigger, menu, select, options } = getRestrictionDropdownParts(dropdown);
      trigger?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        setRestrictionDropdownOpen(dropdown, !(menu instanceof HTMLElement) || menu.hidden);
      });
      trigger?.addEventListener("keydown", (event) => {
        if (!["Enter", " ", "ArrowDown"].includes(event.key)) {
          return;
        }
        event.preventDefault();
        setRestrictionDropdownOpen(dropdown, true);
        window.requestAnimationFrame(() => focusRestrictionDropdownOption(menu, 0));
      });
      menu?.addEventListener("keydown", (event) => {
        const items = Array.from(menu.querySelectorAll("[data-product-listing-restriction-dropdown-option]"));
        const currentIndex = items.indexOf(event.target);
        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          event.preventDefault();
          focusRestrictionDropdownOption(menu, currentIndex + 1);
        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          event.preventDefault();
          focusRestrictionDropdownOption(menu, currentIndex - 1);
        } else if (event.key === "Home") {
          event.preventDefault();
          focusRestrictionDropdownOption(menu, 0);
        } else if (event.key === "End") {
          event.preventDefault();
          focusRestrictionDropdownOption(menu, items.length - 1);
        } else if (event.key === "Escape") {
          event.preventDefault();
          setRestrictionDropdownOpen(dropdown, false);
          trigger?.focus?.();
        }
      });
      for (const option of options) {
        option.addEventListener("click", (event) => {
          event.preventDefault();
          setRestrictionDropdownValue(dropdown, option.dataset.productListingRestrictionDropdownOption || "");
          setRestrictionDropdownOpen(dropdown, false);
          trigger?.focus?.();
        });
      }
      select?.addEventListener("change", () => syncRestrictionDropdown(dropdown));
      syncRestrictionDropdown(dropdown);
    }

    Object.assign(overlay.style, {
      position: "fixed",
      inset: "0",
      zIndex: "2600",
      display: "grid",
      placeItems: "center",
      padding: "20px",
      background: "rgba(15, 23, 42, 0.42)",
    });
    if (dialog instanceof HTMLElement) {
      Object.assign(dialog.style, {
        position: "relative",
        display: "block",
        width: "min(430px, calc(100vw - 32px))",
        maxHeight: "calc(100dvh - 32px)",
        overflowY: "auto",
        background: "#ffffff",
      });
    }

    const closeModal = () => closeProductListingRestrictionModal();
    closeButton?.addEventListener("click", closeModal);
    cancelButton?.addEventListener("click", closeModal);
    overlay.addEventListener("click", (event) => {
      if (event.target instanceof Element && !event.target.closest("[data-product-listing-restriction-dropdown]")) {
        closeRestrictionDropdowns();
      }
      if (event.target === overlay) {
        closeModal();
      }
    });
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !(confirmButton instanceof HTMLButtonElement)) {
        return;
      }

      const formData = new FormData(form);
      const reason = String(formData.get("reason") || "").trim();
      const durationDays = Number(formData.get("durationDays"));
      const sellerNote = String(formData.get("sellerNote") || "").trim();
      const notifySeller = formData.get("notifySeller") === "on";
      if (!reason || !Number.isInteger(durationDays) || durationDays < 1) {
        if (status instanceof HTMLElement) {
          status.textContent = "Select a restriction reason and duration.";
          status.classList.add("is-error");
        }
        return;
      }

      confirmButton.disabled = true;
      confirmButton.classList.add("is-loading");
      if (status instanceof HTMLElement) {
        status.textContent = "Restricting listing...";
        status.classList.remove("is-error");
      }
      try {
        const response = await fetch(
          `/api/super-admin/products/${encodeURIComponent(productId)}/restrict-listing`,
          {
            method: "POST",
            headers: rootHeaders({
              Accept: "application/json",
              "Content-Type": "application/json",
            }),
            body: JSON.stringify({ reason, durationDays, sellerNote, notifySeller }),
          },
        );
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.message || "Unable to restrict product listing.");
        }

        closeProductListingRestrictionModal({ restoreFocus: false });
        if (isProductRequestDetailModalVisible()) {
          closeProductRequestDetails({ restoreFocus: false });
        }
        await loadProductRequests({ quiet: true, showLoading: false });
        renderProductRequests();
        setFeedback(data.message || "Product listing restricted.", "success");
        void showSuccessValidationModal(
          "Listing Restricted",
          data.sellerNotified
            ? "The listing is hidden from customers and the seller was notified."
            : "The listing is hidden from customers.",
        );
      } catch (error) {
        confirmButton.disabled = false;
        confirmButton.classList.remove("is-loading");
        if (status instanceof HTMLElement) {
          status.textContent = error instanceof Error
            ? error.message
            : "Unable to restrict product listing.";
          status.classList.add("is-error");
        }
      }
    });

    document.body.append(overlay);
    document.body.classList.add("super-admin-product-listing-restriction-open");
    activeProductListingRestrictionModal = overlay;
    activeProductListingRestrictionTrigger = trigger instanceof HTMLElement ? trigger : null;
    window.requestAnimationFrame(() => {
      overlay.classList.add("is-open");
      dialog?.focus({ preventScroll: true });
    });
  }

  function createProductDetailLiveActionSection(product) {
    if (!isProductInLiveListing(product)) {
      return null;
    }

    const productId = String(product?.id || "").trim();
    if (!productId) {
      return null;
    }

    const productName = String(product?.name || "product").trim();
    const listingRestricted = isProductListingRestrictionActive(product);
    const createActionButton = ({ action, labelText, icon, danger = false, disabled = false }) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = `super-admin-product-detail-modal__inline-action${danger ? " is-danger" : ""}`;
      button.dataset.productDetailLiveAction = action;
      button.dataset.productId = productId;
      button.setAttribute("aria-label", `${labelText} for ${productName}`);
      button.title = labelText;
      button.disabled = disabled;
      button.innerHTML = `
        ${createIconSvg(icon)}
        <span>${labelText}</span>
      `;
      return button;
    };

    const actionRow = document.createElement("div");
    actionRow.className = "super-admin-product-detail-modal__action-row";
    actionRow.append(
      createActionButton({
        action: "restrict-listing",
        labelText: listingRestricted ? "Listing Restricted" : "Restrict Listing",
        icon: '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle><path d="m3 3 18 18"></path>',
        disabled: listingRestricted,
      }),
      createActionButton({
        action: "restrict",
        labelText: "Restrict Company",
        icon: companyCardIconPaths.restrict,
      }),
      createActionButton({
        action: "delete",
        labelText: "Delete",
        icon: '<path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>',
        danger: true,
      }),
    );
    actionRow.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      const actionButton = event.target.closest("[data-product-detail-live-action]");
      if (!(actionButton instanceof HTMLButtonElement) || actionButton.disabled) {
        return;
      }

      event.preventDefault();
      event.stopPropagation();
      closeProductRequestMenus();
      closeRejectedProductQuickMenu();

      const action = actionButton.dataset.productDetailLiveAction;
      if (action === "restrict-listing") {
        openProductListingRestrictionModal(product, actionButton);
        return;
      }
      if (action === "restrict") {
        restrictProductCompany(productId);
        return;
      }
      if (action === "delete") {
        void deleteProductRequest(productId, actionButton).then((didDelete) => {
          if (didDelete && isProductRequestDetailModalVisible()) {
            closeProductRequestDetails({ restoreFocus: false });
          }
        });
      }
    });

    return createProductDetailSection("Action", [actionRow], {
      className: "super-admin-product-detail-modal__section--actions",
    });
  }

  function createProductDetailBasicsSection(product) {
    const fields = [
      createProductDetailField("Product ID", product?.id),
      createProductDetailField("Admin ID", product?.adminId || product?.ownerAdminId || product?.companyId),
      createProductDetailField("Approval Status", getProductDetailApprovalLabel(product)),
      createProductDetailField("Visible / Active", product?.isActive !== false),
      createProductDetailField("Primary Category", createProductDetailCategoryValue(
        product,
        product?.category || getProductCategoryLabel(product),
      )),
      createProductDetailField("All Categories", createProductDetailCategoryValue(
        product,
        Array.isArray(product?.categories) ? product.categories : product?.category,
      )),
      createProductDetailField("Submitted", formatProductDetailDateTime(product?.submittedAt)),
      createProductDetailField("Created", formatProductDetailDateTime(product?.createdAt)),
      createProductDetailField("Updated", formatProductDetailDateTime(product?.updatedAt)),
      createProductDetailField("Approved At", formatProductDetailDateTime(product?.approvedAt)),
      createProductDetailField("Approved By", product?.approvedBy),
      createProductDetailField("Rejected At", formatProductDetailDateTime(product?.rejectedAt)),
      createProductDetailField("Rejected By", product?.rejectedBy),

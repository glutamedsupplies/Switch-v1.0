    const pageButton = event.target.closest("[data-product-request-page]");
    if (!(pageButton instanceof HTMLButtonElement) || pageButton.disabled) {
      return;
    }
    const nextPage = Number(pageButton.dataset.productRequestPage);
    if (!Number.isInteger(nextPage) || nextPage < 1 || nextPage === state.productRequestPage) {
      return;
    }
    state.productRequestPage = nextPage;
    renderProductRequests();
    elements.productRequestList?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  elements.productRequestPageSize?.addEventListener("change", () => {
    if (!(elements.productRequestPageSize instanceof HTMLSelectElement)) {
      return;
    }

    const nextPageSize = Math.trunc(Number(elements.productRequestPageSize.value));
    const availablePageSizes = Array.from(elements.productRequestPageSize.options)
      .map((option) => Math.trunc(Number(option.value)))
      .filter((optionValue) => Number.isFinite(optionValue) && optionValue > 0);
    if (
      !Number.isFinite(nextPageSize)
      || nextPageSize < 1
      || (availablePageSizes.length > 0 && !availablePageSizes.includes(nextPageSize))
    ) {
      return;
    }
    state.productRequestPageSize = nextPageSize;
    state.productRequestPage = 1;
    renderProductRequests();
  });

  elements.productRequestList?.addEventListener("pointerover", (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const companyNameTrigger = event.target.closest(".super-admin-product-request-card__company-name-trigger");
    if (!(companyNameTrigger instanceof HTMLElement)) {
      return;
    }

    const card = companyNameTrigger.closest(".super-admin-product-request-card");
    openCompanyPopoverForCard(card);
  });


  function getRejectEvidenceImageDisplayName(item, index) {
    const label = String(item?.label || "").trim();
    const url = String(item?.url || "").trim();
    const withoutQuery = url.split("#")[0].split("?")[0];
    const basename = withoutQuery.split(/[\\/]/).pop();
    if (basename) {
      try {
        const decoded = decodeURIComponent(basename).trim();
        if (decoded) {
          return decoded;
        }
      } catch (error) {
        return basename;
      }
    }
    return label || `Image ${index + 1}`;
  }


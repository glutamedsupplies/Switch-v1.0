    }

    if (elements.companyRestrictionLimitTrigger instanceof HTMLButtonElement) {
      elements.companyRestrictionLimitTrigger.disabled = !isRestrict;
    }

    if (!isRestrict) {
      setCompanyRestrictionLimitDropdownOpen(false);
    }

    for (const option of elements.companyRestrictionLimitOptions) {
      if (!(option instanceof HTMLInputElement)) {
        continue;
      }
      const normalizedValue = normalizeCompanyRestrictionLimitValue(option.value);
      const isSelected = selectedLimits.includes(normalizedValue);
      const isDisabled = !isRestrict || (!isSelected && limitReached);
      const row = option.closest("[data-super-admin-restriction-limit-row]");
      option.disabled = isDisabled;
      row?.classList.toggle("is-selected", isSelected);
      row?.classList.toggle("is-disabled", isDisabled && !isSelected);
      row?.setAttribute("aria-checked", String(isSelected));
    }
  }


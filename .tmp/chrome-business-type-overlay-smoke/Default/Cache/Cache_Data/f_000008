  async function finishInlineStoreTypeEdit(storeTypeName, triggerButton = null) {
    const previousStoreTypeName = normalizeCategoryName(storeTypeName);
    if (!previousStoreTypeName) {
      return;
    }

    const targetElement = getStoreTypeElementByName(previousStoreTypeName);
    const input = targetElement?.querySelector("[data-business-type-inline-name-input]");
    const storeTypeRecord = getStoreTypeRecordByName(previousStoreTypeName);
    const nextStoreTypeName = normalizeCategoryName(
      input instanceof HTMLInputElement ? input.value : previousStoreTypeName,
    );
    if (!nextStoreTypeName) {
      setFeedback("Enter a business type first.", "error");
      if (input instanceof HTMLInputElement) {
        input.focus();
      }
      return;
    }

    if (input instanceof HTMLInputElement) {
      input.value = nextStoreTypeName;
    }

    const assetDraftPatch = buildInlineStoreTypeAssetDraftPatch(storeTypeRecord, previousStoreTypeName);
    const hasNameChange = !isSameStoreTypeName(previousStoreTypeName, nextStoreTypeName);
    if (hasNameChange || assetDraftPatch.hasChanges) {
      const focusTarget = hasNameChange && input instanceof HTMLInputElement
        ? input
        : triggerButton || input;
      if (input instanceof HTMLInputElement) {
        input.dataset.inlineSaving = "true";
      }
      const didSave = await saveInlineStoreTypePatch(
        previousStoreTypeName,
        {
          ...assetDraftPatch.patch,
          ...(hasNameChange ? { name: nextStoreTypeName } : {}),
        },
        {
          focusTarget,
          keepStoreTypeEditing: false,
          pendingMessage: "Saving business type...",
          successMessage: "Business type saved.",
        },
      );
      if (input instanceof HTMLInputElement) {
        delete input.dataset.inlineSaving;
      }
      if (!didSave && input instanceof HTMLInputElement) {
        input.focus();
        input.select();
      }
      if (didSave) {
        resetInlineStoreTypeAssetDraft();
      }
      return;
    }

    state.editingStoreTypeName = "";
    state.inlineEditingCategoryStoreTypeName = "";
    state.inlineEditingCategoryName = "";
    resetInlineStoreTypeAssetDraft();
    setFeedback("Business type saved.", "success");
    renderStoreTypes();
  }


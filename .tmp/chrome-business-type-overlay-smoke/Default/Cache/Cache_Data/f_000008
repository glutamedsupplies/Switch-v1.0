  function getProductDetailHeroStatusBadge(product) {
    const rejectedEvidenceMatch = getProductRejectedEvidenceMatch(product);
    const revisionSignal = getProductRevisionSignal(product);
    const approvalStatus = String(product?.approvalStatus || "pending").trim().toLowerCase();
    const isReviewState = ["pending", "in review", "in_review", "review", "submitted"].includes(approvalStatus);
    const isRevisionRequested = String(revisionSignal?.status || "").trim().toLowerCase() === "requested";

    if (rejectedEvidenceMatch) {
      return { text: "Illegal product", tone: "danger" };
    }

    if (revisionSignal) {
      return { text: isRevisionRequested ? "Revision sent" : "Needs revision", tone: "warning" };
    }

    if (isReviewState) {
      return { text: "In review", tone: "info" };
    }

    return null;
  }

  function getProductDetailListingTypeLabel(product) {
    const explicitValue = String(
      product?.listingType ||
        product?.requestType ||
        product?.submissionType ||
        product?.changeType ||
        "",
    ).trim().toLowerCase();
    if (explicitValue.includes("edit") || explicitValue.includes("update")) {
      return "Edited";
    }
    if (explicitValue.includes("new") || explicitValue.includes("create")) {
      return "New listing";
    }

    const createdAt = new Date(product?.createdAt || product?.submittedAt || "");
    const updatedAt = new Date(product?.updatedAt || product?.approvalUpdatedAt || "");
    if (
      !Number.isNaN(createdAt.getTime()) &&
      !Number.isNaN(updatedAt.getTime()) &&
      updatedAt.getTime() - createdAt.getTime() > 60 * 1000
    ) {
      return "Edited";
    }
    return "New listing";
  }

  function isProductInLiveListing(product) {
    const productId = String(product?.id || "").trim();
    if (!productId) {
      return false;

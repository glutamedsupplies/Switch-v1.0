  // Finds the matching restriction limit option in the super admin dropdown.
  function getCompanyRestrictionLimitOption(value) {
    const normalizedValue = normalizeCompanyRestrictionLimitValue(value);
    return elements.companyRestrictionLimitOptions.find((option) =>

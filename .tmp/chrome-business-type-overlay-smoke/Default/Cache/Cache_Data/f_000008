    return normalizedVisibleCount > 0
      ? normalizedVisibleCount
      : getIconPickerInitialVisibleCount(iconOptions);
  }

  function getIconPickerNextVisibleCount(iconOptions, visibleCount) {
    const iconCount = Array.isArray(iconOptions) ? iconOptions.length : 0;
    const currentVisibleCount = Math.max(0, Math.trunc(Number(visibleCount) || 0));
    const nextBatchCount = getIconPickerInitialVisibleCount(iconOptions);
    return Math.min(iconCount, currentVisibleCount + nextBatchCount);
  }

  function getIconPickerVisibleOptions(iconOptions, visibleCount, selectedIconName) {
    const visibleIconOptions = iconOptions.slice(0, visibleCount);
    const normalizedSelectedIconName = normalizeLucideCategoryIconName(selectedIconName);
    if (
      normalizedSelectedIconName &&
      !visibleIconOptions.some((option) => option.iconName === normalizedSelectedIconName)
    ) {
      const selectedOption = iconOptions.find((option) => option.iconName === normalizedSelectedIconName);
      if (selectedOption) {
        visibleIconOptions.unshift(selectedOption);
      }
    }
    return visibleIconOptions;
  }

  function getFilteredIconPickerOptions(searchTerm = "") {
    const normalizedSearchTerm = normalizeLucideCategoryIconKey(searchTerm);
    return getLucideCategoryIconOptions().filter((option) =>
      !normalizedSearchTerm
      || option.iconName.includes(normalizedSearchTerm)
      || normalizeLucideCategoryIconKey(option.label).includes(normalizedSearchTerm)
    );
  }

  function getPanelIconPickerVisibleCount(panel, iconOptions, searchTerm) {
    const normalizedSearchTerm = normalizeLucideCategoryIconKey(searchTerm);
    const previousSearchTerm = panel.dataset.businessTypeIconPickerSearchTerm || "";
    const storedVisibleCount = previousSearchTerm === normalizedSearchTerm
      ? Number.parseInt(panel.dataset.businessTypeIconPickerVisibleCount || "", 10)
      : 0;
    const visibleCount = getIconPickerVisibleCount(iconOptions, storedVisibleCount);
    panel.dataset.businessTypeIconPickerSearchTerm = normalizedSearchTerm;
    panel.dataset.businessTypeIconPickerVisibleCount = String(visibleCount);
    return visibleCount;
  }

  function setPanelIconPickerVisibleCount(panel, visibleCount) {
    panel.dataset.businessTypeIconPickerVisibleCount = String(Math.max(0, Math.trunc(Number(visibleCount) || 0)));
  }

  function setIconPickerCurrentSearchTerm(panel, searchTerm = "") {
    if (panel instanceof HTMLElement) {
      panel.dataset.businessTypeIconPickerCurrentSearchTerm = normalizeLucideCategoryIconKey(searchTerm);
    }
  }

  function scheduleIconPickerSearchRender(panel, render) {
    if (!(panel instanceof HTMLElement)) {
      render?.();
      return;
    }
    const existingTimer = iconPickerSearchRenderTimers.get(panel);
    if (existingTimer) {
      window.clearTimeout(existingTimer);
    }
    const timer = window.setTimeout(() => {
      iconPickerSearchRenderTimers.delete(panel);
      render?.();
    }, 90);
    iconPickerSearchRenderTimers.set(panel, timer);
  }

  function focusIconPickerSearchInput(panel) {
    const input = panel?.querySelector?.(".business-type-showcase__icon-picker-search");
    if (!(input instanceof HTMLInputElement)) {
      return;
    }
    input.focus({ preventScroll: true });
    const valueLength = input.value.length;
    input.setSelectionRange?.(valueLength, valueLength);
  }

  function isIconPickerSearchFocused(panel) {
    const activeElement = document.activeElement;
    return panel instanceof HTMLElement
      && activeElement instanceof HTMLInputElement
      && activeElement.classList.contains("business-type-showcase__icon-picker-search")
      && panel.contains(activeElement);
  }

  function hydrateIconPickerOptions(panel, visibleIconOptions, searchTerm, rerender) {
    const normalizedSearchTerm = normalizeLucideCategoryIconKey(searchTerm);
    setIconPickerCurrentSearchTerm(panel, searchTerm);
    const visibleTablerIconNames = visibleIconOptions
      .map((option) => option.iconName)
      .filter((iconName) => getTablerIconSlug(iconName));
    const needsCatalog = Boolean(normalizedSearchTerm) && hasUndiscoveredTablerIcons();
    const needsPaths = visibleTablerIconNames.some((iconName) => !getTablerIconPathFromCache(getTablerIconSlug(iconName)));
    if (!needsCatalog && !needsPaths) {
      return;
    }
    const hydrateToken = String(++iconPickerHydrateTokenCounter);
    panel.dataset.businessTypeIconPickerHydrateToken = hydrateToken;
    Promise.all([
      needsCatalog ? ensureTablerIconCatalog() : Promise.resolve(),
      needsPaths ? ensureTablerIconPaths(visibleTablerIconNames) : Promise.resolve(),
    ])
      .then(() => {
        if (
          panel.isConnected
          && panel.dataset.businessTypeIconPickerHydrateToken === hydrateToken
          && panel.dataset.businessTypeIconPickerCurrentSearchTerm === normalizedSearchTerm
        ) {
          rerender?.();
        }
      })
      .catch(() => {
        // Search still works with available Lucide icons if the optional Tabler catalog cannot be read.
      });
  }

  function createIconPickerShowMoreButton(hiddenCount, onClick) {
    const showMoreButton = document.createElement("button");
    showMoreButton.type = "button";
    showMoreButton.className = "super-admin-store-type-category-modal__icon-show-more";
    showMoreButton.textContent = hiddenCount > 0 ? `Show more (${numberText(hiddenCount)})` : "Show more";
    showMoreButton.addEventListener("click", () => {

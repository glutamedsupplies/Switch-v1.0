  // Closes buyer quick-action menus from the super-admin shell before wheel blockers can freeze page scroll.
  function closeUserDataActionMenusForWheel() {
    const dropdowns = Array.from(document.querySelectorAll(".buyer-data-actions")).filter((dropdown) => {
      const menu = dropdown?.querySelector?.("[data-buyer-menu]");
      return dropdown instanceof HTMLElement
        && (dropdown.classList.contains("is-open") || (menu instanceof HTMLElement && !menu.hidden));
    });
    if (!dropdowns.length) {
      return;
    }

    for (const dropdown of dropdowns) {
      if (!(dropdown instanceof HTMLElement)) {
        continue;
      }
      dropdown.classList.remove("is-open");
      const toggle = dropdown.querySelector("[data-buyer-menu-toggle]");
      if (toggle instanceof HTMLElement) {
        toggle.setAttribute("aria-expanded", "false");
      }
      const menu = dropdown.querySelector("[data-buyer-menu]");
      if (menu instanceof HTMLElement) {
        menu.hidden = true;
        menu.classList.remove(
          "is-positioning",
          "is-cursor-positioned",
          "is-fixed-positioned",
          "is-trigger-positioned",
          "is-open-up",
        );
        for (const property of [
          "position",
          "top",
          "right",
          "bottom",
          "left",
          "transform",
          "transform-origin",
          "visibility",
          "--company-action-menu-arrow-left",
        ]) {
          menu.style.removeProperty(property);
        }
      }
    }
  }


  // Supports the configure company status indicator branch of the super admin UI.
  function configureCompanyStatusIndicator(indicator, admin, fallbackLabel, isOnline) {
    if (!(indicator instanceof HTMLElement)) {
      return;
    }

    const banLabel = getCompanyBanBadgeText(admin);
    const restrictionLabel = getCompanyRestrictionBadgeText(admin);
    indicator.textContent = "";
    indicator.innerHTML = "";
    indicator.classList.toggle("is-online", !banLabel && !restrictionLabel && Boolean(isOnline));
    indicator.classList.toggle("is-banned", Boolean(banLabel));
    indicator.classList.toggle("is-restricted", Boolean(restrictionLabel));
    delete indicator.dataset.companyBanCountdown;
    delete indicator.dataset.companyBanAdminId;
    delete indicator.dataset.companyRestrictionCountdown;
    delete indicator.dataset.companyRestrictionAdminId;

    if (banLabel) {
      indicator.innerHTML = createIconSvg(companyCardIconPaths.ban);
      indicator.dataset.companyBanCountdown = banLabel;
      indicator.dataset.companyBanAdminId = getCompanyId(admin);
      indicator.setAttribute("aria-label", banLabel);
      indicator.removeAttribute("title");
      indicator.tabIndex = 0;
      return;
    }

    if (restrictionLabel) {
      indicator.innerHTML = createIconSvg(companyCardIconPaths.restrict);
      indicator.dataset.companyRestrictionCountdown = restrictionLabel;
      indicator.dataset.companyRestrictionAdminId = getCompanyId(admin);
      indicator.setAttribute("aria-label", restrictionLabel);
      indicator.removeAttribute("title");
      indicator.tabIndex = 0;
      return;
    }

    indicator.setAttribute("aria-label", fallbackLabel);
    indicator.removeAttribute("title");
    indicator.removeAttribute("tabindex");
  }

  // Supports the configure company online indicator branch of the super admin UI.
  function configureCompanyOnlineIndicator(indicator, fallbackLabel, isOnline) {
    if (!(indicator instanceof HTMLElement)) {
      return;
    }

    indicator.textContent = "";
    indicator.innerHTML = "";
    indicator.classList.toggle("is-online", Boolean(isOnline));
    indicator.classList.remove("is-banned", "is-restricted");
    delete indicator.dataset.companyBanCountdown;
    delete indicator.dataset.companyBanAdminId;
    delete indicator.dataset.companyRestrictionCountdown;
    delete indicator.dataset.companyRestrictionAdminId;
    indicator.setAttribute("aria-label", fallbackLabel);
    indicator.removeAttribute("title");
    indicator.removeAttribute("tabindex");
  }


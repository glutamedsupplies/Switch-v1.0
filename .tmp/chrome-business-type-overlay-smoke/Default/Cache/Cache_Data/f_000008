    const appendTag = (value) => {
      const tag = String(value || "").trim();
      const key = tag.toLowerCase();
      if (!tag || key === "food" || seen.has(key)) {
        return;
      }
      seen.add(key);
      tags.push(tag);
    };

    if (Array.isArray(product?.tags)) {
      product.tags.forEach(appendTag);

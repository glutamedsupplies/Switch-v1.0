      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.classList.remove("is-loading");
        button.removeAttribute("aria-busy");
      }
    }
  }

  async function requestProductRevision(productId, button = null) {
    const normalizedProductId = String(productId || "").trim();
    if (!normalizedProductId) {
      return false;
    }

    const targetProduct = findProductRequestById(normalizedProductId);
    const productName = String(targetProduct?.name || "product").trim();
    if (!targetProduct) {
      setFeedback("Product request not found.", "error");
      return false;
    }

    const approvalStatus = String(targetProduct?.approvalStatus || "pending").trim().toLowerCase();
    if (approvalStatus === "approved" || approvalStatus === "rejected") {
      setFeedback("Only products in review can be sent for revision.", "error");
      return false;
    }

    const revisionSignal = getProductRevisionSignal(targetProduct);
    if (String(revisionSignal?.status || "").trim().toLowerCase() === "requested") {
      setFeedback(`${productName} already has a revision request.`, "notice");
      return false;
    }

    const revisionSelection = await openProductRevisionModal(targetProduct);
    if (!revisionSelection) {
      return false;
    }

    const revisionFields = normalizeProductRevisionFields(revisionSelection.fields);
    const fieldLabels = getProductRevisionFieldLabels(revisionFields);
    if (!fieldLabels.length) {
      setFeedback("Select at least one revision item.", "error");
      return false;
    }

    const note = String(revisionSelection.note || "").trim();
    const reason = `Needs revision: ${fieldLabels.join(", ")}`;
    const message = note ||
      `Please revise ${productName}. Update the following: ${fieldLabels.join(", ")}.`;

    try {
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.classList.add("is-loading");
        button.setAttribute("aria-busy", "true");
      }
      setFeedback(`Sending revision request for ${productName}...`);

      const response = await fetch(
        `/api/super-admin/products/${encodeURIComponent(normalizedProductId)}/revision`,
        {
          method: "PATCH",
          headers: rootHeaders({
            Accept: "application/json",
            "Content-Type": "application/json",
          }),
          body: JSON.stringify({
            reason,
            message,
            revisionFields,
            revisionNote: note,

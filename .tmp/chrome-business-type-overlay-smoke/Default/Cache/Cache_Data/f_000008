  // Keeps company ban modal duration synchronized with current state.
  function syncCompanyBanModalDuration() {
    const isRestrict = companyControlModalMode === "restrict";
    const isUnban = companyControlModalMode === "unban";
    const isUnrestrict = companyControlModalMode === "unrestrict";
    const isReviewOnly = isUnban || isUnrestrict;
    const hasReason = String(elements.companyBanReasonPicker?.value || "").trim().length > 0;
    const hasRestrictionReason = String(elements.companyRestrictionReasonPicker?.value || "").trim().length > 0;
    const hasRestrictionLimit = getSelectedCompanyRestrictionLimits().length > 0;
    if (elements.companyBanDurationField instanceof HTMLElement) {
      elements.companyBanDurationField.hidden = !isRestrict;
    }
    if (elements.companyBanReasonPickerField instanceof HTMLElement) {
      elements.companyBanReasonPickerField.hidden = isRestrict || isReviewOnly;
    }
    if (elements.companyBanReasonField instanceof HTMLElement) {
      elements.companyBanReasonField.hidden = isRestrict || isReviewOnly;
    }
    if (elements.companyRestrictionReasonPickerField instanceof HTMLElement) {
      elements.companyRestrictionReasonPickerField.hidden = !isRestrict;
    }
    if (elements.companyRestrictionDescriptionField instanceof HTMLElement) {
      elements.companyRestrictionDescriptionField.hidden = !isRestrict;
    }
    if (elements.companyRestrictionLimitsField instanceof HTMLElement) {
      elements.companyRestrictionLimitsField.hidden = !isRestrict;
    }
    if (elements.companyBanDurationInput instanceof HTMLInputElement) {
      elements.companyBanDurationInput.disabled = !isRestrict;
    }
    if (elements.companyBanReasonInput instanceof HTMLTextAreaElement) {
      elements.companyBanReasonInput.disabled = isRestrict || isUnban;
    }
    if (elements.companyRestrictionReasonPicker instanceof HTMLSelectElement) {
      elements.companyRestrictionReasonPicker.disabled = !isRestrict;
    }
    if (elements.companyRestrictionDescriptionInput instanceof HTMLTextAreaElement) {
      elements.companyRestrictionDescriptionInput.disabled = !isRestrict;
    }
    if (elements.companyRestrictionReasonTrigger instanceof HTMLButtonElement) {
      elements.companyRestrictionReasonTrigger.disabled = !isRestrict;
      if (!isRestrict) {
        setCompanyRestrictionReasonDropdownOpen(false);
      }
    }
    for (const option of elements.companyRestrictionLimitOptions) {
      if (option instanceof HTMLInputElement) {
        option.disabled = !isRestrict;
      }
    }
    if (elements.companyBanReasonPicker instanceof HTMLSelectElement) {
      elements.companyBanReasonPicker.disabled = isRestrict || isReviewOnly;
    }
    if (elements.companyBanReasonTrigger instanceof HTMLButtonElement) {
      elements.companyBanReasonTrigger.disabled = isRestrict || isReviewOnly;
      if (isRestrict || isReviewOnly) {
        setCompanyBanReasonDropdownOpen(false);
      }
    }
    if (elements.companyBanDurationUnit instanceof HTMLSelectElement) {
      elements.companyBanDurationUnit.disabled = !isRestrict;
    }
    if (elements.companyBanDurationUnitTrigger instanceof HTMLButtonElement) {
      elements.companyBanDurationUnitTrigger.disabled = !isRestrict;
      if (!isRestrict) {
        setCompanyBanDurationUnitDropdownOpen(false);
      }
    }
    if (elements.companyBanModalConfirmButton instanceof HTMLButtonElement) {
      const durationValue = Number(elements.companyBanDurationInput?.value || 0);
      const hasValidDuration = Number.isFinite(durationValue) && durationValue >= 1;
      elements.companyBanModalConfirmButton.disabled = isReviewOnly
        ? false
        : isRestrict
          ? !hasValidDuration || !hasRestrictionReason || !hasRestrictionLimit
          : !hasReason;
    }
    syncCompanyBanReasonDropdown();
    syncCompanyBanDurationUnitDropdown();
    syncCompanyRestrictionReasonDropdown();
    syncCompanyRestrictionLimitDropdown();
  }

  // Reads or derives company ban modal selection for the current super admin flow.
  function getCompanyBanModalSelection() {
    if (companyControlModalMode === "unban" || companyControlModalMode === "unrestrict") {
      return {};
    }
    if (companyControlModalMode === "restrict") {
      const durationValue = Math.trunc(Number(elements.companyBanDurationInput?.value || 0));
      if (!Number.isFinite(durationValue) || durationValue < 1) {
        elements.companyBanDurationInput?.focus?.();
        return null;
      }
      const durationUnit = String(elements.companyBanDurationUnit?.value || "hours").trim().toLowerCase() === "days"
        ? "days"
        : "hours";
      const expiresAt = new Date(Date.now() + durationValue * (durationUnit === "days" ? 86400000 : 3600000));
      const restrictionReason = getCompanyRestrictionReasonValue();
      if (!restrictionReason) {
        elements.companyRestrictionReasonTrigger?.focus?.();
        return null;
      }
      const restrictionDescription = String(elements.companyRestrictionDescriptionInput?.value || "")
        .replace(/\s+/g, " ")
        .trim();
      const restrictionLimits = getSelectedCompanyRestrictionLimits();
      if (!restrictionLimits.length) {
        elements.companyRestrictionLimitTrigger?.focus?.();
        return null;
      }
      return {
        restrictDurationValue: durationValue,
        restrictDurationUnit: durationUnit,
        restrictExpiresAt: expiresAt.toISOString(),
        restrictionReason,
        restrictionDescription,
        restrictionLimits,
        restrictionLimitLabels: getSelectedCompanyRestrictionLimitLabels(),
      };
    }

    const banReason = String(elements.companyBanReasonPicker?.value || "").replace(/\s+/g, " ").trim();
    if (!banReason) {
      elements.companyBanReasonTrigger?.focus?.();
      return null;
    }
    const banDescription = String(elements.companyBanReasonInput?.value || "").replace(/\s+/g, " ").trim();
    return {
      banType: "permanent",
      banReason,
      banDescription,
    };
  }

  // Closes company ban modal and cleans up related state.
  function closeCompanyBanModal(result = null) {
    setCompanyBanReasonDropdownOpen(false);
    setCompanyBanDurationUnitDropdownOpen(false);
    setCompanyRestrictionReasonDropdownOpen(false);
    setCompanyRestrictionLimitDropdownOpen(false);
    if (elements.companyBanModalOverlay instanceof HTMLElement) {
      elements.companyBanModalOverlay.hidden = true;
      elements.companyBanModalOverlay.classList.remove("is-visible");
      elements.companyBanModalOverlay.setAttribute("aria-hidden", "true");
    }
    if (elements.companyBanModalDialog instanceof HTMLElement) {
      elements.companyBanModalDialog.hidden = true;
      elements.companyBanModalDialog.classList.remove("is-visible", "is-restrict", "is-unban", "is-unrestrict");
    }

    const resolver = companyBanModalResolve;
    companyBanModalResolve = null;
    if (typeof resolver === "function") {
      resolver(result);
    }
  }

  // Reads or derives company ban metric value for the current super admin flow.
  function getCompanyBanMetricValue(admin, keys) {
    for (const key of keys) {
      const value = Number(admin?.counts?.[key] ?? admin?.[key] ?? 0);
      if (Number.isFinite(value) && value > 0) {
        return Math.trunc(value);
      }
    }
    return 0;
  }

  // Reads or derives company ban metrics for the current super admin flow.
  function getCompanyBanMetrics(admins) {
    const entries = Array.isArray(admins) ? admins.filter(Boolean) : [];
    if (!entries.length) {
      return {
        reports: 0,
        violations: 0,
        rating: 0,
      };
    }

    let ratingTotal = 0;
    let ratingCount = 0;
    let reports = 0;
    let violations = 0;

    for (const admin of entries) {
      const counts = getAdminCounts(admin);
      const rating = Number(counts.rating || admin?.rating || 0);
      if (Number.isFinite(rating) && rating > 0) {
        ratingTotal += rating;
        ratingCount += 1;
      }
      reports += getCompanyBanMetricValue(admin, [
        "reports",
        "reportCount",
        "reportsCount",
        "reportedCount",
        "complaints",
        "complaintCount",
      ]);
      violations += getCompanyBanMetricValue(admin, [
        "violations",
        "violationCount",
        "violationsCount",
        "strikes",
        "strikeCount",
        "warnings",
        "warningCount",
      ]);
    }

    return {
      reports,
      violations,
      rating: ratingCount > 0 ? ratingTotal / ratingCount : 0,
    };
  }

  // Builds the DOM structure for company ban tag.
  function createCompanyBanTag(label, tone = "", iconPath = "") {
    const tag = document.createElement("span");
    if (tone) {

  function isSupportedProductImageUpload(file) {
    if (!(file instanceof File)) {
      return false;
    }
    const fileType = String(file.type || "").toLowerCase();
    const fileName = String(file.name || "").toLowerCase();
    return (
      ["image/jpeg", "image/jpg", "image/png", "image/webp"].includes(fileType) ||
      /\.(jpe?g|png|webp)$/.test(fileName)
    );
  }

  async function uploadSuperAdminProductImageFile(file) {
    let response;
    try {
      response = await fetch("/api/uploads", {
        method: "POST",
        headers: rootHeaders({
          Accept: "application/json",
          "Content-Type": file.type || "application/octet-stream",
          "X-File-Name": file.name || "product-image",
        }),
        body: file,
      });
    } catch (error) {
      throw new Error("Unable to upload image. Check the file, then try again.");
    }

    const responseText = await response.text();
    let data = {};
    if (responseText) {
      try {
        data = JSON.parse(responseText);
      } catch (error) {
        if (!response.ok) {
          throw new Error(responseText.trim() || "Unable to upload image.");
        }
      }
    }

    if (!response.ok) {
      throw new Error(data.message || "Unable to upload image.");
    }

    const imageUrl = String(data.imageUrl || data.mediaUrl || "").trim();
    if (!imageUrl) {
      throw new Error("Upload finished but no image URL was returned.");
    }
    return imageUrl;
  }

  async function saveSuperAdminProductUploadedImageUrls(productId, imageUrls) {
    const normalizedProductId = String(productId || "").trim();
    const normalizedImageUrls = normalizeProductDetailUrlList(imageUrls);
    if (!normalizedProductId || !normalizedImageUrls.length) {
      throw new Error("Upload at least one image before saving.");
    }

    const response = await fetch(
      `/api/super-admin/products/${encodeURIComponent(normalizedProductId)}/images`,
      {
        method: "PATCH",
        headers: rootHeaders({
          Accept: "application/json",
          "Content-Type": "application/json",
        }),
        body: JSON.stringify({ imageUrls: normalizedImageUrls }),
      },
    );
    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(data.message || "Unable to save uploaded images for YOLO.");
    }
    return data;
  }


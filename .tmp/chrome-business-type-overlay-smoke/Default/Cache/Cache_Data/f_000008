  // Keeps paginated company pages the same height when the last page has fewer rows.
  function createCompanyPlaceholderCard() {
    const placeholder = document.createElement("article");
    placeholder.className = "super-admin-company-card super-admin-company-card--placeholder";
    placeholder.setAttribute("aria-hidden", "true");
    placeholder.tabIndex = -1;
    return placeholder;
  }

  // Keeps product request count synchronized with current state.
  function syncProductRequestCount(totalCount = state.productRequests.length, visibleCount = totalCount) {
    const count = Number(totalCount) || 0;
    const visible = Number(visibleCount) || 0;
    if (elements.productRequestTotal) {
      elements.productRequestTotal.textContent = `(${numberText(visible)})`;
    }
    if (elements.productRequestCount) {
      elements.productRequestCount.textContent = numberText(count);
      elements.productRequestCount.hidden = count <= 0;
    }
    updateNotificationCount(count);
    renderNotificationPanel();
  }

  function normalizeProductRequestView(value) {
    const normalizedValue = String(value || "").trim().toLowerCase();
    if (normalizedValue === "rejected") {
      return "rejected";
    }
    if (
      normalizedValue === "live" ||
      normalizedValue === "live-listing" ||
      normalizedValue === "live_listing"
    ) {
      return "live";
    }
    if (
      normalizedValue === "approved" ||
      normalizedValue === "approved-saved" ||
      normalizedValue === "approved_saved"
    ) {
      return "approved";
    }
    return "in-review";
  }

  function readProductRequestSkeletonCountCache() {
    try {
      const rawValue = window.localStorage.getItem(productRequestSkeletonCountStorageKey);
      const parsedValue = rawValue ? JSON.parse(rawValue) : {};
      return parsedValue && typeof parsedValue === "object" && !Array.isArray(parsedValue)
        ? parsedValue
        : {};
    } catch (error) {
      return {};
    }
  }

  function getCachedProductRequestVisibleCount(view = state.productRequestView) {
    const cache = readProductRequestSkeletonCountCache();
    const cacheKey = normalizeProductRequestView(view);
    if (!Object.prototype.hasOwnProperty.call(cache, cacheKey)) {
      return null;
    }

    const cachedCount = Math.trunc(Number(cache[cacheKey]));
    return Number.isFinite(cachedCount) && cachedCount >= 0 ? cachedCount : null;
  }

  function cacheProductRequestVisibleCount(view, count) {
    const cacheKey = normalizeProductRequestView(view);
    const normalizedCount = Math.max(0, Math.trunc(Number(count)) || 0);
    try {
      const cache = readProductRequestSkeletonCountCache();
      cache[cacheKey] = normalizedCount;
      window.localStorage.setItem(productRequestSkeletonCountStorageKey, JSON.stringify(cache));
    } catch (error) {
      // Ignore storage failures; skeletons can still fall back to the current page size.
    }
  }

  function getActiveLiveProductRequests() {
    return state.liveProductRequests;
  }

  function getActiveProductRequestCollection() {
    if (state.productRequestView === "rejected") {
      return state.rejectedProductRequests;
    }
    if (state.productRequestView === "live") {
      return getActiveLiveProductRequests();
    }
    if (state.productRequestView === "approved") {
      return state.approvedProductRequests;
    }
    return state.productRequests;
  }

  function findProductRequestById(productId) {
    const normalizedProductId = String(productId || "").trim();
    return [
      ...state.productRequests,
      ...state.rejectedProductRequests,
      ...state.approvedProductRequests,
      ...state.liveProductRequests,
    ].find((product) =>
      String(product?.id || "").trim() === normalizedProductId
    ) || null;
  }

  function getProductImageUploadHeaderTarget() {
    const activeView = normalizeProductRequestView(state.productRequestView);
    if (activeView !== "approved" && activeView !== "rejected") {
      return null;
    }

    const filteredRequests = getFilteredProductRequests(getActiveProductRequestCollection());
    if (!filteredRequests.length) {
      return null;
    }

    const pageSize = Math.max(1, Number(state.productRequestPageSize) || 10);
    const pageIndex = Math.max(0, Number(state.productRequestPage || 1) - 1);
    const pageStart = pageIndex * pageSize;
    return filteredRequests[pageStart] || filteredRequests[0] || null;
  }

  function syncProductRequestStats() {
    const statKeyByCard = {
      submitted: "submitted",
      "in-review": "inReview",
      approved: "approved",
      rejected: "rejected",
    };
    for (const card of elements.productRequestStatCards) {
      const statKey = statKeyByCard[card.dataset.superAdminProductRequestStat];
      const valueElement = card.querySelector("[data-super-admin-product-request-stat-value]");
      if (valueElement) {
        valueElement.textContent = numberText(state.productRequestStats?.[statKey] || 0);
      }
    }
  }

  function syncProductRequestView() {
    const activeView = normalizeProductRequestView(state.productRequestView);
    state.productRequestView = activeView;
    for (const button of elements.productRequestViewButtons) {
      const isActive = normalizeProductRequestView(button.dataset.superAdminProductReviewView) === activeView;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
      button.disabled = isActive;
    }
    for (const label of elements.productRequestViewLabels) {
      const view = normalizeProductRequestView(label.dataset.superAdminProductReviewViewLabel);
      if (view === "rejected") {
        label.textContent = `Rejected (${numberText(state.rejectedProductRequests.length)})`;
      } else if (view === "live") {
        label.textContent = `Live listing (${numberText(getActiveLiveProductRequests().length)})`;
      } else if (view === "approved") {
        label.textContent = `Approved (${numberText(state.approvedProductRequests.length)})`;
      } else {
        label.textContent = `In review (${numberText(state.productRequests.length)})`;
      }
    }
    const headingLabel = activeView === "rejected"
      ? "Rejected"
      : activeView === "live"
        ? "Live Listing"
      : activeView === "approved"
        ? "Approved"
        : "In Review";
    if (elements.productRequestHeading) {
      elements.productRequestHeading.textContent = headingLabel;
    }
    if (elements.productRequestTitle) {
      elements.productRequestTitle.textContent = headingLabel;
    }
    if (elements.productImageAddButton instanceof HTMLButtonElement) {
      const canUploadImages = activeView === "approved" || activeView === "rejected";
      const activeCollection = getActiveProductRequestCollection();
      elements.productImageAddButton.hidden = !canUploadImages;
      elements.productImageAddButton.disabled = !canUploadImages || activeCollection.length === 0;
      elements.productImageAddButton.setAttribute(
        "aria-label",
        `Add image to ${headingLabel} product`,
      );
    }
  }

  function setProductRequestView(value) {
    const nextView = normalizeProductRequestView(value);
    if (nextView === state.productRequestView) {
      return;
    }
    state.productRequestView = nextView;
    state.productRequestPage = 1;
    syncProductRequestView();
    renderProductRequests();
  }

  // Reads or derives product request search text for the current super admin flow.
  function getProductRequestSearchText(product) {
    return [
      product?.name,
      product?.category,
      Array.isArray(product?.categories) ? product.categories.join(" ") : "",
      getProductCompanyLabel(product),
      product?.description,
      product?.sku,
      product?.id,
      getProductRejectedEvidenceMatch(product) ? "illegal product rejected evidence yolo flagged" : "",
      getProductRevisionSignal(product) ? "revision needs edit category mismatch caution" : "",
      moneyText(product?.salesPrice ?? product?.originalPrice ?? product?.price),
      getProductReviewCount(product),
      getProductRatingDetailLabel(product),
      getProductCreatedDayLabel(product),
    ]
      .map((value) => String(value || "").trim().toLowerCase())
      .filter(Boolean)
      .join(" ");
  }

  function normalizeProductRequestFilterValue(type, value) {
    const normalized = String(value || "").trim().toLowerCase();
    if (type === "category") {
      return ["with-category", "no-category"].includes(normalized) ? normalized : "all";
    }
    if (type === "pricing") {
      return ["discounted", "regular-price", "missing-price"].includes(normalized) ? normalized : "all";
    }
    if (type === "signal") {
      return [
        "illegal-alert",
        "needs-revision",
        "multiple-media",
        "has-video",
        "missing-image",
      ].includes(normalized)
        ? normalized
        : "all";
    }
    return "all";
  }

  function normalizeProductRequestSortValue(value) {
    const normalized = String(value || "").trim().toLowerCase();
    return [
      "oldest",
      "name-asc",
      "price-desc",
      "price-asc",
      "stock-desc",
      "reviews-desc",
    ].includes(normalized)
      ? normalized
      : "newest";
  }

  function normalizeProductRequestSortValues(value) {
    return normalizeSortValues(value, normalizeProductRequestSortValue, "newest");
  }

  // Reads or derives product request filter label for the current super admin flow.
  function getProductRequestFilterLabel(type, value) {
    const labels = {
      category: {
        "with-category": "With category",
        "no-category": "No category",
      },
      pricing: {
        discounted: "Discounted",
        "regular-price": "No discount",
        "missing-price": "Missing price",
      },
      signal: {
        "illegal-alert": "AI / YOLO alert",
        "needs-revision": "Needs revision",
        "multiple-media": "Multiple media",
        "has-video": "Has video",
        "missing-image": "Missing image",
      },
    };
    return labels[type]?.[value] || "All";
  }

  function getProductRequestSortLabel(value) {
    const labels = {
      newest: "Newest first",
      oldest: "Oldest first",
      "name-asc": "Product name A-Z",
      "price-desc": "Highest price",
      "price-asc": "Lowest price",
      "stock-desc": "Most stock",
      "reviews-desc": "Most reviews",
    };
    return labels[normalizeProductRequestSortValue(value)] || labels.newest;
  }

  function getProductRequestSortSummaryLabel(values) {
    return normalizeProductRequestSortValues(values).map(getProductRequestSortLabel).join(", ");
  }

  function getCheckedProductRequestFilterValue(type) {
    const checked = document.querySelector(`[data-super-admin-product-request-filter="${type}"]:checked`);
    return normalizeProductRequestFilterValue(type, checked?.value);
  }

  function getCheckedProductRequestSortValues() {
    return readCheckedSortValues(
      "[data-super-admin-product-request-sort]",
      normalizeProductRequestSortValue,
      "newest",
    );
  }

  function setProductRequestRadioChecked(selector, value) {
    const control = document.querySelector(`${selector}[value="${value}"]`);
    if (control instanceof HTMLInputElement) {
      control.checked = true;
    }
  }

  function setProductRequestSortControlsChecked(values) {
    setSortControlsChecked(
      "[data-super-admin-product-request-sort]",
      values,
      normalizeProductRequestSortValue,
      "newest",
    );
  }

  // Keeps product request filter summary synchronized with current controls.
  function syncProductRequestFilterSummary() {
    const selectedLabels = [];
    const category = getCheckedProductRequestFilterValue("category");
    const pricing = getCheckedProductRequestFilterValue("pricing");
    const signal = getCheckedProductRequestFilterValue("signal");

    if (category !== "all") selectedLabels.push(getProductRequestFilterLabel("category", category));
    if (pricing !== "all") selectedLabels.push(getProductRequestFilterLabel("pricing", pricing));
    if (signal !== "all") selectedLabels.push(getProductRequestFilterLabel("signal", signal));
    if (!selectedLabels.length) selectedLabels.push("All");

    if (elements.productRequestFilterSummary) {
      elements.productRequestFilterSummary.textContent =
        `${selectedLabels.join(", ")}, ${getProductRequestSortSummaryLabel(getCheckedProductRequestSortValues())}`;
    }
  }

  function getProductRequestPriceValue(product) {
    const salesPrice = Number(product?.salesPrice);
    if (Number.isFinite(salesPrice) && salesPrice >= 0) {
      return salesPrice;
    }
    const originalPrice = Number(product?.originalPrice ?? product?.price);
    return Number.isFinite(originalPrice) && originalPrice >= 0 ? originalPrice : NaN;
  }

  function getProductRequestSortTimestamp(product) {
    const approvalStatus = String(product?.approvalStatus || "pending").trim().toLowerCase();
    const dateCandidates = approvalStatus === "approved"
      ? [product?.approvedAt, product?.approvalUpdatedAt, product?.submittedAt, product?.createdAt, product?.updatedAt]
      : approvalStatus === "rejected"
        ? [product?.rejectedAt, product?.approvalUpdatedAt, product?.submittedAt, product?.createdAt, product?.updatedAt]
        : [product?.submittedAt, product?.createdAt, product?.updatedAt, product?.approvalUpdatedAt];

    for (const value of dateCandidates) {
      const timestamp = new Date(value || "").getTime();
      if (!Number.isNaN(timestamp)) {
        return timestamp;
      }
    }
    return 0;
  }

  function compareProductRequestNames(left, right) {
    return String(left?.name || "Unnamed product").localeCompare(
      String(right?.name || "Unnamed product"),
      undefined,
      { sensitivity: "base" },
    );
  }

  // Reads or derives product request filter value for the current super admin flow.
  function getProductRequestFilterValue(product) {
    const categoryLabel = getProductCategoryLabel(product);
    const salesPrice = Number(product?.salesPrice);
    const originalPrice = Number(product?.originalPrice ?? product?.price);
    const displayPrice = getProductRequestPriceValue(product);
    const mediaCounts = getProductRequestMediaCounts(product);
    const approvalStatus = String(product?.approvalStatus || "pending").trim().toLowerCase();
    const hasPrice = Number.isFinite(displayPrice) && displayPrice >= 0;
    const hasDiscount =
      Number.isFinite(salesPrice) &&
      salesPrice >= 0 &&
      Number.isFinite(originalPrice) &&
      originalPrice > 0 &&
      salesPrice < originalPrice;

    return {
      hasCategory: Boolean(categoryLabel),
      hasPrice,
      hasDiscount,
      hasIllegalAlert: approvalStatus === "rejected" || Boolean(getProductRejectedEvidenceMatch(product)),
      hasRevisionSignal: Boolean(getProductRevisionSignal(product)),
      hasMultipleMedia: mediaCounts.imageCount > 1 || mediaCounts.videoCount > 0,
      hasVideo: mediaCounts.videoCount > 0,
      missingImage: !getProductImageUrl(product),
    };
  }

  // Supports the matches product request filter branch of the super admin UI.
  function matchesProductRequestFilter(product) {
    const filters = state.productRequestFilters || {};
    const categoryFilter = normalizeProductRequestFilterValue("category", filters.category);
    const pricingFilter = normalizeProductRequestFilterValue("pricing", filters.pricing);
    const signalFilter = normalizeProductRequestFilterValue("signal", filters.signal);
    const productFilter = getProductRequestFilterValue(product);

    if (categoryFilter === "with-category" && !productFilter.hasCategory) {
      return false;
    }
    if (categoryFilter === "no-category" && productFilter.hasCategory) {
      return false;
    }
    if (pricingFilter === "discounted" && !productFilter.hasDiscount) {
      return false;
    }
    if (pricingFilter === "regular-price" && (!productFilter.hasPrice || productFilter.hasDiscount)) {
      return false;
    }
    if (pricingFilter === "missing-price" && productFilter.hasPrice) {
      return false;
    }
    if (signalFilter === "illegal-alert" && !productFilter.hasIllegalAlert) {
      return false;
    }
    if (signalFilter === "needs-revision" && !productFilter.hasRevisionSignal) {
      return false;
    }
    if (signalFilter === "multiple-media" && !productFilter.hasMultipleMedia) {
      return false;
    }
    if (signalFilter === "has-video" && !productFilter.hasVideo) {
      return false;
    }
    if (signalFilter === "missing-image" && !productFilter.missingImage) {
      return false;
    }
    return true;
  }

  function hasActiveProductRequestFilters() {
    const filters = state.productRequestFilters || {};
    return normalizeProductRequestFilterValue("category", filters.category) !== "all" ||
      normalizeProductRequestFilterValue("pricing", filters.pricing) !== "all" ||
      normalizeProductRequestFilterValue("signal", filters.signal) !== "all" ||
      !isDefaultSortSelection(state.productRequestSort, normalizeProductRequestSortValue, "newest");
  }

  function compareProductRequestsBySortValue(left, right, sortValue) {
    if (sortValue === "oldest") {
      return getProductRequestSortTimestamp(left) - getProductRequestSortTimestamp(right);
    }
    if (sortValue === "name-asc") {
      return compareProductRequestNames(left, right);
    }
    if (sortValue === "price-desc" || sortValue === "price-asc") {
      const leftPrice = getProductRequestPriceValue(left);
      const rightPrice = getProductRequestPriceValue(right);
      const normalizedLeft = Number.isFinite(leftPrice) ? leftPrice : (sortValue === "price-desc" ? -Infinity : Infinity);
      const normalizedRight = Number.isFinite(rightPrice) ? rightPrice : (sortValue === "price-desc" ? -Infinity : Infinity);
      return sortValue === "price-desc"
        ? normalizedRight - normalizedLeft
        : normalizedLeft - normalizedRight;
    }
    if (sortValue === "stock-desc") {
      return getProductStock(right) - getProductStock(left);
    }
    if (sortValue === "reviews-desc") {
      return getProductReviewCount(right) - getProductReviewCount(left);
    }
    return getProductRequestSortTimestamp(right) - getProductRequestSortTimestamp(left);
  }

  function compareProductRequestsBySort(left, right) {
    for (const sortValue of normalizeProductRequestSortValues(state.productRequestSort)) {
      const compareResult = compareProductRequestsBySortValue(left, right, sortValue);
      if (compareResult !== 0) {
        return compareResult;
      }
    }
    return compareProductRequestNames(left, right);
  }

  function applyProductRequestFiltersFromControls() {
    state.productRequestFilters = {
      category: getCheckedProductRequestFilterValue("category"),
      pricing: getCheckedProductRequestFilterValue("pricing"),
      signal: getCheckedProductRequestFilterValue("signal"),
    };
    state.productRequestSort = getCheckedProductRequestSortValues();
    state.productRequestPage = 1;
    syncProductRequestFilterSummary();
    renderProductRequests();
    toggleProductRequestFilterDropdown(false);
  }

  function clearProductRequestFilters() {
    setProductRequestRadioChecked('[data-super-admin-product-request-filter="category"]', "all");
    setProductRequestRadioChecked('[data-super-admin-product-request-filter="pricing"]', "all");
    setProductRequestRadioChecked('[data-super-admin-product-request-filter="signal"]', "all");
    setProductRequestSortControlsChecked(["newest"]);
    state.productRequestFilters = {
      category: "all",
      pricing: "all",
      signal: "all",
    };
    state.productRequestSort = ["newest"];
    state.productRequestPage = 1;
    syncProductRequestFilterSummary();
    renderProductRequests();
  }

  // Reads or derives filtered product requests for the current super admin flow.
  function getFilteredProductRequests(requests = state.productRequests) {
    const searchTerm = state.productRequestSearchTerm.trim().toLowerCase();
    return requests
      .filter((product) => {
        if (!matchesProductRequestFilter(product)) {
          return false;
        }
        if (!searchTerm) {
          return true;
        }
        return getProductRequestSearchText(product).includes(searchTerm);
      })
      .sort(compareProductRequestsBySort);
  }

  // Updates product request menu open and synchronizes related UI state.
  function setProductRequestMenuOpen(actions, isOpen) {
    if (!(actions instanceof HTMLElement)) {
      return;
    }

    const menu = actions.querySelector("[data-product-request-menu]");
    const toggle = actions.querySelector("[data-product-request-menu-toggle]");
    actions.classList.toggle("is-open", Boolean(isOpen));
    if (menu instanceof HTMLElement) {
      menu.hidden = !isOpen;
    }
    if (toggle instanceof HTMLButtonElement) {
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    }
  }

  // Closes product request menus and cleans up related state.
  function closeProductRequestMenus(exceptActions = null) {
    const actionGroups = Array.from(
      elements.productRequestList?.querySelectorAll(".super-admin-product-request-card__actions") || [],
    );
    for (const actions of actionGroups) {
      if (actions === exceptActions) {
        continue;
      }
      setProductRequestMenuOpen(actions, false);
    }
  }

  let activeCompanyPopoverCard = null;
  let companyPopoverCloseTimer = 0;

  // Clears company popover close timer and related transient state.
  function clearCompanyPopoverCloseTimer() {
    if (!companyPopoverCloseTimer) {
      return;
    }
    window.clearTimeout(companyPopoverCloseTimer);
    companyPopoverCloseTimer = 0;
  }

  // Updates company popover card open and synchronizes related UI state.
  function setCompanyPopoverCardOpen(card, isOpen) {
    if (!(card instanceof HTMLElement)) {
      return;
    }
    card.classList.toggle("is-company-popover-open", Boolean(isOpen));
  }

  // Opens company popover for card and prepares related state.
  function openCompanyPopoverForCard(card) {
    if (!(card instanceof HTMLElement)) {
      return;
    }
    clearCompanyPopoverCloseTimer();
    if (activeCompanyPopoverCard && activeCompanyPopoverCard !== card) {
      setCompanyPopoverCardOpen(activeCompanyPopoverCard, false);
    }
    activeCompanyPopoverCard = card;
    setCompanyPopoverCardOpen(card, true);
  }

  // Schedules company popover close after the current interaction.
  function scheduleCompanyPopoverClose(card) {
    if (!(card instanceof HTMLElement)) {
      return;
    }
    clearCompanyPopoverCloseTimer();
    companyPopoverCloseTimer = window.setTimeout(() => {
      if (activeCompanyPopoverCard === card) {
        setCompanyPopoverCardOpen(card, false);
        activeCompanyPopoverCard = null;
      }
      companyPopoverCloseTimer = 0;
    }, 500);
  }

  // Reads or derives product company admin for the current super admin flow.
  function getProductCompanyAdmin(product) {
    const productAdminIds = [
      product?.adminId,
      product?.ownerAdminId,
      product?.companyId,
      product?.sellerId,
      product?.sellerAdminId,
      product?.storeId,
      product?.workspaceId,
      product?.tenantId,
    ].map((value) => String(value || "").trim()).filter(Boolean);
    if (productAdminIds.length) {
      const matchedById = state.admins.find((admin) => {
        const adminIds = [
          admin?.adminId,
          admin?.id,
          admin?.tenantId,
          admin?.workspaceId,
        ].map((value) => String(value || "").trim()).filter(Boolean);
        return adminIds.some((adminId) => productAdminIds.includes(adminId));
      });
      if (matchedById) {
        return matchedById;
      }
    }

    const normalizeMatchText = (value) => String(value || "").trim().toLowerCase();
    const productNames = [
      product?.companyName,
      product?.storeName,
      product?.businessName,
    ].map(normalizeMatchText).filter(Boolean);
    const productEmail = normalizeMatchText(product?.companyEmail || product?.sellerEmail || product?.email);
    if (!productNames.length && !productEmail) {
      return null;
    }
    return state.admins.find((admin) => {
      const adminNames = [
        admin?.companyName,
        admin?.storeName,
        admin?.businessName,
        admin?.displayName,
      ].map(normalizeMatchText).filter(Boolean);
      const adminEmail = normalizeMatchText(admin?.email);
      return adminNames.some((name) => productNames.includes(name)) ||
        (productEmail && adminEmail === productEmail);
    }) || null;
  }

  // Reads or derives product company preview counts for the current super admin flow.
  function getProductCompanyPreviewCounts(product, companyAdmin = getProductCompanyAdmin(product)) {
    if (companyAdmin) {
      return getAdminCounts(companyAdmin);
    }
    const rating = Number(product?.companyRating ?? product?.sellerRating ?? product?.storeRating ?? 0);
    const followers = Number(
      product?.followersCount ??
        product?.companyFollowersCount ??
        product?.sellerFollowersCount ??
        0,
    );
    return {
      followers: Number.isFinite(followers) && followers > 0 ? Math.trunc(followers) : 0,
      rating: Number.isFinite(rating) && rating > 0 ? rating : 0,
    };
  }

  // Reads or derives product company tone index for the current super admin flow.
  function getProductCompanyToneIndex(product, companyAdmin = getProductCompanyAdmin(product)) {
    if (companyAdmin) {
      return getCompanyToneIndex(companyAdmin);
    }
    const source = String(product?.adminId || product?.companyName || product?.storeName || product?.businessName || "Company");
    let hash = 0;
    for (const char of source) {
      hash = (hash + char.charCodeAt(0)) % 6;
    }
    return hash + 1;
  }

  // Reads or derives product review count for the current super admin flow.
  function getProductReviewCount(product) {
    const reviewCount = Number(
      product?.commentCount ??
        product?.reviewCount ??
        product?.reviewsCount ??
        product?.ratingCount ??
        product?.ratingsCount ??
        (Array.isArray(product?.reviews) ? product.reviews.length : 0),
    );
    return Number.isFinite(reviewCount) && reviewCount > 0 ? Math.trunc(reviewCount) : 0;
  }

  // Reads or derives product rating detail label for the current super admin flow.
  function getProductRatingDetailLabel(product) {
    const rating = Number(product?.rating ?? product?.productRating ?? 0);
    return `${Number.isFinite(rating) && rating > 0 ? rating.toFixed(1) : "0.0"} rating`;
  }

  // Formats date day for display.
  function formatDateDay(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) {
      return "No date";
    }

    return date.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  }

  // Reads or derives product created day label for the current super admin flow.
  function getProductCreatedDayLabel(product) {
    return formatDateDay(product?.createdAt || product?.submittedAt || product?.updatedAt);
  }

  // Normalizes product actor role before comparison or storage.
  function normalizeProductActorRole(value) {
    const text = String(value || "").trim().toLowerCase();
    if (!text) {
      return "";
    }
    if (text.includes("employee")) {
      return "Employee";
    }
    if (text.includes("admin") || text.includes("root") || text.includes("super")) {
      return "Admin";
    }
    return "";
  }

  // Reads or derives product modified label for the current super admin flow.
  function getProductModifiedLabel(product) {
    const updatedDate = new Date(product?.updatedAt || product?.approvalUpdatedAt || "");
    const createdDate = new Date(product?.createdAt || product?.submittedAt || "");
    const hasUpdatedDate = !Number.isNaN(updatedDate.getTime());
    const hasCreatedDate = !Number.isNaN(createdDate.getTime());
    const isModified = hasUpdatedDate && (!hasCreatedDate || updatedDate.getTime() - createdDate.getTime() > 1000);
    const role =
      normalizeProductActorRole(
        product?.modifiedByRole ??
          product?.updatedByRole ??
          product?.lastModifiedByRole ??
          product?.submittedByRole ??
          product?.createdByRole,
      ) ||
      normalizeProductActorRole(
        product?.modifiedBy ??
          product?.updatedBy ??
          product?.lastModifiedBy ??
          product?.submittedBy ??
          product?.createdBy,
      );
    const actionLabel = isModified ? "Modified" : "Submitted";
    return `${actionLabel} by ${role || "Admin"}`;
  }

  // Formats the compact age label shown over review images.
  function getProductRequestAgeLabel(product) {
    const value = product?.submittedAt || product?.createdAt || product?.updatedAt || "";
    const timestamp = new Date(value).getTime();
    if (Number.isNaN(timestamp)) {
      return "Recently";
    }

    const elapsedSeconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
    if (elapsedSeconds < 3600) {
      const minutes = Math.max(1, Math.floor(elapsedSeconds / 60));
      return `${numberText(minutes)}m ago`;
    }
    if (elapsedSeconds < 86400) {
      return `${numberText(Math.floor(elapsedSeconds / 3600))}h ago`;
    }
    const days = Math.floor(elapsedSeconds / 86400);
    if (days < 30) {
      return `${numberText(days)} day${days === 1 ? "" : "s"} ago`;
    }
    return formatRelativeTime(value);
  }

  function getProductRejectedEvidenceMatch(product) {
    const match =
      product?.yoloInspection?.rejectedEvidenceMatch ??
      product?.rejectedEvidenceMatch ??
      product?.illegalProductMatch ??
      null;
    if (!match || typeof match !== "object") {
      return null;
    }
    const score = Number(match.score ?? match.visualSearchScore ?? match.confidence);
    const threshold = Number(match.threshold ?? 0);
    const flagged =
      match.flagged === true ||
      String(match.status || "").trim().toLowerCase() === "matched" ||
      (Number.isFinite(score) && Number.isFinite(threshold) && threshold > 0 && score >= threshold);
    return flagged ? match : null;
  }

  function getRejectedEvidenceScoreLabel(match) {
    const score = Number(match?.score ?? match?.visualSearchScore ?? match?.confidence);
    if (!Number.isFinite(score) || score <= 0) {
      return "";
    }
    const normalizedScore = score > 1 ? score / 100 : score;
    return `${Math.round(Math.max(0, Math.min(1, normalizedScore)) * 100)}%`;
  }

  function getProductRevisionSignal(product) {
    const revision = product?.yoloRevision ?? product?.revisionSignal ?? null;
    if (!revision || typeof revision !== "object") {
      return null;
    }
    const status = String(revision.status || "").trim().toLowerCase();
    const flagged =
      revision.flagged === true ||
      status === "suggested" ||
      status === "requested";
    return flagged ? revision : null;
  }

  function normalizeProductDetailEvidenceUrl(value) {
    return String(value || "").trim().toLowerCase();
  }

  function appendProductDetailEvidenceUrls(target, value) {
    if (!value) {
      return;
    }
    if (Array.isArray(value)) {
      value.forEach((entry) => appendProductDetailEvidenceUrls(target, entry));
      return;
    }
    if (typeof value === "object") {
      [
        value.imageUrl,
        value.sourceImageUrl,
        value.productImageUrl,
        value.mediaUrl,
        value.url,
        value.src,
        value.href,
        value.image,
        value.imageUrls,
        value.images,
      ].forEach((entry) => appendProductDetailEvidenceUrls(target, entry));
      return;
    }

    const normalizedUrl = normalizeProductDetailEvidenceUrl(value);
    if (normalizedUrl && !target.includes(normalizedUrl)) {
      target.push(normalizedUrl);
    }
  }

  function getProductRevisionImageEvidenceEntries(revision) {
    if (!revision || typeof revision !== "object") {
      return [];
    }

    const entries = [];
    const seen = new Set();
    const appendEntry = (entry) => {
      if (!entry) {
        return;
      }
      const imageUrl = typeof entry === "object"
        ? String(entry.imageUrl || entry.url || entry.mediaUrl || entry.productImageUrl || "").trim()
        : String(entry || "").trim();
      const normalizedImageUrl = normalizeProductDetailEvidenceUrl(imageUrl);
      if (!normalizedImageUrl || seen.has(normalizedImageUrl)) {
        return;
      }
      seen.add(normalizedImageUrl);
      const imageBuckets = Array.isArray(entry?.imageBuckets)
        ? entry.imageBuckets.map((bucket) => String(bucket || "").trim()).filter(Boolean)
        : [];
      entries.push({
        imageUrl,
        normalizedImageUrl,
        label: String(entry?.label || entry?.visualLabel || imageBuckets.join(", ") || "").trim(),
        imageBuckets,
        matchType: String(entry?.matchType || revision.matchType || "").trim(),
        reason: String(entry?.reason || "").trim(),
        message: String(entry?.message || "").trim(),
      });
    };

    if (Array.isArray(revision.images)) {
      revision.images.forEach(appendEntry);
    }
    if (Array.isArray(revision.evidenceImages)) {
      revision.evidenceImages.forEach(appendEntry);
    }
    if (Array.isArray(revision.imageUrls)) {
      revision.imageUrls.forEach(appendEntry);
    }
    appendEntry(revision);
    return entries;
  }

  function findProductRevisionImageEvidence(revision, itemUrl) {
    const normalizedItemUrl = normalizeProductDetailEvidenceUrl(itemUrl);
    if (!normalizedItemUrl) {
      return null;
    }
    return getProductRevisionImageEvidenceEntries(revision)
      .find((entry) => entry.normalizedImageUrl === normalizedItemUrl) || null;
  }

  function getProductRevisionCategoryEvidenceEntries(revision) {
    if (!revision || typeof revision !== "object") {
      return [];
    }

    const entries = [];
    const seen = new Set();
    const appendEntry = (entry) => {
      if (!entry || typeof entry !== "object") {
        return;
      }
      const label = String(
        entry.label ||
          entry.category ||
          entry.categoryName ||
          entry.categoryLabel ||
          "",
      ).trim();
      const normalizedLabel = normalizeCategoryName(label).toLowerCase();
      if (!normalizedLabel || seen.has(normalizedLabel)) {
        return;
      }
      seen.add(normalizedLabel);
      entries.push({
        label,
        normalizedLabel,
        matchType: String(entry.matchType || revision.matchType || "").trim(),
        reason: String(entry.reason || "").trim(),
        message: String(entry.message || revision.message || revision.reason || "").trim(),
      });
    };

    if (Array.isArray(revision.categoryEvidence)) {
      revision.categoryEvidence.forEach(appendEntry);
    }
    if (Array.isArray(revision.categoryAlerts)) {
      revision.categoryAlerts.forEach(appendEntry);
    }
    if (Array.isArray(revision.categoryMismatches)) {
      revision.categoryMismatches.forEach(appendEntry);
    }
    return entries;
  }

  function findProductRevisionCategoryEvidence(revision, categoryValue) {
    const normalizedCategory = normalizeCategoryName(categoryValue).toLowerCase();
    if (!normalizedCategory) {
      return null;
    }
    return getProductRevisionCategoryEvidenceEntries(revision)
      .find((entry) => entry.normalizedLabel === normalizedCategory) || null;
  }

  function createProductDetailCategoryValue(product, values) {
    const rawValues = Array.isArray(values)
      ? values
      : values === null || values === undefined
        ? []
        : [values];
    const seen = new Set();
    const categories = [];
    rawValues.forEach((value) => {
      const category = normalizeCategoryName(value);
      const key = category.toLowerCase();
      if (!category || seen.has(key)) {
        return;
      }
      seen.add(key);
      categories.push(category);
    });
    if (!categories.length) {
      return document.createTextNode("-");
    }

    const revision = getProductRevisionSignal(product);
    const list = document.createElement("span");
    list.className = "super-admin-product-detail-modal__category-list";
    for (const category of categories) {
      const evidence = findProductRevisionCategoryEvidence(revision, category);
      const chip = document.createElement("span");
      chip.className = "super-admin-product-detail-modal__category-chip";
      chip.classList.toggle("is-warning", Boolean(evidence));
      chip.textContent = category;
      if (evidence) {
        const message = String(evidence.message || evidence.reason || "Category needs revision.").trim();
        chip.title = message;
        chip.setAttribute("aria-label", `${category}: ${message}`);
        const icon = document.createElement("span");
        icon.className = "super-admin-product-detail-modal__category-warning-icon";
        icon.innerHTML = createIconSvg(revisionWarningIconPaths);
        chip.append(icon);
      }
      list.append(chip);
    }
    return list;
  }

  function getProductDetailMediaYoloEvidence(product, item) {
    if (!item || item.type === "video") {
      return null;
    }

    const revision = getProductRevisionSignal(product);
    if (!revision) {
      return null;
    }

    const itemUrl = normalizeProductDetailEvidenceUrl(item.url);
    if (!itemUrl) {
      return null;
    }

    const matchingRevisionEvidence = findProductRevisionImageEvidence(revision, item.url);
    const evidenceUrls = [];
    appendProductDetailEvidenceUrls(evidenceUrls, revision);
    const inspection = product?.yoloInspection && typeof product.yoloInspection === "object"
      ? product.yoloInspection
      : {};
    appendProductDetailEvidenceUrls(evidenceUrls, inspection.revisionEvidence);
    if (Array.isArray(inspection.images)) {
      inspection.images.forEach((imageResult) => {
        const detections = Array.isArray(imageResult?.detections) ? imageResult.detections : [];
        const hasFlaggedDetection = detections.some((detection) => detection?.flagged === true);
        if (imageResult?.flagged === true || hasFlaggedDetection) {
          appendProductDetailEvidenceUrls(evidenceUrls, imageResult?.imageUrl || imageResult?.url);
        }
      });
    }
    const hasExactEvidenceUrl =
      Boolean(matchingRevisionEvidence) ||
      evidenceUrls.some((url) => url === itemUrl);

    if (!hasExactEvidenceUrl) {
      return null;
    }

    const matchType = String(matchingRevisionEvidence?.matchType || revision.matchType || "").trim().toLowerCase();
    const messageText = String(
      matchingRevisionEvidence?.message ||
        matchingRevisionEvidence?.reason ||
        revision.message ||
        revision.reason ||
        "",
    ).trim();
    const evidenceVisualLabel = String(
      matchingRevisionEvidence?.label ||
        (Array.isArray(matchingRevisionEvidence?.imageBuckets)
          ? matchingRevisionEvidence.imageBuckets.join(", ")
          : "") ||
        "",
    ).trim();
    const hasMediaMismatch = matchType.includes("media");
    const hasNameMismatch = matchType.includes("name") || /product\s+name/i.test(messageText);
    const hasCategoryMismatch = matchType.includes("category") || /\bcategory\b/i.test(messageText);
    const evidenceType = hasMediaMismatch
      ? "Media mismatch"
      : hasNameMismatch && hasCategoryMismatch
      ? "Product name/category mismatch"
      : hasNameMismatch
        ? "Product name mismatch"
        : hasCategoryMismatch
          ? "Category mismatch"
           : "YOLO evidence";
    return {
      label: evidenceVisualLabel ? `${evidenceType}: ${evidenceVisualLabel}` : evidenceType,
      message:
        messageText ||
        "YOLO detected that this image may not match the product name or category.",
    };
  }

  function normalizeYoloDetectionLabel(value) {
    const rawValue = value && typeof value === "object"
      ? value.label ?? value.className ?? value.class ?? value.name ?? value.object ?? value.tag
      : value;
    const label = String(rawValue || "").trim();
    if (!label || /^\d+$/.test(label)) {
      return "";
    }

    return label
      .replace(/[_-]+/g, " ")
      .replace(/\s+/g, " ")
      .split(" ")
      .map((part) => {
        const normalizedPart = part.trim();
        if (!normalizedPart) {
          return "";
        }
        return normalizedPart.length <= 2
          ? normalizedPart.toUpperCase()
          : `${normalizedPart.charAt(0).toUpperCase()}${normalizedPart.slice(1).toLowerCase()}`;
      })
      .filter(Boolean)
      .join(" ");
  }

  function appendUniqueLabel(labels, label) {
    const normalizedLabel = String(label || "").trim();
    if (
      normalizedLabel &&
      !labels.some((entry) => entry.toLowerCase() === normalizedLabel.toLowerCase())
    ) {
      labels.push(normalizedLabel);
    }
  }

  function getProductYoloDetectionLabels(product) {
    const labels = [];
    const inspection = product?.yoloInspection && typeof product.yoloInspection === "object"
      ? product.yoloInspection
      : {};
    const appendDetectionList = (detections) => {
      if (!Array.isArray(detections)) {
        return;
      }
      for (const detection of detections) {
        appendUniqueLabel(labels, normalizeYoloDetectionLabel(detection));
      }
    };

    appendDetectionList(inspection.detections);
    if (Array.isArray(inspection.images)) {
      for (const imageResult of inspection.images) {
        appendDetectionList(imageResult?.detections);
      }
    }

    return labels;
  }

  function getProductRejectedFallbackDetectionLabels(product) {
    const labels = [];
    const imageUrls = [
      product?.imageUrl,
      product?.mainImageUrl,
      product?.cardImageUrl,
      ...(Array.isArray(product?.imageUrls) ? product.imageUrls : []),
      ...(Array.isArray(product?.visualSearchImageUrls) ? product.visualSearchImageUrls : []),
      ...(Array.isArray(product?.yoloInspection?.imageUrls) ? product.yoloInspection.imageUrls : []),
    ];
    const haystack = [
      product?.name,
      product?.description,
      product?.sku,
      product?.brand,
      product?.model,
      ...imageUrls,
    ]
      .map((value) => String(value || "").toLowerCase())
      .join(" ");
    const keywordGroups = [
      { label: "Sexual product", patterns: [/\bsexual\b/, /\bsex\b/, /\badult\b/, /\bvibrator\b/, /\bdildo\b/, /\bcondom\b/] },
      { label: "Gun", patterns: [/\bgun\b/, /\bfirearm\b/, /\bweapon\b/, /\bpistol\b/, /\brifle\b/, /\bammo\b/] },
      { label: "Bottle", patterns: [/\bbottle\b/, /\bwater\b/, /\bdrink\b/, /\bbeverage\b/, /\bgluta\b/, /\bjuice\b/, /\bsoda\b/] },
      { label: "Box", patterns: [/\bbox\b/, /\bpackage\b/, /\bpack\b/, /\bcarton\b/] },
      { label: "Food", patterns: [/\bfood\b/, /\bmeal\b/, /\brice\b/, /\bburger\b/, /\bchicken\b/, /\bpizza\b/, /\bsnack\b/, /\bbread\b/] },
      { label: "Clothing", patterns: [/\bcloth\b/, /\bclothes\b/, /\bshirt\b/, /\bshorts\b/, /\bpants\b/, /\bdress\b/, /\bshoe\b/] },
      { label: "Medicine", patterns: [/\bmedicine\b/, /\bdrug\b/, /\bpill\b/, /\bcapsule\b/, /\bsupplement\b/, /\btablet\b/] },
      { label: "Cosmetic", patterns: [/\bcosmetic\b/, /\bbeauty\b/, /\bcream\b/, /\blotion\b/, /\bsoap\b/, /\bserum\b/] },
      { label: "Electronics", patterns: [/\belectronic\b/, /\bphone\b/, /\bcharger\b/, /\bcable\b/, /\bheadset\b/, /\bearphone\b/] },
    ];

    for (const group of keywordGroups) {
      if (group.patterns.some((pattern) => pattern.test(haystack))) {
        appendUniqueLabel(labels, group.label);
      }
    }

    return labels;
  }

  function getRejectedProductDetectionLabel(product) {
    const labels = getProductYoloDetectionLabels(product);
    if (!labels.length) {
      labels.push(...getProductRejectedFallbackDetectionLabels(product));
    }
    return labels.slice(0, 3).join(", ") || "Image evidence";
  }

  function getRejectedProductDateTimeLabel(product) {
    const value = product?.rejectedAt || product?.approvalUpdatedAt || product?.updatedAt || product?.createdAt || "";
    return formatDateTime(value);
  }

  function getApprovedProductDateTimeLabel(product) {
    const value =
      product?.yoloInspection?.approvedEvidence?.approvedAt ||
      product?.approvedAt ||
      product?.approvalUpdatedAt ||
      product?.updatedAt ||
      product?.createdAt ||
      "";
    return formatDateTime(value);
  }

  function getApprovedProductDetectionLabel(product) {
    const labels = getProductYoloDetectionLabels(product);
    if (!labels.length) {
      const evidenceName = String(product?.yoloInspection?.approvedEvidence?.productName || "").trim();
      if (evidenceName) {
        labels.push(evidenceName);
      }
    }
    if (!labels.length) {
      labels.push(...getProductRejectedFallbackDetectionLabels(product));
    }
    return labels.slice(0, 3).join(", ") || "Approved evidence";
  }

  function normalizeManualDetectionLabelInput(value) {
    return String(value || "")
      .replace(/\s+/g, " ")
      .trim();
  }

  function hasProductDetailValue(value) {
    if (value === null || value === undefined) {
      return false;
    }
    if (typeof value === "string") {
      return value.trim().length > 0;
    }
    if (typeof value === "number") {
      return Number.isFinite(value);
    }
    if (typeof value === "boolean") {
      return true;
    }
    if (Array.isArray(value)) {
      return value.some((item) => hasProductDetailValue(item));
    }
    if (typeof value === "object") {
      return Object.values(value).some((item) => hasProductDetailValue(item));
    }
    return true;
  }

  function formatProductDetailKeyLabel(key) {
    const words = String(key || "")
      .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
      .replace(/([A-Za-z])(\d)/g, "$1 $2")
      .replace(/(\d)([A-Za-z])/g, "$1 $2")
      .replace(/[_-]+/g, " ")
      .trim()
      .split(/\s+/)
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");
    return words
      .replace(/\bId\b/g, "ID")
      .replace(/\bUrl\b/g, "URL")
      .replace(/\bUrls\b/g, "URLs")
      .replace(/\bYolo\b/g, "YOLO")
      .replace(/\b3 D\b/g, "3D");
  }

  function formatProductDetailValue(value, fallback = "-") {
    if (!hasProductDetailValue(value)) {
      return fallback;
    }
    if (typeof value === "boolean") {
      return value ? "Yes" : "No";
    }
    if (typeof value === "number") {
      return Number.isFinite(value) ? value.toLocaleString() : fallback;
    }
    if (Array.isArray(value)) {
      return value
        .filter((item) => hasProductDetailValue(item))
        .map((item) => typeof item === "object" ? JSON.stringify(item) : String(item))
        .join(", ") || fallback;
    }
    if (typeof value === "object") {
      return JSON.stringify(value, null, 2);
    }
    return String(value || "").trim() || fallback;
  }

  function formatProductDetailDateTime(value, fallback = "-") {
    if (!hasProductDetailValue(value)) {
      return fallback;
    }
    const label = formatDateTime(value);
    return label === "No date" ? fallback : label;
  }

  function formatProductDetailDateDay(value, fallback = "-") {
    if (!hasProductDetailValue(value)) {
      return fallback;
    }
    const label = formatDateDay(value);
    return label === "No date" ? fallback : label;
  }

  function formatProductDetailMoney(value, fallback = "Not set") {
    if (!hasProductDetailValue(value)) {
      return fallback;
    }
    const amount = Number(value);
    return Number.isFinite(amount) ? moneyText(amount) : fallback;
  }

  function formatProductDetailPercent(value, fallback = "-") {
    const amount = Number(value);
    return Number.isFinite(amount) ? `${amount.toLocaleString()}%` : fallback;
  }

  function getProductDetailApprovalLabel(product) {
    const approvalStatus = String(product?.approvalStatus || "pending").trim().toLowerCase();
    if (approvalStatus === "approved") {
      return "Approved";
    }
    if (approvalStatus === "rejected") {
      return "Rejected";
    }
    return "In review";
  }

  function getProductDetailDiscountLabel(product) {
    const originalPrice = Number(product?.originalPrice ?? product?.price);
    const salesPrice = Number(product?.salesPrice);
    if (
      !Number.isFinite(originalPrice) ||
      originalPrice <= 0 ||
      !Number.isFinite(salesPrice) ||
      salesPrice < 0 ||
      salesPrice >= originalPrice
    ) {
      return "No discount";
    }
    const percent = Math.round(((originalPrice - salesPrice) / originalPrice) * 100);
    return `${percent}% off`;
  }

  function createProductDetailIcon(iconPath) {
    const icon = document.createElement("span");
    icon.className = "super-admin-product-detail-modal__icon";
    icon.innerHTML = createIconSvg(iconPath);
    return icon;
  }

  function createProductDetailChip(label, tone = "neutral") {
    const chip = document.createElement("span");
    chip.className = `super-admin-product-detail-modal__chip is-${tone}`;
    chip.textContent = String(label || "").trim() || "-";
    return chip;
  }

  function createProductDetailField(label, value, options = {}) {
    const row = document.createElement("div");
    row.className = "super-admin-product-detail-modal__field";
    row.classList.toggle("is-wide", options.wide === true);
    row.classList.toggle("is-multiline", options.multiline === true);
    row.classList.toggle("is-monospace", options.monospace === true);

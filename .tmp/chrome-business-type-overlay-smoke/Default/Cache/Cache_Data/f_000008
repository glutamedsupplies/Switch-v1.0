    const productView = normalizeProductRequestView(state.productRequestView);
    const canShowQuickMenu =
      card instanceof HTMLElement &&
      (card.dataset.approvalStatus === "rejected" || productView === "live");
    if (!canShowQuickMenu) {
      closeRejectedProductQuickMenu();

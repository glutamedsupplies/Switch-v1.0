    const setModalError = (message = "") => {
      if (!(errorElement instanceof HTMLElement)) {
        return;
      }
      errorElement.textContent = message;
      errorElement.hidden = !message;
    };

    const setSaving = (isSaving) => {
      overlay.dataset.saving = isSaving ? "true" : "false";
      for (const button of overlay.querySelectorAll("button")) {
        if (button instanceof HTMLButtonElement) {
          button.disabled = isSaving;
        }
      }
      if (saveButton instanceof HTMLButtonElement) {
        saveButton.classList.toggle("is-loading", isSaving);
        saveButton.disabled = isSaving || draftItems.length === 0;
        if (isSaving) {
          saveButton.setAttribute("aria-busy", "true");
        } else {
          saveButton.removeAttribute("aria-busy");
        }
      }
    };

    const syncUploadControls = () => {
      const atLimit = draftItems.length >= productImageUploadMaxCount;
      if (saveButton instanceof HTMLButtonElement) {
        saveButton.disabled = draftItems.length === 0 || overlay.dataset.saving === "true";
      }
      if (addMoreButton instanceof HTMLButtonElement) {
        addMoreButton.disabled = atLimit || overlay.dataset.saving === "true";
      }
    };

    const pickFiles = () => {
      if (overlay.dataset.saving === "true" || !(input instanceof HTMLInputElement)) {
        return;
      }
      input.click();
    };

    const removeDraftItem = (index) => {
      const item = draftItems[index];
      if (!item) {
        return;
      }
      if (item.objectUrl) {
        URL.revokeObjectURL(item.objectUrl);
        objectUrls.delete(item.objectUrl);
      }
      draftItems.splice(index, 1);
      renderUploadGrid();
    };

    function renderUploadGrid() {
      if (!(grid instanceof HTMLElement)) {
        return;
      }
      grid.innerHTML = "";
      draftItems.forEach((item, index) => {
        const tile = document.createElement("figure");
        tile.className = "super-admin-product-image-upload-modal__tile";
        tile.innerHTML = `
          <img src="${escapeHtml(item.objectUrl)}" alt="${escapeHtml(item.file.name || `Upload ${index + 1}`)}" />

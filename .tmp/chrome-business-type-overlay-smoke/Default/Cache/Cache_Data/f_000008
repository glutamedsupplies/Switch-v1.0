  // Loads company admin records from the backend and refreshes dependent UI state.
  async function loadAdmins() {
    state.loading = true;
    setFeedback("Loading companies...");
    try {
      const response = await fetch("/api/super-admin/admins", {
        cache: "no-store",
        headers: rootHeaders({
          Accept: "application/json",
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to load companies.");
      }

      state.admins = Array.isArray(data.admins) ? data.admins : [];

      // Load followers count for each admin
      await loadFollowersCountForAdmins();

      renderAdmins(state.admins);
      if (
        state.productRequests.length > 0 ||
        state.rejectedProductRequests.length > 0 ||
        state.approvedProductRequests.length > 0 ||
        state.liveProductRequests.length > 0
      ) {
        renderProductRequests();
      }
      setFeedback("");
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : "Unable to load companies.", "error");
    } finally {
      state.loading = false;
    }
  }

  // Merges freshly loaded company records with local follower counts.
  function mergeCompanyAdminSnapshots(nextAdmins) {
    const existingById = new Map(
      state.admins.map((admin) => [getCompanyId(admin), admin]),
    );
    return (Array.isArray(nextAdmins) ? nextAdmins : []).map((admin) => {
      const adminId = getCompanyId(admin);
      const existingAdmin = existingById.get(adminId);
      return {
        ...admin,
        followersCount: Number(admin?.followersCount ?? existingAdmin?.followersCount ?? 0),
      };
    });
  }

  // Reads the presence-only signature used to avoid unnecessary list rerenders.
  function getCompanyPresenceRenderSignature(admins) {
    return (Array.isArray(admins) ? admins : [])
      .map((admin) => [
        getCompanyId(admin),
        isCompanyAdminOnline(admin) ? "1" : "0",
        getCompanyLastLoginAt(admin),
        admin?.presenceUpdatedAt ?? "",
        admin?.onlineStatus ?? "",
        admin?.presenceStatus ?? "",
        getCompanyAccountState(admin),
      ].join(":"))
      .join("|");
  }

  // Checks whether a company action menu is currently open.
  function hasOpenCompanyActionMenu() {
    return Boolean(document.querySelector(".super-admin-company-card__action-dropdown.is-open"));
  }

  // Captures an open company action menu before a list rebuild so idle refreshes do not hide it.
  function getOpenCompanyActionMenuSnapshot() {
    const dropdown = document.querySelector(".super-admin-company-card__action-dropdown.is-open");
    if (!(dropdown instanceof HTMLElement)) {
      return null;
    }

    const card = dropdown.closest(".super-admin-company-card");
    const menu = dropdown.querySelector("[data-company-action-menu]");
    if (!(card instanceof HTMLElement) || !(menu instanceof HTMLElement)) {
      return null;
    }

    const menuRect = menu.getBoundingClientRect();
    const isCursorPositioned = menu.classList.contains("is-cursor-positioned");
    const isOpenUp = menu.classList.contains("is-open-up");
    return {
      companyId: String(card.dataset.companyId || "").trim(),
      isCursorPositioned,
      cursorPosition: isCursorPositioned
        ? {
            clientX: menuRect.left + menuRect.width / 2,
            clientY: isOpenUp ? menuRect.bottom + 10 : menuRect.top - 10,
          }
        : null,
    };
  }

  // Restores an open company action menu after the list has been refreshed.
  function restoreOpenCompanyActionMenuSnapshot(snapshot) {
    if (!snapshot?.companyId || !(elements.list instanceof HTMLElement)) {
      return;
    }

    const card = Array.from(elements.list.querySelectorAll(".super-admin-company-card"))
      .find((candidate) =>
        candidate instanceof HTMLElement &&
        String(candidate.dataset.companyId || "").trim() === snapshot.companyId,
      );
    if (!(card instanceof HTMLElement)) {
      return;
    }

    const dropdown = card.querySelector(".super-admin-company-card__action-dropdown");
    const toggle = dropdown?.querySelector("[data-company-action-menu-toggle]");
    if (!(dropdown instanceof HTMLElement)) {
      return;
    }

    syncCompanyActionItemsForSelection(card, snapshot.companyId);
    setCompanyActionMenuOpen(
      dropdown,
      true,
      snapshot.isCursorPositioned && snapshot.cursorPosition
        ? { cursorPosition: snapshot.cursorPosition }
        : { anchorElement: toggle },
    );
  }

  // Refreshes company live presence without showing a full loading state.
  async function refreshCompanyPresenceSnapshot() {
    if (
      document.hidden ||
      state.loading ||
      state.activeSection !== "companies" ||
      companyPresenceRefreshInFlight
    ) {
      return;
    }

    companyPresenceRefreshInFlight = true;
    const previousSignature = getCompanyPresenceRenderSignature(state.admins);
    try {
      const response = await fetch("/api/super-admin/admins", {
        cache: "no-store",
        headers: rootHeaders({
          Accept: "application/json",
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to refresh company presence.");
      }

      state.admins = mergeCompanyAdminSnapshots(data.admins);
      renderCompanyStats(state.admins);
      const nextSignature = getCompanyPresenceRenderSignature(state.admins);
      if (nextSignature !== previousSignature && !hasOpenCompanyActionMenu()) {
        renderAdmins(state.admins);
      }
    } catch (error) {
      console.warn(error instanceof Error ? error.message : "Unable to refresh company presence.");
    } finally {
      companyPresenceRefreshInFlight = false;
    }
  }

  // Refreshes admin followers counts without rebuilding unrelated state.
  async function refreshAdminFollowersCounts() {
    if (document.hidden || state.loading || state.activeSection !== "companies" || !state.admins.length) {
      return;
    }

    await loadFollowersCountForAdmins();
    if (hasOpenCompanyActionMenu()) {
      renderCompanyStats(state.admins);
      return;
    }
    renderAdmins(state.admins);
  }

  // Normalizes company action target ids before comparison or storage.
  function normalizeCompanyActionTargetIds(adminIds) {
    return Array.from(
      new Set(
        (Array.isArray(adminIds) ? adminIds : [adminIds])
          .map((adminId) => String(adminId || "").trim())
          .filter(Boolean),
      ),
    );
  }


  function updateIntegratedPartnerSummary(config, partners) {
    const records = Array.isArray(partners) ? partners : [];
    const total = records.length;
    const active = records.filter(readIntegratedEnabledFlag).length;
    const inactive = Math.max(0, total - active);
    const activePercent = total ? (active / total) * 100 : 0;
    const inactivePercent = total ? (inactive / total) * 100 : 0;

    if (config.total) config.total.textContent = `(${numberText(total)})`;
    if (config.stats?.total) config.stats.total.textContent = numberText(total);
    if (config.stats?.active) config.stats.active.textContent = numberText(active);
    if (config.stats?.inactive) config.stats.inactive.textContent = numberText(inactive);
    if (config.stats?.activePercent) config.stats.activePercent.textContent = `${activePercent.toFixed(1)}%`;
    if (config.stats?.inactivePercent) config.stats.inactivePercent.textContent = `${inactivePercent.toFixed(1)}%`;
  }


  // Builds a status row for loading, error, and empty activity states.
  function createCompanyActivityStatusRow(message, options = {}) {
    const row = document.createElement("div");
    row.className = `super-admin-company-activity-log__status${options.error ? " is-error" : ""}`;
    row.setAttribute("role", "row");
    const text = document.createElement("span");
    text.textContent = message;
    row.append(text);
    if (options.retryAdminId) {
      const retryButton = document.createElement("button");
      retryButton.type = "button";
      retryButton.className = "super-admin-company-activity-log__retry";
      retryButton.textContent = "Retry";
      retryButton.addEventListener("click", () => {
        void loadCompanyActivityLogs(options.retryAdminId, { force: true });
      });
      row.append(retryButton);
    }
    return row;
  }

  // Builds the company activity table used inside the modal.
  function createCompanyActivityTable(admin) {
    const adminId = getCompanyId(admin);
    const rows = getCompanyActivityRows(adminId);
    const isLoading = companyActivityLogsLoading.has(adminId);
    const errorMessage = companyActivityLogsErrors.get(adminId) || "";
    const table = document.createElement("div");
    table.className = "super-admin-company-activity-log__table";
    table.setAttribute("role", "table");
    table.setAttribute("aria-label", `Activity logs for ${getCompanyName(admin)}`);
    const header = document.createElement("div");
    header.className = "super-admin-company-activity-log__row super-admin-company-activity-log__row--header";
    header.setAttribute("role", "row");
    ["Activity", "User", "Details", "IP Address", "Date & Time"].forEach((label) => {
      const cell = document.createElement("div");
      cell.className = "super-admin-company-activity-log__cell";
      cell.setAttribute("role", "columnheader");
      cell.textContent = label;
      header.append(cell);
    });
    table.append(header);

    if (errorMessage) {
      table.append(createCompanyActivityStatusRow(errorMessage, { error: true, retryAdminId: adminId }));
    } else if (isLoading && !rows.length) {
      table.append(createCompanyActivityStatusRow("Loading activity logs..."));
    } else if (!rows.length) {
      table.append(createCompanyActivityStatusRow("No seller activity logs yet."));
    } else {
      rows.forEach((activity) => table.append(createCompanyActivityRow(activity)));
    }

    return table;
  }

  // Updates the activity modal body.
  function renderCompanyActivityModalContent(admin, modalBody) {
    if (!(modalBody instanceof HTMLElement)) {
      return;
    }

    modalBody.innerHTML = "";
    modalBody.append(createCompanyActivityTable(admin));
  }

  // Handles keyboard shortcuts for the activity modal.
  function handleCompanyActivityModalKeydown(event) {
    if (event.key !== "Escape") {
      return;
    }

    event.preventDefault();
    closeCompanyActivityModal();
  }

  // Closes the company activity modal and restores focus when possible.
  function closeCompanyActivityModal(options = {}) {
    if (!(activeCompanyActivityModal instanceof HTMLElement)) {
      return;
    }

    const modal = activeCompanyActivityModal;
    activeCompanyActivityModal = null;
    modal.remove();
    document.removeEventListener("keydown", handleCompanyActivityModalKeydown);
    document.body.classList.remove("super-admin-company-activity-modal-open");

    if (options.restoreFocus !== false && activeCompanyActivityModalTrigger instanceof HTMLElement) {
      activeCompanyActivityModalTrigger.focus();
    }
    activeCompanyActivityModalTrigger = null;
  }

  // Opens the company activity logs in a standalone modal.
  function openCompanyActivityModal(adminId, options = {}) {
    const normalizedAdminId = String(adminId || "").trim();
    const admin = findCompanyById(normalizedAdminId);
    if (!admin) {
      setFeedback("Company activity logs are not available yet.", "error");
      return;
    }

    closeCompanyActivityModal({ restoreFocus: false });
    activeCompanyActivityModalTrigger = document.activeElement instanceof HTMLElement
      ? document.activeElement
      : null;

    const companyName = getCompanyName(admin);
    const titleId = `super-admin-company-activity-modal-title-${Date.now()}`;
    const overlay = document.createElement("div");
    overlay.className = "super-admin-company-activity-modal-overlay";
    overlay.dataset.companyActivityAdminId = getCompanyId(admin);
    overlay.innerHTML = `
      <section class="super-admin-company-activity-modal" role="dialog" aria-modal="true" aria-labelledby="${titleId}" tabindex="-1">
        <button type="button" class="super-admin-company-activity-modal__close" aria-label="Close activity logs" title="Close">
          ${createCloseIconSvg()}
        </button>
        <header class="super-admin-company-activity-modal__header">
          <span class="super-admin-company-activity-modal__icon" aria-hidden="true">
            ${createActivityLibraryIconSvg({ lucide: "History", tabler: "history", fallback: activityActionIconPaths.activity })}
          </span>
          <span class="super-admin-company-activity-modal__title-copy">
            <h2 id="${titleId}">Activity Logs</h2>
            <span>${escapeHtml(companyName)}</span>
          </span>
        </header>
        <div class="super-admin-company-activity-modal__body" data-company-activity-modal-body></div>
      </section>
    `;

    const modalBody = overlay.querySelector("[data-company-activity-modal-body]");
    const closeButton = overlay.querySelector(".super-admin-company-activity-modal__close");
    const dialog = overlay.querySelector(".super-admin-company-activity-modal");
    activeCompanyActivityModal = overlay;
    document.body.append(overlay);
    document.body.classList.add("super-admin-company-activity-modal-open");
    renderCompanyActivityModalContent(admin, modalBody);

    closeButton?.addEventListener("click", () => closeCompanyActivityModal());
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) {
        closeCompanyActivityModal();
      }
    });
    document.addEventListener("keydown", handleCompanyActivityModalKeydown);
    window.setTimeout(() => {
      dialog?.focus?.();
    }, 0);

    if (options.force === true || !companyActivityLogsByAdminId.has(normalizedAdminId)) {
      void loadCompanyActivityLogs(normalizedAdminId, { force: options.force === true });
    }
  }


  function normalizeSortValues(value, normalizeValue, fallbackValue) {
    const rawValues = Array.isArray(value) ? value : [value];
    const normalizedValues = [];
    const seenValues = new Set();

    for (const rawValue of rawValues) {
      const normalizedValue = normalizeValue(rawValue);
      if (!seenValues.has(normalizedValue)) {
        seenValues.add(normalizedValue);
        normalizedValues.push(normalizedValue);
      }
    }

    const nonFallbackValues = normalizedValues.filter((normalizedValue) => normalizedValue !== fallbackValue);
    return nonFallbackValues.length ? nonFallbackValues : (normalizedValues.length ? normalizedValues : [fallbackValue]);
  }

  function readCheckedSortValues(selector, normalizeValue, fallbackValue) {
    const checkedValues = Array.from(document.querySelectorAll(`${selector}:checked`))
      .filter((control) => control instanceof HTMLInputElement)
      .map((control) => control.value);
    return normalizeSortValues(checkedValues.length ? checkedValues : [fallbackValue], normalizeValue, fallbackValue);
  }

  function setSortControlsChecked(selector, values, normalizeValue, fallbackValue) {
    const normalizedValues = normalizeSortValues(values, normalizeValue, fallbackValue);
    const selectedValues = new Set(normalizedValues);
    const controls = Array.from(document.querySelectorAll(selector))
      .filter((control) => control instanceof HTMLInputElement);
    let hasCheckedControl = false;

    for (const control of controls) {
      control.checked = selectedValues.has(normalizeValue(control.value));
      hasCheckedControl = hasCheckedControl || control.checked;
    }

    const fallbackControl = controls.find((control) => normalizeValue(control.value) === fallbackValue);
    if (
      fallbackControl?.checked &&
      controls.some((control) => control !== fallbackControl && control.checked)
    ) {
      fallbackControl.checked = false;
      hasCheckedControl = controls.some((control) => control.checked);
    }

    if (!hasCheckedControl) {
      if (fallbackControl) {
        fallbackControl.checked = true;
      }
    }
  }

  function enforceSortCheckboxFallback(selector, changedControl, normalizeValue, fallbackValue) {
    const controls = Array.from(document.querySelectorAll(selector))
      .filter((control) => control instanceof HTMLInputElement);
    const fallbackControl = controls.find((control) => normalizeValue(control.value) === fallbackValue);

    if (
      changedControl instanceof HTMLInputElement &&
      changedControl.checked &&
      normalizeValue(changedControl.value) !== fallbackValue &&
      fallbackControl
    ) {
      fallbackControl.checked = false;
    }

    if (
      changedControl instanceof HTMLInputElement &&
      changedControl.checked &&
      normalizeValue(changedControl.value) === fallbackValue
    ) {
      for (const control of controls) {
        if (control !== changedControl) {
          control.checked = false;
        }
      }
    }

    if (
      fallbackControl?.checked &&
      controls.some((control) => control !== fallbackControl && control.checked)
    ) {
      fallbackControl.checked = false;
    }

    if (!controls.some((control) => control.checked) && fallbackControl) {
      fallbackControl.checked = true;
    }
  }

  function isDefaultSortSelection(values, normalizeValue, fallbackValue) {
    const normalizedValues = normalizeSortValues(values, normalizeValue, fallbackValue);
    return normalizedValues.length === 1 && normalizedValues[0] === fallbackValue;
  }

  // Keeps super admin nav toggle label synchronized with current state.
  function syncSuperAdminNavToggleLabel() {
    if (!elements.navToggle) {
      return;
    }
    const isOpen = document.body.classList.contains("super-admin-nav-open");
    const label = isOpen ? "Close navigation" : "Open navigation";
    elements.navToggle.setAttribute("aria-expanded", String(isOpen));
    elements.navToggle.setAttribute("aria-label", label);
    elements.navToggle.title = label;
  }


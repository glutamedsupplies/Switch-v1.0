    const spacing = 8;
    const rect = menu.getBoundingClientRect();
    const maxLeft = Math.max(spacing, window.innerWidth - rect.width - spacing);
    const maxTop = Math.max(spacing, window.innerHeight - rect.height - spacing);
    const left = Math.min(Math.max(spacing, Number(x) || spacing), maxLeft);
    const top = Math.min(Math.max(spacing, Number(y) || spacing), maxTop);
    menu.style.left = `${left}px`;
    menu.style.top = `${top}px`;
  }


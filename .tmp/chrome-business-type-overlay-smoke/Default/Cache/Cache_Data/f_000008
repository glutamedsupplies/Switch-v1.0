    const partners = Array.isArray(state[config.stateKey]) ? state[config.stateKey] : [];
    return partners.find((candidate) =>
      getIntegratedPartnerId(candidate).toLowerCase() === normalizedId.toLowerCase()
    ) || null;
  }


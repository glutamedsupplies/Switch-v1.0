  // Reads the current seller warning count used for 1-3 restriction level display.
  function getCompanyWarningCount(admin) {
    const countSources = [
      admin?.restrictionWarningCount,
      admin?.restrictionLevelCount,
      admin?.restrictedLevelCount,
      admin?.superAdminWarningCount,
      admin?.warningCount,
      admin?.warnings,
    ];
    let warningCount = 0;

    for (const source of countSources) {
      const numericValue = Array.isArray(source) ? source.length : Number(source);
      if (Number.isFinite(numericValue)) {
        warningCount = Math.max(warningCount, Math.trunc(numericValue));
      }
    }

    return Math.max(0, Math.min(3, warningCount));
  }

  // Converts a 1-3 warning count into the shared restriction level descriptor.
  function getCompanyRestrictionLevelFromWarningCount(warningCount) {
    const normalizedCount = Math.max(0, Math.min(3, Math.trunc(Number(warningCount) || 0)));
    if (normalizedCount >= 3) {
      return { label: "High", tone: "danger", meter: 3 };
    }
    if (normalizedCount === 2) {
      return { label: "Medium", tone: "warning", meter: 2 };
    }
    if (normalizedCount === 1) {
      return { label: "Low", tone: "warning", meter: 1 };
    }
    return { label: "Low", tone: "neutral", meter: 1 };
  }

  // Reads or derives company restriction badge text for the current super admin flow.
  function getCompanyRestrictionBadgeText(admin) {
    if (getCompanyAccountState(admin) !== "restricted") {
      return "";
    }
    const expiresAt = getCompanyRestrictExpiresAt(admin);
    const remainingMs = expiresAt ? expiresAt.getTime() - Date.now() : 0;
    if (!Number.isFinite(remainingMs) || remainingMs <= 0) {
      return "Restricted";
    }
    const totalSeconds = Math.max(0, Math.ceil(remainingMs / 1000));
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    return `Restricted - ${hours}h ${minutes}m ${seconds}s left`;

    setCompanyBanDurationUnitDropdownOpen(!isOpen);
  });

  for (const option of elements.companyBanDurationUnitOptions) {
    option.addEventListener("click", () => {
      setCompanyBanDurationUnit(option.dataset.superAdminBanDurationUnitOption, { dispatchChange: true });
      setCompanyBanDurationUnitDropdownOpen(false);
      elements.companyBanDurationUnitTrigger?.focus?.();
    });
  }

  elements.companyBanDurationUnit?.addEventListener("change", () => {
    syncCompanyBanModalDuration();
    syncCompanyBanDurationUnitDropdown();
  });

  elements.companyRestrictionLimitTrigger?.addEventListener("click", (event) => {
    event.preventDefault();
    if (elements.companyRestrictionLimitTrigger.disabled) {
      return;
    }
    const isOpen = elements.companyRestrictionLimitTrigger.getAttribute("aria-expanded") === "true";
    setCompanyRestrictionLimitDropdownOpen(!isOpen);
  });

  elements.storeTypeModalCloseButton?.addEventListener("click", () => {
    closeStoreTypeModal();
  });

  elements.storeTypeModalOverlay?.addEventListener("click", (event) => {
    if (event.target === elements.storeTypeModalOverlay) {
      closeStoreTypeModal();
    }
  });

  elements.storeTypeCategoryModalCloseButton?.addEventListener("click", () => {
    setStoreTypeCategoryModalOpen(false);
  });

  elements.storeTypeCategoryModalOverlay?.addEventListener("click", (event) => {
    if (event.target === elements.storeTypeCategoryModalOverlay) {
      setStoreTypeCategoryModalOpen(false);
    }
  });

  elements.paymentPartnerModalCloseButton?.addEventListener("click", () => {
    if (!paymentPartnerModalSaving) {
      setPaymentPartnerModalOpen(false);
    }
  });

  elements.paymentPartnerModalCancelButton?.addEventListener("click", () => {
    if (!paymentPartnerModalSaving) {
      setPaymentPartnerModalOpen(false);
    }
  });

  elements.paymentPartnerModalOverlay?.addEventListener("click", (event) => {
    if (event.target === elements.paymentPartnerModalOverlay && !paymentPartnerModalSaving) {
      setPaymentPartnerModalOpen(false);
    }
  });

  elements.deliveryPartnerModalCloseButton?.addEventListener("click", () => {
    if (!deliveryPartnerModalSaving) {
      setDeliveryPartnerModalOpen(false);
    }
  });

  elements.deliveryPartnerModalCancelButton?.addEventListener("click", () => {
    if (!deliveryPartnerModalSaving) {
      setDeliveryPartnerModalOpen(false);
    }
  });

  elements.deliveryPartnerModalOverlay?.addEventListener("click", (event) => {
    if (event.target === elements.deliveryPartnerModalOverlay && !deliveryPartnerModalSaving) {
      setDeliveryPartnerModalOpen(false);
    }
  });

  elements.deliveryPartnerApiKeyModalCloseButton?.addEventListener("click", () => {
    if (!deliveryPartnerApiKeyModalSaving) {
      setDeliveryPartnerApiKeyModalOpen(false);
    }
  });

  elements.deliveryPartnerApiKeyModalCancelButton?.addEventListener("click", () => {
    if (!deliveryPartnerApiKeyModalSaving) {
      setDeliveryPartnerApiKeyModalOpen(false);
    }
  });

  elements.deliveryPartnerApiKeyModalOverlay?.addEventListener("click", (event) => {
    if (event.target === elements.deliveryPartnerApiKeyModalOverlay && !deliveryPartnerApiKeyModalSaving) {
      setDeliveryPartnerApiKeyModalOpen(false);
    }
  });

  elements.validationModalOverlay?.addEventListener("click", (event) => {
    if (event.target === elements.validationModalOverlay && validationModalAllowOverlayClose) {
      closeValidationModal(false);
    }
  });

  document.addEventListener("wheel", handleUserDataActionWheel, {
    capture: true,
    passive: true,
  });
  document.addEventListener("pointermove", clearUserDataQuickActionWheelSuppression, {
    passive: true,
  });
  document.addEventListener("wheel", blockCategoryDrawerBackgroundScroll, {
    capture: true,
    passive: false,
  });
  document.addEventListener("wheel", blockSuperAdminNavOpenWheel, {
    capture: true,
    passive: false,
  });
  document.addEventListener("wheel", () => {
    if (hasOpenCompanyActionMenu()) {
      closeCompanyActionMenus();
    }
  }, {
    capture: true,
    passive: true,
  });
  document.addEventListener("touchmove", blockCategoryDrawerBackgroundScroll, {
    capture: true,
    passive: false,
  });
  document.addEventListener("keydown", blockCategoryDrawerBackgroundKeyScroll, true);
  document.addEventListener("scroll", closeUserDataActionMenusForWheel, true);
  document.addEventListener("scroll", scheduleBusinessTypeFloatingMenuPosition, true);
  window.addEventListener("scroll", scheduleBusinessTypeFloatingMenuPosition, { passive: true });
  window.addEventListener("resize", scheduleBusinessTypeFloatingMenuPlacementRefresh, { passive: true });
  window.visualViewport?.addEventListener("scroll", scheduleBusinessTypeFloatingMenuPosition, { passive: true });
  window.visualViewport?.addEventListener("resize", scheduleBusinessTypeFloatingMenuPlacementRefresh, { passive: true });

  document.addEventListener("click", (event) => {
    const clickedButton = event.target instanceof Element
      ? event.target.closest("button")
      : null;
    if (clickedButton instanceof HTMLButtonElement) {
      closeInlineStoreTypeEditForExternalButton(clickedButton);
    }
  }, true);

  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Node &&
      !Array.from(document.querySelectorAll("[data-business-type-action-dropdown]")).some((dropdown) =>
        dropdown instanceof HTMLElement && dropdown.contains(event.target)
      )
    ) {
      closeBusinessTypeActionMenus();
    }

    if (
      elements.companyBanReasonTrigger?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      elements.companyBanReasonDropdown instanceof HTMLElement &&
      !elements.companyBanReasonDropdown.contains(event.target)
    ) {
      setCompanyBanReasonDropdownOpen(false);
    }

    if (
      elements.companyBanDurationUnitTrigger?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      elements.companyBanDurationUnitDropdown instanceof HTMLElement &&
      !elements.companyBanDurationUnitDropdown.contains(event.target)
    ) {
      setCompanyBanDurationUnitDropdownOpen(false);
    }

    if (
      elements.companyRestrictionReasonTrigger?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      elements.companyRestrictionReasonDropdown instanceof HTMLElement &&
      !elements.companyRestrictionReasonDropdown.contains(event.target)
    ) {
      setCompanyRestrictionReasonDropdownOpen(false);
    }

    if (
      elements.companyRestrictionLimitTrigger?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      elements.companyRestrictionLimitDropdown instanceof HTMLElement &&
      !elements.companyRestrictionLimitDropdown.contains(event.target)
    ) {
      setCompanyRestrictionLimitDropdownOpen(false);
    }

    const isWithinCategoryTrigger = getCategoryTriggerButtons().some((button) =>
      isEventWithinElement(event, button)
    );
    const isWithinStoreTypeTrigger = getStoreTypeTriggerButtons().some((button) =>
      isEventWithinElement(event, button)
    );
    if (
      isCategoryDrawerVisible()
      && !isEventWithinElement(event, elements.categoryPanel)
      && !isWithinCategoryTrigger
    ) {
      setCategoryDrawerOpen(false);
    }
    if (
      isStoreTypeDrawerVisible()
      && !isEventWithinElement(event, elements.storeTypePanel)
      && !isWithinStoreTypeTrigger
    ) {
      setStoreTypeDrawerOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isDeliveryPartnerApiKeyModalVisible()) {
      event.preventDefault();
      if (!deliveryPartnerApiKeyModalSaving) {
        setDeliveryPartnerApiKeyModalOpen(false);
      }
      return;
    }

    if (event.key === "Escape" && isDeliveryPartnerModalVisible()) {
      event.preventDefault();
      if (!deliveryPartnerModalSaving) {
        setDeliveryPartnerModalOpen(false);
      }
      return;
    }

    if (event.key === "Escape" && isPaymentPartnerModalVisible()) {
      event.preventDefault();
      if (!paymentPartnerModalSaving) {
        setPaymentPartnerModalOpen(false);
      }
      return;
    }

    if (
      event.key === "Escape" &&
      document.querySelector("[data-business-type-action-dropdown].is-open")
    ) {
      event.preventDefault();
      closeBusinessTypeActionMenus();
      return;
    }

    if (
      event.key === "Escape" &&
      elements.companyBanReasonTrigger?.getAttribute("aria-expanded") === "true"
    ) {
      event.preventDefault();
      setCompanyBanReasonDropdownOpen(false);
      elements.companyBanReasonTrigger?.focus?.();
      return;
    }

    if (
      event.key === "Escape" &&
      elements.companyBanDurationUnitTrigger?.getAttribute("aria-expanded") === "true"
    ) {
      event.preventDefault();
      setCompanyBanDurationUnitDropdownOpen(false);
      elements.companyBanDurationUnitTrigger?.focus?.();
      return;
    }

    if (
      event.key === "Escape" &&
      elements.companyRestrictionReasonTrigger?.getAttribute("aria-expanded") === "true"
    ) {
      event.preventDefault();
      setCompanyRestrictionReasonDropdownOpen(false);
      elements.companyRestrictionReasonTrigger?.focus?.();
      return;
    }

    if (
      event.key === "Escape" &&
      elements.companyRestrictionLimitTrigger?.getAttribute("aria-expanded") === "true"
    ) {
      event.preventDefault();
      setCompanyRestrictionLimitDropdownOpen(false);
      elements.companyRestrictionLimitTrigger?.focus?.();
      return;
    }

    if (
      event.key === "Escape" &&
      elements.companyBanModalDialog instanceof HTMLElement &&
      !elements.companyBanModalDialog.hidden
    ) {
      event.preventDefault();
      closeCompanyBanModal(null);
      return;
    }

    if (
      event.key === "Escape" &&
      elements.validationModalOverlay instanceof HTMLElement &&
      !elements.validationModalOverlay.hidden
    ) {
      event.preventDefault();
      if (!validationModalAllowManualClose) {
        return;
      }
      closeValidationModal(false);
      return;
    }

    if (event.key === "Escape" && isStoreTypeCategoryModalVisible()) {
      event.preventDefault();
      setStoreTypeCategoryModalOpen(false);
      return;
    }

    if (event.key === "Escape" && isStoreTypeModalVisible()) {
      event.preventDefault();
      closeStoreTypeModal();
      return;
    }

    if (event.key === "Escape" && isCategoryDrawerVisible()) {
      setCategoryDrawerOpen(false, { restoreFocus: true });
    }
    if (event.key === "Escape" && isStoreTypeDrawerVisible()) {
      setStoreTypeDrawerOpen(false, { restoreFocus: true });
    }
  });

  const initialHashSection = String(window.location.hash || "").replace(/^#/, "");
  if (sectionNames.has(initialHashSection)) {
    state.activeSection = initialHashSection;
  }
  setSuperAdminNavOpen(getSavedSuperAdminNavOpen(), { persist: false });
  syncPlatformSettingToggles();
  syncPlatformSettingsSearch();
  setActiveSection(state.activeSection);
  syncCompanyViewButtons();
  syncCompanyFilterControlsFromState();
  syncCompanyFilterSummary();
  syncStoreTypeFilterSummary();
  syncProductRequestFilterSummary();
  void loadAdmins();
  void loadProductRequests({ quiet: true });
  void loadStoreTypes({ quiet: true });
  window.setInterval(() => {
    void refreshAdminFollowersCounts();
  }, 15000);
  window.setInterval(() => {
    void refreshCompanyPresenceSnapshot();
  }, companyPresenceRefreshIntervalMs);
  window.addEventListener("focus", () => {
    void refreshCompanyPresenceSnapshot();
  });
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) {
      void refreshCompanyPresenceSnapshot();
    }
  });
  window.setInterval(refreshCompanyBanCountdowns, 1000);
})();

  async function commitInlineStoreTypeCategoryNameEdit(storeTypeName, categoryName, input, options = {}) {
    if (!(input instanceof HTMLInputElement) || input.dataset.inlineSaving === "true") {
      return;
    }
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    const previousCategoryName = normalizeCategoryName(categoryName);
    const nextCategoryName = normalizeCategoryName(input.value);
    const storeTypeRecord = getStoreTypeRecordByName(normalizedStoreTypeName);
    if (!storeTypeRecord || !previousCategoryName) {
      return;
    }
    if (!nextCategoryName) {
      setFeedback("Enter a category name first.", "error");
      input.focus();
      return;
    }
    const duplicateCategory = storeTypeRecord.categories.some((existingCategory) =>
      !isSameCategoryName(existingCategory, previousCategoryName) &&
      isSameCategoryName(existingCategory, nextCategoryName)
    );
    if (duplicateCategory) {
      setFeedback("Category already exists in this business type.", "error");
      input.focus();
      input.select();
      return;
    }
    input.value = nextCategoryName;
    if (isSameCategoryName(previousCategoryName, nextCategoryName)) {
      if (options.exitAfterSave) {
        state.inlineEditingCategoryStoreTypeName = "";
        state.inlineEditingCategoryName = "";
        renderStoreTypes();
      }
      return;
    }

    const categoryDetails = getStoreTypeCategoryDetailsForSave(storeTypeRecord).map((detail) =>
      isSameCategoryName(detail.name, previousCategoryName)
        ? { ...detail, name: nextCategoryName }
        : detail,
    );
    const categories = storeTypeRecord.categories.map((existingCategory) =>
      isSameCategoryName(existingCategory, previousCategoryName)
        ? nextCategoryName
        : existingCategory,
    );
    input.dataset.inlineSaving = "true";
    await saveInlineStoreTypePatch(
      normalizedStoreTypeName,
      { categories, categoryDetails },
      {
        focusTarget: input,
        inlineCategoryName: options.exitAfterSave ? "" : nextCategoryName,
        pendingMessage: "Updating category...",
        successMessage: "Category updated.",
      },
    );
    delete input.dataset.inlineSaving;
  }


    });
  }

  elements.productRequestList?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const quickMenuTrigger = event.target.closest("[data-product-quick-menu-trigger]");
    if (quickMenuTrigger instanceof HTMLButtonElement) {
      const card = quickMenuTrigger.closest(".super-admin-product-request-card");
      if (card instanceof HTMLElement) {
        const triggerRect = quickMenuTrigger.getBoundingClientRect();
        event.preventDefault();
        event.stopPropagation();
        closeProductRequestMenus();
        openRejectedProductQuickMenu(card, triggerRect.right - 8, triggerRect.bottom + 8);
      }
      return;
    }

    const menuToggle = event.target.closest("[data-product-request-menu-toggle]");
    if (menuToggle instanceof HTMLButtonElement) {
      const actions = menuToggle.closest(".super-admin-product-request-card__actions");
      const shouldOpen = menuToggle.getAttribute("aria-expanded") !== "true";
      closeProductRequestMenus(actions);
      setProductRequestMenuOpen(actions, shouldOpen);
      event.stopPropagation();
      return;
    }

    const actionButton = event.target.closest("[data-product-request-action]");
    if (actionButton instanceof HTMLButtonElement) {
      const action = actionButton.dataset.productRequestAction;
      const productId = actionButton.dataset.productId;
      closeProductRequestMenus();
      event.stopPropagation();
      if (action === "details") {
        showProductRequestDetails(productId, actionButton);
        return;
      }
      if (action === "cancel") {
        void cancelProductRequest(productId, actionButton);
        return;
      }
      if (action === "revision") {
        void requestProductRevision(productId, actionButton);
        return;
      }
      if (action === "inspect") {
        void inspectProductRequestImages(productId, actionButton);
        return;
      }
      if (action === "edit-detection") {
        void editProductDetectionLabel(productId, actionButton);
        return;
      }
      if (action === "approve") {
        void approveProductRequest(productId, actionButton);
        return;
      }
      if (action === "delete-ui") {
        void deleteProductRequest(productId, actionButton);
        return;
      }
      return;
    }

    const companyNameTrigger = event.target.closest(".super-admin-product-request-card__company-name-trigger");
    if (companyNameTrigger instanceof HTMLElement) {
      const card = companyNameTrigger.closest(".super-admin-product-request-card");
      const companyId = String(card?.dataset.companyId || "").trim();
      if (companyId) {
        event.preventDefault();
        event.stopPropagation();
        closeProductRequestMenus();
        closeRejectedProductQuickMenu();
        setSelectedCompanies([companyId], { activeCompanyId: companyId });
        openCompanyDrawer(companyId);
        return;
      }
    }

    if (event.target.closest("button, a, input, select, textarea, label, summary")) {
      return;
    }

    const card = event.target.closest(".super-admin-product-request-card");
    if (card instanceof HTMLElement) {
      const view = normalizeProductRequestView(state.productRequestView);
      if (view === "approved" || view === "rejected") {
        return;
      }
      closeProductRequestMenus();
      closeRejectedProductQuickMenu();
      showProductRequestDetails(card.dataset.productId, card);
    }
  });

  elements.productRequestList?.addEventListener("keydown", (event) => {
    if (!(event.target instanceof Element)) {
      return;

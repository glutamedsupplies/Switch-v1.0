      event.preventDefault();
      event.stopPropagation();

      const action = actionButton.dataset.productDetailAction;
      const actionProductId = actionButton.dataset.productId || productId;
      void (async () => {
        let completed = false;
        if (action === "approve") {
          completed = await approveProductRequest(actionProductId, actionButton) === true;

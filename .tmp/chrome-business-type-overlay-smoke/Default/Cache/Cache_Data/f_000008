  // Appends company control review row to the target DOM list.
  function appendCompanyControlReviewRow(list, label, value) {
    if (!(list instanceof HTMLElement)) {
      return;
    }
    const row = document.createElement("div");
    const term = document.createElement("dt");
    const description = document.createElement("dd");
    term.textContent = label;
    description.textContent = String(value || "-");
    row.append(term, description);
    list.append(row);
  }

  // Reads or derives company restriction review description for the current super admin flow.
  function getCompanyRestrictionReviewDescription(admin, reason) {
    const companyName = getCompanyName(admin);
    const adminSubject = `${companyName} admin account`;
    const possessiveAdminSubject = /s$/i.test(adminSubject) ? `${adminSubject}'` : `${adminSubject}'s`;
    const source = String(
      admin?.restrictionDescription ??
        admin?.restrictDescription ??
        admin?.restriction_description ??
        admin?.restrict_description ??
        "",
    )
      .replace(/\s+/g, " ")
      .trim();
    const description = source || `${adminSubject} was restricted because of ${reason}.`;
    return description
      .replace(/\byou\s+are\b/gi, `${adminSubject} is`)
      .replace(/\byou['`]?re\b/gi, `${adminSubject} is`)
      .replace(/\byou\s+have\b/gi, `${adminSubject} has`)
      .replace(/\byou['`]?ve\b/gi, `${adminSubject} has`)
      .replace(/\byour\s+account\b/gi, adminSubject)
      .replace(/\byour\s+company\b/gi, companyName)
      .replace(/\byour\b/gi, possessiveAdminSubject)
      .replace(/\byou\b/gi, adminSubject);
  }

  // Updates company control modal review and synchronizes related UI state.
  function setCompanyControlModalReview(admins, mode) {
    const review = elements.companyControlModalReview;
    const reviewTitle = elements.companyControlModalReviewTitle;
    const reviewList = elements.companyControlModalReviewList;
    const normalizedMode = String(mode || "").trim().toLowerCase();
    const shouldReview = normalizedMode === "unban" || normalizedMode === "unrestrict";
    if (!(review instanceof HTMLElement) || !(reviewList instanceof HTMLElement)) {
      return;
    }

    review.hidden = !shouldReview;
    reviewList.innerHTML = "";
    if (!shouldReview) {
      return;
    }

    const entries = Array.isArray(admins) ? admins.filter(Boolean) : [];
    const admin = entries[0] || null;
    const isBulk = entries.length > 1;
    const title = normalizedMode === "unrestrict" ? "Restriction Review" : "Ban Review";
    if (reviewTitle instanceof HTMLElement) {
      reviewTitle.textContent = isBulk ? `${title} (${numberText(entries.length)} selected)` : title;
    }

    if (!admin) {
      appendCompanyControlReviewRow(reviewList, "Reason", "No review details available.");
      return;
    }

    if (normalizedMode === "unrestrict") {
      const reason = String(
        admin?.restrictionReason ?? admin?.restrictReason ?? admin?.restriction_reason ?? admin?.restrict_reason ?? "",
      ).trim() || "No restriction reason provided.";
      const description = getCompanyRestrictionReviewDescription(admin, reason);
      const restrictedAt = admin?.restrictedAt ?? admin?.restricted_at ?? admin?.statusUpdatedAt ?? "";
      const restrictedBy = String(admin?.restrictedBy ?? admin?.restricted_by ?? "Super Admin").trim() || "Super Admin";
      const expiresAt = getCompanyRestrictExpiresAt(admin);
      const limitLabels = getCompanyRestrictionLimitLabels(admin);
      appendCompanyControlReviewRow(reviewList, "Reason", reason);
      appendCompanyControlReviewRow(reviewList, "Description", description);
      appendCompanyControlReviewRow(reviewList, "Limited Access", limitLabels.length ? limitLabels.join(", ") : "No access limits recorded.");
      appendCompanyControlReviewRow(
        reviewList,
        "Restricted",
        `${restrictedAt ? formatDateTime(restrictedAt) : "Unknown date"} by ${restrictedBy}`,
      );
      if (expiresAt) {
        appendCompanyControlReviewRow(reviewList, "Expires", formatDateTime(expiresAt));
      }
      return;
    }

    const reason = String(
      admin?.banReason ?? admin?.lastBanReason ?? admin?.ban_reason ?? admin?.last_ban_reason ?? "",
    ).trim() || "No ban reason provided.";
    const description = String(
      admin?.banDescription ?? admin?.banDetails ?? admin?.ban_description ?? admin?.ban_details ?? "",
    ).trim() || "No description provided.";
    const bannedAt = admin?.bannedAt ?? admin?.lastBannedAt ?? admin?.banned_at ?? admin?.last_banned_at ?? "";
    const bannedBy = String(admin?.bannedBy ?? admin?.lastBannedBy ?? admin?.banned_by ?? admin?.last_banned_by ?? "Super Admin").trim() || "Super Admin";
    appendCompanyControlReviewRow(reviewList, "Reason", reason);
    appendCompanyControlReviewRow(reviewList, "Description", description);
    appendCompanyControlReviewRow(
      reviewList,
      "Banned",
      `${bannedAt ? formatDateTime(bannedAt) : "Unknown date"} by ${bannedBy}`,
    );
  }

  // Opens the shared ban, unban, restrict, and unrestrict review modal.
  function showCompanyBanModal(adminIds, mode = "ban") {
    const normalizedAdminIds = normalizeCompanyActionTargetIds(adminIds);
    if (
      !normalizedAdminIds.length ||
      !(elements.companyBanModalOverlay instanceof HTMLElement) ||
      !(elements.companyBanModalDialog instanceof HTMLElement)
    ) {
      return Promise.resolve(null);
    }

    if (typeof companyBanModalResolve === "function") {
      closeCompanyBanModal(null);
    }

    const isBulk = normalizedAdminIds.length > 1;
    const normalizedMode = String(mode || "").trim().toLowerCase();
    const isRestrict = normalizedMode === "restrict";
    const isUnban = normalizedMode === "unban";
    const isUnrestrict = normalizedMode === "unrestrict";
    companyControlModalMode = isUnrestrict ? "unrestrict" : isUnban ? "unban" : isRestrict ? "restrict" : "ban";
    const primaryAdmin = findCompanyById(normalizedAdminIds[0]);
    const companyName = isBulk
      ? `${numberText(normalizedAdminIds.length)} selected companies`
      : primaryAdmin
        ? getCompanyName(primaryAdmin)
        : getCompanyActionTargetLabel(normalizedAdminIds);
    const targetAdmins = normalizedAdminIds
      .map((adminId) => findCompanyById(adminId))
      .filter(Boolean);
    const metrics = getCompanyBanMetrics(targetAdmins.length ? targetAdmins : primaryAdmin ? [primaryAdmin] : []);

    if (elements.companyBanModalTitle instanceof HTMLElement) {
      elements.companyBanModalTitle.textContent = isUnrestrict
        ? isBulk ? "Review restrictions before unrestricting?" : "Unrestrict company?"
        : isUnban
        ? isBulk ? "Unban selected companies?" : "Unban company?"
        : isRestrict
        ? isBulk ? "Restrict selected companies?" : "Restrict company?"
        : isBulk ? "Ban selected companies?" : "Ban company?";
    }
    if (elements.companyBanModalCopy instanceof HTMLElement) {
      elements.companyBanModalCopy.textContent = isUnrestrict
        ? `${companyName} will regain restricted admin features after review.`
        : isUnban
        ? `${companyName} will regain access to admin and seller sign in.`
        : isRestrict
        ? `${companyName} will have selected admin features limited temporarily.`
        : `${companyName} will be permanently blocked from admin sign in.`;
    }
    if (elements.companyControlModalNotice instanceof HTMLElement) {
      elements.companyControlModalNotice.textContent = isUnrestrict
        ? "Review why this company was restricted before removing the restriction."
        : isUnban
        ? "Confirm that this company should be allowed to sign in again."
        : isRestrict
        ? "Set the duration, reason, and access limits for this restriction."
        : "Pick the reason for permanently banning this company.";
    }
    if (elements.companyControlModalIcon instanceof HTMLElement) {
      elements.companyControlModalIcon.innerHTML = createIconSvg(
        isUnban || isUnrestrict ? companyCardIconPaths.unban : isRestrict ? companyCardIconPaths.restrict : companyCardIconPaths.ban,
      );
    }
    if (elements.companyBanModalCloseButton instanceof HTMLButtonElement) {
      const closeLabel = isUnrestrict ? "Close unrestrict modal" : isUnban ? "Close unban modal" : isRestrict ? "Close restrict modal" : "Close ban modal";
      elements.companyBanModalCloseButton.setAttribute("aria-label", closeLabel);
      elements.companyBanModalCloseButton.title = closeLabel;
    }
    if (elements.companyBanModalName instanceof HTMLElement) {
      elements.companyBanModalName.textContent = companyName;
    }
    if (elements.companyBanModalMeta instanceof HTMLElement) {
      elements.companyBanModalMeta.textContent = isBulk
        ? "Bulk admin account action"
        : primaryAdmin?.email || getCompanyId(primaryAdmin) || "Admin account";
    }
    if (elements.companyBanModalTags instanceof HTMLElement) {
      elements.companyBanModalTags.innerHTML = "";
      elements.companyBanModalTags.append(
        createCompanyBanTag(
          `${numberText(metrics.reports)} reports`,
          "caution",
          companyCardIconPaths.reviews,
        ),
        createCompanyBanTag(
          `${numberText(metrics.violations)} violations`,
          "red",
          revisionWarningIconPaths,
        ),
        createCompanyBanTag(
          `${metrics.rating > 0 ? metrics.rating.toFixed(1) : "0.0"} rating`,
          "blue",
          companyCardIconPaths.rating,
        ),
      );
    }

    setCompanyBanModalAvatar(primaryAdmin);
    setCompanyControlModalReview(targetAdmins.length ? targetAdmins : primaryAdmin ? [primaryAdmin] : [], companyControlModalMode);

    if (elements.companyBanDurationInput instanceof HTMLInputElement) {
      elements.companyBanDurationInput.value = "24";
    }
    if (elements.companyBanReasonInput instanceof HTMLTextAreaElement) {
      elements.companyBanReasonInput.value = "";
    }
    if (elements.companyRestrictionReasonPicker instanceof HTMLSelectElement) {
      setCompanyRestrictionReason("");
    }
    if (elements.companyRestrictionDescriptionInput instanceof HTMLTextAreaElement) {
      elements.companyRestrictionDescriptionInput.value = "";
    }
    for (const option of elements.companyRestrictionLimitOptions) {
      if (option instanceof HTMLInputElement) {
        option.checked = false;
      }
    }
    setCompanyRestrictionLimitDropdownOpen(false);
    setCompanyRestrictionReasonDropdownOpen(false);
    syncCompanyRestrictionLimitDropdown();
    if (elements.companyBanReasonPicker instanceof HTMLSelectElement) {
      setCompanyBanReason("");
    }
    setCompanyBanDurationUnit("hours");
    if (elements.companyBanModalConfirmButton instanceof HTMLButtonElement) {
      elements.companyBanModalConfirmButton.textContent = isUnrestrict
        ? isBulk ? "Unrestrict Selected" : "Unrestrict Company"
        : isUnban
        ? isBulk ? "Unban Selected" : "Unban Company"
        : isRestrict
        ? isBulk ? "Restrict Selected" : "Restrict Company"
        : isBulk ? "Ban Selected" : "Ban Company";
      elements.companyBanModalConfirmButton.disabled = false;
    }
    syncCompanyBanModalDuration();

    elements.companyBanModalOverlay.hidden = false;
    elements.companyBanModalOverlay.classList.add("is-visible");
    elements.companyBanModalOverlay.setAttribute("aria-hidden", "false");
    elements.companyBanModalDialog.hidden = false;
    elements.companyBanModalDialog.classList.add("is-visible");
    elements.companyBanModalDialog.classList.toggle("is-restrict", isRestrict);
    elements.companyBanModalDialog.classList.toggle("is-unban", isUnban);
    elements.companyBanModalDialog.classList.toggle("is-unrestrict", isUnrestrict);

    window.setTimeout(() => {
      if (isUnban || isUnrestrict) {
        elements.companyBanModalConfirmButton?.focus?.();
      } else if (isRestrict) {
        elements.companyBanDurationInput?.focus?.();
      } else {
        elements.companyBanReasonTrigger?.focus?.();
      }
    }, 0);

    return new Promise((resolve) => {
      companyBanModalResolve = resolve;
    });
  }

  // Applies company control action result to state and UI.
  function applyCompanyControlActionResult(admin, action) {
    if (!admin || typeof admin !== "object") {
      return admin;
    }
    const normalizedAction = String(action || "").trim().toLowerCase();
    if (normalizedAction !== "unrestrict") {
      return admin;
    }
    return {
      ...admin,
      status: "active",
      accountStatus: "active",
      accountState: "active",
      adminStatus: "active",
      userStatus: "active",
      isActive: true,
      disabled: false,
      isRestricted: false,
      restricted: false,

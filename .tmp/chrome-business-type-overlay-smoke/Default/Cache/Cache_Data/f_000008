        title: isRevisionRequested ? "Revision sent" : "Request revision",
        icon: '<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"></path>',
        disabled: isRevisionRequested,
      }),
      createActionButton({
        action: "approve",
        labelText: `Approve ${productName}`,
        title: "Approve",
        icon: '<path d="m5 12 4 4L19 6"></path>',

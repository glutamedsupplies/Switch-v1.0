  function syncPlatformSettingsSearch() {
    const searchTerm = String(state.settingsSearchTerm || "").trim().toLowerCase();
    let visibleGroupCount = 0;

    for (const group of elements.platformSettingGroups) {
      const headingText = String(group.querySelector("h3")?.textContent || "").trim().toLowerCase();
      const groupMatches = Boolean(searchTerm) && headingText.includes(searchTerm);
      let visibleToggleCount = 0;

      for (const toggleRow of Array.from(group.querySelectorAll(".super-admin-settings-toggle"))) {
        const labelText = String(toggleRow.querySelector("span:first-child")?.textContent || "").trim().toLowerCase();
        const keyText = String(toggleRow.querySelector("[data-platform-setting-toggle]")?.dataset.platformSettingToggle || "").trim().toLowerCase();
        const shouldShowToggle = !searchTerm || groupMatches || labelText.includes(searchTerm) || keyText.includes(searchTerm);
        toggleRow.hidden = !shouldShowToggle;
        if (shouldShowToggle) {
          visibleToggleCount += 1;
        }
      }

      group.hidden = Boolean(searchTerm) && visibleToggleCount === 0;
      if (!group.hidden) {
        visibleGroupCount += 1;
      }
    }

    if (elements.platformSettingEmpty) {
      elements.platformSettingEmpty.hidden = visibleGroupCount > 0;

  // Reads cached activity rows for a company drawer.
  function getCompanyActivityRows(adminId) {
    const normalizedAdminId = String(adminId || "").trim();
    return companyActivityLogsByAdminId.get(normalizedAdminId) || [];
  }

  // Re-renders the activity modal if it is currently showing this company.
  function refreshCompanyActivityModal(adminId) {
    const normalizedAdminId = String(adminId || "").trim();
    if (!normalizedAdminId || !(activeCompanyActivityModal instanceof HTMLElement)) {
      return;
    }

    if (String(activeCompanyActivityModal.dataset.companyActivityAdminId || "").trim() !== normalizedAdminId) {
      return;
    }

    const admin = findCompanyById(normalizedAdminId);
    const modalBody = activeCompanyActivityModal.querySelector("[data-company-activity-modal-body]");
    if (admin && modalBody instanceof HTMLElement) {
      renderCompanyActivityModalContent(admin, modalBody);
    }
  }

  // Loads company activity rows from the super admin endpoint.
  async function loadCompanyActivityLogs(adminId, options = {}) {
    const normalizedAdminId = String(adminId || "").trim();
    if (!normalizedAdminId || companyActivityLogsLoading.has(normalizedAdminId)) {
      return;
    }
    if (!options.force && companyActivityLogsByAdminId.has(normalizedAdminId)) {
      return;
    }

    companyActivityLogsLoading.add(normalizedAdminId);
    companyActivityLogsErrors.delete(normalizedAdminId);
    refreshCompanyActivityModal(normalizedAdminId);

    try {
      const response = await fetch(
        `/api/super-admin/admins/${encodeURIComponent(normalizedAdminId)}/activity?limit=50`,
        {
          headers: rootHeaders({ Accept: "application/json" }),
        },
      );
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data?.message || "Unable to load activity logs.");
      }

      companyActivityLogsByAdminId.set(
        normalizedAdminId,
        Array.isArray(data?.activities) ? data.activities : [],
      );
    } catch (error) {
      companyActivityLogsErrors.set(
        normalizedAdminId,
        error instanceof Error ? error.message : "Unable to load activity logs.",
      );
    } finally {
      companyActivityLogsLoading.delete(normalizedAdminId);
      refreshCompanyActivityModal(normalizedAdminId);
    }
  }

  function getActivityActionTone(kind) {
    const normalizedKind = String(kind || "").trim().toLowerCase();
    if (
      normalizedKind.startsWith("add-") ||
      normalizedKind.includes("-added") ||
      normalizedKind.includes("created") ||
      normalizedKind.includes("upload")
    ) {
      return "add";
    }
    if (
      normalizedKind.startsWith("delete-") ||
      normalizedKind.startsWith("remove-") ||
      normalizedKind.includes("deleted") ||
      normalizedKind.includes("removed") ||
      normalizedKind.includes("cancel")
    ) {
      return "delete";
    }
    if (
      normalizedKind.startsWith("edit-") ||
      normalizedKind.startsWith("change-") ||
      normalizedKind.startsWith("update-") ||
      normalizedKind.includes("updated") ||
      normalizedKind.includes("edited") ||
      normalizedKind.includes("profile")
    ) {
      return "edit";
    }
    return "";
  }

  function createActivityLibraryIconSvg(config) {
    const icons = typeof window !== "undefined" && window.lucide?.icons
      ? window.lucide.icons
      : {};
    if (
      config?.lucide &&
      Array.isArray(icons[config.lucide]) &&
      typeof window !== "undefined" &&
      window.lucide?.createElement
    ) {
      const svgElement = window.lucide.createElement(icons[config.lucide], {
        "aria-hidden": "true",
        focusable: "false",
      });
      svgElement.setAttribute("viewBox", "0 0 24 24");
      svgElement.setAttribute("fill", "none");
      svgElement.setAttribute("stroke", "currentColor");
      svgElement.setAttribute("stroke-width", "2");
      svgElement.setAttribute("stroke-linecap", "round");
      svgElement.setAttribute("stroke-linejoin", "round");
      return svgElement.outerHTML;
    }

    const tablerPath = config?.tabler && typeof window !== "undefined"
      ? window.tablerIcons?.icons?.[config.tabler] || ""
      : "";
    return createIconSvg(tablerPath || config?.fallback || activityActionIconPaths.activity);
  }

  function createCompanyActivityIconSvg(kind) {
    const normalizedKind = String(kind || "").trim().toLowerCase();
    const actionTone = getActivityActionTone(kind);
    if (normalizedKind.includes("employee") && actionTone && employeeActivityActionIconConfigs[actionTone]) {
      return createActivityLibraryIconSvg(employeeActivityActionIconConfigs[actionTone]);
    }
    if (actionTone && activityActionIconConfigs[actionTone]) {
      return createActivityLibraryIconSvg(activityActionIconConfigs[actionTone]);
    }
    return createIconSvg(getCompanyActivityIconPath(kind));
  }

  // Reads the icon for each company activity kind.
  function getCompanyActivityIconPath(kind) {
    const normalizedKind = String(kind || "").trim().toLowerCase();
    const actionTone = getActivityActionTone(normalizedKind);
    if (normalizedKind.includes("employee") && actionTone === "add") {
      return activityActionIconPaths.employeeAdd;
    }
    if (normalizedKind.includes("employee") && actionTone === "edit") {
      return activityActionIconPaths.employeeEdit;
    }
    if (normalizedKind.includes("employee") && actionTone === "delete") {
      return activityActionIconPaths.employeeDelete;
    }
    if (actionTone === "add") {
      return activityActionIconPaths.addList;
    }
    if (actionTone === "edit") {
      return activityActionIconPaths.editList;
    }
    if (actionTone === "delete") {
      return activityActionIconPaths.trash;
    }
    if (normalizedKind.includes("employee")) {
      return companyCardIconPaths.employees;
    }
    if (normalizedKind.includes("product")) {
      return companyCardIconPaths.listings;
    }
    if (normalizedKind.includes("rating")) {
      return companyCardIconPaths.rating;
    }
    if (normalizedKind.includes("password")) {
      return '<rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>';
    }
    if (normalizedKind.includes("profile")) {
      return companyCardIconPaths.contact;
    }
    if (normalizedKind.includes("business")) {
      return companyBuildingIconPaths;
    }
    if (normalizedKind.includes("report")) {
      return '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path>';
    }
    return activityActionIconPaths.activity;
  }

  // Formats the date and time columns for activity rows.
  function getCompanyActivityDateParts(value) {
    const date = new Date(value || "");
    if (!Number.isFinite(date.getTime())) {
      return ["Unknown date", ""];
    }

    return [
      date.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
      }),
      date.toLocaleTimeString(undefined, {
        hour: "2-digit",
        minute: "2-digit",
      }),
    ];
  }

  // Builds a single company activity row.
  function createCompanyActivityRow(activity) {
    const row = document.createElement("div");
    row.className = "super-admin-company-activity-log__row";
    row.setAttribute("role", "row");

    const activityCell = document.createElement("div");
    activityCell.className = "super-admin-company-activity-log__cell super-admin-company-activity-log__cell--activity";
    activityCell.setAttribute("role", "cell");

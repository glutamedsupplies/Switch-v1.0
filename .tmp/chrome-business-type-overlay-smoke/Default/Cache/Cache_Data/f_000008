    }
    elements.storeTypeBreadcrumb.textContent = normalizeCategoryName(
      state.selectedStoreTypeNavName,
    ) || "All";
  }

  // Opens the business type section from a sidebar sub button and focuses that type.
  function handleStoreTypeSubNavClick(storeTypeName) {
    const normalizedStoreTypeName = normalizeCategoryName(storeTypeName);
    if (!normalizedStoreTypeName) {
      return;
    }

    state.selectedStoreTypeNavName = normalizedStoreTypeName;
    syncStoreTypeBreadcrumb();
    renderStoreTypeSubNav(state.storeTypes);
    if (state.activeSection !== "store-types") {
      setActiveSection("store-types");
    }

    window.setTimeout(() => {
      focusStoreTypeShowcase(normalizedStoreTypeName);
    }, 80);
  }

  // Keeps the Business Type sidebar sub buttons synchronized with saved labels.
  function renderStoreTypeSubNav(storeTypes = state.storeTypes) {
    if (!elements.storeTypeSubNav) {
      return;
    }

    const nextStoreTypes = normalizeStoreTypeValues(storeTypes);
    elements.storeTypeSubNav.innerHTML = "";

    if (
      state.selectedStoreTypeNavName &&
      !nextStoreTypes.some((storeType) => isSameStoreTypeName(storeType, state.selectedStoreTypeNavName))
    ) {
      state.selectedStoreTypeNavName = "";
    }
    syncStoreTypeBreadcrumb();

    if (!nextStoreTypes.length) {
      const emptyItem = document.createElement("span");
      emptyItem.className = "super-admin-company-status-nav__item super-admin-store-type-subnav__empty";
      emptyItem.innerHTML = '<span class="super-admin-company-status-nav__dot" aria-hidden="true"></span><span>No business types</span>';
      elements.storeTypeSubNav.append(emptyItem);
      return;
    }

    for (const storeTypeName of nextStoreTypes) {
      const storeTypeRecord = getStoreTypeRecordByName(storeTypeName);
      const button = document.createElement("button");
      button.type = "button";
      button.className = "super-admin-company-status-nav__item super-admin-store-type-subnav__item";
      button.dataset.superAdminStoreTypeShortcut = storeTypeName;
      button.setAttribute("aria-pressed", isSameStoreTypeName(storeTypeName, state.selectedStoreTypeNavName) ? "true" : "false");
      button.title = storeTypeRecord?.categories.length
        ? `${storeTypeName} - ${numberText(storeTypeRecord.categories.length)} categories`
        : storeTypeName;

      const dot = document.createElement("span");
      dot.className = "super-admin-company-status-nav__dot";
      dot.setAttribute("aria-hidden", "true");

      const label = document.createElement("span");
      label.textContent = storeTypeName;

      button.classList.toggle("is-active", isSameStoreTypeName(storeTypeName, state.selectedStoreTypeNavName));
      button.append(dot, label);
      button.addEventListener("click", () => handleStoreTypeSubNavClick(storeTypeName));
      elements.storeTypeSubNav.append(button);
    }
  }

  // Opens category management scoped to one business type.
  function focusStoreTypeCategoryEditor(storeTypeName, { categoryName = "", focusInput = true } = {}) {
    setStoreTypeCategoryModalOpen(true, { storeTypeName, categoryName, focusInput });
  }

  function scrollBusinessTypeCategoryCarousel(categoryGrid, direction = 1) {
    if (!(categoryGrid instanceof HTMLElement)) {
      return;
    }
    const firstCard = categoryGrid.querySelector(".business-type-showcase__category-card");
    const computedStyle = window.getComputedStyle(categoryGrid);
    const gap = Number.parseFloat(computedStyle.columnGap || computedStyle.gap || "12") || 12;
    const cardWidth = firstCard instanceof HTMLElement
      ? firstCard.getBoundingClientRect().width
      : categoryGrid.clientWidth / 10;
    const visibleCount = Number.parseInt(
      computedStyle.getPropertyValue("--business-type-category-count"),
      10,
    ) || 8;
    const scrollAmount = Math.max(cardWidth + gap, (cardWidth + gap) * visibleCount);
    categoryGrid.scrollBy({
      left: scrollAmount * (direction < 0 ? -1 : 1),
      behavior: "smooth",
    });
  }


  // Supports the number text branch of the super admin UI.
  function numberText(value) {
    const numberValue = Number(value);
    return Number.isFinite(numberValue) ? numberValue.toLocaleString() : "0";
  }

  // Supports the money text branch of the super admin UI.
  function moneyText(value) {
    const numberValue = Number(value);
    return Number.isFinite(numberValue)
      ? `\u20B1 ${numberValue.toLocaleString(undefined, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        })}`
      : "\u20B1 0.00";
  }

  // Formats date time for display.
  function formatDateTime(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) {
      return "No date";
    }

    return date.toLocaleString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  }

  // Formats relative time for display.
  function formatRelativeTime(value) {
    const date = new Date(value);
    const timestamp = date.getTime();
    if (Number.isNaN(timestamp)) {
      return "Never";
    }

    const elapsedSeconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
    if (elapsedSeconds < 45) {
      return "Just now";
    }

    const units = [
      ["year", 31536000],
      ["month", 2592000],
      ["day", 86400],
      ["hour", 3600],
      ["min", 60],
    ];

    for (const [unit, seconds] of units) {
      const amount = Math.floor(elapsedSeconds / seconds);
      if (amount >= 1) {
        return `${numberText(amount)} ${unit}${amount === 1 ? "" : "s"} ago`;
      }
    }

    return "Just now";
  }

  // Formats short relative time for display.
  function formatShortRelativeTime(value) {
    const date = new Date(value);
    const timestamp = date.getTime();
    if (Number.isNaN(timestamp)) {
      return "Never";
    }

    const elapsedSeconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
    if (elapsedSeconds < 45) {
      return "now";
    }

    const units = [
      ["y", 31536000],
      ["mo", 2592000],
      ["d", 86400],
      ["h", 3600],
      ["m", 60],
    ];

    for (const [unit, seconds] of units) {
      const amount = Math.floor(elapsedSeconds / seconds);
      if (amount >= 1) {
        return `${numberText(amount)}${unit} ago`;
      }
    }

    return "now";
  }


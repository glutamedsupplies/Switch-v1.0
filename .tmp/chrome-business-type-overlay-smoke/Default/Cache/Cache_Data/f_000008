        ? document.activeElement
        : elements.deliveryPartnerAddButton;
      deliveryPartnerApiKeyModalScrollSnapshot = getSuperAdminScrollSnapshot();
      if (elements.deliveryPartnerApiKeyModalInput instanceof HTMLInputElement) {
        elements.deliveryPartnerApiKeyModalInput.value = "";
        elements.deliveryPartnerApiKeyModalInput.placeholder = partner?.hasApiKey || partner?.apiKeyMasked
          ? "Enter a replacement API key"
          : "Enter API key";
      }
      if (elements.deliveryPartnerApiKeyModalSubtitle) {
        elements.deliveryPartnerApiKeyModalSubtitle.textContent = `Set the API key for ${getIntegratedPartnerName(partner)}.`;
      }
      setDeliveryPartnerApiKeyModalFeedback("");
      setDeliveryPartnerApiKeyModalSaving(false);
      overlay.hidden = false;
      overlay.setAttribute("aria-hidden", "false");
      window.requestAnimationFrame(() => overlay.classList.add("is-open"));
      deliveryPartnerApiKeyModalFocusTimer = window.setTimeout(() => {
        deliveryPartnerApiKeyModalFocusTimer = 0;
        focusWithoutScroll(elements.deliveryPartnerApiKeyModalInput || elements.deliveryPartnerApiKeyModalDialog);
        restoreSuperAdminScrollSnapshot(deliveryPartnerApiKeyModalScrollSnapshot);
      }, 90);
      return;
    }

    overlay.classList.remove("is-open");
    overlay.setAttribute("aria-hidden", "true");
    restoreSuperAdminScrollSnapshot(deliveryPartnerApiKeyModalScrollSnapshot);
    deliveryPartnerApiKeyModalCloseTimer = window.setTimeout(() => {
      overlay.hidden = true;
      deliveryPartnerApiKeyModalCloseTimer = 0;
      if (elements.deliveryPartnerApiKeyModalInput instanceof HTMLInputElement) {
        elements.deliveryPartnerApiKeyModalInput.value = "";
      }
      setDeliveryPartnerApiKeyModalFeedback("");
      deliveryPartnerApiKeyModalPartnerId = "";
      if (restoreFocus) {
        focusWithoutScroll(deliveryPartnerApiKeyModalTrigger || elements.deliveryPartnerAddButton);
      }
      restoreSuperAdminScrollSnapshotStable(deliveryPartnerApiKeyModalScrollSnapshot);
      deliveryPartnerApiKeyModalScrollSnapshot = null;
      deliveryPartnerApiKeyModalTrigger = null;
    }, 180);
  }

  async function saveDeliveryPartnerApiKeyFromModal() {
    if (deliveryPartnerApiKeyModalSaving) {
      return;
    }
    const apiKey = String(elements.deliveryPartnerApiKeyModalInput?.value || "").trim();
    if (!apiKey) {
      setDeliveryPartnerApiKeyModalFeedback("Enter the delivery partner API key.");
      elements.deliveryPartnerApiKeyModalInput?.focus();
      return;
    }
    const partner = findIntegratedPartner("delivery", deliveryPartnerApiKeyModalPartnerId);
    if (!partner) {
      setDeliveryPartnerApiKeyModalFeedback("Delivery partner could not be found.");
      return;
    }

    setDeliveryPartnerApiKeyModalSaving(true);
    try {
      const response = await fetch(`/api/delivery-partners/${encodeURIComponent(deliveryPartnerApiKeyModalPartnerId)}`, {
        method: "PATCH",
        headers: rootHeaders({
          Accept: "application/json",
          "Content-Type": "application/json",
        }),
        body: JSON.stringify({ apiKey }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || "Unable to update the API key.");
      }
      await loadIntegratedPartners("delivery", { quiet: true });
      setFeedback(data.message || `API key updated for ${getIntegratedPartnerName(partner)}.`, "success");
      setDeliveryPartnerApiKeyModalOpen(false, { restoreFocus: true });
    } catch (error) {
      setDeliveryPartnerApiKeyModalFeedback(
        error instanceof Error ? error.message : "Unable to update the API key.",
      );
    } finally {
      setDeliveryPartnerApiKeyModalSaving(false);
    }
  }

  // Loads integrated partners data and updates local state.
  async function loadIntegratedPartners(type, { quiet = false } = {}) {
    const config = getIntegratedPartnerConfig(type);
    state[config.loadingKey] = true;
    if (!quiet) {
      setFeedback(`Loading ${config.pluralLabel.toLowerCase()}...`);
    }
    try {
      const response = await fetch(config.endpoint, {
        cache: "no-store",
        headers: rootHeaders({ Accept: "application/json" }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || `Unable to load ${config.pluralLabel.toLowerCase()}.`);
      }
      state[config.stateKey] = Array.isArray(data.partners) ? data.partners : [];
      renderIntegratedPartners(type);
      if (!quiet) setFeedback("");
    } catch (error) {
      renderIntegratedPartners(type);
      setFeedback(error instanceof Error ? error.message : `Unable to load ${config.pluralLabel.toLowerCase()}.`, "error");
    } finally {
      state[config.loadingKey] = false;
    }

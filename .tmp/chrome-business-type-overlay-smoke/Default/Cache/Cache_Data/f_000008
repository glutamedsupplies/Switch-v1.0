    for (const subNav of elements.sidebarSubNavs) {
      const targetSection = subNav.dataset.superAdminSubnav;
      const shouldHide = targetSection === "services"
        ? !serviceSectionNames.has(state.activeSection)
        : targetSection !== state.activeSection ||
          (targetSection === "companies" && Boolean(state.companyStatusNavCollapsed));

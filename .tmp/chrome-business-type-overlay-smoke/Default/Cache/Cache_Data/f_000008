      return lucideCategoryIconOptionsCache.options;
    }

    const seen = new Set();
    const options = [];
    const sourceEntries = iconCount
      ? Object.keys(icons).map((exportName) => [getLucideIconSlug(exportName), exportName])
      : Object.keys(lucideCategoryIconPaths).map((iconName) => [iconName, ""]);

    for (const [iconName, exportName] of sourceEntries) {
      if (!iconName || seen.has(iconName)) {
        continue;
      }
      seen.add(iconName);
      options.push({
        iconName,
        exportName,
        source: "lucide",
        label: formatLucideCategoryIconLabel(iconName),
      });
    }

    for (const iconName of tablerIconNames) {
      const optionName = `tabler:${iconName}`;
      if (!iconName || seen.has(optionName)) {
        continue;
      }
      seen.add(optionName);
      options.push({
        iconName: optionName,
        exportName: "",
        source: "tabler",
        label: `Tabler ${formatLucideCategoryIconLabel(optionName)}`,
      });
    }

    options.sort((left, right) => left.label.localeCompare(right.label, undefined, { sensitivity: "base" }));
    lucideCategoryIconOptionsCache = { iconCount, tablerIconCount, options };
    return options;
  }

  function getLucideIconExportName(iconName) {
    if (normalizeTablerIconName(iconName)) {
      return "";
    }
    const normalizedIconName = normalizeLucideCategoryIconKey(iconName);
    const aliasedIconName = lucideCategoryIconAliases[normalizedIconName] || normalizedIconName;
    const option = getLucideCategoryIconOptions().find((item) => item.iconName === aliasedIconName);
    return option?.exportName || "";
  }

  function normalizeLucideCategoryIconName(value) {
    const tablerIconName = normalizeTablerIconName(value);
    if (tablerIconName) {
      const tablerIconSlug = getTablerIconSlug(tablerIconName);
      return !hasTablerIconCatalog()
        || getTablerIconPathFromCache(tablerIconSlug)
        || getTablerCatalogEntries().includes(tablerIconSlug)
        ? tablerIconName
        : "";
    }
    const iconName = normalizeLucideCategoryIconKey(value);
    const aliasedIconName = lucideCategoryIconAliases[iconName] || iconName;
    if (getLucideIconExportName(aliasedIconName) || lucideCategoryIconPaths[aliasedIconName]) {
      return aliasedIconName;
    }
    return "";
  }

  function getAutoLucideCategoryIconName(categoryName) {
    const categoryKey = normalizeLucideCategoryIconKey(categoryName);
    if (!categoryKey) {
      return "";
    }
    const directIconName = normalizeLucideCategoryIconName(categoryKey);
    if (directIconName) {
      return directIconName;
    }
    for (const token of categoryKey.split("-")) {
      const tokenIconName = normalizeLucideCategoryIconName(token);
      if (tokenIconName) {
        return tokenIconName;
      }
    }
    return "";
  }

  function createLucideCategoryIconSvg(iconName, options = {}) {
    const normalizedIconName = normalizeLucideCategoryIconName(iconName);
    const tablerIconSlug = getTablerIconSlug(normalizedIconName);
    const shouldQueueTablerRefresh = options.queueTablerRefresh !== false;
    if (tablerIconSlug) {
      const tablerIconPath = getTablerIconPathFromCache(tablerIconSlug);
      if (tablerIconPath) {
        return createIconSvg(tablerIconPath);
      }
      if (shouldQueueTablerRefresh) {
        requestTablerIconRenderRefresh([tablerIconSlug]);
      }
    }
    const icons = getLucideBrowserIcons();
    const exportName = getLucideIconExportName(normalizedIconName);
    if (
      exportName
      && Array.isArray(icons[exportName])
      && typeof window !== "undefined"
      && window.lucide?.createElement
    ) {
      const svgElement = window.lucide.createElement(icons[exportName], {
        "aria-hidden": "true",
        focusable: "false",
      });
      svgElement.setAttribute("viewBox", "0 0 24 24");
      svgElement.setAttribute("fill", "none");
      svgElement.setAttribute("stroke", "currentColor");
      svgElement.setAttribute("stroke-width", "2");
      svgElement.setAttribute("stroke-linecap", "round");
      svgElement.setAttribute("stroke-linejoin", "round");
      return svgElement.outerHTML;
    }

    return createIconSvg(lucideCategoryIconPaths[normalizedIconName] || lucideCategoryIconPaths.tag);
  }

  function getEffectiveStoreTypeCategoryIconName(categoryName = elements.storeTypeCategoryInput?.value) {
    return normalizeLucideCategoryIconName(state.storeTypeCategoryDraftIconName)

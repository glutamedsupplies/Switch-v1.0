        const message = error instanceof Error ? error.message : "Unable to upload images.";
        setModalError(message);
        setFeedback(message, "error");
        setSaving(false);
        syncUploadControls();
      }
    };

    activeProductImageUploadModal = overlay;
    activeProductImageUploadTrigger = trigger instanceof HTMLElement ? trigger : null;
    activeProductImageUploadCleanup = () => {
      for (const objectUrl of objectUrls) {
        URL.revokeObjectURL(objectUrl);
      }
      objectUrls.clear();
    };

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) {
        closeProductImageUploadModal();
        return;
      }
      if (!(event.target instanceof Element)) {
        return;
      }
      if (event.target.closest("[data-upload-pick]")) {
        event.preventDefault();
        pickFiles();
        return;
      }
      const removeButton = event.target.closest("[data-upload-remove-index]");
      if (removeButton instanceof HTMLElement) {
        event.preventDefault();
        removeDraftItem(Number(removeButton.dataset.uploadRemoveIndex));
      }
    });
    input?.addEventListener("change", () => {
      if (input instanceof HTMLInputElement) {
        addDraftFiles(input.files);
        input.value = "";
      }
    });
    closeButton?.addEventListener("click", () => closeProductImageUploadModal());
    cancelButton?.addEventListener("click", () => closeProductImageUploadModal());
    saveButton?.addEventListener("click", () => {
      void saveImages();
    });

    document.body.append(overlay);
    document.body.classList.add("super-admin-product-image-upload-open");
    renderUploadGrid();
    window.requestAnimationFrame(() => overlay.classList.add("is-open"));
    window.setTimeout(() => dialog?.focus?.({ preventScroll: true }), 0);
  }


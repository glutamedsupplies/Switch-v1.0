    const companyNameTrigger = event.target.closest(".super-admin-product-request-card__company-name-trigger");
    if (companyNameTrigger instanceof HTMLElement && (event.key === "Enter" || event.key === " ")) {
      const card = companyNameTrigger.closest(".super-admin-product-request-card");
      const companyId = String(card?.dataset.companyId || "").trim();
      if (companyId) {
        event.preventDefault();
        closeProductRequestMenus();
        closeRejectedProductQuickMenu();
        setSelectedCompanies([companyId], { activeCompanyId: companyId });
        openCompanyDrawer(companyId);
        return;
      }
    }
    if (event.target.closest("button, a, input, select, textarea, label, summary")) {
      return;
    }
    const card = event.target.closest(".super-admin-product-request-card");
    if (!(card instanceof HTMLElement)) {
      return;
    }
    const view = normalizeProductRequestView(state.productRequestView);
    if (view === "approved" || view === "rejected") {
      return;
    }
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      closeProductRequestMenus();
      closeRejectedProductQuickMenu();
      showProductRequestDetails(card.dataset.productId, card);
    }
  });

  elements.productRequestList?.addEventListener("contextmenu", (event) => {

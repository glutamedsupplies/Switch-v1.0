      normalizeCompanyRestrictionLimitValue(option.value) === normalizedValue
    ) || null;
  }

  // Reads or derives company restriction limit label for the current super admin flow.
  function getCompanyRestrictionLimitLabel(value) {
    const normalizedValue = normalizeCompanyRestrictionLimitValue(value);
    const optionLabel = getCompanyRestrictionLimitOptionLabel(
      getCompanyRestrictionLimitOption(normalizedValue),
    );
    if (optionLabel) {
      return optionLabel;
    }
    if (companyRestrictionLimitLabels.has(normalizedValue)) {
      return companyRestrictionLimitLabels.get(normalizedValue);
    }
    return String(value || "")
      .replace(/[_-]+/g, " ")
      .replace(/\s+/g, " ")
      .trim()
      .replace(/\b\w/g, (match) => match.toUpperCase());

          </button>
        `;
        grid.append(tile);
      });

      const remainingSlots = productImageUploadMaxCount - draftItems.length;
      const placeholderCount = remainingSlots > 0 ? 1 : 0;
      grid.style.setProperty(
        "--upload-image-column-count",
        String(Math.max(1, Math.min(4, draftItems.length + placeholderCount))),
      );
      for (let index = 0; index < placeholderCount; index += 1) {
        const placeholder = document.createElement("button");
        placeholder.type = "button";
        placeholder.className = "super-admin-product-image-upload-modal__placeholder";
        placeholder.dataset.uploadPick = "true";
        placeholder.innerHTML = `
          ${createIconSvg('<path d="M10.3 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10l-3.1-3.1a2 2 0 0 0-2.814.014L6 21"/><path d="m14 19.5 3-3 3 3"/><path d="M17 22v-5.5"/><circle cx="9" cy="9" r="2"/>')}
          <span>Upload image</span>
          <small>JPG, PNG or WEBP<br />Up to 10MB</small>
        `;
        grid.append(placeholder);
      }
      syncUploadControls();
    }

    const addDraftFiles = (files) => {
      const nextFiles = Array.from(files || []);
      if (!nextFiles.length) {
        return;
      }
      const rejected = [];
      for (const file of nextFiles) {
        if (draftItems.length >= productImageUploadMaxCount) {
          rejected.push("Image limit reached.");
          break;
        }
        if (!isSupportedProductImageUpload(file)) {
          rejected.push(`${file.name || "Image"} is not a JPG, PNG, or WEBP file.`);
          continue;
        }
        if (file.size > productImageUploadMaxBytes) {
          rejected.push(`${file.name || "Image"} is larger than 10MB.`);
          continue;
        }
        const objectUrl = URL.createObjectURL(file);
        objectUrls.add(objectUrl);
        draftItems.push({ file, objectUrl });
      }
      setModalError(rejected[0] || "");
      renderUploadGrid();
    };

    const saveImages = async () => {
      if (!draftItems.length || overlay.dataset.saving === "true") {
        return;

  function syncProductDetectionEditState() {
    const activeProductId = String(state.activeDetectionEditProductId || "").trim();
    const savingProductId = String(state.savingDetectionEditProductId || "").trim();
    const cards = Array.from(
      elements.productRequestList?.querySelectorAll(".super-admin-product-request-card") || [],
    );

    for (const card of cards) {
      const productId = String(card.dataset.productId || "").trim();
      const isActive = Boolean(activeProductId) && productId === activeProductId;
      const isSaving = Boolean(savingProductId) && productId === savingProductId;
      card.classList.toggle("is-detection-editing", isActive);
      card.classList.toggle("is-detection-saving", isSaving);
      if (isSaving) {
        card.setAttribute("aria-busy", "true");
      } else {
        card.removeAttribute("aria-busy");
      }
    }

    const editButtons = Array.from(
      elements.productRequestList?.querySelectorAll('[data-product-request-action="edit-detection"]') || [],
    );
    for (const editButton of editButtons) {
      if (!(editButton instanceof HTMLButtonElement)) {
        continue;
      }
      const productId = String(editButton.dataset.productId || "").trim();
      const shouldLock = Boolean(activeProductId) && productId !== activeProductId;
      editButton.disabled = shouldLock;
      editButton.classList.toggle("is-locked", shouldLock);
      if (shouldLock) {
        editButton.setAttribute("aria-disabled", "true");
        editButton.title = "Finish the active detection edit first";
      } else {
        editButton.removeAttribute("aria-disabled");
        editButton.title = "Edit detected object";
      }
    }
  }

  function restoreInlineDetectionEditor(row, labelElement, button, editor) {
    if (editor instanceof HTMLElement) {
      editor.remove();
    }
    if (row instanceof HTMLElement) {
      row.classList.remove("is-editing");
    }
    if (labelElement instanceof HTMLElement) {
      labelElement.hidden = false;
    }
    if (button instanceof HTMLButtonElement) {
      button.hidden = false;
      button.disabled = false;
      button.classList.remove("is-loading");
      button.removeAttribute("aria-busy");
    }
    const productId = String(button?.dataset?.productId || "").trim();
    if (!productId || state.activeDetectionEditProductId === productId) {
      state.activeDetectionEditProductId = "";
    }
    if (!productId || state.savingDetectionEditProductId === productId) {
      state.savingDetectionEditProductId = "";
    }
    syncProductDetectionEditState();
  }

  async function editProductDetectionLabel(productId, button = null) {
    const normalizedProductId = String(productId || "").trim();
    if (!normalizedProductId) {
      return false;
    }

    const targetProduct = findProductRequestById(normalizedProductId);
    const productName = String(targetProduct?.name || "product").trim();
    const row = button instanceof HTMLElement
      ? button.closest(".super-admin-product-request-card__detected-row")
      : null;
    const labelElement = row instanceof HTMLElement
      ? row.querySelector("[data-request-detected-label]")
      : null;

    if (!(row instanceof HTMLElement) || !(labelElement instanceof HTMLElement)) {
      return false;
    }
    if (
      state.activeDetectionEditProductId &&
      state.activeDetectionEditProductId !== normalizedProductId
    ) {
      const activeCard = Array.from(
        elements.productRequestList?.querySelectorAll(".super-admin-product-request-card") || [],
      ).find((card) => String(card?.dataset?.productId || "").trim() === state.activeDetectionEditProductId);
      const activeInput = activeCard?.querySelector(".super-admin-product-request-card__detected-input");
      if (activeInput instanceof HTMLInputElement) {
        activeInput.focus();
        activeInput.select();
      }
      return false;
    }
    if (row.classList.contains("is-editing")) {
      const activeInput = row.querySelector(".super-admin-product-request-card__detected-input");
      if (activeInput instanceof HTMLInputElement) {
        activeInput.focus();
        activeInput.select();
      }
      return false;
    }

    const labelText = String(labelElement.textContent || "").replace(/^Detected:\s*/i, "");
    const currentLabel = normalizeManualDetectionLabelInput(
      getProductDetectionLabelForEdit(targetProduct) || labelText,
    );
    const editor = document.createElement("span");
    editor.className = "super-admin-product-request-card__detected-editor";

    const prefix = document.createElement("span");
    prefix.className = "super-admin-product-request-card__detected-editor-prefix";
    prefix.textContent = "Detected:";

    const input = document.createElement("input");
    input.type = "text";
    input.className = "super-admin-product-request-card__detected-input";
    input.value = currentLabel;
    input.maxLength = 48;
    input.placeholder = "input label";
    input.autocomplete = "off";
    input.setAttribute("aria-label", `Edit detected object label for ${productName}`);

    const saveButton = document.createElement("button");
    saveButton.type = "button";
    saveButton.className = "super-admin-product-request-card__detected-editor-action super-admin-product-request-card__detected-editor-action--save";
    saveButton.setAttribute("aria-label", "Save detected object label");
    saveButton.title = "Save";
    saveButton.innerHTML = createIconSvg('<path d="m5 12 4.2 4.2L19 6.5" stroke-linecap="round" stroke-linejoin="round"></path>');

    const cancelButton = document.createElement("button");
    cancelButton.type = "button";
    cancelButton.className = "super-admin-product-request-card__detected-editor-action super-admin-product-request-card__detected-editor-action--cancel";
    cancelButton.setAttribute("aria-label", "Cancel detected object edit");
    cancelButton.title = "Cancel";
    cancelButton.innerHTML = createIconSvg('<path d="M7 7 17 17" stroke-linecap="round"></path><path d="M17 7 7 17" stroke-linecap="round"></path>');

    editor.append(prefix, input, saveButton, cancelButton);
    labelElement.hidden = true;
    if (button instanceof HTMLButtonElement) {
      button.hidden = true;
    }
    state.activeDetectionEditProductId = normalizedProductId;
    syncProductDetectionEditState();
    row.classList.add("is-editing");
    row.append(editor);
    input.focus();
    input.select();

    const setSaving = (isSaving) => {
      state.savingDetectionEditProductId = isSaving ? normalizedProductId : "";
      input.disabled = isSaving;
      saveButton.disabled = isSaving;
      cancelButton.disabled = isSaving;
      if (button instanceof HTMLButtonElement) {
        button.disabled = isSaving;
        button.classList.toggle("is-loading", isSaving);
        if (isSaving) {
          button.setAttribute("aria-busy", "true");
        } else {
          button.removeAttribute("aria-busy");
        }
      }
      saveButton.classList.toggle("is-loading", isSaving);
      if (isSaving) {
        saveButton.setAttribute("aria-busy", "true");
      } else {
        saveButton.removeAttribute("aria-busy");
      }
      syncProductDetectionEditState();
    };

    const cancelEdit = () => {
      if (saveButton.disabled) {
        return;
      }
      restoreInlineDetectionEditor(row, labelElement, button, editor);
    };

    const saveEdit = async () => {
      const nextLabel = normalizeManualDetectionLabelInput(input.value);
      if (!nextLabel) {
        setFeedback("Enter a real object label before saving.", "error");
        input.focus();
        return false;
      }
      if (nextLabel === currentLabel) {
        restoreInlineDetectionEditor(row, labelElement, button, editor);
        return false;
      }

      try {
        setSaving(true);
        setFeedback(`Updating YOLO detection for ${productName}...`);

        const response = await fetch(
          `/api/super-admin/products/${encodeURIComponent(normalizedProductId)}/detection-label`,
          {
            method: "PATCH",
            headers: rootHeaders({
              Accept: "application/json",
              "Content-Type": "application/json",
            }),
            body: JSON.stringify({ label: nextLabel }),
          },
        );
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.message || "Unable to update YOLO detection label.");
        }

        await loadProductRequests({ quiet: true, showLoading: false });
        state.activeDetectionEditProductId = "";
        state.savingDetectionEditProductId = "";
        renderProductRequests();
        setFeedback(data.message || "YOLO detection label updated.", "success");
        return true;
      } catch (error) {
        setFeedback(error instanceof Error ? error.message : "Unable to update YOLO detection label.", "error");
        setSaving(false);
        input.focus();
        input.select();
        return false;
      }
    };

    saveButton.addEventListener("click", (event) => {
      event.stopPropagation();
      void saveEdit();
    });
    cancelButton.addEventListener("click", (event) => {
      event.stopPropagation();
      cancelEdit();
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        event.stopPropagation();
        void saveEdit();
      } else if (event.key === "Escape") {
        event.preventDefault();
        event.stopPropagation();
        cancelEdit();
      }
    });

    return true;
  }

  async function deleteProductRequest(productId, button = null) {
    const normalizedProductId = String(productId || "").trim();
    if (!normalizedProductId) {

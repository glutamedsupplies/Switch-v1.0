  function resetStoreTypeCategoryComposer({ focusInput = false } = {}) {
    state.editingStoreTypeCategoryName = "";
    state.storeTypeCategoryDraftImageUrl = "";
    state.storeTypeCategoryDraftIconUrl = "";
    state.storeTypeCategoryDraftIconName = "";
    state.storeTypeCategoryDraftIconNameTouched = false;
    state.storeTypeCategoryDraftImageFile = null;
    state.storeTypeCategoryDraftIconFile = null;
    state.storeTypeCategoryIconSearchTerm = "";
    state.storeTypeCategoryIconVisibleCount = 0;
    if (elements.storeTypeCategoryInput) elements.storeTypeCategoryInput.value = "";
    if (elements.storeTypeCategoryIconSearchInput) elements.storeTypeCategoryIconSearchInput.value = "";
    if (elements.storeTypeCategoryImageInput) elements.storeTypeCategoryImageInput.value = "";
    if (elements.storeTypeCategoryIconInput) elements.storeTypeCategoryIconInput.value = "";
    if (elements.addStoreTypeCategoryButton) elements.addStoreTypeCategoryButton.textContent = "Add Category";
    renderStoreTypeCategoryIconPicker();
    syncStoreTypeCategoryAssetFileNames();
    if (focusInput) elements.storeTypeCategoryInput?.focus();
  }

  function editStoreTypeDraftCategory(categoryName) {
    const detail = state.storeTypeDraftCategoryDetails.find(
      (item) => isSameCategoryName(item.name, categoryName),
    ) || {};
    state.editingStoreTypeCategoryName = categoryName;
    state.storeTypeCategoryDraftImageUrl = normalizeBusinessTypeImageUrl(detail.imageUrl);
    state.storeTypeCategoryDraftIconUrl = normalizeBusinessTypeImageUrl(detail.iconImageUrl);
    state.storeTypeCategoryDraftIconName = normalizeLucideCategoryIconName(detail.iconName);
    state.storeTypeCategoryDraftIconNameTouched = false;
    state.storeTypeCategoryDraftImageFile = null;
    state.storeTypeCategoryDraftIconFile = null;
    state.storeTypeCategoryIconVisibleCount = 0;
    if (elements.storeTypeCategoryInput) elements.storeTypeCategoryInput.value = categoryName;
    if (elements.addStoreTypeCategoryButton) elements.addStoreTypeCategoryButton.textContent = "Update Category";
    renderStoreTypeCategoryIconPicker();
    syncStoreTypeCategoryAssetFileNames();
    elements.storeTypeCategoryInput?.focus();
    elements.storeTypeCategoryInput?.select();
  }

  // Supports the add store type draft category branch of the super admin UI.
  function addStoreTypeDraftCategory({ focusInput = true } = {}) {
    const categoryName = normalizeCategoryName(elements.storeTypeCategoryInput?.value);
    if (!categoryName) {
      elements.storeTypeCategoryInput?.focus();
      return false;
    }

    if (!state.storeTypeDraftCategories.some((category) => isSameCategoryName(category, categoryName))) {
      state.storeTypeDraftCategories = normalizeCategoryValues([
        ...state.storeTypeDraftCategories,
        categoryName,
      ]);
    }

    const previousName = state.editingStoreTypeCategoryName || categoryName;
    const existingDetail = state.storeTypeDraftCategoryDetails.find(
      (item) => isSameCategoryName(item.name, previousName),
    ) || {};
    state.storeTypeDraftCategoryDetails = [
      ...state.storeTypeDraftCategoryDetails.filter(
        (item) => !isSameCategoryName(item.name, previousName) && !isSameCategoryName(item.name, categoryName),
      ),
      {
        name: categoryName,
        productCount: Math.trunc(normalizeStoreTypeNumber(existingDetail.productCount)),
        imageUrl: state.storeTypeCategoryDraftImageUrl || existingDetail.imageUrl || "",
        iconImageUrl: state.storeTypeCategoryDraftIconUrl || existingDetail.iconImageUrl || "",
        iconName: state.storeTypeCategoryDraftIconNameTouched
          ? normalizeLucideCategoryIconName(state.storeTypeCategoryDraftIconName)
          : normalizeLucideCategoryIconName(state.storeTypeCategoryDraftIconName)
            || normalizeLucideCategoryIconName(existingDetail.iconName),
        status: normalizeStoreTypeCategoryStatus(existingDetail.status),
        imageFile: state.storeTypeCategoryDraftImageFile,
        iconFile: state.storeTypeCategoryDraftIconFile,
      },
    ];
    if (state.editingStoreTypeCategoryName && !isSameCategoryName(state.editingStoreTypeCategoryName, categoryName)) {
      state.storeTypeDraftCategories = state.storeTypeDraftCategories.map((item) =>
        isSameCategoryName(item, state.editingStoreTypeCategoryName) ? categoryName : item,
      );
    }
    state.storeTypeDraftCategories = normalizeCategoryValues(state.storeTypeDraftCategories);
    renderStoreTypeDraftCategories();
    syncStoreTypeModalSummary();
    resetStoreTypeCategoryComposer({ focusInput });
    return true;
  }

  function getBusinessTypeAssetFileName(value, fallback = "") {
    const normalizedUrl = String(value || "").trim().split("#")[0].split("?")[0];
    const fileName = normalizedUrl.split(/[\\/]/).pop() || "";
    if (!fileName) {
      return fallback;
    }
    try {
      return decodeURIComponent(fileName);
    } catch (error) {
      return fileName;
    }
  }

  function syncStoreTypeAssetFileNames() {
    if (elements.storeTypeImageFileName) {
      elements.storeTypeImageFileName.textContent = state.storeTypeDraftImageFile?.name
        || getBusinessTypeAssetFileName(state.storeTypeDraftImageUrl, "No image selected");
    }
    if (elements.storeTypeIconFileName) {
      const manualIconName = normalizeLucideCategoryIconName(state.storeTypeDraftIconName);
      elements.storeTypeIconFileName.textContent = state.storeTypeDraftIconFile?.name
        || getBusinessTypeAssetFileName(
          state.storeTypeDraftIconUrl,
          manualIconName ? `Icon: ${formatLucideCategoryIconLabel(manualIconName)}` : "No icon selected",
        );
    }
    syncStoreTypeIconPickerSummary();
  }

  function syncStoreTypeStatusOptions() {
    const selectedStatus = normalizeStoreTypeStatus(elements.storeTypeStatusSelect?.value);
    const isActive = selectedStatus === "active";
    elements.storeTypeStatusToggle?.classList.toggle("is-active", isActive);
    elements.storeTypeStatusToggle?.setAttribute("aria-pressed", isActive ? "true" : "false");
    if (elements.storeTypeStatusToggleLabel) {
      elements.storeTypeStatusToggleLabel.textContent = isActive ? "Active" : "Inactive";
    }
  }

  function isSupportedBusinessTypeAssetFile(file, type = "image") {
    if (!(file instanceof File)) {
      return false;
    }
    const fileType = String(file.type || "").toLowerCase();
    const fileName = String(file.name || "").toLowerCase();
    if (type === "icon") {
      return ["image/png", "image/svg+xml"].includes(fileType) || /\.(png|svg)$/.test(fileName);
    }
    return ["image/jpeg", "image/jpg", "image/png", "image/webp"].includes(fileType)
      || /\.(jpe?g|png|webp)$/.test(fileName);
  }

  function setStoreTypeAssetFile(type, file) {
    const isIcon = type === "icon";
    const maxBytes = isIcon ? 2 * 1024 * 1024 : 4 * 1024 * 1024;
    if (!(file instanceof File)) {
      if (isIcon) {
        state.storeTypeDraftIconFile = null;
      } else {
        state.storeTypeDraftImageFile = null;
      }
      syncStoreTypeAssetFileNames();
      return;
    }
    if (!isSupportedBusinessTypeAssetFile(file, type)) {
      setFeedback(
        isIcon ? "Choose a PNG or SVG icon." : "Choose a JPG, PNG, or WEBP image.",
        "error",
      );
      if (isIcon && elements.storeTypeIconInput) {
        elements.storeTypeIconInput.value = "";
      } else if (!isIcon && elements.storeTypeImageInput) {
        elements.storeTypeImageInput.value = "";
      }
      return;
    }
    if (file.size > maxBytes) {
      setFeedback(
        isIcon ? "Business type icon must be 2MB or smaller." : "Business type image must be 4MB or smaller.",
        "error",
      );
      if (isIcon && elements.storeTypeIconInput) {
        elements.storeTypeIconInput.value = "";
      } else if (!isIcon && elements.storeTypeImageInput) {
        elements.storeTypeImageInput.value = "";
      }
      return;
    }

    if (isIcon) {
      state.storeTypeDraftIconFile = file;
      state.storeTypeDraftIconName = "";
      renderStoreTypeIconPicker();
    } else {
      state.storeTypeDraftImageFile = file;
    }
    syncStoreTypeAssetFileNames();
    setFeedback("");
  }

  function setStoreTypeCategoryAssetFile(type, file) {
    const isIcon = type === "icon";
    const input = isIcon ? elements.storeTypeCategoryIconInput : elements.storeTypeCategoryImageInput;
    const maxBytes = isIcon ? 2 * 1024 * 1024 : 4 * 1024 * 1024;
    if (!(file instanceof File)) {
      if (isIcon) state.storeTypeCategoryDraftIconFile = null;
      else state.storeTypeCategoryDraftImageFile = null;
      syncStoreTypeCategoryAssetFileNames();
      return;
    }
    if (!isSupportedBusinessTypeAssetFile(file, type)) {
      setFeedback(isIcon ? "Choose a PNG or SVG category icon." : "Choose a JPG, PNG, or WEBP category image.", "error");
      if (input) input.value = "";
      return;
    }
    if (file.size > maxBytes) {
      setFeedback(isIcon ? "Category icon must be 2MB or smaller." : "Category image must be 4MB or smaller.", "error");
      if (input) input.value = "";
      return;
    }
    if (isIcon) state.storeTypeCategoryDraftIconFile = file;
    else state.storeTypeCategoryDraftImageFile = file;
    syncStoreTypeCategoryAssetFileNames();
    setFeedback("");
  }

  async function uploadStoreTypeCategoryDetails() {
    const uploadedDetails = [];
    for (const detail of state.storeTypeDraftCategoryDetails) {
      const nextDetail = {
        name: detail.name,
        productCount: Math.trunc(normalizeStoreTypeNumber(detail.productCount)),
        imageUrl: normalizeBusinessTypeImageUrl(detail.imageUrl),
        iconImageUrl: normalizeBusinessTypeImageUrl(detail.iconImageUrl),
        iconName: normalizeLucideCategoryIconName(detail.iconName),
        status: normalizeStoreTypeCategoryStatus(detail.status),
      };
      if (detail.imageFile instanceof File) {
        setFeedback(`Uploading image for ${detail.name}...`);
        nextDetail.imageUrl = await uploadSuperAdminProductImageFile(detail.imageFile);
      }
      if (detail.iconFile instanceof File) {
        setFeedback(`Uploading icon for ${detail.name}...`);
        nextDetail.iconImageUrl = await uploadSuperAdminProductImageFile(detail.iconFile);
      }
      uploadedDetails.push(nextDetail);
    }
    return uploadedDetails;
  }

  async function uploadStoreTypeDraftAssets(storeTypeDraft) {
    const nextDraft = { ...storeTypeDraft };
    if (state.storeTypeDraftImageFile instanceof File) {
      setFeedback("Uploading business type image...");
      nextDraft.heroImageUrl = await uploadSuperAdminProductImageFile(state.storeTypeDraftImageFile);
    }
    if (state.storeTypeDraftIconFile instanceof File) {
      setFeedback("Uploading business type icon...");
      nextDraft.iconImageUrl = await uploadSuperAdminProductImageFile(state.storeTypeDraftIconFile);
    }
    return nextDraft;
  }

  // Reads or derives current store type draft for the current super admin flow.
  function getCurrentStoreTypeDraft() {
    const selectedRecord = getStoreTypeRecordByName(
      normalizeCategoryName(elements.storeTypeNameInput?.value) || state.editingStoreTypeName,
    );
    const hasIconImage = state.storeTypeDraftIconFile instanceof File || Boolean(state.storeTypeDraftIconUrl);
    return {
      name: normalizeCategoryName(elements.storeTypeNameInput?.value),
      categories: [...state.storeTypeDraftCategories],
      status: normalizeStoreTypeStatus(elements.storeTypeStatusSelect?.value),
      commissionRate: normalizeStoreTypeNumber(elements.storeTypeCommissionRateInput?.value),
      serviceFee: normalizeStoreTypeNumber(elements.storeTypeServiceFeeInput?.value),
      heroImageUrl: normalizeBusinessTypeImageUrl(state.storeTypeDraftImageUrl),
      iconImageUrl: normalizeBusinessTypeImageUrl(state.storeTypeDraftIconUrl),
      iconName: hasIconImage
        ? normalizeLucideCategoryIconName(state.storeTypeDraftIconName)
        : (
            normalizeLucideCategoryIconName(state.storeTypeDraftIconName || selectedRecord?.iconName)
            || getEffectiveStoreTypeIconName()
          ),
      companiesUsing: Math.trunc(normalizeStoreTypeNumber(selectedRecord?.companiesUsing)),
      productCount: Math.trunc(normalizeStoreTypeNumber(selectedRecord?.productCount)),
    };
  }

  // Keeps store type modal summary synchronized with current state.
  function syncStoreTypeModalSummary() {

    const apiKey = String(elements.deliveryPartnerApiKeyInput?.value || "").trim();
    const existingPartner = editingDeliveryPartnerId
      ? findIntegratedPartner("delivery", editingDeliveryPartnerId)
      : null;
    const isEditing = Boolean(existingPartner);
    setDeliveryPartnerModalFeedback("");
    if (!branch) {
      setDeliveryPartnerModalFeedback("Enter the delivery partner name.");
      elements.deliveryPartnerBranchInput?.focus();
      return;
    }
    if (!isEditing && !apiKey) {
      setDeliveryPartnerModalFeedback("Enter the delivery partner API key.");
      elements.deliveryPartnerApiKeyInput?.focus();
      return;
    }
    if (!isEditing && !(deliveryPartnerImageFile instanceof File)) {
      setDeliveryPartnerModalFeedback("Choose a logo for the delivery partner.");
      return;
    }
    const duplicatePartner = state.deliveryPartners.some((partner) =>
      getIntegratedPartnerId(partner) !== editingDeliveryPartnerId
      &&
      getIntegratedPartnerName(partner).localeCompare(branch, undefined, { sensitivity: "accent" }) === 0
    );
    if (duplicatePartner) {
      setDeliveryPartnerModalFeedback("A delivery partner with this name already exists.");
      elements.deliveryPartnerBranchInput?.focus();
      elements.deliveryPartnerBranchInput?.select();
      return;
    }

    setDeliveryPartnerModalSaving(true);
    try {
      const imageUrl = deliveryPartnerImageFile instanceof File
        ? await uploadSuperAdminProductImageFile(deliveryPartnerImageFile)
        : getIntegratedPartnerImage(existingPartner);
      const endpoint = isEditing
        ? `/api/delivery-partners/${encodeURIComponent(editingDeliveryPartnerId)}`
        : "/api/delivery-partners";
      const payload = isEditing ? { branch, imageUrl } : { branch, imageUrl, apiKey };
      const response = await fetch(endpoint, {
        method: isEditing ? "PATCH" : "POST",
        headers: rootHeaders({
          Accept: "application/json",
          "Content-Type": "application/json",
        }),
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || `Unable to ${isEditing ? "update" : "save"} delivery partner.`);
      }
      await loadIntegratedPartners("delivery", { quiet: true });
      setFeedback(data.message || `Delivery partner ${isEditing ? "updated" : "saved"}.`, "success");
      setDeliveryPartnerModalOpen(false, { restoreFocus: true });
    } catch (error) {
      setDeliveryPartnerModalFeedback(
        error instanceof Error ? error.message : `Unable to ${isEditing ? "update" : "save"} delivery partner.`,
      );
    } finally {
      setDeliveryPartnerModalSaving(false);

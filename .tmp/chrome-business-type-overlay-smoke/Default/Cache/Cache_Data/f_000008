  // Checks whether event within element is true for the current record or UI state.
  function isEventWithinElement(event, element) {
    if (!(element instanceof HTMLElement) || !event) {
      return false;
    }

    if (typeof event.composedPath === "function") {
      const eventPath = event.composedPath();
      if (Array.isArray(eventPath) && eventPath.includes(element)) {
        return true;
      }
    }

    return event.target instanceof Node && element.contains(event.target);
  }

  // Normalizes category name before comparison or storage.
  function normalizeCategoryName(value, { preserveTrailingSpace = false } = {}) {
    const compactedValue = String(value ?? "")
      .replace(/\s+/g, " ")
      .replace(/^\s+/, "");

    if (!compactedValue) {
      return "";
    }

    const hasTrailingSpace = preserveTrailingSpace && /\s$/.test(compactedValue);
    const formattedCoreValue = hasTrailingSpace
      ? compactedValue.slice(0, -1)
      : compactedValue.trimEnd();

    return hasTrailingSpace ? `${formattedCoreValue} ` : formattedCoreValue;
  }

  // Normalizes category values before comparison or storage.
  function normalizeCategoryValues(values) {
    const rawValues = Array.isArray(values)
      ? values
      : values === null || values === undefined
        ? []
        : [values];
    const seen = new Set();
    const normalizedValues = [];

    for (const value of rawValues) {
      const normalizedCategory = normalizeCategoryName(value);
      const normalizedKey = normalizedCategory.toLowerCase();
      if (!normalizedCategory || seen.has(normalizedKey)) {
        continue;
      }

      seen.add(normalizedKey);
      normalizedValues.push(normalizedCategory);
    }

    return normalizedValues.sort((left, right) =>
      left.localeCompare(right, undefined, { sensitivity: "base" }),
    );
  }

  // Normalizes store type values before comparison or storage.
  function normalizeStoreTypeValues(values) {
    const rawValues = Array.isArray(values)
      ? values
      : values === null || values === undefined
        ? []
        : [values];
    const seen = new Set();
    const normalizedValues = [];

    for (const value of rawValues) {
      const normalizedStoreType = normalizeCategoryName(
        value && typeof value === "object"
          ? value.name ?? value.storeType ?? value.type ?? value.label ?? value.title
          : value,
      );
      const normalizedKey = normalizedStoreType.toLowerCase();
      if (!normalizedStoreType || seen.has(normalizedKey)) {
        continue;
      }

      seen.add(normalizedKey);
      normalizedValues.push(normalizedStoreType);
    }

    return normalizedValues.sort((left, right) =>
      left.localeCompare(right, undefined, { sensitivity: "base" }),
    );
  }

  // Normalizes store type status before comparison or storage.
  function normalizeStoreTypeStatus(value) {
    return String(value ?? "").trim().toLowerCase() === "inactive"
      ? "inactive"
      : "active";
  }

  function normalizeStoreTypeCategoryStatus(value) {
    const normalizedValue = String(value ?? "").trim().toLowerCase();
    return ["inactive", "deactivated", "disabled", "off"].includes(normalizedValue)
      ? "inactive"
      : "active";
  }

  // Normalizes store type number before comparison or storage.
  function normalizeStoreTypeNumber(value) {
    const numberValue = Number(value ?? 0);
    return Number.isFinite(numberValue) && numberValue >= 0 ? numberValue : 0;
  }

  // Keeps business type imagery limited to browser-safe image sources.
  function normalizeBusinessTypeImageUrl(value) {
    const imageUrl = String(value ?? "").trim();
    if (
      imageUrl.startsWith("/")
      || imageUrl.startsWith("data:image/")
      || /^https?:\/\//i.test(imageUrl)
    ) {
      return imageUrl;
    }
    return "";
  }

  // Normalizes optional per-category details returned with a business type.
  function normalizeStoreTypeCategoryStats(value) {
    const sourceValues = Array.isArray(value)
      ? value
      : value && typeof value === "object"
        ? Object.entries(value).map(([name, details]) => ({
            name,
            ...(details && typeof details === "object"
              ? details
              : { productCount: details }),
          }))
        : [];
    const seen = new Map();

    for (const source of sourceValues) {
      const categoryName = normalizeCategoryName(
        source?.name ?? source?.category ?? source?.label,
      );
      if (!categoryName) {
        continue;
      }

      const key = categoryName.toLowerCase();
      if (!seen.has(key)) {
        seen.set(key, {
          name: categoryName,
          productCount: Math.trunc(
            normalizeStoreTypeNumber(source?.productCount ?? source?.count ?? source?.items),
          ),
          imageUrl: normalizeBusinessTypeImageUrl(
            source?.imageUrl ?? source?.mainImageUrl ?? source?.thumbnailUrl,
          ),
          iconImageUrl: normalizeBusinessTypeImageUrl(
            source?.iconImageUrl ?? source?.iconUrl ?? source?.categoryIconUrl,
          ),
          iconName: normalizeLucideCategoryIconName(
            source?.iconName ?? source?.lucideIconName ?? source?.categoryIconName,
          ),
          status: normalizeStoreTypeCategoryStatus(
            source?.status ?? source?.categoryStatus ?? source?.state,
          ),
        });
      }
    }

    return [...seen.values()];
  }

  // Normalizes store type record before comparison or storage.
  function normalizeStoreTypeRecord(value) {
    const name = normalizeCategoryName(
      value && typeof value === "object"
        ? value.name ?? value.storeType ?? value.type ?? value.label ?? value.title
        : value,
    );

    if (!name) {
      return null;
    }

    const source = value && typeof value === "object" ? value : {};
    return {
      name,
      categories: normalizeCategoryValues(source.categories ?? source.category),
      status: normalizeStoreTypeStatus(source.status ?? source.businessTypeStatus),
      commissionRate: normalizeStoreTypeNumber(source.commissionRate ?? source.commission),
      serviceFee: normalizeStoreTypeNumber(source.serviceFee ?? source.serviceFeeAmount),
      companiesUsing: Math.trunc(normalizeStoreTypeNumber(source.companiesUsing)),
      productCount: Math.trunc(normalizeStoreTypeNumber(source.productCount)),
      heroImageUrl: normalizeBusinessTypeImageUrl(
        source.heroImageUrl ?? source.imageUrl ?? source.coverImageUrl,
      ),
      iconImageUrl: normalizeBusinessTypeImageUrl(
        source.iconImageUrl ?? source.iconUrl ?? source.businessTypeIconUrl,
      ),
      iconName: normalizeLucideCategoryIconName(source.iconName ?? source.lucideIconName),
      categoryStats: normalizeStoreTypeCategoryStats(
        source.categoryStats ?? source.categoryDetails ?? source.categoryCounts,
      ),
    };
  }

  // Normalizes store type records before comparison or storage.
  function normalizeStoreTypeRecords(values) {
    const seen = new Map();
    for (const value of Array.isArray(values) ? values : []) {
      const record = normalizeStoreTypeRecord(value);
      if (!record) {
        continue;
      }
      const key = record.name.toLowerCase();
      if (!seen.has(key)) {
        seen.set(key, record);
      }
    }

    return [...seen.values()].sort((left, right) =>
      left.name.localeCompare(right.name, undefined, { sensitivity: "base" }),
    );
  }

  // Reads or derives store type record by name for the current super admin flow.
  function getStoreTypeRecordByName(storeTypeName) {

  // Reads or derives company restriction limit labels for the current super admin flow.
  function getCompanyRestrictionLimitLabels(admin) {
    const rawLimits = Array.isArray(admin?.restrictionLimits)
      ? admin.restrictionLimits
      : Array.isArray(admin?.restrictLimits)
        ? admin.restrictLimits
        : Array.isArray(admin?.limitedAccess)
          ? admin.limitedAccess
          : String(admin?.restrictionLimits ?? admin?.restrictLimits ?? admin?.limitedAccess ?? "")
            .split(",")
            .map((value) => value.trim())
            .filter(Boolean);
    const rawLabels = Array.isArray(admin?.restrictionLimitLabels)
      ? admin.restrictionLimitLabels
      : Array.isArray(admin?.restrictLimitLabels)
        ? admin.restrictLimitLabels
        : [];
    const labels = rawLabels.length
      ? rawLabels
      : rawLimits.map(getCompanyRestrictionLimitLabel);
    return [...new Set(labels.map((label) => String(label || "").trim()).filter(Boolean))];

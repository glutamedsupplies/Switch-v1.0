  // Builds the payload used when Super Admin sends a seller warning notice.
  function createCompanySellerWarningPayload(adminIds) {
    const normalizedAdminIds = normalizeCompanyActionTargetIds(adminIds);
    const label = getCompanyActionTargetLabel(normalizedAdminIds);
    return {
      action: "notify",
      notificationType: "warning",
      notificationAudience: "seller",

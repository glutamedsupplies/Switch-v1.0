body.super-admin-page .partner-data-remove-button:focus-visible {
  background: transparent;
  color: #991b1b;
}

body.super-admin-page .partner-data-status-toggle {
  position: relative;
  display: inline-flex;
  width: 38px;
  min-width: 38px;
  height: 22px;
  min-height: 22px;
  align-items: center;
  padding: 2px;
  border: 0;
  border-radius: 999px;
  background: #cbd5e1;
  box-shadow: none;
}

body.super-admin-page .partner-data-status-toggle::after {
  content: "";
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.24);
  transform: translateX(0);
  transition: transform 160ms ease;
}

body.super-admin-page .partner-data-status-toggle[aria-checked="true"] {
  background: var(--accent-button-bg, var(--accent));
}

body.super-admin-page .partner-data-status-toggle[aria-checked="true"]::after {
  transform: translateX(16px);
}

body.super-admin-page .partner-data-status-toggle:hover,
body.super-admin-page .partner-data-status-toggle:focus-visible {
  outline: 2px solid rgba(var(--accent-rgb), 0.2);
  outline-offset: 2px;
}

body.super-admin-page .partner-data-status-toggle:disabled,
body.super-admin-page .partner-data-action-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

body.super-admin-page .partner-data-list-empty {
  border-radius: 0 0 8px 8px;
  background: #ffffff;
}

body.super-admin-page .partner-data-footer {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  padding: 28px 0 0;
}

body.super-admin-page .partner-data-footer > span {
  color: #64748b;
  font-size: 10px;
  line-height: 1.3;
  white-space: nowrap;
}


/* Payment partner creation stays inside the Super Admin workspace. */
body.super-admin-page .super-admin-payment-partner-modal {
  box-sizing: border-box;
  width: min(calc(100% - 28px), 560px);
  max-width: 560px;
}

body.super-admin-page .super-admin-payment-partner-modal__file-picker {
  grid-template-columns: 48px minmax(0, 1fr);
  min-height: 112px;
}

body.super-admin-page .super-admin-payment-partner-modal__preview {
  width: 48px;
  height: 48px;
  overflow: hidden;
  background: rgba(var(--accent-rgb), 0.1);
  color: var(--accent-button-bg, var(--accent));
}

body.super-admin-page .super-admin-payment-partner-modal__preview img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #ffffff;
}

body.super-admin-page .super-admin-payment-partner-modal__preview img[hidden],
body.super-admin-page .super-admin-payment-partner-modal__preview svg[hidden] {
  display: none;
}

body.super-admin-page .super-admin-payment-partner-modal__file-picker
  .super-admin-store-type-modal__file-action {
  border-color: rgba(var(--accent-rgb), 0.28);
  color: var(--accent-button-bg, var(--accent));
}

body.super-admin-page .super-admin-payment-partner-modal__logo-field:hover
  .super-admin-store-type-modal__file-action,
body.super-admin-page .super-admin-payment-partner-modal__logo-field:focus-within
  .super-admin-store-type-modal__file-action {
  border-color: var(--accent-button-bg, var(--accent));
  background: rgba(var(--accent-rgb), 0.08);
}

body.super-admin-page #payment-partner-branch-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 46px;
  padding: 0 13px;
  border: 1px solid #c5d1e1;
  border-radius: 7px;
  background: #ffffff;
  color: #1f2937;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
}

body.super-admin-page #payment-partner-branch-input:focus,
body.super-admin-page #payment-partner-branch-input:focus-visible {
  border-color: var(--accent-button-bg, var(--accent));
  outline: none;
  box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.14);
}

body.super-admin-page .super-admin-payment-partner-modal__feedback {
  margin: -4px 0 0;
  padding: 9px 11px;
  border: 1px solid #fecaca;
  border-radius: 6px;
  background: #fff7f7;
  color: #b42318;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.4;
}

body.super-admin-page .super-admin-payment-partner-modal__feedback[hidden] {
  display: none;
}

body.super-admin-page .super-admin-payment-partner-modal__save-button {
  position: relative;
  min-width: 154px;
}

body.super-admin-page .super-admin-payment-partner-modal__save-button.is-loading > span {
  visibility: hidden;
}

body.super-admin-page .super-admin-payment-partner-modal__save-button.is-loading:disabled {
  border-color: var(--accent-button-bg, var(--accent));
  background: var(--accent-button-bg, var(--accent));
  color: var(--accent-contrast, #ffffff);
  opacity: 1;
}

body.super-admin-page .super-admin-payment-partner-modal__save-button.is-loading::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 17px;
  height: 17px;
  margin: -10px 0 0 -10px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: super-admin-payment-partner-spin 700ms linear infinite;
}

@keyframes super-admin-payment-partner-spin {
  to {
    transform: rotate(360deg);
  }
}


/* Use the Company Restrict backdrop treatment across every Super Admin modal. */
body.super-admin-page :is(
  .theme-modal-overlay,
  .validation-modal-overlay,
  .super-admin-ban-modal-overlay,
  .super-admin-company-activity-modal-overlay,
  .super-admin-product-delete-modal-overlay,
  .super-admin-product-revision-modal-overlay,
  .super-admin-reject-evidence-modal-overlay,
  .super-admin-product-detail-modal-overlay,
  .super-admin-product-listing-restriction-modal-overlay,
  .super-admin-product-image-upload-modal-overlay,
  .super-admin-image-zoom-modal-overlay,
  .buyer-data-modal-backdrop
) {
  background: rgba(15, 23, 42, 0.18) !important;
  -webkit-backdrop-filter: blur(3.5px) !important;
  backdrop-filter: blur(3.5px) !important;
}


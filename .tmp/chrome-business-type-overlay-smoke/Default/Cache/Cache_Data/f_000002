.super-admin-product-request-card.is-detection-saving > :not(.super-admin-product-request-card__detection-loading) {
  opacity: 0.42;
  filter: blur(2px);
  pointer-events: none;
  transition: opacity 160ms ease, filter 160ms ease;
}

.super-admin-product-request-card.is-detection-saving .super-admin-product-request-card__media img {
  opacity: 0.55;
  filter: blur(4px);
}

.super-admin-product-request-card__detection-loading {
  position: absolute;
  inset: 0;
  z-index: 12;
  display: none;
  place-items: center;
  gap: 8px;
  align-content: center;
  justify-content: center;
  border-radius: inherit;
  background: rgba(255, 255, 255, 0.58);
  color: #111827;
  text-align: center;
  pointer-events: auto;

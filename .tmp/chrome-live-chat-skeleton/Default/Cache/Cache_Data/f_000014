(function () {
  const storageKey = "gms-web-theme";
  const dashboardBackgroundStorageKey = "gms-dashboard-background";
  const workspaceColorStorageKey = "gms-workspace-color";
  const workspaceThemeEndpoint = "/api/workspace-theme";
  const adminSessionStorageKey = "gms-admin-session";
  const employeeSessionStorageKey = "gms-employee-session";
  const superAdminSessionStorageKey = "gms-super-admin-session";
  const defaultTheme = Object.freeze({ r: 37, g: 99, b: 235 });
  const defaultDashboardBackground = Object.freeze({ r: 243, g: 244, b: 246 });
  const defaultIndicatorRange = Object.freeze({ start: 0.16, end: 0.82 });
  const defaultGradientAngle = 135;
  const defaultGradientOpacity = Object.freeze({ start: 1, middle: 1, end: 1 });
  const defaultGradientMiddlePosition = 0.5;
  const defaultGradientPrimaryStop = "start";
  let currentAppliedThemeConfig = null;
  let currentWorkspaceColor = "";
  let workspaceColorSyncPromise = null;
  let workspaceColorRequestRevision = 0;

  function readSessionStorageJson(key) {
    try {
      const rawValue = window.sessionStorage.getItem(key);
      return rawValue ? JSON.parse(rawValue) : null;
    } catch (error) {
      return null;
    }
  }

  function resolveAdminTenantIdFromSession(session, fallback = "") {
    if (!session || typeof session !== "object") {
      return fallback;
    }

    const tenantId = getFirstScopeValue(session, [
      "adminId",
      "ownerAdminId",
      "tenantId",
      "workspaceId",
      "storeAdminId",
      "sellerId",
      "shopId",
    ]);
    if (tenantId) {
      return tenantId;
    }

    const accountTenantId = getFirstScopeValue(session, ["id", "accountCode"]);
    if (isAdminTenantId(accountTenantId)) {
      return accountTenantId;
    }

    return fallback;
  }

  function isAdminTenantId(value) {
    const normalizedValue = String(value ?? "").trim().toLowerCase();
    return normalizedValue.startsWith("admin-");
  }

  function isUsableAdminTenantId(value) {
    const normalizedValue = String(value ?? "").trim();
    return Boolean(normalizedValue) && normalizedValue.toLowerCase() !== "admin";
  }

  function getStoredAdminTenantId() {
    try {
      return String(window.localStorage.getItem("gms-admin-id") ?? "").trim();
    } catch (error) {
      return "";
    }
  }

  function getActiveAdminTenantId() {
    const employeeSession = readSessionStorageJson(employeeSessionStorageKey);
    const employeeAdminId = resolveAdminTenantIdFromSession(employeeSession, "");
    if (isUsableAdminTenantId(employeeAdminId)) {
      return employeeAdminId;
    }

    const adminSession = readSessionStorageJson(adminSessionStorageKey);
    const adminId = resolveAdminTenantIdFromSession(adminSession, "");
    if (isUsableAdminTenantId(adminId)) {
      return adminId;
    }

    const storedAdminId = getStoredAdminTenantId();
    return isUsableAdminTenantId(storedAdminId) ? storedAdminId : "";
  }

  function shouldAttachAdminTenantHeader(input) {
    const requestUrlValue =
      typeof Request !== "undefined" && input instanceof Request
        ? input.url
        : input;

    if (typeof requestUrlValue !== "string" && !(requestUrlValue instanceof URL)) {
      return false;
    }

    const requestUrl = new URL(requestUrlValue, window.location.href);
    const excludedPaths = new Set([
      "/api/admin-login",
      "/api/super-admin-login",
    ]);

    return requestUrl.origin === window.location.origin
      && requestUrl.pathname.startsWith("/api/")
      && !requestUrl.pathname.startsWith("/api/super-admin/")
      && !excludedPaths.has(requestUrl.pathname);
  }

  function installAdminTenantFetchScope() {
    if (!window.fetch || window.__gmsAdminTenantFetchScopeInstalled) {
      return;
    }

    const nativeFetch = window.fetch.bind(window);
    window.__gmsAdminTenantFetchScopeInstalled = true;
    window.fetch = (input, init = {}) => {
      const adminId = getActiveAdminTenantId();
      if (!adminId || !shouldAttachAdminTenantHeader(input)) {
        return nativeFetch(input, init);
      }

      const requestHeaders =
        typeof Request !== "undefined" && input instanceof Request
          ? input.headers
          : undefined;
      const headers = new Headers(init.headers || requestHeaders || undefined);
      if (!headers.has("X-GMS-Admin-ID")) {
        headers.set("X-GMS-Admin-ID", adminId);
      }

      return nativeFetch(input, {
        ...init,
        headers,
      });
    };
  }

  installAdminTenantFetchScope();

  function normalizeStorageScopePart(value, fallback = "default") {
    const normalized = String(value ?? "")
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9._-]+/g, "-")
      .replace(/^-+|-+$/g, "");

    return normalized || fallback;
  }

  function getFirstScopeValue(source, keys) {
    if (!source || typeof source !== "object") {
      return "";
    }

    for (const key of keys) {
      const value = String(source[key] ?? "").trim();
      if (value) {
        return value;
      }
    }

    return "";
  }

  function hasEmployeeSessionIdentity(session) {
    return Boolean(
      session &&
      typeof session === "object" &&
      (
        session.role === "employee" ||
        session.id ||
        session.accountCode ||
        session.employeeId ||
        session.email ||
        session.position
      ),
    );
  }

  function resolveEmployeeThemeScope(session) {
    if (!hasEmployeeSessionIdentity(session)) {
      return null;
    }

    const accountValue = getFirstScopeValue(session, [
      "employeeId",
      "accountCode",
      "id",
      "email",
      "username",
    ]);

    if (accountValue) {
      const id = normalizeStorageScopePart(accountValue);
      const aliases = [
        session.employeeId,
        session.accountCode,
        session.id,
        session.email,
        session.username,
      ]
        .map((value) => normalizeStorageScopePart(value, ""))
        .filter((value, index, values) => value && value !== id && values.indexOf(value) === index);

      return {
        type: "employee-account",
        id,
        aliases,
        position: normalizeStorageScopePart(session.position, ""),
      };
    }

    return {
      type: "employee-position",
      id: normalizeStorageScopePart(session.position, "employee"),
      position: normalizeStorageScopePart(session.position, "employee"),
    };
  }

  function resolveAdminThemeScope(session) {
    if (!session || typeof session !== "object") {
      return null;
    }

    const accountValue = getFirstScopeValue(session, [
      "adminId",
      "ownerAdminId",
      "tenantId",
      "workspaceId",
      "storeAdminId",
      "sellerId",
      "shopId",
      "id",
      "accountCode",
      "employeeId",
      "email",
      "username",
      "name",
    ]);

    return {
      type: "admin-account",
      id: normalizeStorageScopePart(accountValue, "admin"),
    };
  }

  function resolveSuperAdminThemeScope(session) {
    if (!session || typeof session !== "object") {
      return null;
    }

    const role = String(session.role ?? session.root?.role ?? "").trim().toLowerCase();
    const username = String(session.username ?? session.root?.username ?? "").trim().toLowerCase();

    if (role === "super-admin" || role === "root" || username === "root") {
      return {
        type: "super-admin",
        id: "root",
      };
    }

    return null;
  }

  function isSuperAdminThemePage() {
    const pathname = String(window.location?.pathname ?? "").trim().toLowerCase();
    return Boolean(
      document.body?.classList?.contains("super-admin-page") ||
        /\/(?:super_admin|superadmin_product|user_data|root_login)\.html$/.test(pathname),
    );
  }

  function getActiveThemeStorageScope() {
    const superAdminScope = resolveSuperAdminThemeScope(
      readSessionStorageJson(superAdminSessionStorageKey),
    );

    if (superAdminScope && isSuperAdminThemePage()) {
      return superAdminScope;
    }

    const employeeScope = resolveEmployeeThemeScope(
      readSessionStorageJson(employeeSessionStorageKey),
    );

    if (employeeScope) {
      return employeeScope;
    }

    const adminScope = resolveAdminThemeScope(readSessionStorageJson(adminSessionStorageKey));
    if (adminScope) {
      return adminScope;
    }

    return superAdminScope;
  }

  function getScopedStorageKey(baseKey, scope = getActiveThemeStorageScope()) {
    if (!scope) {
      return baseKey;
    }

    return `${baseKey}:${scope.type}:${scope.id}`;
  }

  function getStorageFallbackKeys(baseKey, scope = getActiveThemeStorageScope()) {
    if (!scope) {
      return [];
    }

    if (scope.type === "employee-account") {
      const accountAliasKeys = Array.isArray(scope.aliases)
        ? scope.aliases.map((alias) => `${baseKey}:employee-account:${alias}`)
        : [];
      const positionKeys = scope.position
        ? [`${baseKey}:employee-position:${scope.position}`]
        : [];

      return [...accountAliasKeys, ...positionKeys];
    }

    if (scope.type === "admin-account") {
      return [baseKey];
    }

    if (scope.type === "super-admin") {
      return [baseKey];
    }

    return [];
  }

  function readScopedStorageConfig(baseKey, normalizeConfig, fallback) {
    const scope = getActiveThemeStorageScope();
    const candidateKeys = [
      getScopedStorageKey(baseKey, scope),
      ...getStorageFallbackKeys(baseKey, scope),
    ].filter((key, index, keys) => key && keys.indexOf(key) === index);

    try {
      for (const key of candidateKeys) {
        const stored = localStorage.getItem(key);
        if (stored) {
          return normalizeConfig(JSON.parse(stored));
        }
      }
    } catch (error) {
      return normalizeConfig(fallback);
    }

    return normalizeConfig(fallback);
  }

  function writeScopedStorageConfig(baseKey, config) {
    try {
      localStorage.setItem(getScopedStorageKey(baseKey), JSON.stringify(config));
    } catch (error) {
      // Ignore storage errors and still apply the theme for this session.
    }
  }

  function removeScopedStorageConfig(baseKey) {
    const scope = getActiveThemeStorageScope();
    const removableFallbackKeys =
      scope?.type === "employee-account"
        ? getStorageFallbackKeys(baseKey, scope).filter(
            (key) => !key.includes(":employee-position:"),
          )
        : [];
    const keysToRemove = [
      getScopedStorageKey(baseKey, scope),
      ...removableFallbackKeys,
      ...(scope?.type === "admin-account" ? [baseKey] : []),
      ...(scope?.type === "super-admin" ? [baseKey] : []),
    ].filter((key, index, keys) => key && keys.indexOf(key) === index);

    try {
      for (const key of keysToRemove) {
        localStorage.removeItem(key);
      }
    } catch (error) {
      // Ignore storage errors and continue with the default config.
    }
  }

  function clampChannel(value, fallback) {
    const number = Number(value);
    if (!Number.isFinite(number)) {
      return fallback;
    }

    return Math.min(255, Math.max(0, Math.round(number)));
  }

  function normalizeColor(input, fallback) {
    return {
      r: clampChannel(input?.r, fallback.r),
      g: clampChannel(input?.g, fallback.g),
      b: clampChannel(input?.b, fallback.b),
    };
  }

  function areColorsEqual(firstColor, secondColor) {
    const first = normalizeColor(firstColor, defaultTheme);
    const second = normalizeColor(secondColor, defaultTheme);

    return first.r === second.r && first.g === second.g && first.b === second.b;
  }

  function normalizeTheme(input) {
    return normalizeColor(input, defaultTheme);
  }

  function clampUnit(value, fallback) {
    const number = Number(value);
    if (!Number.isFinite(number)) {
      return fallback;
    }

    return Math.min(1, Math.max(0, number));
  }

  function normalizeGradientAngle(input) {
    const number = Number(input);
    if (!Number.isFinite(number)) {
      return defaultGradientAngle;
    }

    const normalized = ((number % 360) + 360) % 360;
    return Math.round(normalized);
  }

  function normalizeDashboardBackground(input) {
    return normalizeColor(input, defaultDashboardBackground);
  }

  function mixColors(firstColor, secondColor, ratio = 0.5) {
    const first = normalizeColor(firstColor, defaultDashboardBackground);
    const second = normalizeColor(secondColor, first);
    const weight = clampUnit(ratio, 0.5);

    return {
      r: Math.round(first.r + ((second.r - first.r) * weight)),
      g: Math.round(first.g + ((second.g - first.g) * weight)),
      b: Math.round(first.b + ((second.b - first.b) * weight)),
    };
  }

  function mixWithWhite(value, amount) {
    return Math.round(value + (255 - value) * amount);
  }

  function mixWithBlack(value, amount) {
    return Math.round(value * (1 - amount));
  }

  function toRgb(theme) {
    return `rgb(${theme.r}, ${theme.g}, ${theme.b})`;
  }

  function toRgba(theme, alpha) {
    return `rgba(${theme.r}, ${theme.g}, ${theme.b}, ${alpha})`;
  }

  function buildGradientFill(startTheme, endTheme, options = {}) {
    const angle =
      typeof options.angle === "string" && options.angle.trim()
        ? options.angle
        : `${normalizeGradientAngle(options.angle)}deg`;
    const startStop = clampUnit(options.startStop, 0);
    const endStop = Math.max(clampUnit(options.endStop, 1), Math.min(1, startStop + 0.001));
    const startAlpha = clampUnit(options.startAlpha, 1);
    const endAlpha = clampUnit(options.endAlpha, 1);
    const hasMiddleTheme = Boolean(options.middleTheme);
    const middleStop = hasMiddleTheme
      ? normalizeGradientMiddlePosition(options.middleStop, {
          start: startStop,
          end: endStop,
        })
      : null;
    const middleAlpha = hasMiddleTheme
      ? clampUnit(options.middleAlpha, (startAlpha + endAlpha) / 2)
      : null;

    if (!hasMiddleTheme) {
      return `linear-gradient(
        ${angle},
        ${toRgba(startTheme, startAlpha)} 0%,
        ${toRgba(startTheme, startAlpha)} ${startStop * 100}%,
        ${toRgba(endTheme, endAlpha)} ${endStop * 100}%,
        ${toRgba(endTheme, endAlpha)} 100%
      )`;
    }

    return `linear-gradient(
      ${angle},
      ${toRgba(startTheme, startAlpha)} 0%,
      ${toRgba(startTheme, startAlpha)} ${startStop * 100}%,
      ${toRgba(options.middleTheme, middleAlpha)} ${middleStop * 100}%,
      ${toRgba(endTheme, endAlpha)} ${endStop * 100}%,
      ${toRgba(endTheme, endAlpha)} 100%
    )`;
  }

  function rgbToHex(input, fallback = defaultTheme) {
    const theme = normalizeColor(input, fallback);

    return `#${[theme.r, theme.g, theme.b]
      .map((channel) => channel.toString(16).padStart(2, "0"))
      .join("")
      .toUpperCase()}`;
  }

  function hexToColor(value, fallback) {
    const normalizedValue = String(value ?? "").trim().replace(/^#/, "");

    if (!/^[0-9a-fA-F]{6}$/.test(normalizedValue)) {
      return { ...fallback };
    }

    return {
      r: Number.parseInt(normalizedValue.slice(0, 2), 16),
      g: Number.parseInt(normalizedValue.slice(2, 4), 16),
      b: Number.parseInt(normalizedValue.slice(4, 6), 16),
    };
  }

  function hexToTheme(value) {
    return hexToColor(value, defaultTheme);
  }

  function normalizeWorkspaceColor(value) {
    const normalizedColor = String(value ?? "").trim().toLowerCase();
    return /^#[0-9a-f]{6}$/.test(normalizedColor) ? normalizedColor : "";
  }

  function readCachedWorkspaceColor() {
    try {
      return normalizeWorkspaceColor(window.localStorage.getItem(workspaceColorStorageKey));
    } catch (error) {
      return "";
    }
  }

  function cacheWorkspaceColor(color) {
    try {
      window.localStorage.setItem(workspaceColorStorageKey, color);
    } catch (error) {
      // The server value still applies for this page when browser storage is unavailable.
    }
  }

  function getWorkspaceColor() {
    return currentWorkspaceColor || readCachedWorkspaceColor();
  }

  function applyWorkspaceColor(color, options = {}) {
    const normalizedColor = normalizeWorkspaceColor(color);
    if (!normalizedColor) {
      return "";
    }

    const previousColor = currentWorkspaceColor;
    currentWorkspaceColor = normalizedColor;
    if (options.cache !== false) {
      cacheWorkspaceColor(normalizedColor);
    }

    applyTheme({
      mode: "solid",
      theme: hexToTheme(normalizedColor),
    });

    if (options.dispatch !== false && previousColor !== normalizedColor) {
      window.dispatchEvent(
        new CustomEvent("gms:workspace-color-changed", {
          detail: {
            color: normalizedColor,
            source: String(options.source || "local"),
          },
        }),
      );
    }

    return normalizedColor;
  }

  async function syncWorkspaceColor(options = {}) {
    if (workspaceColorSyncPromise && options.force !== true) {
      return workspaceColorSyncPromise;
    }
    if (typeof window.fetch !== "function") {
      return "";
    }

    const requestRevision = ++workspaceColorRequestRevision;
    const syncPromise = (async () => {
      try {
        const response = await window.fetch(workspaceThemeEndpoint, {
          method: "GET",
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!response.ok) {
          return "";
        }

        const data = await response.json().catch(() => ({}));
        const sharedColor = normalizeWorkspaceColor(
          data?.workspaceColor ?? data?.color,
        );
        if (requestRevision !== workspaceColorRequestRevision) {
          return getWorkspaceColor();
        }
        if (sharedColor) {
          applyWorkspaceColor(sharedColor, {
            source: "server",
          });
        }
        return sharedColor;
      } catch (error) {
        return "";
      }
    })();

    workspaceColorSyncPromise = syncPromise;
    try {
      return await syncPromise;
    } finally {
      if (workspaceColorSyncPromise === syncPromise) {
        workspaceColorSyncPromise = null;
      }
    }
  }

  async function saveWorkspaceColor(color, options = {}) {
    const normalizedColor = normalizeWorkspaceColor(color);
    if (!normalizedColor) {
      throw new TypeError("Workspace color must use a six-digit hex value.");
    }
    if (typeof window.fetch !== "function") {
      throw new Error("Workspace theme service is unavailable.");
    }

    const requestRevision = ++workspaceColorRequestRevision;
    const headers = new Headers(options.headers || undefined);
    headers.set("Accept", "application/json");
    headers.set("Content-Type", "application/json");
    const response = await window.fetch(workspaceThemeEndpoint, {
      method: "PUT",
      headers,
      cache: "no-store",
      body: JSON.stringify({ workspaceColor: normalizedColor }),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(data?.message || "Unable to save workspace color.");
    }

    const savedColor = normalizeWorkspaceColor(
      data?.workspaceColor ?? data?.color,
    ) || normalizedColor;
    if (requestRevision === workspaceColorRequestRevision) {
      applyWorkspaceColor(savedColor, {
        source: "super-admin",
      });
    }
    return savedColor;
  }

  function hexToDashboardBackground(value) {
    return hexToColor(value, defaultDashboardBackground);
  }

  function normalizeIndicatorRange(input) {
    const start = clampUnit(input?.start, defaultIndicatorRange.start);
    const end = clampUnit(input?.end, defaultIndicatorRange.end);

    return {
      start: Math.min(start, Math.max(0, end - 0.08)),
      end: Math.max(end, Math.min(1, start + 0.08)),
    };
  }

  function normalizeGradientMiddlePosition(input, indicatorRange = defaultIndicatorRange) {
    const range = normalizeIndicatorRange(indicatorRange);
    const fallback = (range.start + range.end) / 2;
    const value = clampUnit(input, fallback);
    const min = Math.min(range.start + 0.04, Math.max(0, range.end - 0.001));
    const max = Math.max(range.end - 0.04, Math.min(1, range.start + 0.001));

    return Math.min(max, Math.max(min, value));
  }

  function normalizeGradientOpacity(input) {
    const start = clampUnit(input?.start, defaultGradientOpacity.start);
    const middle = clampUnit(
      input?.middle,
      (start + clampUnit(input?.end, defaultGradientOpacity.end)) / 2,
    );
    const end = clampUnit(input?.end, defaultGradientOpacity.end);

    return {
      start,
      middle,
      end,
    };
  }

  function normalizeGradientPrimaryStop(input, theme = null, gradientStops = null) {
    const explicitStop = String(input ?? "").trim().toLowerCase();
    if (explicitStop === "end") {
      return "end";
    }
    if (explicitStop === "start") {
      return "start";
    }

    if (
      theme &&
      gradientStops &&
      areColorsEqual(theme, gradientStops.end) &&
      !areColorsEqual(theme, gradientStops.start)
    ) {
      return "end";
    }

    return defaultGradientPrimaryStop;
  }

  function normalizeGradientStops(
    input,
    fallbackTheme = defaultTheme,
    middlePosition = defaultGradientMiddlePosition,
  ) {
    const theme = normalizeTheme(fallbackTheme);
    const start = normalizeColor(input?.start, theme);
    const end = normalizeColor(input?.end, theme);
    const middleFallback = mixColors(
      start,
      end,
      clampUnit(middlePosition, defaultGradientMiddlePosition),
    );

    return {
      start,
      middle: normalizeColor(input?.middle, middleFallback),
      end,
    };
  }

  function normalizeThemeConfig(input) {
    const isConfigCandidate =
      input &&
      typeof input === "object" &&
      ("theme" in input ||
        "mode" in input ||
        "gradientStops" in input ||
        "indicatorRange" in input ||
        "gradientMiddleEnabled" in input ||
        "gradientMiddlePosition" in input ||
        "gradientAngle" in input ||
        "gradientOpacity" in input ||
        "gradientPrimaryStop" in input);
    const requestedMode = isConfigCandidate && input.mode === "gradient" ? "gradient" : "solid";
    const fallbackTheme = normalizeTheme(
      isConfigCandidate ? input.theme ?? input.gradientStops?.start : input,
    );
    const indicatorRange = normalizeIndicatorRange(isConfigCandidate ? input.indicatorRange : null);
    const gradientMiddleEnabled = Boolean(isConfigCandidate ? input.gradientMiddleEnabled : false);
    const gradientMiddlePosition = normalizeGradientMiddlePosition(
      isConfigCandidate ? input.gradientMiddlePosition : null,
      indicatorRange,
    );
    const gradientStops = normalizeGradientStops(
      isConfigCandidate ? input.gradientStops : null,
      fallbackTheme,
      gradientMiddlePosition,
    );
    const gradientPrimaryStop = normalizeGradientPrimaryStop(
      isConfigCandidate ? input.gradientPrimaryStop : null,
      isConfigCandidate ? input.theme : null,
      gradientStops,
    );
    const theme =
      requestedMode === "gradient"
        ? normalizeTheme(gradientStops[gradientPrimaryStop])
        : fallbackTheme;

    return {
      theme,
      mode: requestedMode,
      gradientStops,
      indicatorRange,
      gradientMiddleEnabled,
      gradientMiddlePosition,
      gradientAngle: normalizeGradientAngle(isConfigCandidate ? input.gradientAngle : null),
      gradientOpacity: normalizeGradientOpacity(isConfigCandidate ? input.gradientOpacity : null),
      gradientPrimaryStop,
    };
  }

  function normalizeDashboardBackgroundConfig(input) {
    const isConfigCandidate =
      input &&
      typeof input === "object" &&
      ("theme" in input ||
        "mode" in input ||
        "gradientStops" in input ||
        "indicatorRange" in input ||
        "gradientMiddleEnabled" in input ||
        "gradientMiddlePosition" in input ||
        "gradientAngle" in input ||
        "gradientOpacity" in input);
    const theme = normalizeDashboardBackground(
      isConfigCandidate ? input.theme ?? input.gradientStops?.start : input,
    );
    const indicatorRange = normalizeIndicatorRange(isConfigCandidate ? input.indicatorRange : null);
    const gradientMiddleEnabled = Boolean(isConfigCandidate ? input.gradientMiddleEnabled : false);
    const gradientMiddlePosition = normalizeGradientMiddlePosition(
      isConfigCandidate ? input.gradientMiddlePosition : null,
      indicatorRange,
    );
    const gradientStops = normalizeGradientStops(
      isConfigCandidate ? input.gradientStops : null,
      theme,
      gradientMiddlePosition,
    );

    return {
      theme,
      mode: isConfigCandidate && input.mode === "gradient" ? "gradient" : "solid",
      gradientStops,
      indicatorRange,
      gradientMiddleEnabled,
      gradientMiddlePosition,
      gradientAngle: normalizeGradientAngle(isConfigCandidate ? input.gradientAngle : null),
      gradientOpacity: normalizeGradientOpacity(isConfigCandidate ? input.gradientOpacity : null),
    };
  }

  function serializeThemeConfig(input) {
    const config = normalizeThemeConfig(input);
    return {
      theme: { ...config.theme },
      mode: config.mode,
      gradientStops: {
        start: { ...config.gradientStops.start },
        middle: { ...config.gradientStops.middle },
        end: { ...config.gradientStops.end },
      },
      indicatorRange: { ...config.indicatorRange },
      gradientMiddleEnabled: config.gradientMiddleEnabled,
      gradientMiddlePosition: config.gradientMiddlePosition,
      gradientAngle: config.gradientAngle,
      gradientOpacity: { ...config.gradientOpacity },
      gradientPrimaryStop: config.gradientPrimaryStop,
    };
  }

  function serializeDashboardBackgroundConfig(input) {
    const config = normalizeDashboardBackgroundConfig(input);
    return {
      theme: { ...config.theme },
      mode: config.mode,
      gradientStops: {
        start: { ...config.gradientStops.start },
        middle: { ...config.gradientStops.middle },
        end: { ...config.gradientStops.end },

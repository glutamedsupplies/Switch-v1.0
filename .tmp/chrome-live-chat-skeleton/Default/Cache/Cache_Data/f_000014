            class="validation-modal__icon validation-modal__icon--success"
            aria-hidden="true"
            role="presentation"
            tabindex="-1"
          >
            <div class="product-validation-lottie-check" data-admin-success-lottie></div>
          </div>
        </div>
        <div class="validation-modal__body">
          <h2 class="validation-modal__title" id="admin-success-modal-title" data-admin-success-title>Success</h2>
          <p class="validation-modal__copy" data-admin-success-copy></p>
        </div>
      </section>
    `;

    document.body.appendChild(overlay);

    return {
      overlay,
      dialog: overlay.querySelector(".admin-success-modal"),
      icon: overlay.querySelector(".validation-modal__icon"),
      title: overlay.querySelector("[data-admin-success-title]"),
      copy: overlay.querySelector("[data-admin-success-copy]"),
    };
  }

  function getAdminSuccessModalRefs() {
    if (!adminSuccessModalRefs) {
      adminSuccessModalRefs = createAdminSuccessModal();
    }

    return adminSuccessModalRefs;
  }

  function clearAdminSuccessModalCloseTimer() {
    if (adminSuccessModalCloseTimer) {
      window.clearTimeout(adminSuccessModalCloseTimer);
      adminSuccessModalCloseTimer = 0;
    }
  }

  function closeAdminSuccessModal(options = {}) {
    if (!adminSuccessModalRefs) {
      if (typeof options?.onClosed === "function") {
        options.onClosed();
      }
      return;
    }

    clearAdminSuccessModalCloseTimer();
    destroyAdminSuccessModalAnimation();

    const refs = adminSuccessModalRefs;
    refs.overlay.classList.remove("is-open");

    let cleanedUp = false;
    const finishClose = () => {
      if (cleanedUp) {
        return;
      }

      cleanedUp = true;
      refs.overlay.hidden = true;
      refs.overlay.setAttribute("aria-hidden", "true");
      refs.overlay.removeEventListener("transitionend", handleTransitionEnd);
      window.clearTimeout(exitTimer);
      document.body.classList.remove("modal-open");

      if (typeof options?.onClosed === "function") {
        options.onClosed();
      }
    };

    const handleTransitionEnd = (event) => {
      if (event.target === refs.overlay) {
        finishClose();
      }
    };

    refs.overlay.addEventListener("transitionend", handleTransitionEnd);
    const exitTimer = window.setTimeout(finishClose, 300);
  }

  function showAdminSuccessModal(options = {}) {
    if (!document.body) {
      return false;
    }

    const refs = getAdminSuccessModalRefs();
    const title = String(options?.title ?? "Success").trim() || "Success";
    const copy = String(options?.copy ?? "").trim();
    const autoCloseMs = Number.isFinite(Number(options?.autoCloseMs))
      ? Math.max(0, Number(options.autoCloseMs))
      : 2000;

    clearAdminSuccessModalCloseTimer();
    destroyAdminSuccessModalAnimation();
    refs.title.textContent = title;
    refs.copy.textContent = copy;
    refs.copy.hidden = !copy;
    refs.overlay.hidden = false;
    refs.overlay.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
    void playAdminSuccessModalAnimation();

    window.requestAnimationFrame(() => {
      refs.overlay.classList.add("is-open");
      refs.dialog?.focus?.();
    });

    if (autoCloseMs > 0) {
      adminSuccessModalCloseTimer = window.setTimeout(() => {
        adminSuccessModalCloseTimer = 0;
        closeAdminSuccessModal({
          onClosed: typeof options?.onAutoClose === "function" ? options.onAutoClose : null,
        });
      }, autoCloseMs);
    }

    return true;
  }

  applyStoredThemeConfig();
  watchFontAwesomeIcons();

  window.addEventListener("gms-employee-session-updated", refreshActiveThemeStorageScope);
  window.addEventListener("gms-admin-session-updated", refreshActiveThemeStorageScope);
  window.addEventListener("storage", (event) => {
    if (event.key === workspaceColorStorageKey) {
      applyWorkspaceColor(event.newValue, {
        cache: false,
        source: "storage",
      });
      return;
    }
    if (
      event.key === employeeSessionStorageKey ||
      event.key === adminSessionStorageKey
    ) {
      refreshActiveThemeStorageScope();
    }
  });

  window.WebTheme = {
    storageKey,
    dashboardBackgroundStorageKey,
    workspaceColorStorageKey,
    defaultTheme: { ...defaultTheme },
    defaultIndicatorRange: { ...defaultIndicatorRange },
    defaultGradientAngle,
    defaultGradientOpacity: { ...defaultGradientOpacity },
    defaultGradientMiddlePosition,
    defaultGradientPrimaryStop,
    defaultDashboardBackground: { ...defaultDashboardBackground },
    loadTheme,
    loadThemeConfig,
    saveTheme,
    saveThemeConfig,
    resetTheme,
    loadDashboardBackground,
    loadDashboardBackgroundConfig,
    saveDashboardBackground,
    saveDashboardBackgroundConfig,
    resetDashboardBackground,
    refreshActiveThemeStorageScope,
    applyTheme,
    getWorkspaceColor,
    applyWorkspaceColor,
    syncWorkspaceColor,
    saveWorkspaceColor,
    applyDashboardBackground,
    normalizeTheme,
    normalizeThemeConfig,
    normalizeGradientStops,
    normalizeGradientAngle,
    normalizeGradientOpacity,
    normalizeGradientPrimaryStop,
    normalizeGradientMiddlePosition,
    normalizeDashboardBackground,
    normalizeDashboardBackgroundConfig,
    rgbToHex,
    hexToTheme,
    hexToDashboardBackground,
    toRgb,
    applyFontAwesomeIcons,
    getActiveThemeStorageScope,
    getThemeStorageKey: () => getScopedStorageKey(storageKey),
    getDashboardBackgroundStorageKey: () => getScopedStorageKey(dashboardBackgroundStorageKey),
  };

  void syncWorkspaceColor();

  window.GMSAdminSuccessModal = {
    show: showAdminSuccessModal,
    close: closeAdminSuccessModal,
  };
})();

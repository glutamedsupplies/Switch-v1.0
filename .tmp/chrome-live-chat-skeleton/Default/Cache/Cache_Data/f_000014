  function ensureAdminSuccessModalLottiePlayer() {
    if (window.lottie?.loadAnimation) {
      return Promise.resolve(true);
    }

    if (adminSuccessModalLottieLoadPromise) {
      return adminSuccessModalLottieLoadPromise;
    }

    adminSuccessModalLottieLoadPromise = new Promise((resolve) => {
      const existingScript = document.querySelector(
        `script[src$="${adminSuccessModalLottiePlayerUrl}"], script[src*="${adminSuccessModalLottiePlayerUrl}?"]`,
      );
      if (existingScript) {
        existingScript.addEventListener("load", () => resolve(Boolean(window.lottie?.loadAnimation)), { once: true });
        existingScript.addEventListener("error", () => resolve(false), { once: true });
        if (window.lottie?.loadAnimation) {
          resolve(true);
        }
        return;

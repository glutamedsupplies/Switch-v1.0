      isGradientMode ? activeConfig.gradientStops.start : activeTheme;
    const gradientMiddle =
      isGradientMode && activeConfig.gradientMiddleEnabled
        ? activeConfig.gradientStops.middle
        : null;
    const gradientEnd =
      isGradientMode ? activeConfig.gradientStops.end : activeTheme;
    const gradientAngle = normalizeGradientAngle(activeConfig.gradientAngle);
    const gradientRadians = ((gradientAngle - 90) * Math.PI) / 180;
    const gradientX = Math.cos(gradientRadians);
    const gradientY = Math.sin(gradientRadians);
    const x1 = `${((0.5 - gradientX / 2) * 100).toFixed(2)}%`;

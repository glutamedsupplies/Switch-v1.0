    <script>
      (function() {
        try {
          var savedColor = String(localStorage.getItem("gms-workspace-color") || "").trim().toLowerCase();
          if (/^#[0-9a-f]{6}$/i.test(savedColor)) {
            var rgb = savedColor.slice(1).match(/.{2}/g).map(function(part) { return parseInt(part, 16); });
            var rgbStr = rgb.join(", ");
            var contrast = ((rgb[0] * 299 + rgb[1] * 587 + rgb[2] * 114) / 1000) >= 168 ? "#111827" : "#ffffff";
            document.documentElement.style.setProperty("--accent", savedColor);
            document.documentElement.style.setProperty("--accent-rgb", rgbStr);
            document.documentElement.style.setProperty("--accent-strong", savedColor);
            document.documentElement.style.setProperty("--accent-text", savedColor);
            document.documentElement.style.setProperty("--accent-contrast", contrast);
            document.documentElement.style.setProperty("--listing-insight-accent", savedColor);
            document.documentElement.style.setProperty("--listing-insight-accent-rgb", rgbStr);
            document.documentElement.style.setProperty("--listing-insight-accent-muted", "rgba(" + rgbStr + ", 0.075)");
            document.documentElement.style.setProperty("--listing-insight-accent-border", "rgba(" + rgbStr + ", 0.28)");
            document.documentElement.style.setProperty("--listing-insight-accent-contrast", contrast);
          }
        } catch (error) {}
      })();
    </script>

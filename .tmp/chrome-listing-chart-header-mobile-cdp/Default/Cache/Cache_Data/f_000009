                    data-product-insight-side-view="trend"
                    aria-pressed="false"
                  >
                    Trend
                  </button>
                </div>

                <div class="product-insight-side-detail" id="product-insight-side-detail">
                  <div class="empty-state">
                    Click a product row to review its performance details.
                  </div>
                </div>
              </section>
            </div>

            <button
              type="button"
              class="listing-insight-drawer-backdrop"
              aria-label="Close product details"
              data-listing-insight-close
            ></button>
          </section>

          <section
            class="listing-insight-product-detail"
            aria-label="Selected listing insight"
            role="dialog"
            aria-modal="true"
            aria-labelledby="listing-insight-detail-title"
            data-listing-insight-product-detail
            hidden
          >
            <header class="listing-insight-detail-toolbar">
              <div class="listing-insight-detail-toolbar__identity">
                <span class="listing-insight-detail-toolbar__icon listing-insight-detail-toolbar__icon--analytics" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-no-axes-combined-icon lucide-chart-no-axes-combined">
                    <path d="M12 16v5"/><path d="M16 14.639V21"/><path d="M20 10.656V21"/><path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"/><path d="M4 18.463V21"/><path d="M8 14.656V21"/>
                  </svg>
                </span>
                <div class="listing-insight-detail-toolbar__copy">
                  <h2 id="listing-insight-detail-title">Listing Insight</h2>
                  <p>
                    Review sales, revenue, performance, and customer feedback for
                    <strong data-listing-insight-detail-breadcrumb>Product</strong>.
                  </p>
                </div>
              </div>

              <div class="listing-insight-detail-toolbar__actions">
                <label class="listing-insight-detail-range">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 10h18" />
                  </svg>
                  <select aria-label="Listing insight timeframe" data-listing-insight-detail-range>
                    <option value="all">Overall</option>
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="monthly">Monthly</option>
                    <option value="yearly">Yearly</option>
                  </select>
                </label>

                <button
                  type="button"
                  class="listing-insight-detail-close"
                  aria-label="Close listing insight"
                  title="Close listing insight"
                  data-listing-insight-detail-back
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                  </svg>
                  <span>Close listing insight</span>
                </button>
              </div>
            </header>

            <div class="listing-insight-detail-content" data-listing-insight-detail-content></div>
          </section>
        </div>
      </div>
    </main>

    <script src="/admin_navigation.js?v=seller-square-pen-1"></script>
    <script src="/theme.js?v=shared-workspace-color-1"></script>
    <script src="/settings-menu.js?v=seller-square-pen-1"></script>
    <script src="/admin-search-not-found.js?v=admin-search-not-found-1"></script>
    <script src="/product_insight.js?v=listing-chart-header-filter-1"></script>
  </body>
</html>

          <span class="lcx-thread__order">${orderId ? `Order #${liveChatEscape(orderId)}` : "Customer inquiry"}</span>
          <span class="lcx-thread__bottomline">
            <span class="lcx-thread__preview">${liveChatEscape(conversation.preview)}</span>

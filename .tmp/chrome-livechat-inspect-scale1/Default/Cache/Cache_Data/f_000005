      productListingFrameLastHeight = contentHeight;
      const nextHeight = `${contentHeight}px`;
      frame.style.setProperty("--main-listing-frame-height", nextHeight);
      frame.style.height = nextHeight;
      frame.setAttribute("scrolling", "no");

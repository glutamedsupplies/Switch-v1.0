body.modal-open {
  overflow: hidden;
  overscroll-behavior: none;
}

.employee-account-settings-overlay,
.employee-account-settings-overlay *,
.employee-account-settings-overlay *::before,
.employee-account-settings-overlay *::after {
  box-sizing: border-box;
}

.employee-account-settings-overlay {
  position: fixed;
  inset: 0;
  z-index: 4000;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.46);
  opacity: 0;
  pointer-events: none;
  -webkit-backdrop-filter: blur(0);
  backdrop-filter: blur(0);
  transition: opacity 180ms ease, backdrop-filter 180ms ease;
}

.employee-account-settings-overlay.is-open {
  opacity: 1;
  pointer-events: auto;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}

.employee-account-settings-overlay[hidden],
.employee-account-settings-overlay [hidden] {
  display: none !important;
}

.employee-account-settings-modal {
  width: min(960px, 100%);
  min-width: 0;
  max-height: min(760px, calc(100dvh - 48px));
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 8px;
  background: #ffffff;
  color: #172033;
  font-family: var(--main-font, "Poppins", "Segoe UI", sans-serif);
  box-shadow: 0 28px 72px rgba(15, 23, 42, 0.24);
  transform: translateY(10px) scale(0.985);
  transition: transform 180ms ease;
}

.employee-account-settings-overlay.is-open .employee-account-settings-modal {
  transform: translateY(0) scale(1);
}

.employee-account-settings-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 66px;
  padding: 14px 20px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.employee-account-settings-modal__header h2 {
  margin: 0;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0;
}

.employee-account-settings-modal__close,
.employee-account-settings-photo-viewer__close,
.admin-account-settings-validation-overlay .validation-modal__close {
  display: inline-grid;
  width: 38px;
  height: 38px;
  min-width: 38px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: #e5e7eb;
  color: #334155;
  cursor: pointer;
  box-shadow: none;
}

.employee-account-settings-modal__close:hover,
.employee-account-settings-modal__close:focus-visible,
.employee-account-settings-photo-viewer__close:hover,
.employee-account-settings-photo-viewer__close:focus-visible,
.admin-account-settings-validation-overlay .validation-modal__close:hover,
.admin-account-settings-validation-overlay .validation-modal__close:focus-visible {
  background: #475569;
  color: #ffffff;
  outline: none;
}

.employee-account-settings-modal__close svg,
.employee-account-settings-photo-viewer__close svg,
.admin-account-settings-validation-overlay .validation-modal__close svg {
  width: 18px;
  height: 18px;
}

.employee-account-settings-modal__form {
  width: 100%;
  min-height: 0;
  min-width: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  gap: 16px;
  overflow: auto;
  padding: 16px 20px 20px;
}

.admin-account-settings-tabs {
  width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4px;
  padding: 4px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 8px;
  background: #f1f5f9;
}

.admin-account-settings-tab {
  min-width: 0;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 12px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #64748b;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0;
  text-align: center;
  cursor: pointer;
}

.admin-account-settings-tab svg {
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
}

.admin-account-settings-tab span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.admin-account-settings-tab:hover,
.admin-account-settings-tab:focus-visible {
  color: #172033;
  outline: none;
}

.admin-account-settings-tab.is-active {
  background: #ffffff;
  color: var(--accent, #159ab1);
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.1);
}

.admin-account-settings-panel {
  min-height: 0;
}

.employee-account-settings-layout {
  display: grid;
  grid-template-columns: minmax(190px, 224px) minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}

.employee-account-settings-profile {
  min-width: 0;
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 16px;
  padding: 6px 22px 12px 2px;
  border-right: 1px solid rgba(148, 163, 184, 0.22);
}

.employee-account-settings-profile h3,
.employee-account-settings-basic h3 {
  width: 100%;
  margin: 0 0 4px;
  color: #172033;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0;
}

.employee-account-settings-profile h3 {
  text-align: center;
}

.employee-account-settings-profile__avatar-wrap {
  position: relative;
  display: inline-grid;
  place-items: center;
}

.employee-account-settings-profile__avatar-button {
  display: inline-grid;
  width: 116px;
  height: 116px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
}

.employee-account-settings-profile__avatar-button:hover,
.employee-account-settings-profile__avatar-button:focus-visible,
.employee-account-settings-profile__avatar-wrap.is-open .employee-account-settings-profile__avatar-button {
  outline: none;
  box-shadow: 0 0 0 4px rgba(var(--accent-rgb, 21, 154, 177), 0.13);
}

.employee-account-settings-profile__avatar-button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.employee-account-settings-profile__avatar {
  display: inline-grid;
  width: 116px;
  height: 116px;
  overflow: hidden;
  place-items: center;
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 50%;
  background: #e2e8f0;
  color: #475569;
  font-size: 30px;
  font-weight: 700;
}

.employee-account-settings-profile__avatar img,
.employee-account-settings-profile__avatar [data-admin-account-settings-avatar-fallback] {
  width: 100%;
  height: 100%;
}

.employee-account-settings-profile__avatar img {
  display: block;
  object-fit: cover;
  background: transparent;
}

.employee-account-settings-profile__avatar [data-admin-account-settings-avatar-fallback] {
  display: grid;
  place-items: center;
}

.employee-account-settings-avatar-remove {
  position: absolute;
  top: -3px;
  right: -3px;
  z-index: 2;
  display: inline-grid;
  width: 28px;
  height: 28px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: #e5e7eb;
  color: #475569;
  cursor: pointer;
}

.employee-account-settings-avatar-remove svg {
  width: 14px;
  height: 14px;
}

.employee-account-settings-avatar-remove:hover,
.employee-account-settings-avatar-remove:focus-visible {
  background: #475569;
  color: #ffffff;
  outline: none;
}

.employee-account-settings-profile__menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 50%;
  z-index: 4;
  width: max-content;
  min-width: 218px;
  padding: 6px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.16);
  transform: translateX(-50%);
}

.employee-account-settings-profile__menu button {
  width: 100%;
  min-height: 38px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #334155;
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}

.employee-account-settings-profile__menu button:hover,
.employee-account-settings-profile__menu button:focus-visible {
  background: #f1f5f9;
  outline: none;
}

.employee-account-settings-profile__menu svg {
  flex: 0 0 17px;
  width: 17px;
  height: 17px;
  color: #64748b;
}

.employee-account-settings-profile__identity {
  min-width: 0;
  max-width: 100%;
  display: grid;
  justify-items: center;
  gap: 3px;
}

.employee-account-settings-profile__name {
  max-width: 100%;
  color: #172033;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
  overflow-wrap: anywhere;
}

.employee-account-settings-profile__position {
  color: var(--accent, #159ab1);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.employee-account-settings-profile__since {
  margin-top: 8px;
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.3;
  text-align: center;
}

.employee-account-settings-basic {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 13px;
}

.employee-account-settings-contact-grid,
.employee-account-settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.employee-account-settings-field {
  position: relative;
  min-width: 0;
  display: grid;
  gap: 7px;
  color: #334155;
  font-size: 12px;
  font-weight: 600;
}

.employee-account-settings-field--full {
  grid-column: 1 / -1;
}

.employee-account-settings-editable-field {
  position: relative;
  display: block;
  min-width: 0;
}

.employee-account-settings-field input,
.employee-account-settings-phone-field {
  width: 100%;
  height: 48px;
  min-height: 48px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: #f1f5f9;
  color: #172033;
  box-shadow: none;
}

.employee-account-settings-field input {
  min-width: 0;
  padding: 12px 14px;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  outline: none;
}

.employee-account-settings-editable-field input {
  padding-right: 48px;
}

.employee-account-settings-field input:disabled {
  cursor: default;
  opacity: 1;
  color: #64748b;
  -webkit-text-fill-color: #64748b;
}

.employee-account-settings-field.is-editable input:not(:disabled),
.employee-account-settings-phone-field:focus-within {
  border-color: rgba(var(--accent-rgb, 21, 154, 177), 0.46);
  background: #ffffff;
}

.employee-account-settings-field-edit {
  position: absolute;
  top: 50%;
  right: 8px;
  width: 32px;
  height: 32px;
  display: inline-grid;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  transform: translateY(-50%);
}

.employee-account-settings-field-edit svg {
  width: 16px;
  height: 16px;
}

.employee-account-settings-field-edit:hover,
.employee-account-settings-field-edit:focus-visible,
.employee-account-settings-field-edit.is-active {
  background: rgba(var(--accent-rgb, 21, 154, 177), 0.11);
  color: var(--accent, #159ab1);
  outline: none;
}

.employee-account-settings-phone-field {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  padding: 0 8px 0 13px;
}

.employee-account-settings-phone-field__prefix {
  color: #64748b;
  font-size: 13px;
  font-weight: 600;
}

.employee-account-settings-phone-field input {
  height: 46px;
  min-height: 46px;
  padding: 10px 8px;
  border: 0;
  background: transparent;
}

.employee-account-settings-field-edit--phone {
  position: static;
  transform: none;
}

.employee-account-settings-field.is-invalid input,
.employee-account-settings-field.is-invalid .employee-account-settings-phone-field {
  border-color: rgba(185, 28, 28, 0.72);
}

.employee-account-settings-field[data-account-tooltip]::after {
  content: attr(data-account-tooltip);
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 8;
  max-width: min(300px, calc(100vw - 48px));
  padding: 7px 9px;
  border-radius: 6px;
  background: #b91c1c;
  color: #ffffff;
  font-size: 11px;
  line-height: 1.35;
  white-space: normal;
  box-shadow: 0 10px 24px rgba(185, 28, 28, 0.22);
}

.admin-account-settings-summary {
  align-content: start;
  overflow: auto;
}

.admin-account-settings-plan-hero {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  padding: 18px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
  background: rgba(var(--accent-rgb, 21, 154, 177), 0.07);
}

.admin-account-settings-plan-hero__icon,
.admin-account-settings-summary__icon {
  display: inline-grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 50%;
  background: rgba(var(--accent-rgb, 21, 154, 177), 0.13);
  color: var(--accent, #159ab1);
}

.admin-account-settings-plan-hero__icon svg,
.admin-account-settings-summary__icon svg {
  width: 21px;
  height: 21px;
}

.admin-account-settings-plan-hero__copy {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.admin-account-settings-plan-hero__copy > span {
  color: #64748b;
  font-size: 12px;
}

.admin-account-settings-plan-hero__copy strong {
  color: #172033;
  font-size: 20px;
  font-weight: 650;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.admin-account-settings-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #15803d;
  font-size: 12px;
  font-weight: 700;
  text-transform: capitalize;
}

.admin-account-settings-status::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
}

.admin-account-settings-summary__heading {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 4px 2px 16px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

.admin-account-settings-summary__heading > div {
  min-width: 0;
}

.admin-account-settings-summary__heading h3 {
  margin: 0;
  color: #172033;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0;
}

.admin-account-settings-summary__heading p {
  margin: 3px 0 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.45;
}

.admin-account-settings-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 0;
}

.admin-account-settings-detail-grid > div {
  min-width: 0;
  display: grid;
  gap: 5px;
  padding: 16px 18px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.admin-account-settings-detail-grid > div:nth-child(odd) {
  border-right: 1px solid rgba(148, 163, 184, 0.18);
}

.admin-account-settings-detail-grid dt {
  color: #64748b;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.3;
}

.admin-account-settings-detail-grid dd {
  min-width: 0;
  margin: 0;
  color: #172033;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.employee-account-settings-feedback {
  min-height: 17px;
  margin: 0;
  color: #64748b;
  font-size: 12px;
}

.employee-account-settings-feedback:empty {
  display: none;
}

.employee-account-settings-feedback.is-error {
  color: #b91c1c;
}

.employee-account-settings-modal__actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  padding-top: 2px;
}

.employee-account-settings-secondary,
.employee-account-settings-primary,
.admin-account-settings-validation-overlay .validation-modal__action-button {
  min-height: 40px;
  padding: 9px 15px;
  border-radius: 8px;
  font: inherit;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
}

.employee-account-settings-secondary,
.admin-account-settings-validation-overlay .validation-modal__action-button {
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: #ffffff;
  color: #334155;
}

.employee-account-settings-primary {
  border: 0;
  background: var(--accent, #159ab1);
  color: #ffffff;
}

.employee-account-settings-secondary:hover,
.employee-account-settings-secondary:focus-visible,
.admin-account-settings-validation-overlay .validation-modal__action-button:hover,
.admin-account-settings-validation-overlay .validation-modal__action-button:focus-visible {
  background: #f1f5f9;
  outline: none;
}

.employee-account-settings-primary:hover,
.employee-account-settings-primary:focus-visible {
  filter: brightness(0.94);
  outline: none;
}

.employee-account-settings-secondary:disabled,
.employee-account-settings-primary:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.employee-account-settings-photo-viewer {
  position: fixed;
  inset: 0;
  z-index: 4020;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.58);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

.employee-account-settings-photo-viewer__dialog {
  position: relative;
  width: min(390px, 100%);
  padding: 42px 24px 24px;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.28);
}

.employee-account-settings-photo-viewer__close {
  position: absolute;
  top: 12px;
  right: 12px;
}

.employee-account-settings-photo-viewer img {
  display: block;
  width: min(300px, 100%);
  aspect-ratio: 1;
  margin: 0 auto;
  border-radius: 50%;
  object-fit: cover;
  background: transparent;
}

.admin-account-settings-validation-overlay {
  position: fixed;
  inset: 0;
  z-index: 4040;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.52);
  opacity: 0;
  pointer-events: none;
  -webkit-backdrop-filter: blur(0);
  backdrop-filter: blur(0);
  transition: opacity 180ms ease, backdrop-filter 180ms ease;
}

.admin-account-settings-validation-overlay.is-open {
  opacity: 1;
  pointer-events: auto;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}

.admin-account-settings-validation-overlay .validation-modal {
  position: relative;
  width: min(410px, 100%);
  padding: 22px;
  border-radius: 8px;
  background: #ffffff;
  color: #172033;
  text-align: center;
  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.28);
}

.admin-account-settings-validation-overlay .validation-modal__close {
  position: absolute;
  top: 14px;
  right: 14px;
}

.admin-account-settings-validation-overlay .validation-modal__top {
  display: flex;
  justify-content: center;
}

.admin-account-settings-validation-overlay .validation-modal__icon {
  width: 138px;
  height: 138px;
  display: grid;
  place-items: center;
  color: #d99b14;
}

.admin-account-settings-validation-overlay .validation-modal__icon svg,
.employee-account-settings-lottie-check {
  width: 138px;
  height: 138px;
}

.admin-account-settings-validation-overlay .validation-modal__body {
  margin-top: 10px;
}

.admin-account-settings-validation-overlay .validation-modal__title {
  margin: 0;
  font-size: 22px;
  font-weight: 600;
  letter-spacing: 0;
}

.admin-account-settings-validation-overlay .validation-modal__copy {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.55;
}

.admin-account-settings-validation-overlay .validation-modal__actions {
  display: flex;
  justify-content: center;
  margin-top: 18px;
}

@media (max-width: 720px) {
  .employee-account-settings-overlay {
    padding: 12px;
  }

  .employee-account-settings-modal {
    max-height: calc(100dvh - 24px);
  }

  .employee-account-settings-layout {
    grid-template-columns: 1fr;
  }

  .employee-account-settings-profile {
    grid-template-columns: auto minmax(0, 1fr);
    justify-items: start;
    align-items: center;
    padding: 2px 0 16px;
    border-right: 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
  }

  .employee-account-settings-profile h3,
  .employee-account-settings-profile > input {
    grid-column: 1 / -1;
  }

  .employee-account-settings-profile h3 {
    text-align: left;
  }

  .employee-account-settings-profile__identity {
    justify-items: start;
  }

  .employee-account-settings-profile__name,
  .employee-account-settings-profile__position,
  .employee-account-settings-profile__since {
    text-align: left;
  }
}

@media (max-width: 540px) {
  .employee-account-settings-overlay {
    padding: 8px;
  }

  .employee-account-settings-modal {
    width: calc(100vw - 16px);
    max-width: calc(100vw - 16px);
    max-height: calc(100dvh - 16px);
  }

  .employee-account-settings-modal__header {
    min-height: 58px;
    padding: 10px 12px;
  }

  .employee-account-settings-modal__header h2 {
    font-size: 17px;
  }

  .employee-account-settings-modal__form {
    gap: 13px;
    overflow-x: hidden;
    padding: 12px;
  }

  .admin-account-settings-tab {
    min-height: 48px;
    flex-direction: column;
    gap: 3px;
    padding: 6px 4px;
    font-size: 10px;
  }

  .admin-account-settings-summary__heading {
    align-items: flex-start;
  }

  .admin-account-settings-summary__heading p {
    overflow-wrap: anywhere;
  }

  .admin-account-settings-tab svg {
    width: 16px;
    height: 16px;
  }

  .employee-account-settings-contact-grid,
  .employee-account-settings-grid,
  .admin-account-settings-detail-grid {
    grid-template-columns: 1fr;
  }

  .admin-account-settings-detail-grid > div:nth-child(odd) {
    border-right: 0;
  }

  .admin-account-settings-plan-hero {
    grid-template-columns: auto minmax(0, 1fr);
    padding: 14px;
  }

  .admin-account-settings-status {
    grid-column: 2;
  }

  .employee-account-settings-modal__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .employee-account-settings-secondary,
  .employee-account-settings-primary {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .employee-account-settings-overlay,
  .employee-account-settings-modal,
  .admin-account-settings-validation-overlay {
    transition: none;
  }
}

body.main-orders-embedded .main-orders-detail-timeline__list li.is-active .main-orders-detail-timeline__marker {
  border-color: #1686bc;
  box-shadow: 0 0 0 3px rgba(22, 134, 188, 0.12);
}

body.main-orders-embedded .main-orders-detail-timeline__list li.is-active strong {
  color: #176f9a;
}

body.main-orders-embedded .main-orders-detail-timeline__list li.is-complete:not(:last-child)::before {
  background: #8fd3aa;
}

body.main-orders-embedded .main-orders-detail-timeline__list li strong {
  color: #344054;
  font-size: 9px;
  font-weight: 650;
}

body.main-orders-embedded .main-orders-detail-timeline__list li > span:last-child {
  max-width: 100px;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.main-orders-embedded .main-orders-detail-items__table {
  display: grid;
}

body.main-orders-embedded .main-orders-detail-item {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 90px 54px 100px;
  align-items: center;
  gap: 10px;
  min-height: 50px;
  padding: 7px 12px;
  border-bottom: 1px solid #edf0f4;
  color: #344054;
  font-size: 9px;
}

body.main-orders-embedded .main-orders-detail-item__product {
  min-width: 0;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
}

body.main-orders-embedded .main-orders-detail-item__image {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: 1px solid #e1e6ed;
  border-radius: 5px;
  background: #f2f4f7;
  color: #667085;
  font-size: 10px;
  font-weight: 700;
}

body.main-orders-embedded .main-orders-detail-item__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

body.main-orders-embedded .main-orders-detail-item__product > div {
  min-width: 0;
  display: grid;
  gap: 2px;
}

body.main-orders-embedded .main-orders-detail-item__product strong,
body.main-orders-embedded .main-orders-detail-item__product span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.main-orders-embedded .main-orders-detail-item__product strong {
  color: var(--main-orders-ink);
  font-size: 9px;
}

body.main-orders-embedded .main-orders-detail-item__product span {
  color: var(--main-orders-muted);
  font-size: 8px;
}

body.main-orders-embedded .main-orders-detail-item > strong {
  text-align: right;
}

body.main-orders-embedded .main-orders-detail-items__totals {
  width: min(310px, 100%);
  display: grid;
  gap: 6px;
  margin-left: auto;
  padding: 10px 12px 12px;
}

@media (max-width: 1080px) {
  body.main-orders-embedded .main-orders-detail-layout {
    grid-template-columns: minmax(0, 1fr) minmax(230px, 260px);
  }

  body.main-orders-embedded .main-orders-detail-info-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  body.main-orders-embedded .main-orders-detail-delivery__body {
    grid-template-columns: minmax(150px, 0.72fr) minmax(220px, 1.28fr);
  }
}

@media (max-width: 820px) {
  body.main-orders-embedded .main-orders-detail-shell {
    padding: 14px;
  }

  body.main-orders-embedded .main-orders-detail-top {
    align-items: stretch;
    flex-direction: column;
  }

  body.main-orders-embedded .main-orders-detail-top h1 {
    max-width: calc(100vw - 110px);
  }

  body.main-orders-embedded .main-orders-detail-top__actions {
    min-width: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: stretch;
  }

  body.main-orders-embedded .main-orders-detail-layout {
    grid-template-columns: minmax(0, 1fr);
  }

  body.main-orders-embedded .main-orders-detail-sidebar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  body.main-orders-embedded .main-orders-detail-timeline {
    grid-column: 1 / -1;
  }
}

@media (max-width: 620px) {
  body.main-orders-embedded .main-orders-detail-shell {
    gap: 11px;
    padding: 11px;
  }

  body.main-orders-embedded .main-orders-detail-top__title {
    width: 100%;
    gap: 8px;
  }

  body.main-orders-embedded .main-orders-detail-top__title > div {
    width: calc(100% - 42px);
  }

  body.main-orders-embedded .main-orders-detail-top__title-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 5px;
  }

  body.main-orders-embedded .main-orders-detail-top h1 {
    width: 100%;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
    font-size: 16px;
  }

  body.main-orders-embedded .main-orders-detail-top__actions {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  body.main-orders-embedded .main-orders-detail-button {
    min-width: 0;
  }

  body.main-orders-embedded .main-orders-detail-button span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  body.main-orders-embedded .main-orders-detail-progress {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding: 4px 10px;
  }

  body.main-orders-embedded .main-orders-detail-progress__step {
    min-height: 40px;
    grid-template-columns: 24px minmax(0, 1fr) minmax(72px, 110px);
    align-items: center;
    justify-items: start;
    gap: 8px;
    padding: 4px 0;
    text-align: left;
  }

  body.main-orders-embedded .main-orders-detail-progress__step::before,
  body.main-orders-embedded .main-orders-detail-progress__step::after {
    top: auto;
    right: auto;
    left: 10px;
    width: 2px;
    height: 50%;
  }

  body.main-orders-embedded .main-orders-detail-progress__step::before {
    top: 0;
  }

  body.main-orders-embedded .main-orders-detail-progress__step::after {
    top: 50%;
  }

  body.main-orders-embedded .main-orders-detail-progress__step strong,
  body.main-orders-embedded .main-orders-detail-progress__step small {
    max-width: 100%;
    white-space: normal;
  }

  body.main-orders-embedded .main-orders-detail-progress__step small {
    justify-self: end;
    text-align: right;
  }

  body.main-orders-embedded .main-orders-detail-notice {
    align-items: stretch;
    flex-direction: column;
  }

  body.main-orders-embedded .main-orders-detail-info-grid,
  body.main-orders-embedded .main-orders-detail-sidebar,
  body.main-orders-embedded .main-orders-detail-delivery__body {
    grid-template-columns: minmax(0, 1fr);
  }

  body.main-orders-embedded .main-orders-detail-map,
  body.main-orders-embedded .main-orders-detail-map .insight-tracking-map__frame {
    min-height: 210px;
  }

  body.main-orders-embedded .main-orders-detail-timeline {
    grid-column: auto;
  }

  body.main-orders-embedded .main-orders-detail-item {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
    padding: 10px 12px;
  }

  body.main-orders-embedded .main-orders-detail-item__product {
    grid-column: 1 / -1;
  }

  body.main-orders-embedded .main-orders-detail-item > [data-label]::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 3px;
    color: #98a2b3;
    font-size: 7px;
    font-weight: 700;
    text-transform: uppercase;
  }

  body.main-orders-embedded .main-orders-detail-item > strong {
    text-align: left;
  }
}

@media print {
  body.order-insight-page.main-orders-embedded {
    height: auto !important;
    overflow: visible !important;
    background: #ffffff !important;
  }

  body.main-orders-embedded .main-orders-detail-view,
  body.main-orders-embedded .main-orders-detail-shell {
    height: auto !important;
    overflow: visible !important;
    background: #ffffff !important;
  }

  body.main-orders-embedded .main-orders-detail-back,
  body.main-orders-embedded .main-orders-detail-top__actions,
  body.main-orders-embedded .main-orders-detail-notice .main-orders-detail-button,
  body.main-orders-embedded .main-orders-detail-panel__heading .main-orders-detail-button {
    display: none !important;
  }
}

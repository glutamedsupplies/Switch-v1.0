/* Main dashboard Live Orders view. The standalone Order Insight layout remains unchanged. */
html.order-insight-page-root:has(body.main-orders-embedded),
body.order-insight-page.main-orders-embedded {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 100%;
  min-height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #f5f7fa;
}

body.order-insight-page.main-orders-embedded {
  --main-orders-accent: #0b9897;
  --main-orders-ink: #101828;
  --main-orders-muted: #667085;
  --main-orders-line: #e7ebf1;
  padding: 0 !important;
}

body.main-orders-embedded .dashboard-sidebar,
body.main-orders-embedded .dashboard-content > .hero,
body.main-orders-embedded .insight-tracking-panel,
body.main-orders-embedded .insight-order-detail-panel,
body.main-orders-embedded .order-insight-scroll-proxy {
  display: none !important;
}

body.order-insight-page.main-orders-embedded.admin-super-sidebar-enabled .dashboard-shell--panel-nav .dashboard-sidebar,
body.order-insight-page.main-orders-embedded.admin-super-header-enabled .dashboard-content > .hero.admin-super-header {
  display: none !important;
}

body.order-insight-page.main-orders-embedded.admin-super-sidebar-enabled .dashboard-shell--panel-nav > .dashboard-layout {
  display: block !important;
  grid-template-columns: minmax(0, 1fr) !important;
}

body.main-orders-embedded .order-insight-shell.page-shell,
body.main-orders-embedded .dashboard-layout,
body.main-orders-embedded .dashboard-content,
body.main-orders-embedded .insight-main-grid {
  width: 100% !important;
  max-width: none !important;
  height: 100% !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
}

body.main-orders-embedded .dashboard-layout,
body.main-orders-embedded .dashboard-content,
body.main-orders-embedded .insight-main-grid {
  display: block !important;
}

body.main-orders-embedded .insight-main-grid > .insight-order-list-shell.dashboard-panel {
  width: 100% !important;
  max-width: none !important;
  height: 100% !important;
  min-height: 0 !important;
  display: grid !important;
  grid-template-rows: auto auto auto auto minmax(0, 1fr) auto !important;
  gap: 0 !important;
  border: 1px solid var(--main-orders-line) !important;
  border-radius: 8px !important;
  background: #ffffff !important;
  overflow: hidden !important;
}

.main-orders-heading,
.main-orders-summary,
.main-orders-table-heading,
.main-orders-pagination,
.main-orders-filter-trigger {
  display: none;
}

body.main-orders-embedded .main-orders-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 20px 14px;
  background: #ffffff;
}

body.main-orders-embedded .main-orders-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

body.main-orders-embedded .main-orders-title-line h1 {
  margin: 0;
  color: var(--main-orders-ink);
  font-size: 24px;
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: 0;
}

body.main-orders-embedded .main-orders-heading p {
  margin: 5px 0 0;
  color: var(--main-orders-muted);
  font-size: 13px;
  line-height: 1.45;
}

body.main-orders-embedded .main-orders-heading .main-orders-updated {
  margin-top: 4px;
  white-space: nowrap;
  font-size: 12px;
}

body.main-orders-embedded .main-orders-live-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 24px;
  padding: 3px 8px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #087443;
  font-size: 11px;
  font-weight: 700;
}

body.main-orders-embedded .main-orders-live-badge > span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #16a36a;
}

body.main-orders-embedded .main-orders-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  padding: 0 20px 16px;
  background: #ffffff;
}

body.main-orders-embedded .main-orders-summary-card {
  min-width: 0;
  min-height: 96px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px;
  border: 1px solid var(--main-orders-line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 5px 14px rgba(16, 24, 40, 0.05);
}

body.main-orders-embedded .main-orders-summary-card__icon {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e8f8f7;
  color: #078b89;
}

body.main-orders-embedded .main-orders-summary-card.is-pending .main-orders-summary-card__icon {
  background: #fff7df;
  color: #d79a00;
}

body.main-orders-embedded .main-orders-summary-card.is-processing .main-orders-summary-card__icon {
  background: #f2ebff;
  color: #805ad5;
}

body.main-orders-embedded .main-orders-summary-card.is-delivery .main-orders-summary-card__icon {
  background: #e8f6ff;
  color: #1686bc;
}

body.main-orders-embedded .main-orders-summary-card__icon svg {
  width: 23px;
  height: 23px;
}

body.main-orders-embedded .main-orders-summary-card__copy {
  min-width: 0;
  display: grid;
  gap: 2px;
}

body.main-orders-embedded .main-orders-summary-card__copy > span,
body.main-orders-embedded .main-orders-summary-card__copy > small {
  overflow: hidden;
  color: var(--main-orders-muted);
  font-size: 11px;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.main-orders-embedded .main-orders-summary-card__copy > strong {
  color: var(--main-orders-ink);
  font-size: 24px;
  line-height: 1.1;
}

body.main-orders-embedded .insight-order-controls-panel.dashboard-panel {
  z-index: 20;
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  border: 0 !important;
  border-top: 1px solid var(--main-orders-line) !important;
  border-bottom: 1px solid var(--main-orders-line) !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  overflow: visible !important;
}

body.main-orders-embedded .insight-courier-tabs {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  padding: 11px 20px 9px;
  border-bottom: 1px solid var(--main-orders-line);
  overflow-x: auto;
  scrollbar-width: none;
}

body.main-orders-embedded .insight-courier-tabs::-webkit-scrollbar {
  display: none;
}

body.main-orders-embedded .insight-courier-tabs .product-form-section-carousel__button {
  min-width: max-content;
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: #ffffff;
  color: #344054;
  box-shadow: none;
  font-size: 12px;
  font-weight: 650;
}

body.main-orders-embedded .insight-courier-tabs .product-form-section-carousel__button:hover,
body.main-orders-embedded .insight-courier-tabs .product-form-section-carousel__button:focus-visible {
  border-color: #b9dede;
  background: #f4fbfb;
  outline: none;
}

body.main-orders-embedded .insight-courier-tabs .product-form-section-carousel__button.is-active {
  border-color: var(--main-orders-accent);
  background: var(--main-orders-accent);
  color: #ffffff;
}

body.main-orders-embedded .main-orders-tab-count {
  min-width: 20px;
  height: 20px;
  display: inline-grid;
  place-items: center;
  padding-inline: 5px;
  border-radius: 999px;
  background: #f2f4f7;
  color: #667085;
  font-size: 10px;
}

body.main-orders-embedded .insight-courier-tabs .is-active .main-orders-tab-count {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

body.main-orders-embedded .insight-order-tools {
  display: flex;
  align-items: center;
  align-content: flex-start;
  gap: 10px;
  padding: 11px 20px;
}

body.main-orders-embedded .insight-order-tools > * {
  min-height: 36px !important;
  height: 36px !important;
}

body.main-orders-embedded .main-orders-filter-trigger {
  min-height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 7px 11px;
  border: 1px solid #dfe4ea;
  border-radius: 6px;
  background: #ffffff;
  color: #344054;
  font: inherit;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
}

body.main-orders-embedded .main-orders-filter-trigger:hover,
body.main-orders-embedded .main-orders-filter-trigger:focus-visible {
  border-color: #a7d5d4;
  outline: none;
}

body.main-orders-embedded .main-orders-filter-trigger svg {
  width: 15px;
  height: 15px;
}

body.main-orders-embedded .main-orders-filter-trigger svg:last-child {
  width: 13px;
  height: 13px;
}

body.main-orders-embedded .insight-order-dropdown-shell {
  order: 1;
  width: min(190px, 25vw);
  min-width: 150px;
  height: 36px !important;
}

body.main-orders-embedded .insight-order-dropdown-shell .product-category-multiselect__trigger {
  min-height: 36px !important;
  height: 36px !important;
  border-radius: 6px !important;
}

body.main-orders-embedded .insight-order-search {
  order: 2;
  width: min(360px, 38vw);
  min-width: 220px;
  min-height: 36px !important;
  height: 36px !important;
  margin-left: auto;
  padding: 7px 10px !important;
  border: 1px solid #dfe4ea !important;
  border-radius: 6px !important;
  background: #ffffff !important;
  box-shadow: none !important;
}

body.main-orders-embedded .insight-order-search:focus-within {
  border-color: var(--main-orders-accent) !important;
  background: #ffffff !important;
  box-shadow: 0 0 0 3px rgba(11, 152, 151, 0.1) !important;
}

body.main-orders-embedded .insight-order-search input[type="search"] {
  font-size: 12px;
}

body.main-orders-embedded .insight-order-controls-spacer {
  display: none !important;
}

body.main-orders-embedded .main-orders-table-heading {
  display: grid;
  grid-template-columns: minmax(116px, 0.9fr) minmax(150px, 1.15fr) minmax(178px, 1.35fr) 68px minmax(92px, 0.78fr) minmax(104px, 0.82fr) 102px 80px;
  align-items: center;
  gap: 10px;
  min-height: 39px;
  padding: 8px 18px;
  border-bottom: 1px solid var(--main-orders-line);
  background: #fafbfc;
  color: #475467;
  font-size: 11px;
  font-weight: 700;
}

body.main-orders-embedded .insight-order-list-container {
  min-height: 0;
  height: 100%;
  overflow: hidden;
  background: #ffffff !important;
}

body.main-orders-embedded .insight-main-grid .insight-order-list {
  width: 100%;
  height: 100% !important;
  display: block;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  overflow-y: auto;
  background: #ffffff !important;
  scrollbar-width: thin;
}

body.main-orders-embedded .insight-order-list > .empty-state {
  margin: 24px;
}

body.main-orders-embedded .insight-main-grid .insight-order-list .main-orders-row {
  position: relative;
  z-index: auto;
  width: 100%;
  min-height: 62px;
  display: grid;
  grid-template-columns: minmax(116px, 0.9fr) minmax(150px, 1.15fr) minmax(178px, 1.35fr) 68px minmax(92px, 0.78fr) minmax(104px, 0.82fr) 102px 80px;
  align-items: center;
  gap: 10px;
  margin: 0;
  padding: 8px 18px;
  border: 0 !important;
  border-bottom: 1px solid #edf0f4 !important;
  border-radius: 0 !important;
  background: #ffffff !important;
  box-shadow: none !important;
  outline: 0 !important;
  transform: none !important;
  transition: background-color 140ms ease;
  overflow: visible;
}

body.main-orders-embedded .insight-main-grid .insight-order-list .main-orders-row:hover {
  background: #f8fbfb !important;
  box-shadow: none !important;
  transform: none !important;
}

body.main-orders-embedded .main-orders-cell {
  min-width: 0;
  color: #344054;
  font-size: 11px;
  line-height: 1.3;
}

body.main-orders-embedded .main-orders-cell > strong,
body.main-orders-embedded .main-orders-cell-copy > strong {
  min-width: 0;
  display: block;
  overflow: hidden;
  color: var(--main-orders-ink);
  font-size: 11px;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.main-orders-embedded .main-orders-cell-copy {
  min-width: 0;
  display: grid;
  gap: 2px;
}

body.main-orders-embedded .main-orders-cell-copy > small,
body.main-orders-embedded .main-orders-cell--time > small {
  min-width: 0;
  display: block;
  overflow: hidden;
  color: var(--main-orders-muted);
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.main-orders-embedded .main-orders-cell--id {
  width: 100%;
  max-width: 100%;
  display: grid;
  justify-items: start;
  gap: 4px;
  overflow: hidden;
}

body.main-orders-embedded .main-orders-cell--id > strong {
  width: 100%;
  max-width: 100%;
}

body.main-orders-embedded .main-orders-new-badge {
  display: inline-flex;
  align-items: center;
  min-height: 18px;
  padding: 2px 6px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #087443;
  font-size: 9px;
  font-weight: 700;
}

body.main-orders-embedded .main-orders-cell--customer,
body.main-orders-embedded .main-orders-cell--product {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
}

body.main-orders-embedded .main-orders-avatar,
body.main-orders-embedded .main-orders-product-image {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: 1px solid #e8ebef;
  background: #f2f4f7;
  color: #667085;
  font-size: 10px;
  font-weight: 700;
}

body.main-orders-embedded .main-orders-avatar {
  border-radius: 50%;
}

body.main-orders-embedded .main-orders-product-image {
  border-radius: 5px;
}

body.main-orders-embedded .main-orders-avatar img,
body.main-orders-embedded .main-orders-product-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

body.main-orders-embedded .main-orders-cell--quantity {
  text-align: center;
}

body.main-orders-embedded .main-orders-cell--status .insight-order-chip {
  max-width: 100%;
  min-height: 22px;
  padding: 4px 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #edf6ff;
  color: #2374a5;
  font-size: 9px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-preparing,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-processing,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-packing {
  background: #fff7dc;
  color: #9a6700;
}

body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-packed,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-shipped,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-in-transit,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-out-for-delivery {
  background: #eef2ff;
  color: #5b52b8;
}

body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-delivered,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-completed {
  background: #ecfdf3;
  color: #087443;
}

body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-cancel,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-cancelled,
body.main-orders-embedded .main-orders-cell--status .insight-order-chip.is-canceled {
  background: #fff0f1;
  color: #c03442;
}

body.main-orders-embedded .main-orders-cell--time {
  position: relative;
  display: grid;
  gap: 2px;
  padding-left: 10px;
}

body.main-orders-embedded .main-orders-cell--time::before {
  content: "";
  position: absolute;
  top: 4px;
  left: 0;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #16a36a;
}

body.main-orders-embedded .main-orders-cell--actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}

body.main-orders-embedded .main-orders-icon-button {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid #e1e5ea;
  border-radius: 6px;
  background: #ffffff;
  color: #667085;
  cursor: pointer;
}

body.main-orders-embedded .main-orders-icon-button:hover,
body.main-orders-embedded .main-orders-icon-button:focus-visible {
  border-color: #8cc9c8;
  color: var(--main-orders-accent);
  outline: none;
}

body.main-orders-embedded .main-orders-icon-button svg {
  width: 15px;
  height: 15px;
}

body.main-orders-embedded .main-orders-action-menu {
  position: relative;
  display: inline-flex;
}

body.main-orders-embedded .main-orders-action-menu__popup {
  position: absolute;
  top: calc(100% + 5px);
  right: 0;
  z-index: 50;
  width: 148px;
  padding: 5px;
  border: 1px solid var(--main-orders-line);
  border-radius: 6px;
  background: #ffffff;
  box-shadow: 0 10px 24px rgba(16, 24, 40, 0.14);
}

body.main-orders-embedded .main-orders-action-menu__popup[hidden] {
  display: none !important;
}

body.main-orders-embedded .main-orders-action-menu__popup button {
  width: 100%;
  min-height: 32px;
  padding: 6px 8px;
  border: 0;
  border-radius: 4px;
  background: #ffffff;
  color: #344054;
  text-align: left;
  font: inherit;
  font-size: 11px;
  cursor: pointer;
}

body.main-orders-embedded .main-orders-action-menu__popup button:hover,
body.main-orders-embedded .main-orders-action-menu__popup button:focus-visible {
  background: #f1f8f8;
  color: #087f7e;
  outline: none;
}

body.main-orders-embedded .main-orders-pagination {
  min-height: 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 8px 18px;
  border-top: 1px solid var(--main-orders-line);
  background: #ffffff;
}

body.main-orders-embedded .main-orders-pagination > p {
  margin: 0;
  color: var(--main-orders-muted);
  font-size: 11px;
}

body.main-orders-embedded .main-orders-pagination__controls {
  display: flex;
  align-items: center;
  gap: 5px;
}

body.main-orders-embedded .main-orders-page-button {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid #e2e6eb;
  border-radius: 6px;
  background: #ffffff;
  color: #344054;
  font: inherit;
  font-size: 11px;
  font-weight: 650;
  cursor: pointer;
}

body.main-orders-embedded .main-orders-page-button:hover:not(:disabled),
body.main-orders-embedded .main-orders-page-button:focus-visible,
body.main-orders-embedded .main-orders-page-button.is-current {
  border-color: var(--main-orders-accent);
  background: var(--main-orders-accent);
  color: #ffffff;
  outline: none;
}

body.main-orders-embedded .main-orders-page-button:disabled {
  opacity: 0.4;
  cursor: default;
}

body.main-orders-embedded .main-orders-page-button svg {
  width: 15px;
  height: 15px;
}

body.main-orders-embedded .main-orders-pagination__ellipsis {
  width: 20px;
  color: var(--main-orders-muted);
  text-align: center;
  font-size: 11px;
}

@media (max-width: 1080px) {
  body.main-orders-embedded .main-orders-summary {
    gap: 8px;
  }

  body.main-orders-embedded .main-orders-summary-card {
    gap: 9px;
    padding: 11px;
  }

  body.main-orders-embedded .main-orders-summary-card__icon {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
  }

  body.main-orders-embedded .main-orders-table-heading,
  body.main-orders-embedded .insight-main-grid .insight-order-list .main-orders-row {
    grid-template-columns: minmax(100px, 0.8fr) minmax(132px, 1.08fr) minmax(150px, 1.2fr) 55px minmax(78px, 0.7fr) minmax(88px, 0.75fr) 88px 70px;
    gap: 7px;
    padding-inline: 12px;
  }

  body.main-orders-embedded .main-orders-cell--customer,
  body.main-orders-embedded .main-orders-cell--product {
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 6px;
  }

  body.main-orders-embedded .main-orders-avatar,
  body.main-orders-embedded .main-orders-product-image {
    width: 28px;
    height: 28px;
  }
}

@media (max-width: 900px) {
  body.main-orders-embedded .insight-main-grid > .insight-order-list-shell.dashboard-panel {
    overflow-y: auto !important;
  }

  body.main-orders-embedded .main-orders-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  body.main-orders-embedded .insight-order-tools {
    flex-wrap: wrap;
  }

  body.main-orders-embedded .insight-order-search {
    width: 100%;
    min-width: 0;
    flex: 1 1 100%;
    margin-left: 0;
    order: 3;
    height: 38px !important;
  }

  body.main-orders-embedded .insight-order-dropdown-shell {
    flex: 1 1 190px;
    width: auto;
  }

  body.main-orders-embedded .main-orders-table-heading {
    display: none;

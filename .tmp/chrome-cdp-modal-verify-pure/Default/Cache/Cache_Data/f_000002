  async function loadLiveChatWorkspace() {
    if (!elements.liveChatMount || elements.liveChatMount.dataset.mainLiveChatReady === "true") {
      return;
    }

    elements.liveChatMount.setAttribute("aria-busy", "true");
    try {
      const response = await fetch(liveChatDocumentSrc, {
        cache: "no-store",
        headers: { Accept: "text/html" },
      });
      if (!response.ok) {
        throw new Error("Unable to load the Live Chat workspace.");
      }

      const sourceDocument = new DOMParser().parseFromString(await response.text(), "text/html");
      const sourceBoard = sourceDocument.querySelector(".live-chat-board");
      if (!sourceBoard) {
        throw new Error("The Live Chat workspace is unavailable.");
      }

      const board = document.importNode(sourceBoard, true);
      elements.liveChatMount.replaceChildren(board);
      elements.liveChatMount.dataset.mainLiveChatReady = "true";

      ["[data-chat-media-modal]", "[data-chat-delete-modal-overlay]"].forEach((selector) => {
        if (elements.liveChatView?.querySelector(selector)) {
          return;
        }
        const sourceModal = sourceDocument.querySelector(selector);
        if (sourceModal) {
          elements.liveChatView?.appendChild(document.importNode(sourceModal, true));
        }
      });

      await loadScriptOnce(liveChatControllerSrc, "data-main-live-chat-controller");
      syncLiveChatSearch(liveChatSearchQuery);
    } catch (error) {
      elements.liveChatMount.dataset.mainLiveChatReady = "false";
      elements.liveChatMount.innerHTML = `
        <div class="main-live-chat-error" role="alert">
          <strong>Unable to load conversations</strong>
          <p>Please refresh or try again.</p>
          <button type="button" data-main-live-chat-retry>Try again</button>
        </div>`;
      throw error;
    } finally {
      elements.liveChatMount.removeAttribute("aria-busy");
    }
  }


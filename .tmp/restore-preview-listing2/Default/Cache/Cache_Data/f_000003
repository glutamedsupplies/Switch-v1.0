/* Product Listing styles moved from product-panel.css. */

/* Product panel only overrides.
   Loaded after styles.css so these rules win without affecting other pages. */

.product-status-shell .product-panel-grid__inventory {
  gap: 12px !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
}

.product-status-shell .product-panel-grid__inventory-tools {
  grid-template-columns: minmax(220px, 1fr) minmax(180px, 240px) !important;
  gap: 12px !important;
  margin-bottom: 6px !important;
}

.product-status-shell .dashboard-content > .hero--product-list {
  position: sticky !important;
  top: var(--admin-heading-sticky-top, 4px) !important;
  z-index: 220;
  background: var(--dashboard-page-background, #f3f4f6);
}

.product-status-shell .product-list {
  display: grid !important;
  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  grid-auto-flow: row;
  gap: 12px !important;
  align-items: stretch;
  overflow: visible;
}

.product-status-shell .product-card,
.product-status-shell .product-card.is-inactive,
.product-status-shell .product-card--add-product {
  position: relative;
  z-index: 0;
  display: grid !important;
  grid-template-rows: auto minmax(0, 1fr) auto;
  min-width: 0;
  min-height: 0;
  height: 100% !important;
  gap: 0 !important;
  align-items: stretch;
  padding: 8px !important;
  overflow: visible !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 6px !important;
  background: #ffffff !important;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05) !important;
  outline: none !important;
  transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease !important;
  isolation: isolate;
}

.product-status-shell .product-card:hover,
.product-status-shell .product-card.is-inactive:hover,
.product-status-shell .product-card--add-product:hover {
  z-index: 20;
  border-color: #d1d5db !important;
  box-shadow: 0 7px 18px rgba(15, 23, 42, 0.08) !important;
  outline: none !important;
  transform: translateY(-1px) !important;
}

.product-status-shell .product-card::before,
.product-status-shell .product-card--add-product::before {
  display: none !important;
}

.product-status-shell .product-card--expired-batch,
.product-status-shell .product-card--expired-batch:hover,
.product-status-shell .product-card--expired-batch.is-inactive,
.product-status-shell .product-card--expired-batch.is-inactive:hover {
  border-color: #dc2626 !important;
}

.product-status-shell .product-card--expired-batch:hover {
  box-shadow: 0 12px 26px rgba(220, 38, 38, 0.16) !important;
}

.product-status-shell .product-card--pending-request,
.product-status-shell .product-card--pending-request:hover,
.product-status-shell .product-card--pending-request.is-inactive,
.product-status-shell .product-card--pending-request.is-inactive:hover {
  border-color: #f59e0b !important;
  background: #ffffff !important;
  outline: none !important;
}

.product-status-shell .product-card--pending-request:hover {
  box-shadow: 0 12px 26px rgba(245, 158, 11, 0.18) !important;
}

.product-status-shell .product-image,
.product-status-shell .product-image--add-product,
.product-status-shell .product-card__photo-button {
  display: grid !important;
  width: 100% !important;
  height: auto !important;
  aspect-ratio: 1 / 1;
  flex: 0 0 auto;
  place-items: center;
  overflow: hidden !important;
  border-radius: 5px !important;
  background: #f3f4f6 !important;
  color: #94a3b8;
}

.product-status-shell .product-card__photo-button {
  padding: 0 !important;
  border: 0 !important;
  box-shadow: none !important;
  cursor: pointer !important;
}

.product-status-shell .product-card__photo-button:hover,
.product-status-shell .product-card__photo-button:active,
.product-status-shell .product-card__photo-button:focus-visible {
  background: #f3f4f6 !important;
  box-shadow: none !important;
  outline: none !important;
  transform: none !important;
}

.product-status-shell .product-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top !important;
}

.product-status-shell .product-image--add-product {
  border: 1px dashed #cbd5e1 !important;
}

.product-status-shell .product-image__plus {
  width: 46px;
  height: 46px;
  border-radius: 999px;
  font-size: 26px;
  box-shadow: none;
}

.product-status-shell .product-image__meta {
  left: 7px;
  right: auto;
  bottom: 7px;
  z-index: 4;
  gap: 5px;
  max-width: calc(100% - 52px);
}

.product-status-shell .product-image__count {
  box-sizing: border-box;
  min-width: 30px;
  min-height: 22px;
  gap: 4px;
  padding: 4px 7px;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 999px !important;
  background: rgba(17, 24, 39, 0.86) !important;
  color: #ffffff;
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  cursor: pointer !important;
  transform: none !important;
  transition: background 140ms ease !important;
}

.product-status-shell .product-image__count:hover {
  background: rgba(15, 23, 42, 0.94) !important;
  transform: none !important;
}

.product-status-shell .product-image__count i,
.product-status-shell .product-image__count svg {
  width: 12px;
  height: 12px;
  flex: 0 0 12px;
  font-size: 12px;
}

.product-status-shell .product-card__status-row {
  position: absolute;
  top: 15px;
  left: 15px;
  right: 15px;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  pointer-events: none;
}

.product-status-shell .product-card__badge--status {
  display: inline-flex;
  align-items: center;
  width: auto;
  min-width: 0;
  max-width: calc(100% - 48px);
  min-height: 18px;
  height: auto;
  padding: 3px 6px;
  border: 1px solid color-mix(in srgb, var(--accent) 58%, #ffffff);
  border-radius: 999px;
  background: var(--accent);
  color: var(--accent-contrast, #ffffff);
  box-shadow: none;
  font-size: 11px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
  text-transform: none;
  pointer-events: auto;
}

.product-status-shell .product-card__badge--status::after {
  content: attr(title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-card__badge--status.is-inactive {
  border-color: #fecaca;
  background: #dc2626;
  color: #ffffff;
}

.product-status-shell .product-card--pending-request .product-card__badge--status {
  border-color: transparent;
  background: #f59e0b;
  color: #ffffff;
}

.product-status-shell .product-card--expired-batch .product-card__badge--status {
  border-color: #fecaca;
  background: #dc2626;
  color: #ffffff;
}

.product-status-shell .product-card__visibility-toggle {
  min-height: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  pointer-events: auto;
}

.product-status-shell .product-card__visibility-toggle:hover,
.product-status-shell .product-card__visibility-toggle:focus-visible,
.product-status-shell .product-card__visibility-toggle:active {
  background: transparent;
  box-shadow: none;
  outline: none;
  transform: none;
}

.product-status-shell .product-card__visibility-toggle-track {
  width: 34px;
  height: 18px;
  padding: 2px;
  border: 1px solid rgba(255, 255, 255, 0.52);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.66);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  transition: background 220ms cubic-bezier(0.22, 1, 0.36, 1) !important;
}

.product-status-shell .product-card__visibility-toggle-thumb {
  width: 12px;
  height: 12px;
  box-shadow: none;
}

.product-status-shell .product-card__visibility-toggle.is-active .product-card__visibility-toggle-track {
  background-color: var(--accent) !important;
  background-image: var(--accent-button-gradient-bg) !important;
  background-size: 100% 100% !important;
  background-repeat: no-repeat !important;
}

.product-status-shell .product-card__visibility-toggle.is-active .product-card__visibility-toggle-thumb {
  transform: translateX(16px);
}

.product-status-shell .product-card__body {
  display: grid;
  min-width: 0;
  min-height: 0;
  align-content: start;
  flex: none !important;
  gap: 5px;
  padding: 10px 3px 0 !important;
}

.product-status-shell .product-card__body--add-product {
  gap: 8px;
}

.product-status-shell .product-name {
  display: block;
  overflow: hidden;
  min-height: 16px;
  margin: 0;
  color: #111827;
  font-size: 16px;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-name__category {
  display: none;
}

.product-status-shell .product-card__category {
  display: block;
  overflow: hidden;
  width: fit-content;
  max-width: 100%;
  min-height: 14px;
  padding: 2px 6px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-card__price-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 6px;
  overflow: hidden;
  white-space: nowrap;
}

.product-status-shell .product-card__price {
  flex: 0 0 auto;
  overflow: hidden;
  color: #1f2937;
  font-size: 14px;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
}

.product-status-shell .product-card__original-price {
  min-width: 0;
  overflow: hidden;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 500;
  line-height: 1;
  text-decoration: line-through;
  text-overflow: ellipsis;
}

.product-status-shell .product-card__highlights {
  gap: 5px;
  margin-top: 1px;
}

.product-status-shell .product-card__highlight-badge {
  min-height: 18px;
  padding: 3px 6px;
  border-radius: 999px !important;
  font-size: 10px;
  font-weight: 600;
  line-height: 1;
}

.product-status-shell .product-card__batch-note,
.product-status-shell .product-card__pending-note,
.product-status-shell .product-card__body--add-product .product-meta {
  overflow: hidden;
  color: #64748b;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.35;
}

.product-status-shell .product-card__footer {
  display: grid;
  width: 100%;
  margin-top: auto !important;
  padding: 9px 3px 0 !important;
  border-top: 1px solid #eef0f3 !important;
  background: transparent !important;
}

.product-status-shell .product-card--expired-batch .product-card__footer {
  background: transparent !important;
}

.product-status-shell .product-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(66px, 0.56fr) 32px;
  align-items: center;
  width: 100%;
  gap: 7px;
  margin: 0;
}

.product-status-shell .product-actions .icon-action-button {
  display: inline-grid;
  width: 32px;
  min-width: 32px;
  min-height: 32px;
  height: 32px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 5px;
  background: transparent;
  box-shadow: none;
  color: #475569;
  transform: none !important;
  transition: background 140ms ease, color 140ms ease, border-color 140ms ease !important;
}

.product-status-shell .product-actions .product-card__overview-button {
  display: inline-flex;
  justify-content: center;
  width: 100%;
  min-width: 0;
  padding: 0 8px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: var(--accent-text, var(--accent));
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-actions .product-card__overview-button i {
  display: none;
}

.product-status-shell .product-actions .product-card__overview-button span {
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-status-shell .product-actions .icon-action-button:hover,
.product-status-shell .product-actions .icon-action-button:focus-visible {
  background: rgba(var(--accent-rgb), 0.06);
  color: var(--accent-text, var(--accent));
  box-shadow: none;
  outline: none;
  transform: none !important;
}

.product-status-shell .product-actions .delete-button,
.product-status-shell .product-actions .icon-action-button--danger {
  color: #df4d58;
}

.product-status-shell .product-actions .delete-button:hover,
.product-status-shell .product-actions .delete-button:focus-visible,
.product-status-shell .product-actions .icon-action-button--danger:hover,
.product-status-shell .product-actions .icon-action-button--danger:focus-visible {
  background: #ffe0e3;
  color: #bd2633;
}

.product-status-shell .product-actions .icon-action-button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
  transform: none !important;
}

.product-status-shell .product-actions .icon-action-button i,
.product-status-shell .product-actions .icon-action-button svg {
  display: block;
  width: 18px;
  height: 18px;
  font-size: 18px;
  line-height: 1;
}

.product-status-shell .product-actions .product-card__edit-button {
  display: inline-flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 8px;
  border: 1px solid #cbd5e1;
  background: #f8fafc;
  color: var(--accent-text, var(--accent));
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-actions .product-card__edit-button i {
  width: 13px;
  height: 13px;
  flex: 0 0 13px;
  font-size: 13px;
}

.product-status-shell .product-actions .product-card__edit-button span {
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (max-width: 1520px) {
  .product-status-shell .product-list {
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 1280px) {
  .product-status-shell .product-list {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 980px) {
  .product-status-shell .product-list {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 700px) {
  .product-status-shell .product-panel-grid__inventory-tools {
    grid-template-columns: 1fr !important;
  }

  .product-status-shell .product-list {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 560px) {
  .product-status-shell .product-list {
    grid-template-columns: 1fr !important;
  }
}

/* Listing command and Add Product workspace modal. */
.product-status-shell .product-panel-grid__inventory-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-width: 0;
  padding: 2px 0 4px;
}

.product-status-shell .product-panel-grid__inventory-heading .section-label {
  margin: 0 0 2px;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

.product-status-shell .product-panel-grid__inventory-heading h2 {
  margin: 0;
  color: #111827;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.2;
}

.product-status-shell .product-listing-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 4px 0 2px;
}

.product-status-shell .product-listing-summary__card {
  --listing-summary-color: #2563eb;
  --listing-summary-soft: #eff6ff;
  display: grid;
  min-width: 0;
  min-height: 108px;
  grid-template-columns: 42px minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  overflow: hidden;
  border: 1px solid #e3e7ec;
  border-radius: 6px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
}

.product-status-shell .product-listing-summary__card--active {
  --listing-summary-color: #0f9f78;
  --listing-summary-soft: #e8f8f4;
}

.product-status-shell .product-listing-summary__card--inactive {
  --listing-summary-color: #64748b;
  --listing-summary-soft: #f1f5f9;
}

.product-status-shell .product-listing-summary__card--restricted {
  --listing-summary-color: #dc4c64;
  --listing-summary-soft: #fff0f3;
}

.product-status-shell .product-listing-summary__icon {
  display: inline-grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 6px;
  background: var(--listing-summary-soft);
  color: var(--listing-summary-color);
  font-size: 20px;
}

.product-status-shell .product-listing-summary__content {
  display: grid;
  min-width: 0;
  align-content: center;
  gap: 2px;
}

.product-status-shell .product-listing-summary__label,
.product-status-shell .product-listing-summary__note {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-listing-summary__label {
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
}

.product-status-shell .product-listing-summary__value {
  color: #111827;
  font-size: 27px;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}

.product-status-shell .product-listing-summary__note {
  margin-top: 3px;
  color: #7b8796;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.25;
}

.product-status-shell .product-panel-add-button {
  display: inline-flex;
  min-width: 0;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 16px;
  border: 1px solid var(--accent, #0f9f78);
  border-radius: 6px;
  background: var(--accent, #0f9f78);
  color: var(--accent-contrast, #ffffff);
  box-shadow: 0 5px 12px rgba(var(--accent-rgb, 15, 159, 120), 0.16);
  font-size: 13px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-panel-add-button:hover,
.product-status-shell .product-panel-add-button:focus-visible {
  border-color: var(--accent-hover, var(--accent, #0f9f78));
  background: var(--accent-hover, var(--accent, #0f9f78));
  box-shadow: 0 7px 16px rgba(var(--accent-rgb, 15, 159, 120), 0.22);
  outline: none;
  transform: translateY(-1px);
}

.product-status-shell .product-composer-modal-overlay[hidden],
.product-composer-modal-overlay.main-product-composer-body-portal[hidden] {
  display: none !important;
}

.product-status-shell .product-composer-modal-overlay,
.product-composer-modal-overlay.main-product-composer-body-portal {
  position: fixed;
  width: 100vw;
  height: 100vh;
  align-items: center;
  justify-content: center;
  display: flex;
  z-index: 2000;
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-sizing: border-box;
  margin: 0;
  padding: 32px;
  overflow: hidden ;
  isolation: isolate;
  animation: none;
}

.product-composer-modal-overlay.main-product-composer-body-portal::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background: rgba(15, 23, 42, 0.46);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  pointer-events: none;
}

.product-status-shell .product-composer-modal--workspace {
  display: grid !important;
  width: min(1400px, calc(100vw - 64px));
  height: min(880px, calc(100vh - 64px));
  position: relative;
  z-index: 1;
  min-height: 0 !important;
  margin: auto !important;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  border: 1px solid #dfe4ea !important;
  border-radius: 7px !important;
  background: #ffffff !important;
  box-shadow: 0 28px 70px rgba(15, 23, 42, 0.28) !important;
  animation: product-composer-dialog-in 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.product-status-shell .product-composer-modal--workspace:focus {
  outline: none;
}

.product-status-shell .product-composer-modal__topbar {
  position: relative;
  z-index: 5;
  display: flex;
  min-width: 0;
  min-height: 74px;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 13px 18px;
  border-bottom: 1px solid #e5e7eb;
  background: #ffffff;
}

.product-status-shell .product-composer-modal__identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
}

.product-status-shell .product-composer-modal__identity > div {
  min-width: 0;
}

.product-status-shell .product-composer-modal__brand-icon {
  display: inline-grid;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  place-items: center;
  border-radius: 6px;
  background: #e8f8f4;
  color: #0f9f78;
  font-size: 20px;
}

.product-status-shell .product-composer-modal__topbar .section-label {
  display: none;
}

.product-status-shell .product-composer-modal__topbar h2 {
  overflow: hidden;
  margin: 0;
  color: #111827;
  font-size: 25px;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-composer-modal__subtitle {
  overflow: hidden;

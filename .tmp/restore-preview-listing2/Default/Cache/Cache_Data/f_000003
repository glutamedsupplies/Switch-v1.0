  display: flex;
  min-width: 0;
  gap: 9px;
  padding: 4px 2px 7px;
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-inline: contain;
  scroll-behavior: smooth;
  scroll-snap-type: x proximity;
  scrollbar-width: none;
}

.product-partner-selection__list::-webkit-scrollbar {
  display: none;
}

.product-partner-selection__option,
.product-status-shell .product-composer-section label.product-partner-selection__option {
  position: relative;
  display: flex;
  min-width: 102px;
  min-height: 140px;
  flex: 0 0 clamp(102px, 24%, 134px);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 0;
  padding: 15px 9px 12px;
  overflow: visible;
  border: 1px solid #e1e6eb;
  border-radius: 11px;
  background: #ffffff;
  box-shadow: none;
  color: #182033;
  cursor: pointer;
  scroll-snap-align: start;
  text-align: center;
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}

.product-partner-selection__option:hover,
.product-partner-selection__option:focus-within,
.product-partner-selection__option.is-selected:hover,
.product-partner-selection__option.is-selected:focus-within {
  border-color: rgba(var(--service-accent-rgb), 0.48);
  background: #ffffff;
  box-shadow: 0 7px 18px rgba(15, 23, 42, 0.075);
  transform: translateY(-1px);
}

.product-partner-selection__option.is-selected {
  border-color: var(--service-accent);
  background: linear-gradient(180deg, #ffffff 0%, rgba(var(--service-accent-rgb), 0.035) 100%);
  box-shadow: 0 0 0 1px rgba(var(--service-accent-rgb), 0.08);
}

.product-partner-selection__option.is-selected::after {
  position: absolute;
  top: -8px;
  right: -7px;
  display: grid;
  width: 25px;
  height: 25px;
  place-items: center;
  border: 3px solid #ffffff;
  border-radius: 999px;
  background: var(--service-accent);
  box-shadow: 0 3px 8px rgba(var(--service-accent-rgb), 0.26);
  color: #ffffff;
  content: "\2713";
  font-size: 13px;
  font-weight: 800;
  line-height: 1;
}

.product-partner-selection__option input {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  border: 0;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
}

.product-partner-selection__logo {
  display: grid;
  width: 70px;
  height: 48px;
  flex: 0 0 48px;
  place-items: center;
  overflow: hidden;
  border-radius: 9px;
  background: rgba(var(--service-accent-rgb), 0.09);
  color: var(--service-accent);
  font-size: 20px;
  font-weight: 800;
}

.product-partner-selection__logo.has-image {
  background: #ffffff;
  box-shadow: none;
}

.product-partner-selection__logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.product-partner-selection__name {
  display: -webkit-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  color: #172033;
  font-size: 11px;
  font-weight: 650;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  white-space: normal;
}

.product-partner-selection__scroll-button {
  display: inline-grid;
  width: 32px;
  min-width: 32px;
  height: 32px;
  min-height: 32px;
  place-items: center;
  margin: 0;
  padding: 0;
  border: 1px solid #e1e6eb;
  border-radius: 999px;
  background: #ffffff;
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
  color: #273247;
  cursor: pointer;
  outline: none;
  transform: none;
  transition: border-color 160ms ease, color 160ms ease, opacity 160ms ease;
}

.product-partner-selection__scroll-button:hover,
.product-partner-selection__scroll-button:focus-visible {
  border-color: rgba(var(--service-accent-rgb), 0.42);
  background: #ffffff;
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
  color: var(--service-accent);
  outline: none;
  transform: none;
}

.product-partner-selection__scroll-button:disabled {
  opacity: 0.32;
  cursor: default;
}

.product-partner-selection__scroll-button svg {
  width: 17px;
  height: 17px;
}

.product-partner-selection__footer {
  position: relative;
  display: flex;
  min-height: 12px;
  align-items: center;
  justify-content: center;
  margin-top: 3px;
}

.product-partner-selection__dots {
  display: flex;
  min-height: 9px;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.product-partner-selection__dot {
  display: block;
  width: 7px;
  min-width: 7px;
  height: 7px;
  min-height: 7px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: #dfe4ea;
  box-shadow: none;
  cursor: pointer;
  outline: none;
  transform: none;
  transition: background 160ms ease, transform 160ms ease;
}

.product-partner-selection__dot.is-active {
  background: var(--service-accent);
  transform: scale(1.12);
}

.product-partner-selection__status {
  position: absolute;
  right: 0;
  min-height: 0;
  margin: 0;
  color: #7b8796;
  font-size: 9px;
  font-weight: 550;
  line-height: 1.3;
}

.product-partner-selection__status:empty {
  display: none;
}

.product-partner-selection__empty {
  display: grid;
  width: 100%;
  min-height: 102px;
  flex: 1 0 100%;
  place-items: center;
  padding: 16px;
  border: 1px dashed #d8dee6;
  border-radius: 10px;
  background: #f8fafb;
  color: #788393;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

@media (max-width: 640px) {
  .product-partner-selection__heading {
    display: grid;
    gap: 3px;
  }

  .product-partner-selection__group-header {
    grid-template-columns: 38px minmax(0, 1fr) 32px;
    gap: 10px;
    padding: 12px;
  }

  .product-partner-selection__group-icon {
    width: 38px;
    height: 38px;
  }

  .product-partner-selection__body {
    padding: 0 10px 11px;
  }

  .product-partner-selection__carousel {
    grid-template-columns: 29px minmax(0, 1fr) 29px;
    gap: 6px;
  }

  .product-partner-selection__scroll-button {
    width: 29px;
    min-width: 29px;
    height: 29px;
    min-height: 29px;
  }

  .product-partner-selection__option,
  .product-status-shell .product-composer-section label.product-partner-selection__option {
    min-width: 98px;
    min-height: 108px;
    flex-basis: 98px;
    padding: 13px 7px 10px;
  }

  .product-partner-selection__logo {
    width: 62px;
    height: 43px;
    flex-basis: 43px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .product-partner-selection__list {
    scroll-behavior: auto;
  }

  .product-partner-selection__option,
  .product-partner-selection__trigger svg {
    transition: none;
  }
}

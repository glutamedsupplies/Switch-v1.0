      "rank units units"
      "rank revenue change"
      "rank trend trend";
    row-gap: 8px;
    min-height: 110px;
    padding-block: 12px;
  }

  .listing-insight-row__rank {
    grid-area: rank;
    align-self: start;
    margin-top: 8px;
  }

  .listing-insight-row__product {
    grid-area: product;
  }

  .listing-insight-row__units {
    grid-area: units;
    justify-self: start;
  }

  .listing-insight-row__revenue {
    grid-area: revenue;
  }

  .listing-insight-row__change {
    grid-area: change;

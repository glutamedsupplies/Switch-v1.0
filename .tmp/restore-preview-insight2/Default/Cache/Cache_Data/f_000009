  overflow: hidden;
  text-overflow: ellipsis;
}

.listing-insight-detail-product__metadata-item + .listing-insight-detail-product__metadata-item::before {
  content: "\2022";
  margin-right: 7px;
  color: #a3abba;
}

.listing-insight-detail-product__rating {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 12px;
  color: #546178;
  font-size: 11px;
}

.listing-insight-detail-product__rating .product-insight-stars {
  gap: 2px;
}

.listing-insight-detail-metric {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr);
  align-items: start;
  gap: 10px;
  min-width: 0;
  min-height: 82px;
  padding: 8px 14px;
  border-left: 1px solid #edf0f4;
}

.listing-insight-detail-metric__icon {
  display: inline-grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
}

.listing-insight-detail-metric__icon svg {
  width: 19px;
  height: 19px;
}

.listing-insight-detail-metric__icon.is-sold {
  background: #e7f7f8;
  color: #0998a1;
}

.listing-insight-detail-metric__icon.is-revenue {
  background: #eaf8ed;
  color: #159447;
}

.listing-insight-detail-metric__icon.is-price {
  background: #f0eafe;
  color: #7d4ce0;
}

.listing-insight-detail-metric__icon.is-views {
  background: #e8f2ff;
  color: #2479dd;
}

.listing-insight-detail-metric__copy {
  min-width: 0;
}

.listing-insight-detail-metric__label {
  display: block;
  color: #66738a;
  font-size: 10px;
  line-height: 1.35;
}

.listing-insight-detail-metric__value {
  display: block;
  max-width: 100%;
  margin-top: 6px;
  overflow: hidden;
  color: #172033;
  font-size: 17px;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.listing-insight-detail-metric .listing-insight-row__change-value {
  margin-top: 10px;
  font-size: 10px;
}

.listing-insight-detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.18fr) minmax(360px, 0.9fr);
  gap: 14px;
  align-items: stretch;
}

.listing-insight-detail-chart,
.listing-insight-performance,
.listing-insight-comments,
.listing-insight-rating-panel {
  min-width: 0;
  overflow: hidden;
}

.listing-insight-detail-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 52px;
  padding: 0 18px;
  border-bottom: 1px solid #edf0f4;
}

.listing-insight-detail-card__header h3 {
  margin: 0;
  color: #172033;
  font-size: 13px;
  font-weight: 750;
  letter-spacing: 0;
}

.listing-insight-detail-card__header h3 span,
.listing-insight-detail-card__context {
  color: #68758c;
  font-size: 10px;
  font-weight: 500;
}

.listing-insight-detail-bar-chart {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(44px, 1fr));
  align-items: end;
  gap: 12px;
  height: 238px;
  margin: 18px 20px 0;
  padding: 10px 8px 0;
  border-bottom: 1px solid #dfe5ed;
  background-image: repeating-linear-gradient(to top, transparent 0, transparent 51px, #edf0f4 52px);
}

.listing-insight-detail-bar-chart__column {
  display: grid;
  grid-template-rows: 18px minmax(0, 1fr) 26px;
  align-items: end;
  justify-items: center;
  height: 100%;
  min-width: 0;
}

.listing-insight-detail-bar-chart__column > strong {
  align-self: start;
  color: #6a768b;
  font-size: 9px;
  font-weight: 600;
}

.listing-insight-detail-bar-chart__column > span:last-child {
  align-self: center;
  max-width: 100%;
  overflow: hidden;
  color: #66738a;
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.listing-insight-detail-bar-chart__bar {
  width: min(38px, 72%);
  height: var(--listing-insight-bar-size, 3%);
  min-height: 3px;
  border-radius: 4px 4px 0 0;
  background: #0799a2;
  box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.08);
}

.listing-insight-detail-chart__legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 43px;
  color: #637087;
  font-size: 10px;
}

.listing-insight-detail-chart__legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #0799a2;
}

.listing-insight-performance__rows {
  display: grid;
  padding: 12px 18px 16px;
}

.listing-insight-performance-row {
  display: grid;
  grid-template-columns: minmax(110px, 1fr) minmax(84px, 0.7fr) minmax(110px, 0.95fr) 66px;
  align-items: center;
  gap: 12px;
  min-height: 48px;
  border-bottom: 1px solid #f0f2f5;
}

.listing-insight-performance-row:last-child {
  border-bottom: 0;
}

.listing-insight-performance-row__label {
  color: #607087;
  font-size: 10px;
}

.listing-insight-performance-row__value {
  color: #172033;
  font-size: 11px;
}

.listing-insight-performance-row__sparkline {
  min-width: 0;
}

.listing-insight-performance-row__sparkline .listing-insight-sparkline {
  height: 26px;
}

.listing-insight-performance-row > .listing-insight-row__change-value {
  justify-self: end;
}

.listing-insight-comments__list {
  display: grid;
}

.listing-insight-comment {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  align-items: start;
  gap: 11px;
  min-height: 74px;
  padding: 12px 18px;
  border-bottom: 1px solid #edf0f4;
}

.listing-insight-comment__avatar {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #e7f5f5;
  color: #087f86;
  font-size: 10px;
  font-weight: 750;
}

.listing-insight-comment__copy {
  min-width: 0;
}

.listing-insight-comment__identity {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.listing-insight-comment__identity strong {
  overflow: hidden;
  color: #172033;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.listing-insight-comment__identity .product-insight-stars {
  gap: 1px;
}

.listing-insight-comment__copy p {
  margin: 5px 0 0;
  color: #455269;
  font-size: 10px;
  line-height: 1.4;
}

.listing-insight-comment__copy time {
  display: block;
  margin-top: 4px;
  color: #8490a1;
  font-size: 9px;
}

.listing-insight-comment__sentiment {
  align-self: center;
  padding: 4px 9px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 650;
}

.listing-insight-comment__sentiment.is-positive {
  background: #e7f7ec;
  color: #168442;
}

.listing-insight-comment__sentiment.is-neutral {
  background: #fff5e7;
  color: #b66b0e;
}

.listing-insight-comment__sentiment.is-negative {
  background: #fff0f1;
  color: #c33d4e;
}

.listing-insight-comments__footer {
  min-height: 34px;
  padding: 9px 18px;
  color: #738096;
  font-size: 9px;
}

.listing-insight-rating-panel__summary {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  gap: 22px;
  padding: 20px 22px;
}

.listing-insight-rating-panel__score {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8px;
}

.listing-insight-rating-panel__score > strong {
  color: #172033;
  font-size: 34px;
  line-height: 1;
}

.listing-insight-rating-panel__score > span:last-child {
  color: #637087;
  font-size: 10px;
}

.listing-insight-rating-panel__bars {
  display: grid;
  gap: 10px;
}

.listing-insight-rating-row {
  display: grid;
  grid-template-columns: 48px minmax(80px, 1fr) 70px;
  align-items: center;
  gap: 10px;
  color: #59667d;
  font-size: 9px;
}

.listing-insight-rating-row__track {
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #e9edf2;
}

.listing-insight-rating-row__fill {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #f5a800;
}

.listing-insight-rating-panel__recommendation {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 22px 20px;
  padding: 14px;
  border: 1px solid #d7eddd;
  border-radius: 7px;
  background: #f1faf4;
  color: #327349;
}

.listing-insight-rating-panel__recommendation > svg {
  width: 25px;
  height: 25px;
  flex: 0 0 25px;
}

.listing-insight-rating-panel__recommendation > span {
  color: #415168;
  font-size: 10px;
}

.listing-insight-rating-panel__recommendation strong {
  margin-right: 4px;
  color: #168442;
}

.listing-insight-rating-panel__recommendation small {
  display: block;
  margin-top: 4px;
  color: #768398;
  font-size: 9px;
}

@media (max-width: 1180px) {
  .listing-insight-detail-overview {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .listing-insight-detail-product {
    grid-column: 1 / -1;
    padding: 0 0 16px;
    border-bottom: 1px solid #edf0f4;
  }

  .listing-insight-detail-metric {
    border-left: 0;
  }

  .listing-insight-detail-metric + .listing-insight-detail-metric {
    border-left: 1px solid #edf0f4;
  }

  .listing-insight-detail-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  body.product-insight-page.listing-insight-embedded .listing-insight-product-detail {
    padding: 14px;
  }

  .listing-insight-detail-toolbar {
    flex-direction: column;
    gap: 13px;
  }

  .listing-insight-detail-toolbar__copy h2 {
    font-size: 20px;
  }

  .listing-insight-detail-toolbar__copy p strong {
    max-width: 54vw;
  }

  .listing-insight-detail-toolbar__actions {
    width: 100%;
    align-items: stretch;
    flex-direction: column;
    justify-content: stretch;
  }

  .listing-insight-detail-back,
  .listing-insight-detail-range {
    width: 100%;
    flex: 1 1 50%;
    box-sizing: border-box;
  }

  .listing-insight-detail-range select {
    width: 100%;
  }

  .listing-insight-detail-overview {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 14px;
  }

  .listing-insight-detail-product > .product-insight-rank-card__media {
    width: 78px;
    height: 78px;
    flex-basis: 78px;
  }

  .listing-insight-detail-product__title {
    align-items: flex-start;
    flex-direction: column;
  }

  .listing-insight-detail-product__metadata {
    align-items: flex-start;
    flex-direction: column;
    white-space: normal;
  }

  .listing-insight-detail-product__metadata-item {
    width: 100%;
  }

  .listing-insight-detail-product__metadata-item + .listing-insight-detail-product__metadata-item::before {
    display: none;
  }

  .listing-insight-detail-bar-chart {
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
    margin-inline: 10px;
    padding-inline: 2px;
  }

  .listing-insight-detail-metric:nth-child(4) {
    border-left: 0;
    border-top: 1px solid #edf0f4;
  }

  .listing-insight-detail-metric:nth-child(5) {
    border-top: 1px solid #edf0f4;
  }

  .listing-insight-performance-row {
    grid-template-columns: minmax(96px, 1fr) minmax(72px, auto) 58px;
  }

  .listing-insight-performance-row__sparkline {
    display: none;
  }

  .listing-insight-comment {
    grid-template-columns: 34px minmax(0, 1fr);
  }

  .listing-insight-comment__sentiment {
    grid-column: 2;
    justify-self: start;
  }

  .listing-insight-rating-panel__summary {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 460px) {
  .listing-insight-detail-back,
  .listing-insight-detail-range {
    width: 100%;
    flex-basis: auto;
  }

  .listing-insight-detail-product {
    align-items: flex-start;
  }

  .listing-insight-detail-product > .product-insight-rank-card__media {
    width: 64px;
    height: 64px;
    flex-basis: 64px;
  }

  .listing-insight-detail-product__rating {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .listing-insight-detail-metric {
    grid-template-columns: 32px minmax(0, 1fr);
    padding-inline: 8px;
  }

  .listing-insight-detail-metric__icon {
    width: 32px;
    height: 32px;
  }

  .listing-insight-detail-metric__value {
    font-size: 14px;
  }

  .listing-insight-detail-bar-chart {
    gap: 5px;
    margin-inline: 10px;
  }

  .listing-insight-detail-bar-chart__bar {
    width: min(24px, 76%);
  }

  .listing-insight-detail-card__header,
  .listing-insight-performance__rows,
  .listing-insight-comment {
    padding-inline: 12px;
  }

  .listing-insight-rating-panel__summary {
    padding: 16px 14px;
  }

  .listing-insight-rating-row {
    grid-template-columns: 44px minmax(62px, 1fr) 58px;
    gap: 7px;
  }

  .listing-insight-rating-panel__recommendation {
    margin-inline: 14px;
  }
}

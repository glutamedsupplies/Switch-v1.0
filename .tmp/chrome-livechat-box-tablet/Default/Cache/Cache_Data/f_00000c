.product-model-scan-modal__camera-message {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 18px;
  z-index: 3;
  margin: 0;
  padding: 9px 12px;
  border-radius: 8px;
  background: rgba(2, 6, 23, 0.74);
  color: #ffffff;
  font-size: 0.86rem;
  font-weight: 750;
  line-height: 1.3;
  text-align: center;
}

.product-model-scan-modal__stage:focus-visible {
  outline: 3px solid rgba(var(--accent-rgb), 0.32);
  outline-offset: 2px;
}

.product-model-scan-modal__stage .product-model-registration__cube {
  width: 118px;
  height: 118px;
}

.product-model-scan-modal__stage .product-model-registration__cube-face--front {

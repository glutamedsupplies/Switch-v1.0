}

.android-preview-details__stat-card--posted .android-preview-material-icon {
  color: var(--accent);
}

.android-preview-details__stat-label {
  color: rgba(82, 96, 122, 0.7);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
}

.android-preview-details__stat-value {
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 800;
  line-height: 1.25;
}

.android-preview-details__about {
  display: grid;
  gap: 12px;
}

.android-preview-details__about-title {
  margin: 0;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 800;
  line-height: 1.2;
}

.android-preview-details__about-text {
  margin: 0;
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.55;
  word-break: break-word;
}

.android-preview-buy {
  position: relative;
  aspect-ratio: 9 / 19.5;
  overflow: hidden;
  border: 1px solid rgba(var(--accent-rgb), 0.12);
  border-radius: 28px;
  background: linear-gradient(180deg, #edf5ff 0%, #f8fbff 100%);

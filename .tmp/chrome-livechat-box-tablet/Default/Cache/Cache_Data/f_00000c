  gap: 2px;
}

.tracking-map-card__copy strong,
.tracking-map-card__copy span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracking-map-card__copy strong {

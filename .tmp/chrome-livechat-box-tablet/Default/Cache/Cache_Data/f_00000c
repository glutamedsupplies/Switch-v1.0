  line-height: 1.5;
}

.visual-search-camera__detection-box {
  position: absolute;
  z-index: 2;
  border: 3px solid #38bdf8;
  border-radius: 8px;
  box-shadow:
    0 0 0 999px rgba(0, 0, 0, 0.18),
    0 0 18px rgba(56, 189, 248, 0.44);
  pointer-events: none;
}

.visual-search-camera__detection-label {
  position: absolute;
  left: 8px;
  bottom: 8px;
  max-width: calc(100% - 16px);
  padding: 4px 8px;
  border-radius: 8px;
  background: rgba(2, 6, 23, 0.82);
  color: #ffffff;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visual-search-camera__detector-status {
  position: absolute;
  left: 12px;
  right: 12px;
  top: 12px;
  z-index: 1;
  margin: 0;
  padding: 7px 10px;
  border-radius: 8px;
  background: rgba(2, 6, 23, 0.74);
  color: #ffffff;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
}

.visual-search-camera__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.visual-search-camera__action {
  min-height: 48px;
  border-radius: 8px;
}

.visual-search-camera__action:disabled {
  cursor: not-allowed;
  opacity: 0.56;
}

.visual-search-camera__action--primary {
  background: var(--accent-button-bg);
  color: var(--accent-contrast);
}

.visual-search-camera__action--primary:hover,
.visual-search-camera__action--primary:focus-visible {
  background: var(--accent-button-hover-bg);
}

.visual-search-preview-container {
  display: grid;
  gap: 12px;
}

.visual-search-angle-grid {
  grid-template-columns: repeat(3, minmax(148px, 1fr));
}

.visual-search-angle-card {
  position: relative;
  min-width: 0;
  min-height: 172px;
  border-radius: 8px;
  background: #ffffff;
}

.visual-search-angle-card[data-ui-tooltip]::after {
  content: attr(data-ui-tooltip);
  position: absolute;
  left: 12px;
  bottom: 12px;
  z-index: 20;
  padding: 8px 12px;
  border: 0;
  border-radius: 10px;
  background: linear-gradient(
    135deg,
    rgba(var(--accent-rgb), 0.96) 0%,
    rgba(var(--accent-rgb), 0.78) 100%
  );
  color: var(--accent-contrast);
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  box-shadow: 0 12px 24px rgba(var(--accent-rgb), 0.24);
  backdrop-filter: blur(12px);
  transform: translateY(4px);
  transition:
    opacity 140ms ease,
    visibility 140ms ease,
    transform 180ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .visual-search-angle-card[data-ui-tooltip]:hover::after {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0.5s;
  }
}

.visual-search-angle-card__button,
.visual-search-angle-card__source-actions,
.visual-search-angle-card__preview-button {
  position: relative;
  width: 100%;
  min-height: 172px;
  height: 100%;
  padding: 18px;
  border: 1.5px dashed rgba(148, 163, 184, 0.78);
  border-radius: 8px;
  background: #ffffff;
  color: var(--accent);
  overflow: hidden;
}

.visual-search-angle-card__button,
.visual-search-angle-card__preview-button {
  display: grid;
  place-items: center;
  cursor: pointer;
}

.visual-search-angle-card__source-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.visual-search-angle-card.has-image .visual-search-angle-card__preview-button {
  border-style: dashed;
  padding: 10px;
}

.visual-search-angle-card__button:hover,
.visual-search-angle-card__button:focus-visible,
.visual-search-angle-card__source-actions:focus-within,
.visual-search-angle-card__source-actions:hover,
.visual-search-angle-card__preview-button:hover,
.visual-search-angle-card__preview-button:focus-visible {
  border-color: var(--accent);
  background: rgba(37, 99, 235, 0.035);
  outline: none;
}

.visual-search-angle-card__button > i,
.visual-search-angle-card__source-button > i,
.visual-search-angle-card__icon-button > i {
  width: 48px;
  height: 48px;
  display: inline-grid;
  place-items: center;
  color: var(--accent);
  font-size: 30px;
  line-height: 1;
}

.visual-search-angle-card__source-button,
.visual-search-angle-card__icon-button {
  width: 42px;
  min-width: 42px;
  height: 42px;
  min-height: 42px;
  aspect-ratio: 1 / 1;
  box-sizing: border-box;
  display: inline-grid;
  place-items: center;
  padding: 0;
  border: 1px solid rgba(15, 23, 42, 0.12);
}

/* Loading Spinner */
.loading-spinner {
  display: inline-block;
  width: 40px;
  height: 40px;
  border: 3px solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--primary-color, #2563eb);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {

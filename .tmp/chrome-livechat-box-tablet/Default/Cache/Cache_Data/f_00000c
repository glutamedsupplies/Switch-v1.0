@keyframes packing-order-transfer-json {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.92) rotate(-3deg);
  }
  8% {
    opacity: 1;
    transform: translateY(-4px) scale(1) rotate(0deg);
  }
  22% {
    transform: translateY(-9px) scale(1.04) rotate(3deg);
  }
  45% {
    transform: translateY(0) scale(0.98) rotate(-2deg);
  }
  72% {
    transform: translateY(-7px) scale(1.03) rotate(2deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }
}

@keyframes packing-order-card-box-motion {
  0% {
    opacity: 0;
    transform: translateY(10px) scale(0.72) rotate(-5deg);
  }
  10% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }
  24% {
    transform: translateY(-12px) scale(1.06) rotate(4deg);
  }
  38% {
    transform: translateY(4px) scale(0.98) rotate(-4deg);
  }
  54% {
    transform: translateY(-8px) scale(1.04) rotate(3deg);
  }
  70% {
    transform: translateY(3px) scale(1) rotate(-2deg);
  }
  86% {
    transform: translateY(-5px) scale(1.03) rotate(2deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }
}

@keyframes packing-order-card-lottie-sway {
  0%,
  100% {
    transform: translateY(0) rotate(-1deg);
  }
  50% {
    transform: translateY(-6px) rotate(1.5deg);
  }
}

@keyframes packing-order-lottie-path-draw {
  to {
    opacity: 1;
    stroke-dashoffset: 0;
  }
}


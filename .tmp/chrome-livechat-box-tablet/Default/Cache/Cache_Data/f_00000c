  --ring-radius: calc((var(--ring-size) / 2) - (var(--ring-thickness) / 2));
  position: relative;
  display: grid;
  place-items: center;
  width: var(--ring-size);
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background:
    radial-gradient(
      farthest-side,
      #ffffff calc(100% - var(--ring-thickness) - 1px),
      transparent calc(100% - var(--ring-thickness))
    ),
    conic-gradient(
      var(--accent, #ef4444) 0turn var(--progress-angle),
      rgba(148, 163, 184, 0.24) var(--progress-angle) 1turn
    );
}

.employee-dashboard-shell .employee-dashboard-progress-ring::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: var(--ring-thickness);
  height: var(--ring-thickness);
  border-radius: 50%;
  background: var(--accent, #ef4444);
  transform:
    translate(-50%, -50%)
    translateY(calc(-1 * var(--ring-radius)));
}

.employee-dashboard-shell .employee-dashboard-progress-ring::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: var(--ring-thickness);
  height: var(--ring-thickness);
  border-radius: 50%;
  background: var(--accent, #ef4444);
  transform:
    translate(-50%, -50%)
    rotate(var(--progress-angle))
    translateY(calc(-1 * var(--ring-radius)));
}


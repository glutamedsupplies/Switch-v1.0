  width: 128px;
  height: 24px;
  margin: 0 auto 10px;
  border-radius: 0 0 18px 18px;
  background: #020617;
}

.android-preview-device__screen {
  min-height: 620px;
  display: flex;
  flex-direction: column;
  border-radius: 30px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background:
    radial-gradient(circle at top, rgba(var(--accent-rgb), 0.12), transparent 26%),
    linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
}

.android-preview-statusbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px 4px;
  color: var(--text-primary);
  font-size: 11px;
  font-weight: 700;
}

.android-preview-statusbar__icons {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-secondary);
}

.android-preview-statusbar__icons i {
  font-size: 11px;
  line-height: 1;
}

.android-preview-appbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 16px 8px;
}

.android-preview-appbar__eyebrow {
  display: block;
  color: rgba(82, 96, 122, 0.9);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.android-preview-appbar__title {
  margin-top: 4px;
  font-size: 22px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.05;
}

.android-preview-appbar__actions {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.android-preview-appbar__action {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.88);
  color: var(--text-primary);
  box-shadow: 0 8px 18px rgba(21, 42, 88, 0.08);
}

.android-preview-tabs {
  display: flex;
  gap: 8px;
  padding: 2px 14px 12px;
  overflow-x: auto;
}

.android-preview-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 32px;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.78);
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.android-preview-tab.is-active {
  background: var(--accent-button-gradient-bg);
  color: var(--accent-contrast);
  box-shadow: 0 12px 24px rgba(var(--accent-rgb), 0.2);
}

.android-preview-feed {
  padding: 0 14px 14px;
  display: grid;
  gap: 12px;
}

.android-preview-section-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 2px;
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 700;
}

.android-preview-card {
  overflow: hidden;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 16px 30px rgba(21, 42, 88, 0.12);
  font-family: var(--android-preview-font-family);
}

.android-preview-card__image {
  position: relative;
  width: 100%;
  height: calc(
    var(--android-preview-card-width) * var(--android-preview-card-image-height) /
      var(--android-app-card-width)
  );
  display: block;
  background: linear-gradient(135deg, var(--accent-soft) 0%, rgba(var(--accent-rgb), 0.35) 100%);
  overflow: hidden;
}

.android-preview-card__image.is-clickable {
  cursor: pointer;
}

.android-preview-card__image img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center center;
}

.android-preview-card__image.is-empty img {
  display: none;
}

.android-preview-card__fallback {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: var(--accent-text);
  font-size: 48px;
  font-weight: 800;
}

.android-preview-card__body {
  display: grid;
  gap: 4px;
  padding: 12px 12px 14px;
}

.android-preview-card__category {
  color: var(--accent-text);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
}

.android-preview-card__name-line {
  min-height: 34px;
  margin: 0;
  color: var(--text-primary);
  font-size: 15px;
  font-weight: 700;
  line-height: 1.15;
}

.android-preview-card__name-text {
  color: inherit;
}

.android-preview-card__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.android-preview-card__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 6px;
  border-radius: var(--android-preview-radius);
  color: #fff;
  font-size: 9.5px;
  font-weight: 800;
  line-height: 1;
}

.android-preview-card__badge--inline {
  margin-left: 4px;
  vertical-align: middle;
}

.android-preview-card__badge--top-seller {
  background: #00897b;
}

.android-preview-card__badge--discount {
  background: #d32f2f;
}

.android-preview-card__badge--top-rating {
  background: #f9a825;
}

.android-preview-card__price-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px;
}

.android-preview-card__price {
  color: var(--accent);
  font-size: 16px;
  font-weight: 600;
}

.android-preview-card__price-original {
  color: rgba(82, 96, 122, 0.78);
  font-size: 11px;
  text-decoration: line-through;
}

.android-preview-card__stats {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  color: var(--text-secondary);
  font-size: 12px;
}

.android-preview-card__stat {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.android-preview-card__stat .android-preview-material-icon {
  font-size: 13px;
  line-height: 1;
}

.android-preview-card__stat--rating .android-preview-material-icon {
  color: #f9a825;
}

.android-preview-visibility {
  margin: 0 14px 14px;
  padding: 10px 12px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.45;
}

.android-preview-visibility.is-visible {
  background: rgba(47, 125, 79, 0.12);
  color: #2f7d4f;
}

.android-preview-visibility.is-hidden {
  background: rgba(168, 52, 52, 0.12);
  color: #a83434;
}

.android-preview-bottom-nav {
  margin-top: auto;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding: 12px 10px 14px;
  border-top: 1px solid rgba(var(--accent-rgb), 0.1);
  background: rgba(255, 255, 255, 0.86);
}

.android-preview-bottom-nav__item {
  display: grid;
  justify-items: center;
  gap: 6px;
  color: var(--text-secondary);
  font-size: 10px;
  font-weight: 700;
}

.android-preview-bottom-nav__item i {
  font-size: 15px;
  line-height: 1;
}

.android-preview-bottom-nav__item.is-active {
  color: var(--accent-text);
}

.android-preview-stage .android-preview-device__screen {
  border-color: var(--android-preview-outline-strong);
  background:
    radial-gradient(circle at top, rgba(var(--accent-rgb), 0.14), transparent 28%),
    linear-gradient(
      180deg,
      var(--android-preview-scaffold) 0%,
      var(--android-preview-dashboard) 100%
    );
}

.android-preview-stage .android-preview-statusbar {
  color: var(--text-primary);
}

.android-preview-stage .android-preview-statusbar__icons,
.android-preview-stage .android-preview-appbar__eyebrow,
.android-preview-stage .android-preview-section-meta,
.android-preview-stage .android-preview-card__stats,
.android-preview-stage .android-preview-card__price-original,
.android-preview-stage .android-preview-details__price-original,
.android-preview-stage .android-preview-buy__summary-price-original,
.android-preview-stage .android-preview-buy__meta-row,
.android-preview-stage .android-preview-bottom-nav__item {
  color: var(--text-secondary);
}

.android-preview-stage .android-preview-appbar__action,
.android-preview-stage .android-preview-tab {
  background: var(--android-preview-surface-muted);
  color: var(--text-primary);
  box-shadow: 0 8px 18px var(--android-preview-shadow-color);
}

.android-preview-stage .android-preview-card,
.android-preview-stage .android-preview-details__stat-card {
  background: var(--android-preview-surface);
  box-shadow: 0 16px 30px var(--android-preview-shadow-color);
}

.android-preview-stage[data-preview-theme="dark"] .android-preview-card,
.android-preview-stage[data-preview-theme="dark"] .android-preview-details__stat-card {
  background: var(--android-preview-surface-soft);
}

.android-preview-stage:not([data-preview-theme="dark"]) .android-preview-card {
  background: #ffffff;
}

.android-preview-stage .android-preview-card__image,
.android-preview-stage .android-preview-details,
.android-preview-stage .android-preview-buy {
  box-shadow: 0 20px 38px var(--android-preview-shadow-color);
}

.android-preview-stage .android-preview-details {
  border-color: var(--android-preview-outline-strong);
  background:
    radial-gradient(circle at top, rgba(var(--accent-rgb), 0.14), transparent 28%),
    linear-gradient(
      180deg,
      var(--android-preview-scaffold) 0%,
      var(--android-preview-dashboard) 100%
    );
}

.android-preview-stage .android-preview-details__body {
  background: transparent;
}

.android-preview-stage:not([data-preview-theme="dark"]) .android-preview-details {
  background:
    radial-gradient(circle at top, rgba(var(--accent-rgb), 0.14), transparent 28%),
    linear-gradient(180deg, #eeeeee 0%, #ffffff 100%);
}

.android-preview-stage:not([data-preview-theme="dark"]) .android-preview-details__stat-card {
  background: #ffffff;
}

.android-preview-stage .android-preview-buy {
  border-color: var(--android-preview-outline-strong);
  background: linear-gradient(
    180deg,
    var(--android-preview-dashboard) 0%,
    var(--android-preview-scaffold) 100%
  );
}

.android-preview-stage .android-preview-buy__sheet,
.android-preview-stage .android-preview-card,
.android-preview-stage .android-preview-buy__cancel {
  background: var(--android-preview-surface);
}

.android-preview-stage .android-preview-buy__summary,
.android-preview-stage .android-preview-buy__variant-card,
.android-preview-stage .android-preview-buy__quantity-control {
  background: var(--android-preview-surface-soft);
}

.android-preview-stage .android-preview-buy__variant-card {
  box-shadow: inset 0 0 0 1px var(--android-preview-outline);
}

.android-preview-stage .android-preview-buy__variant-card.is-selected {
  box-shadow: inset 0 0 0 1.5px rgba(var(--accent-rgb), 0.52);
}

.android-preview-stage .android-preview-buy__cancel {
  border-color: var(--android-preview-outline-strong);
  color: var(--text-primary);
}

.android-preview-stage .android-preview-buy__submit {
  background: var(--accent);
  color: var(--accent-contrast);
}

.android-preview-stage .android-preview-buy__submit-price {
  color: var(--android-preview-on-primary-muted);
}

.android-preview-stage .android-preview-buy__submit.is-disabled {
  color: rgba(255, 255, 255, 0.92);
}

.android-preview-stage .android-preview-details__favorite .android-preview-material-icon {
  color: var(--text-secondary);
}

.android-preview-stage .android-preview-bottom-nav {
  border-top-color: var(--android-preview-outline);
  background: var(--android-preview-surface-muted);
}

.android-preview-stage[data-preview-theme="dark"] .android-preview-device__screen,
.android-preview-stage[data-preview-theme="dark"] .android-preview-details,
.android-preview-stage[data-preview-theme="dark"] .android-preview-buy,
.android-preview-stage[data-preview-theme="dark"] .android-preview-buy__cancel {
  border-color: transparent;
}

.android-preview-stage[data-preview-theme="dark"] .android-preview-buy__variant-card,
.android-preview-stage[data-preview-theme="dark"] .android-preview-buy__variant-card.is-selected {
  box-shadow: none;
}

.android-preview-stage[data-preview-theme="dark"] .android-preview-bottom-nav {
  border-top-color: transparent;
}

.employee-chat-board {
  overflow: hidden;
}

.employee-chat-layout {
  display: grid;
  grid-template-columns: minmax(280px, 320px) minmax(0, 1fr);
  gap: 18px;
  min-height: 560px;
  align-items: stretch;
}

.employee-chat-thread-column,
.employee-chat-conversation-column {
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.employee-chat-thread-list {
  display: grid;
  gap: 10px;
  max-height: 560px;
  overflow-x: hidden;
  overflow-y: auto;
  padding-right: 4px;
}

.employee-chat-placeholder,
.employee-chat-empty-state {
  height: 100%;
  min-height: 240px;
  display: grid;
  place-content: center;
  gap: 8px;
  padding: 24px;
  text-align: center;
  border: 1px solid rgba(15, 23, 42, 0.12);
  border-radius: 8px;
  background: #f9fafb;
  color: var(--text-secondary);
}

.employee-chat-placeholder strong,
.employee-chat-empty-state strong {
  color: var(--text-primary);
}

.employee-chat-thread-item {
  width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr);
  gap: 12px;
  padding: 14px;
  border: 1px solid transparent;
  border-radius: 20px;
  background: var(--surface-soft);
  color: inherit;
  text-align: left;
  cursor: pointer;
  transition:
    border-color 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease,
    background-color 180ms ease;
}

.employee-chat-thread-item:hover,
.employee-chat-thread-item.is-active {
  border-color: transparent;
  background: #f3f4f6;
  box-shadow: none;
  transform: none;
  outline: none;
}

.employee-chat-thread-item__avatar,
.employee-chat-conversation-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--accent-soft), rgba(var(--accent-rgb), 0.2));
  color: var(--accent-text);
  font-weight: 800;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

.employee-chat-thread-item__avatar {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  font-size: 18px;
}

.employee-chat-thread-item__content {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.employee-chat-thread-item__title-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.employee-chat-thread-item__title-row strong {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 600;
}

.employee-chat-thread-item__title-row span,
.employee-chat-thread-item__customer,
.employee-chat-thread-item__preview,
.employee-chat-helper,
.employee-chat-message__bubble span,
.employee-chat-conversation-eyebrow,
.employee-chat-conversation-copy p {
  color: var(--text-secondary);
}

.employee-chat-thread-item__title-row span,
.employee-chat-thread-item__customer {
  font-size: 11px;
  font-weight: 600;
}

.employee-chat-thread-item__preview {
  font-size: 13px;
  font-weight: 400;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.employee-chat-thread-item__preview-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.employee-chat-thread-item__preview-row .employee-chat-thread-item__preview {
  flex: 1 1 auto;
  min-width: 0;
}

.employee-chat-thread-item__preview-time {
  flex: 0 0 auto;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.employee-chat-thread-item__unread-dot {
  width: 10px;
  height: 10px;
  margin-left: auto;
  align-self: center;
  border-radius: 50%;
  background: var(--accent);
  flex: 0 0 auto;
}

.employee-chat-thread-item.is-unread .employee-chat-thread-item__title-row strong {
  font-weight: 700;
}

.employee-chat-thread-item.is-unread .employee-chat-thread-item__preview {
  font-weight: 600;
}

.employee-chat-conversation-shell {
  height: min(72vh, 680px);
  max-height: min(72vh, 680px);
  min-height: 560px;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  border: 1px solid var(--panel-border);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.76);
  overflow: hidden;
}

.employee-chat-conversation-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 18px 16px;
  border-bottom: 1px solid rgba(15, 23, 42, 0.12);
  background: #f9fafb;
}

.employee-chat-conversation-product {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.employee-chat-conversation-avatar {
  width: 60px;
  height: 60px;
  border-radius: 18px;
  font-size: 22px;
  flex-shrink: 0;
}

.employee-chat-conversation-avatar.has-image {
  color: transparent;
}

.employee-chat-conversation-copy {
  min-width: 0;
}

.employee-chat-conversation-eyebrow {
  margin: 0 0 6px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.employee-chat-conversation-copy h3 {
  margin: 0;
  font-size: 20px;
}

.employee-chat-conversation-copy p {
  margin: 6px 0 0;
  line-height: 1.45;
}

.employee-chat-conversation-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.employee-chat-conversation-status__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex: 0 0 auto;
  background: #94a3b8;
}

.employee-chat-conversation-status.is-online .employee-chat-conversation-status__dot {
  background: #22c55e;
}

.employee-chat-conversation-status.is-offline .employee-chat-conversation-status__dot {
  background: #94a3b8;
}

.employee-chat-message-list {
  min-height: 0;
  overflow-y: auto;
  padding: 18px;
  display: grid;
  gap: 12px;
  background: var(--surface);
}

.employee-chat-message {
  display: flex;
}

.employee-chat-message.is-user {
  justify-content: flex-start;
}

.employee-chat-message.is-support {
  justify-content: flex-end;
}

.employee-chat-message__bubble {
  max-width: min(420px, 100%);
  padding: 14px 16px 12px;
  border-radius: 8px;
  background: var(--surface-soft);
  border: 1px solid rgba(15, 23, 42, 0.12);
  box-shadow: 0 10px 18px rgba(21, 42, 88, 0.06);
}

.employee-chat-message.is-support .employee-chat-message__bubble {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
  color: var(--accent-contrast);
  border-color: transparent;
  box-shadow: var(--button-shadow);
}

.employee-chat-message__bubble.is-heart {
  padding: 4px 6px 2px;
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}

.employee-chat-message__bubble.is-emoji {
  padding: 0;
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}

.employee-chat-message__bubble p {
  margin: 0;
  line-height: 1.55;
  white-space: pre-wrap;
}

.employee-chat-message__heart {
  font-size: 28px;
  line-height: 1;
}

.employee-chat-message__emoji-text {
  margin: 0;
  font-size: 40px;
  line-height: 1;
}

.employee-chat-message.is-support .employee-chat-message__bubble span {
  color: rgba(255, 255, 255, 0.82);
}

.employee-chat-message__bubble span {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  font-weight: 700;
}

.employee-chat-composer {
  display: grid;
  gap: 12px;
  padding: 18px;
  border-top: 1px solid rgba(15, 23, 42, 0.12);
  background: #f9fafb;
}

.employee-chat-media-input {
  display: none;
}

.employee-chat-input {
  width: 100%;
  box-sizing: border-box;
  resize: none;
  overflow-y: hidden;
  padding: 12px 16px;
  border-radius: 18px;
  border: 1px solid var(--border);
  outline: none;
  font: inherit;
  line-height: 1.5;
  color: var(--text-primary);
  background: var(--surface);
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.employee-chat-input:focus {
  border-color: rgba(var(--accent-rgb), 0.48);
  box-shadow: 0 0 0 4px var(--ring);
}

.employee-chat-composer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.employee-chat-composer-tools {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.employee-chat-icon-button {
  width: 46px;
  height: 46px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
  color: var(--text-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font: inherit;
  font-size: 18px;
  cursor: pointer;
  transition:
    transform 120ms ease,
    border-color 120ms ease,
    box-shadow 120ms ease,
    background-color 120ms ease;
}

.employee-chat-icon-button:hover {
  transform: translateY(-1px);
  border-color: rgba(var(--accent-rgb), 0.24);
  box-shadow: 0 10px 18px rgba(21, 42, 88, 0.08);
}

.employee-chat-icon-button:disabled {
  opacity: 0.58;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}


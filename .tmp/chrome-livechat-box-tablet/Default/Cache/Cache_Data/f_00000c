  --android-preview-font-family: "TikTok Sans", "Poppins", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  --android-preview-radius: 8px;
  width: 100%;
}

.android-preview-stage[data-preview-theme="dark"] {
  --accent: #e4f75d;
  --accent-strong: #e4f75d;
  --accent-soft: rgba(228, 247, 93, 0.14);
  --accent-rgb: 228, 247, 93;
  --accent-text: #e4f75d;
  --accent-contrast: #000000;
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.72);
  --android-preview-scaffold: #121212;
  --android-preview-dashboard: #1e1e1e;
  --android-preview-surface: #1e1e1e;
  --android-preview-surface-soft: #2a2a2a;
  --android-preview-surface-muted: rgba(30, 30, 30, 0.92);
  --android-preview-outline: transparent;
  --android-preview-outline-strong: transparent;
  --android-preview-shadow-color: rgba(0, 0, 0, 0.34);
  --android-preview-slider-image-background: #000000;
  --android-preview-on-primary-muted: rgba(0, 0, 0, 0.78);
}

.android-preview-material-icon {
  font-family: "Material Symbols Outlined";
  font-weight: 400;
  font-style: normal;
  font-size: 1em;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-smoothing: antialiased;
  font-variation-settings:
    "FILL" 0,
    "wght" 400,
    "GRAD" 0,
    "opsz" 24;
}

.android-preview-material-icon--badge-star {
  flex: 0 0 auto;
  width: 1em;
  height: 1em;
  overflow: hidden;
  text-indent: -9999px;
  vertical-align: middle;
  background: center / contain no-repeat url("./images/android-preview-badge-star.png");
}

.android-preview-layout {
  display: grid;
  align-items: flex-start;
  gap: 18px;
  width: 100%;
}

.android-preview-mobile-group {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 18px;
  width: 100%;
}

.android-preview-card-shell {
  flex: 0 0 auto;
  width: min(100%, var(--android-preview-card-width));
}

.android-preview-details-shell,
.android-preview-buy-shell {
  flex: 0 1 var(--android-phone-preview-width);
  width: min(100%, var(--android-phone-preview-width));
}

.android-preview-details {
  display: grid;
  grid-template-rows: var(--android-preview-details-image-height) minmax(0, 1fr);
  aspect-ratio: 9 / 19.5;
  overflow: hidden;
  border: 1px solid rgba(var(--accent-rgb), 0.12);
  border-radius: 28px;
  background: linear-gradient(180deg, #f7fbff 0%, #ffffff 18%, #ffffff 100%);
  box-shadow: 0 20px 38px rgba(18, 36, 78, 0.12);
  font-family: var(--android-preview-font-family);
}

.android-preview-details__hero {
  position: relative;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(
    135deg,
    rgba(var(--accent-rgb), 0.26) 0%,
    rgba(var(--accent-rgb), 0.08) 100%
  );
}

.android-preview-details__hero.is-clickable {
  cursor: pointer;
}

.android-preview-details__hero.is-slideable {
  touch-action: pan-y;
}

.android-preview-details__hero.is-dragging {
  cursor: pointer;
}

.android-preview-details__hero::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 92px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.18) 100%);
  pointer-events: none;
}

.android-preview-details__hero-carousel {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.android-preview-details__hero-track {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 240ms ease;
  will-change: transform;
}

.android-preview-details__hero.is-dragging .android-preview-details__hero-track {
  transition: none;
}

.android-preview-details__hero-slide {
  flex: 0 0 100%;
  min-width: 100%;
  height: 100%;
  position: relative;
}

.android-preview-details__hero-slide:not(.is-video),
.android-preview-details__hero-slide:not(.is-video) img {
  background: var(--android-preview-slider-image-background);
}

.android-preview-details__hero-slide img,
.android-preview-details__hero-slide video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  user-select: none;
  -webkit-user-drag: none;
}

.android-preview-details__hero-slide video {
  background: #000;
}

.android-preview-details__hero-slide.is-video-crop-pending {
  background: #000;
}

.android-preview-details__hero-video-play {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  pointer-events: none;
}

.android-preview-details__hero-video-play-icon {
  width: 68px;
  height: 68px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.24);
  color: #fff;
  font-size: 30px;
}

.android-preview-details__hero.is-empty img {
  display: none;
}

.android-preview-details__hero-fallback {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: var(--accent-text);
  font-size: 72px;
  font-weight: 800;
}

.android-preview-details__hero-indicators {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6px;
  display: flex;
  justify-content: center;
  padding: 0 12px;
  pointer-events: none;
}

.android-preview-details__hero-indicator-track {
  display: inline-flex;
  align-items: center;
  gap: 0;
  max-width: 100%;
  overflow-x: auto;
  pointer-events: auto;
  scrollbar-width: none;
}

.android-preview-details__hero-indicator-track::-webkit-scrollbar {
  display: none;
}

.android-preview-details__hero-indicator {
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  margin: 0 3px;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.36);
  transition:
    width 220ms ease,
    background-color 220ms ease;
  appearance: none;
  cursor: pointer;
}

.android-preview-details__hero-indicator.is-active {
  width: 20px;
  background: #ffffff;
}

.android-preview-details__body {
  display: grid;
  gap: 16px;
  padding: 18px 18px 22px;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.android-preview-details__body::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.android-preview-details__category-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: fit-content;
  max-width: 100%;
  padding: 6px 10px;
  border-radius: var(--android-preview-radius);
  background: rgba(var(--accent-rgb), 0.12);
  color: var(--accent);
  font-size: 11px;
  font-weight: 800;
  line-height: 1.2;
}

.android-preview-details__category-chip .android-preview-material-icon {
  font-size: 16px;
  line-height: 1;
}

.android-preview-details__title-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.android-preview-details__title {
  flex: 1 1 auto;
  margin: 0;
  color: var(--text-primary);
  font-size: 22px;
  font-weight: 500;
  line-height: 1.15;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.android-preview-details__favorite {
  flex: 0 0 auto;
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  background: transparent;
  color: rgba(82, 96, 122, 0.82);
  box-shadow: none;
}

.android-preview-details__favorite .android-preview-material-icon {
  font-size: 20px;  
  line-height: 1;
}

.android-preview-details__status-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.android-preview-details__status-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: var(--android-preview-radius);
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  line-height: 1;
}

.android-preview-details__status-chip .android-preview-material-icon {
  font-size: 16px;
  line-height: 1;
}

.android-preview-details__status-chip--discount {
  background: #d32f2f;
}

.android-preview-details__status-chip--top-seller {
  background: #0fc2b0;
}

.android-preview-details__status-chip--top-rating {
  background: #f9a825;
}

.android-preview-details__status-chip--top-rating .android-preview-material-icon,
.android-preview-details__stat-card--rating .android-preview-material-icon,
.android-preview-card__stat--rating .android-preview-material-icon {
  font-variation-settings:
    "FILL" 1,
    "wght" 400,
    "GRAD" 0,
    "opsz" 24;
}

.android-preview-details__price-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10px;
}

.price-with-symbol {
  display: inline-flex;
  align-items: baseline;
  gap: 0.08em;
  white-space: nowrap;
}

.price-with-symbol__symbol {
  font-size: 0.75em;
  line-height: 1;
}

.price-with-symbol__amount {
  line-height: 1;
}

.android-preview-details__price {
  color: var(--accent);
  font-size: 28px;
  font-weight: 550;
  line-height: 1;
}

.android-preview-details__price-original {
  color: rgba(82, 96, 122, 0.82);
  font-size: 15px;
  font-weight: 600;
  text-decoration: line-through;
}

.android-preview-details__stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.android-preview-details__stat-card {
  display: grid;
  gap: 8px;
  padding: 14px 12px;
  border-radius: var(--android-preview-radius);
  background: #fff;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.android-preview-details__stat-card .android-preview-material-icon {
  font-size: 18px;
  line-height: 1;
}

.android-preview-details__stat-card--rating .android-preview-material-icon {
  color: #f9a825;
}

.android-preview-details__rating-stars {
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

.android-preview-details__rating-star {
  font-size: 16px;
  line-height: 1;
}

.android-preview-details__rating-star--image {
  flex: 0 0 auto;
  width: 1em;
  height: 1em;
  overflow: hidden;
  text-indent: -9999px;
  vertical-align: middle;
  background: center / contain no-repeat url("./images/android-preview-star.png");
}

.android-preview-details__rating-star.is-active {
  opacity: 1;
}

.android-preview-details__rating-star.is-inactive {
  opacity: 0.28;
}

.android-preview-details__rating-value {

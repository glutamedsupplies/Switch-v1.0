}

.product-model-scan-modal__stage .product-model-registration__cube-face--top {
  transform: rotateX(90deg) translateZ(59px);
}

.product-model-scan-modal__stage .product-model-registration__cube-face--bottom {
  transform: rotateX(-90deg) translateZ(59px);
}

.product-model-scan-modal__line {

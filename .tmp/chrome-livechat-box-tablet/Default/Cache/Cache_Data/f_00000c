    transform: rotate(360deg);
  }
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  gap: 16px;
  color: var(--text-secondary);
}

.loading-container .loading-spinner {
  width: 48px;
  height: 48px;
  border-width: 4px;
}


.visual-search-angle-card__source-button {
  width: 60px;
  min-width: 60px;
  height: 60px;
  min-height: 60px;
  background: rgba(var(--accent-rgb), 0.08);
  border-color: rgba(var(--accent-rgb), 0.18);
  box-shadow: none;
}

.visual-search-angle-card__floating-actions {
  position: absolute;
  right: 12px;
  bottom: 12px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(4px);
  transition:
    opacity 180ms ease,
    transform 180ms ease;
}

.visual-search-angle-card__source-button:hover,
.visual-search-angle-card__source-button:focus-visible,
.visual-search-angle-card__icon-button:hover,
.visual-search-angle-card__icon-button:focus-visible {
  background: #ffffff;
  color: var(--accent);
  box-shadow: 0 12px 26px rgba(15, 23, 42, 0.16);
  outline: none;
}

.visual-search-angle-card__source-button > i {
  width: auto;
  height: auto;
  font-size: 22px;
}

.visual-search-angle-card__icon-button > i {
  width: auto;
  height: auto;
  font-size: 16px;
}

.visual-search-preview-image {
  position: absolute;
  inset: 10px;
  width: calc(100% - 20px);
  height: calc(100% - 20px);
  object-fit: contain;
  border-radius: 6px;
  background: #ffffff;
}

.visual-search-preview-delete-button {
  position: absolute;
  right: 12px;
  top: 12px;
  width: 42px;
  min-width: 42px;
  min-height: 42px;
  height: 42px;
  aspect-ratio: 1 / 1;
  box-sizing: border-box;
  display: inline-grid;
  place-items: center;
  padding: 0;
  border: 1px solid rgba(15, 23, 42, 0.12);
  border-radius: 50% !important;
  background: #ffffff;
  color: var(--text-primary);
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.12);
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transform: translateY(4px);
  transition:
    background-color 180ms ease,
    color 180ms ease,
    opacity 180ms ease,
    transform 180ms ease;
  z-index: 2;
}

.visual-search-preview-delete-button i {
  font-size: 18px !important;
  line-height: 1;
}

.visual-search-preview-delete-button:hover,
.visual-search-preview-delete-button:focus-visible {
  background: #ffffff;
  color: #a83434;
  box-shadow: 0 12px 26px rgba(15, 23, 42, 0.16);
  outline: none;
}

.visual-search-angle-card.has-image:hover .visual-search-angle-card__floating-actions,
.visual-search-angle-card.has-image:focus-within .visual-search-angle-card__floating-actions,
.visual-search-angle-card.has-image:hover .visual-search-preview-delete-button,
.visual-search-angle-card.has-image:focus-within .visual-search-preview-delete-button {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.product-model-registration {
  display: grid;
  grid-template-columns: minmax(220px, 0.9fr) minmax(0, 1fr);
  gap: 16px;
  align-items: stretch;
}

.product-model-registration__viewer {
  position: relative;
  min-height: 260px;
  display: grid;
  place-items: center;
  border: 1.5px dashed rgba(148, 163, 184, 0.78);
  border-radius: 8px;
  background:
    radial-gradient(circle at 30% 20%, rgba(var(--accent-rgb), 0.12), transparent 32%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(241, 245, 249, 0.96));
  cursor: grab;
  overflow: hidden;
  perspective: 760px;
  touch-action: none;
  user-select: none;
}

.product-model-registration__viewer.has-model {
  border-style: solid;
  border-color: rgba(var(--accent-rgb), 0.45);
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.12);
}

.product-model-registration__model-viewer {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  background: transparent;
  opacity: 0;
  pointer-events: none;
  cursor: grab;
  touch-action: none;
  transition: opacity 180ms ease;
}

.product-model-registration__model-viewer:active {
  cursor: grabbing;
}

.product-model-registration__unity-frame {
  position: absolute;
  inset: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
  border: 0;
  background: #0f172a;
}

.product-model-registration__viewer.is-model-viewer-ready .product-model-registration__model-viewer {
  opacity: 1;
  pointer-events: auto;
}

.product-model-registration__viewer.is-model-viewer-ready .product-model-registration__cube,
.product-model-registration__viewer.is-model-viewer-ready .product-model-registration__scan-ring,
.product-model-registration__viewer.is-unity-viewer-ready .product-model-registration__cube,
.product-model-registration__viewer.is-unity-viewer-ready .product-model-registration__scan-ring {
  opacity: 0;
  visibility: hidden;
}

.product-model-registration__viewer.is-dragging {
  cursor: grabbing;
}

.product-model-registration__viewer:focus-visible {
  border-color: var(--accent);
  outline: 3px solid rgba(var(--accent-rgb), 0.18);
  outline-offset: 2px;
}

.product-model-registration__cube {
  --model-rotate-x: -18deg;
  --model-rotate-y: 34deg;
  position: relative;
  z-index: 1;
  width: 92px;
  height: 92px;
  transform: rotateX(var(--model-rotate-x)) rotateY(var(--model-rotate-y));
  transform-style: preserve-3d;
  transition: transform 120ms ease;
}

.product-model-registration__viewer.is-dragging .product-model-registration__cube,
.product-model-scan-modal__stage.is-dragging .product-model-registration__cube {
  transition: none;
}

.product-model-registration__cube-face {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 8px;
  background: linear-gradient(135deg, #1d4ed8, #10b981 48%, #f59e0b);
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  box-shadow: inset 0 0 26px rgba(255, 255, 255, 0.26);
  opacity: 0.92;
}

.product-model-registration__cube-face.has-frame-texture {
  border-color: rgba(255, 255, 255, 0.84);
  box-shadow:
    inset 0 0 18px rgba(15, 23, 42, 0.16),
    0 8px 18px rgba(15, 23, 42, 0.12);
  opacity: 1;
}

.product-model-registration__cube-face--front {
  transform: translateZ(46px);
}

.product-model-registration__cube-face--back {
  transform: rotateY(180deg) translateZ(46px);
}

.product-model-registration__cube-face--right {
  transform: rotateY(90deg) translateZ(46px);
  background: linear-gradient(135deg, #0f766e, #22c55e 50%, #84cc16);
}

.product-model-registration__cube-face--left {
  transform: rotateY(-90deg) translateZ(46px);
  background: linear-gradient(135deg, #7c3aed, #2563eb 52%, #06b6d4);
}

.product-model-registration__cube-face--top {
  transform: rotateX(90deg) translateZ(46px);
  background: linear-gradient(135deg, #f97316, #facc15 54%, #22c55e);
}

.product-model-registration__cube-face--bottom {
  transform: rotateX(-90deg) translateZ(46px);
  background: linear-gradient(135deg, #0f172a, #475569 58%, #14b8a6);
}

.product-model-registration__scan-ring {
  position: absolute;
  width: 154px;
  height: 154px;
  border: 1px solid rgba(var(--accent-rgb), 0.26);
  border-radius: 50%;
  box-shadow: 0 0 0 16px rgba(var(--accent-rgb), 0.045);
  animation: productModelScanPulse 2200ms ease-in-out infinite;
}

.product-model-registration__content {
  display: grid;
  gap: 14px;
  align-content: center;
}

.product-model-registration__carousel {
  display: grid;
  gap: 6px;
}

.product-model-registration__eyebrow,
.product-model-registration__title,
.product-model-registration__copy {
  margin: 0;
}

.product-model-registration__eyebrow {
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.product-model-registration__title {
  color: var(--text-primary);
  font-size: 1.15rem;
  font-weight: 800;
  line-height: 1.2;
}

.product-model-registration__copy {
  color: var(--text-muted);
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.45;
}

.product-model-registration__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.product-model-registration__action {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 14px;
  border: 1px solid rgba(148, 163, 184, 0.34);
  border-radius: 8px;
  background: var(--surface);
  color: var(--text-primary);
  font-weight: 800;
  cursor: pointer;
  transition:
    background-color 160ms ease,
    border-color 160ms ease,
    color 160ms ease,
    transform 160ms ease;
}

.product-model-registration__action:hover,
.product-model-registration__action:focus-visible {
  border-color: rgba(var(--accent-rgb), 0.42);
  color: var(--accent);
  outline: none;
  transform: translateY(-1px);
}

.product-model-registration__action:disabled {
  opacity: 0.52;
  cursor: not-allowed;
  transform: none;
}

.product-model-registration__action--primary {
  border-color: var(--accent-button-bg);
  background: var(--accent-button-bg);
  color: var(--accent-contrast);
}

.product-model-registration__action--primary:hover,
.product-model-registration__action--primary:focus-visible {
  background: var(--accent-button-hover-bg);
  color: var(--accent-contrast);
}

.product-model-registration__action--danger:hover,
.product-model-registration__action--danger:focus-visible {
  border-color: rgba(168, 52, 52, 0.3);
  color: #a83434;
}

.product-model-scan-overlay {
  position: fixed;
  inset: 0;
  z-index: 340;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(15, 23, 42, 0.68);
}

.product-model-scan-modal {
  position: relative;
  width: min(860px, 100%);
  display: grid;
  grid-template-columns: minmax(260px, 0.95fr) minmax(0, 1fr);
  gap: 18px;
  padding: 18px;
  border-radius: 8px;
  background: var(--surface);
  color: var(--text-primary);
  box-shadow: 0 28px 72px rgba(15, 23, 42, 0.28);
}

.product-model-scan-modal__close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 4;
  width: 38px;
  height: 38px;
  display: inline-grid;
  place-items: center;
  border: 1px solid rgba(15, 23, 42, 0.1);
  border-radius: 50%;
  background: #ffffff;
  color: var(--text-primary);
  cursor: pointer;
}

.product-model-scan-modal__close:hover,
.product-model-scan-modal__close:focus-visible {
  color: #a83434;
  outline: none;
}

.product-model-scan-modal__stage {
  position: relative;
  min-height: 320px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background:
    linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
    radial-gradient(circle at 50% 45%, rgba(var(--accent-rgb), 0.36), transparent 42%),
    #0f172a;
  background-size: 32px 32px, 32px 32px, auto, auto;
  cursor: grab;
  overflow: hidden;
  perspective: 820px;
  touch-action: none;
}

.product-model-scan-modal__stage--camera {
  background:
    radial-gradient(circle at 50% 45%, rgba(var(--accent-rgb), 0.24), transparent 42%),
    #0f172a;
  cursor: default;
}

.product-model-scan-modal__stage--frames {
  min-height: 360px;
  align-items: stretch;
  padding: 18px 18px 48px;
  background:
    linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px),
    linear-gradient(145deg, rgba(248, 250, 252, 0.98), rgba(226, 232, 240, 0.98));
  background-size: 28px 28px, 28px 28px, auto;
  cursor: default;
  perspective: none;
  touch-action: auto;
}

.product-model-scan-modal__frame-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.product-model-scan-modal__frame-card {
  min-width: 0;
  min-height: 118px;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto auto;
  gap: 5px;
  padding: 8px;
  border: 1.5px dashed rgba(100, 116, 139, 0.42);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.86);
  color: var(--text-primary);
  cursor: pointer;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    transform 160ms ease;
}

.product-model-scan-modal__frame-card.has-image {
  border-style: solid;
  border-color: rgba(var(--accent-rgb), 0.48);
}

.product-model-scan-modal__frame-card:hover,
.product-model-scan-modal__frame-card:focus-within {
  border-color: rgba(var(--accent-rgb), 0.72);
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
  transform: translateY(-1px);
}

.product-model-scan-modal__frame-preview {
  min-height: 58px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background:
    linear-gradient(135deg, rgba(var(--accent-rgb), 0.12), rgba(16, 185, 129, 0.1)),
    rgba(241, 245, 249, 0.92);
  background-position: center;
  background-size: cover;
  color: var(--accent);
  overflow: hidden;
}

.product-model-scan-modal__frame-preview i {
  font-size: 22px !important;
}

.product-model-scan-modal__frame-label,
.product-model-scan-modal__frame-hint {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-model-scan-modal__frame-label {
  font-size: 0.78rem;
  font-weight: 850;
}

.product-model-scan-modal__frame-hint {
  color: var(--text-muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.product-model-scan-modal__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 180ms ease;
}

.product-model-scan-modal__stage.has-camera .product-model-scan-modal__video {
  opacity: 1;

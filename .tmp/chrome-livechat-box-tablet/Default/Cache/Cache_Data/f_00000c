}

.tracking-map-type-control__button {
  min-width: 76px;
  min-height: 36px;
  padding: 0 12px;
  border: 0;
  border-radius: 6px !important;
  background: transparent;
  color: #3c4043;
  font-size: 13px;
  font-weight: 600 !important;
  cursor: pointer;
}

.tracking-map-type-control__button:hover,
.tracking-map-type-control__button:focus-visible {
  background: #f1f3f4;
}

.tracking-map-type-control__button.is-active {
  background: #e8f0fe;
  color: #1967d2;
}

.tracking-leaflet-map .leaflet-control-attribution {
  right: 8px;
  bottom: 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.86);
  color: #5f6368;
  box-shadow: 0 1px 2px rgba(60, 64, 67, 0.18);
}

.tracking-leaflet-map .leaflet-control-attribution a {
  color: #1967d2;
  text-decoration: none;
}

.tracking-leaflet-pin {
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #ffffff;
  box-shadow: 0 12px 22px rgba(15, 23, 42, 0.22);
}

.tracking-leaflet-pin--hub {
  border: 3px solid #1a73e8;
  color: #1a73e8;
  font-size: 13px;
  font-weight: 900;
}

.tracking-leaflet-pin--destination {
  border-radius: 999px 999px 999px 4px;
  background: #ea4335;
  transform: rotate(-45deg);
}

.tracking-leaflet-pin--destination span {
  width: 12px;
  height: 12px;
  border-radius: 999px;
  background: #ffffff;
}

.tracking-leaflet-courier {
  display: flex !important;
  align-items: center;
  justify-content: center;
  border: 3px solid #1a73e8;
  border-radius: 999px;
  background: #ffffff;
  box-shadow: 0 14px 26px rgba(15, 23, 42, 0.24);
}

.tracking-leaflet-courier span {
  position: relative;
  width: 22px;
  height: 14px;
  display: block;
  border-radius: 4px 5px 4px 4px;
  background: #1a73e8;
}

.tracking-leaflet-courier span::before {
  content: "";
  position: absolute;
  right: -5px;
  bottom: 0;
  width: 8px;
  height: 9px;
  border-radius: 3px 3px 4px 0;
  background: #1a73e8;
}

.tracking-leaflet-courier span::after {
  content: "";
  position: absolute;
  left: 3px;
  right: -2px;
  bottom: -5px;
  height: 5px;
  border-radius: 999px;
  background:
    radial-gradient(circle at 4px 50%, #ffffff 0 2px, transparent 2.5px),
    radial-gradient(circle at calc(100% - 4px) 50%, #ffffff 0 2px, transparent 2.5px);
}

.tracking-map {
  width: 100%;
  height: clamp(420px, 58vh, 620px);
  display: block;
}

.tracking-map-panel {
  background: #ffffff;
}

.tracking-map-panel .panel-heading {
  color: #202124;
}

.tracking-map-panel .section-label {
  color: #5f6368;
  letter-spacing: 0.08em;
}

.tracking-map__road {
  fill: none;
  stroke: rgba(148, 163, 184, 0.45);
  stroke-width: 8;
  stroke-linecap: round;
}

.tracking-map__road--major {
  stroke: rgba(100, 116, 139, 0.32);
  stroke-width: 14;
}

.tracking-map__route-base {
  fill: none;
  stroke: rgba(15, 23, 42, 0.18);
  stroke-width: 12;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.tracking-map__route-progress {
  fill: none;
  stroke: url(#tracking-route-gradient);
  stroke-width: 12;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.tracking-map__waypoint {
  fill: #ffffff;
  stroke: rgba(var(--accent-rgb), 0.45);
  stroke-width: 3;
}

.tracking-map__pin--origin circle {
  fill: #ffffff;
  stroke: rgba(var(--accent-rgb), 0.44);
  stroke-width: 4;
}

.tracking-map__pin--origin path {
  fill: none;
  stroke: rgb(var(--accent-rgb));
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.tracking-map__pin--destination path {
  fill: #16a34a;
}

.tracking-map__pin--destination circle {
  fill: #ffffff;
}

.tracking-map__courier circle {
  fill: #ffffff;
  stroke: rgb(var(--accent-rgb));
  stroke-width: 4;
}

.tracking-map__courier path {
  fill: rgb(var(--accent-rgb));
}

.tracking-map__courier circle:nth-of-type(2),
.tracking-map__courier circle:nth-of-type(3) {
  fill: #ffffff;
  stroke: none;
}

.tracking-map__label rect {
  fill: rgba(255, 255, 255, 0.92);
  stroke: rgba(15, 23, 42, 0.08);
}

.tracking-map__label text {
  fill: var(--text-primary);
  font-family: "Poppins", "Segoe UI", sans-serif;
  font-size: 14px;
  font-weight: 700;
}

.tracking-map-readout {
  margin-top: 14px;
  margin-bottom: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 700;
}

.tracking-map-readout span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracking-map-readout__divider {
  width: 34px;
  height: 2px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: rgba(var(--accent-rgb), 0.32);
}

.tracking-detail-list {
  margin: 0;
  display: grid;
  gap: 12px;
}

.tracking-detail-list > div {
  min-width: 0;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(15, 23, 42, 0.08);
}

.tracking-detail-list dt {
  margin: 0 0 4px;
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.tracking-detail-list dd {
  margin: 0;
  min-width: 0;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.tracking-timeline {
  margin-top: 18px;
  display: grid;
  gap: 0;
}

.tracking-timeline__step {
  position: relative;
  min-height: 58px;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  gap: 10px;
}

.tracking-timeline__step::before {
  content: "";
  position: absolute;
  top: 18px;
  bottom: -4px;
  left: 9px;
  width: 2px;
  background: rgba(15, 23, 42, 0.1);
}

.tracking-timeline__step:last-child::before {
  display: none;
}

.tracking-timeline__dot {
  width: 20px;
  height: 20px;
  margin-top: 1px;
  border: 3px solid rgba(15, 23, 42, 0.14);
  border-radius: 999px;
  background: #ffffff;
  z-index: 1;
}

.tracking-timeline__step.is-complete .tracking-timeline__dot,
.tracking-timeline__step.is-active .tracking-timeline__dot {
  border-color: rgb(var(--accent-rgb));
  background: rgb(var(--accent-rgb));
  box-shadow: 0 0 0 5px rgba(var(--accent-rgb), 0.12);
}

.tracking-timeline__content {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.tracking-timeline__content strong {
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 800 !important;
}

.tracking-timeline__content small {
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 600;
}

@media (max-width: 1280px) {
  .tracking-workspace {
    grid-template-columns: minmax(270px, 360px) minmax(0, 1fr);
  }

  .tracking-detail-panel {
    grid-column: 1 / -1;
  }
}

@media (max-width: 860px) {
  .tracking-summary-grid,
  .tracking-workspace {
    grid-template-columns: 1fr;
  }

  .traking-page .tracking-orders-panel {
    min-height: auto;
    padding-bottom: var(--tracking-orders-panel-bottom-space, 28px);
  }

  .traking-page .tracking-map-panel {
    min-height: auto;
    padding-bottom: var(--tracking-map-panel-bottom-space, 24px);
  }

  .tracking-detail-panel {
    grid-column: auto;
  }

  .tracking-order-list {
    max-height: none;
  }

  .tracking-google-map,
  .tracking-leaflet-map,
  .tracking-map {
    height: 430px;
  }
}

@media (max-width: 560px) {
  .tracking-filter-tabs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tracking-filter-tabs__button:first-child {
    grid-column: 1 / -1;
  }

  .tracking-google-map,
  .tracking-leaflet-map,
  .tracking-map {
    height: 360px;
  }

  .tracking-order-item__topline {
    align-items: flex-start;
    flex-direction: column;
  }

  .tracking-map-readout {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .tracking-map-readout__divider {
    width: 100%;
  }
}


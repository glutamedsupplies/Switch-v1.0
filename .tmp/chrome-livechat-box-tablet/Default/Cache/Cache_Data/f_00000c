}

.android-preview-buy__summary-price-group {
  display: grid;
  gap: 2px;
}

.android-preview-buy__summary-price {
  color: var(--accent);
  font-size: 30px;
  font-weight: 550;
  line-height: 1;
}

.android-preview-buy__summary-price-original {
  color: rgba(82, 96, 122, 0.82);

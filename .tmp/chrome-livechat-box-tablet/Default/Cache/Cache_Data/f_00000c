  font-size: 14px;
  font-weight: 600 !important;
}

.tracking-map-card__copy span {
  color: #5f6368;
  font-size: 12px;
  font-weight: 500;
}

.tracking-map-type-control {
  position: absolute;
  left: 14px;
  bottom: 14px;
  z-index: 620;
  padding: 4px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 8px;
  background: #ffffff;

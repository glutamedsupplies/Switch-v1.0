/* Local Leaflet layout fallback. Keeps map tiles aligned when CDN CSS is slow or blocked. */
.leaflet-container {
  position: relative;
  overflow: hidden;
  background: #dbe7e8;
  outline: 0;
  font-family: "Poppins", "Segoe UI", sans-serif;
  isolation: isolate;
}


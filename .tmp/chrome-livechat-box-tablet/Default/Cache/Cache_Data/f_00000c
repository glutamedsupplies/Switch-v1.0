  background: rgba(var(--accent-rgb), 0.12);
}

.android-preview-buy__summary-image.is-clickable {
  cursor: pointer;
}

.android-preview-buy__summary-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.android-preview-buy__summary-image-fallback {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: var(--accent-text);
  font-size: 40px;
  font-weight: 800;
  background: linear-gradient(

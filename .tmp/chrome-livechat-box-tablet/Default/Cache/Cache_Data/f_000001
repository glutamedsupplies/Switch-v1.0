<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Swift Cart Main</title>
    <link rel="stylesheet" href="/main.css?v=business-live-chat-5" />
    <link rel="stylesheet" href="/restored-main-shell.css?v=restore-1" />
    <link rel="stylesheet" href="/restored-product-listing.css?v=modal-recovery-2" />
  </head>
  <body>
    <div class="main-shell">
      <aside class="main-sidebar" id="main-sidebar" data-main-sidebar>
        <a class="main-brand" href="/main.html" aria-label="Main workspace">
          <span class="main-brand__mark" aria-hidden="true">
            <img class="main-brand__image" alt="" hidden data-main-logo />
            <span class="main-brand__fallback" data-main-fallback>SC</span>
          </span>
          <span class="main-brand__copy">
            <strong data-main-name>
              <span class="main-brand__marquee-text" data-main-name-text>Swift Cart</span>
            </strong>
            <span data-main-subtitle>Workspace</span>
          </span>
        </a>

        <nav class="main-nav" aria-label="Main navigation" data-main-nav></nav>
      </aside>

      <div class="main-backdrop" data-main-backdrop></div>

      <div class="main-page">
        <div class="main-header-container">
          <header class="main-header">
          <div class="main-header__controls">
            <button
              type="button"
              class="main-icon-button main-header__toggle"
              data-main-sidebar-toggle
              aria-label="Open navigation"
              aria-expanded="false"
              aria-controls="main-sidebar"
              title="Open navigation"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 6h16" />
                <path d="M4 12h16" />
                <path d="M4 18h16" />
              </svg>
            </button>

            <div class="main-workspace-pill" aria-label="Workspace status">
              <span class="main-workspace-pill__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                  <path d="M4 9h16l-1.2-4.2A1.2 1.2 0 0 0 17.65 4H6.35a1.2 1.2 0 0 0-1.15.8L4 9Z" />
                  <path d="M5 9v10h14V9" />
                  <path d="M8 13h3v6H8zM14 13h3" stroke-linecap="round" />
                </svg>
              </span>
              <span class="main-workspace-pill__status" aria-hidden="true"></span>
            </div>

            <label class="main-search" aria-label="Search workspace">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.6-3.6" />
              </svg>
              <input type="search" placeholder="Search Workspace" data-main-search />
            </label>

            <button type="button" class="main-filter-button" data-main-filter>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.5 5h17l-6.7 7.7v4.9l-3.6 1.7v-6.6L3.5 5Z" />
              </svg>
              <span data-main-filter-label>All, Newest</span>
            </button>
          </div>

          <div class="main-header__actions">
            <button type="button" class="main-icon-button" aria-label="Notifications" title="Notifications">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                <path d="M10 21h4" />
              </svg>
              <span class="main-notification-badge">5</span>
            </button>
            <button type="button" class="main-icon-button" aria-label="Theme" title="Theme">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="13.5" cy="6.5" r="2.2" />
                <circle cx="7" cy="12" r="2.2" />
                <circle cx="14.5" cy="17.5" r="2.2" />
                <path d="M18.6 12.2a7.5 7.5 0 1 1-1.4-5.8 2.2 2.2 0 0 0 .5 3.7c1.2.4 1.6 1.5.9 2.1Z" />
              </svg>
            </button>
          </div>
          </header>
        </div>

        <main class="main-content" data-main-content>
          <div class="main-dashboard-view" data-main-dashboard-view>
            <section class="main-title">
              <div>
                <p class="main-breadcrumb" data-main-breadcrumb>Dashboard / Main</p>
                <h1 data-main-title>Main Workspace</h1>
                <p data-main-description>Monitor your workspace status and open assigned tools.</p>
              </div>
              <a class="main-primary-link" href="#" data-main-open-dashboard>Open Dashboard</a>
            </section>

            <section class="main-summary" aria-label="Workspace summary" data-main-summary></section>
            <section class="main-links" aria-label="Workspace tools" data-main-links></section>
          </div>

          <section
            class="main-live-chat-view live-chat-shell"
            aria-label="Live Chat"
            data-main-live-chat-view
            hidden
          >
            <input
              type="search"
              class="main-live-chat-search-bridge"
              aria-label="Live Chat search bridge"
              data-employee-chat-search
              tabindex="-1"
              hidden
            />
            <div class="main-live-chat-mount" data-main-live-chat-mount>
              <div class="main-live-chat-loading" role="status">
                <span class="main-live-chat-loading__spinner" aria-hidden="true"></span>
                <strong>Loading conversations...</strong>
              </div>
            </div>
          </section>

          <section
            class="main-orders-view"
            aria-label="Orders"
            data-main-orders-view
            hidden
          >
            <div class="main-orders-frame-shell">
              <div class="main-orders-loading" role="status" data-main-orders-loading>
                <span class="main-orders-loading__spinner" aria-hidden="true"></span>
                <strong>Loading live orders...</strong>
              </div>
              <div class="main-orders-error" role="alert" hidden data-main-orders-error>
                <strong>Unable to load orders</strong>
                <p>Please refresh or try again.</p>
                <button type="button" data-main-orders-retry>Try again</button>
              </div>
              <iframe
                class="main-orders-frame"
                title="Live orders workspace"
                loading="eager"
                data-no-lazy
                data-main-orders-frame
              ></iframe>
            </div>
          </section>

          <section
            class="main-listing-insight-view"
            aria-label="Listing Insight"
            data-main-listing-insight-view
            hidden
          >
            <div class="main-listing-insight-frame-shell">
              <div class="main-listing-insight-loading" role="status" data-main-listing-insight-loading>
                <span class="main-listing-insight-loading__spinner" aria-hidden="true"></span>
                <strong>Loading listing insight...</strong>
              </div>
              <div class="main-listing-insight-error" role="alert" hidden data-main-listing-insight-error>
                <strong>Unable to load listing insight</strong>
                <p>Please refresh or try again.</p>
                <button type="button" data-main-listing-insight-retry>Try again</button>
              </div>
              <iframe
                class="main-listing-insight-frame"
                title="Listing insight workspace"
                loading="eager"
                data-no-lazy
                data-main-listing-insight-frame
              ></iframe>
            </div>
          </section>

          <section
            class="main-listing-view product-status-shell"
            aria-label="Product Listing"
            data-main-listing-view
            hidden
          >
            <header class="main-listing-page-heading" aria-label="Listing header">
              <p class="main-listing-page-heading__breadcrumb">
                <span>Dashboard</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
                <span>Listing</span>
              </p>
              <h1>Listing</h1>
              <p>Manage product records, listing status, item visibility, and seller catalog activity.</p>
              <button
                type="button"
                class="product-panel-add-button"
                id="open-product-composer-button"
                aria-controls="product-composer-modal"
                aria-expanded="false"
              >
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                <span>Add Product</span>
              </button>
            </header>
                        <div class="product-panel-grid product-panel-grid--products-only">
                        <div
                          class="product-composer-modal-overlay"
                          id="product-composer-modal"
                          aria-hidden="true"
                          hidden
                        >
                          <section
                            class="product-composer-modal product-composer-modal--workspace"
                            role="dialog"
                            aria-modal="true"
                            aria-labelledby="form-title"
                            tabindex="-1"
                          >
                            <header class="product-composer-modal__topbar">
                              <div class="product-composer-modal__identity">
                                <span class="product-composer-modal__brand-icon" aria-hidden="true">
                                  <i class="fa-solid fa-cube"></i>
                                </span>
                                <div>
                                  <p class="section-label" id="form-section-label">Create Product</p>
                                  <h2 id="form-title">Add Product</h2>
                                  <p class="product-composer-modal__subtitle">
                                    Create a new product and manage all the essential information.
                                  </p>
                                </div>
                              </div>
                              <div class="product-composer-modal__header-actions">
                                <span class="status-pill" id="status-pill">Adding</span>
                                <button
                                  type="button"
                                  class="product-composer-modal__close"
                                  id="close-product-composer-button"
                                  aria-label="Close Add Product"
                                  title="Close"
                                >
                                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                              </div>
                            </header>

                            <form id="product-form" class="product-form product-composer-form">
                              <div class="product-composer-modal__workspace">
                                <div
                                  id="product-editor-section-media"
                                  class="product-composer-canvas product-form-section-anchor"
                                >
                                  <section
                                    id="product-editor-section-photo"
                                    class="product-composer-section product-composer-section--photo product-image-upload-group product-form-section-anchor"
                                  >
                                    <div class="product-composer-section__heading product-photo-section__heading">
                                      <span class="product-photo-section__icon" aria-hidden="true">
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          width="256"
                                          height="256"
                                          viewBox="0 0 24 24"
                                          fill="none"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          class="lucide lucide-image-icon lucide-image"
                                        >
                                          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                                          <circle cx="9" cy="9" r="2" />
                                          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                                        </svg>
                                      </span>
                                      <div>
                                        <h3>Photo</h3>
                                        <p>Upload high-quality images of your product.</p>
                                      </div>
                                    </div>
                                    <div class="product-photo-uploader">
                                      <div class="product-photo-uploader__loading" id="product-photo-uploader-loading" hidden>
                                        <div class="loading-spinner"></div>
                                        <p>Uploading images...</p>
                                      </div>
                                      <label
                                        class="product-photo-dropzone"
                                        id="add-image-input-button"
                                      >
                                        <span class="product-photo-dropzone__icon" aria-hidden="true">
                                          <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="256"
                                            height="256"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="lucide lucide-cloud-upload-icon lucide-cloud-upload"
                                            focusable="false"
                                          >
                                            <path d="M12 13v8" />
                                            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
                                            <path d="m8 17 4-4 4 4" />
                                          </svg>
                                        </span>
                                        <strong>Drag &amp; drop images here</strong>
                                        <span class="product-photo-dropzone__or">or</span>
                                        <span class="product-photo-dropzone__browse">Browse Files</span>
                                        <input
                                          type="file"
                                          class="product-photo-dropzone__native-input"
                                          id="product-photo-file-input"
                                          accept="image/jpeg,image/png,image/webp"
                                          multiple
                                          aria-label="Browse product images"
                                          aria-describedby="product-photo-upload-note"
                                        />
                                      </label>
                                      <div class="product-photo-carousel" id="product-photo-carousel" hidden>
                                        <button
                                          type="button"
                                          class="product-photo-carousel__nav product-photo-carousel__nav--previous"
                                          data-product-photo-scroll="previous"
                                          aria-label="Scroll product images left"
                                        >
                                          <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                            focusable="false"
                                          >
                                            <path d="m15 18-6-6 6-6" />
                                          </svg>
                                        </button>
                                        <div
                                          id="product-image-input-list"
                                          class="product-image-input-list product-photo-thumbnail-list"
                                          aria-label="Selected product images"
                                          aria-live="polite"
                                        ></div>
                                        <button
                                          type="button"
                                          class="product-photo-carousel__nav product-photo-carousel__nav--next"
                                          data-product-photo-scroll="next"
                                          aria-label="Scroll product images right"
                                        >
                                          <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                            focusable="false"
                                          >
                                            <path d="m9 18 6-6-6-6" />
                                          </svg>
                                        </button>
                                      </div>
                                      <p class="product-photo-upload-note" id="product-photo-upload-note">
                                        You can upload up to 10 images. JPG, PNG, WEBP (Max 10MB each)
                                      </p>
                                    </div>
                                  </section>

                                  <section
                                    id="product-editor-section-video"
                                    class="product-composer-section product-composer-section--video product-video-upload-group product-form-section-anchor"
                                  >
                                    <div class="product-composer-section__heading product-video-section__heading">
                                      <span class="product-video-section__icon" aria-hidden="true">
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          width="256"
                                          height="256"
                                          viewBox="0 0 24 24"
                                          fill="none"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          class="lucide lucide-video-icon lucide-video"
                                        >
                                          <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5" />
                                          <rect x="2" y="6" width="14" height="12" rx="2" />
                                        </svg>
                                      </span>
                                      <div>
                                        <h3>Video</h3>
                                        <p>Upload product videos to showcase it better.</p>
                                      </div>
                                    </div>
                                    <div class="product-video-uploader">
                                      <label class="product-video-dropzone" id="add-video-input-button">
                                        <span class="product-video-dropzone__icon" aria-hidden="true">
                                          <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            focusable="false"
                                          >
                                            <path d="M12 13v8" />
                                            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
                                            <path d="m8 17 4-4 4 4" />
                                          </svg>
                                        </span>
                                        <strong>Drag &amp; drop video here</strong>
                                        <span class="product-video-dropzone__or">or</span>
                                        <span class="product-video-dropzone__browse">Browse Files</span>
                                        <input
                                          type="file"
                                          class="product-video-dropzone__native-input"
                                          id="product-video-file-input"
                                          accept=".mp4,.mov,.webm,video/mp4,video/quicktime,video/webm"
                                          multiple
                                          aria-label="Browse product videos"
                                          aria-describedby="product-video-upload-note"
                                        />
                                      </label>
                                      <div class="product-video-carousel" id="product-video-carousel" hidden>
                                        <button
                                          type="button"
                                          class="product-video-carousel__nav product-video-carousel__nav--previous"
                                          data-product-video-scroll="previous"
                                          aria-label="Scroll product videos left"
                                        >
                                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m15 18-6-6 6-6" />
                                          </svg>
                                        </button>
                                        <div
                                          id="product-video-input-list"
                                          class="product-image-input-list product-video-input-list product-video-file-list"
                                          aria-label="Selected product videos"
                                          aria-live="polite"
                                        ></div>
                                        <button
                                          type="button"
                                          class="product-video-carousel__nav product-video-carousel__nav--next"
                                          data-product-video-scroll="next"
                                          aria-label="Scroll product videos right"
                                        >
                                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6" />
                                          </svg>
                                        </button>
                                      </div>
                                      <p class="product-video-upload-note" id="product-video-upload-note">
                                        MP4, MOV, WebM (Max 100MB)
                                      </p>
                                    </div>
                                  </section>

                                  <section
                                    id="product-editor-section-details"
                                    class="product-composer-section product-composer-section--details product-form-section-panel product-form-section-anchor"
                                  >
                                    <div class="product-composer-section__heading product-details-section__heading">
                                      <span class="product-details-section__icon" aria-hidden="true">
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          width="256"
                                          height="256"
                                          viewBox="0 0 24 24"
                                          fill="none"
                                          stroke="currentColor"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          class="lucide lucide-clipboard-list-icon lucide-clipboard-list"
                                        >
                                          <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                                          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                                          <path d="M12 11h4" />
                                          <path d="M12 16h4" />
                                          <path d="M8 11h.01" />
                                          <path d="M8 16h.01" />
                                        </svg>
                                      </span>
                                      <div>
                                        <h3>Product Details</h3>
                                        <p>Fill in the basic information about the product.</p>
                                      </div>
                                    </div>
                                    <div class="product-form-details-stack">
                                      <input type="hidden" name="category" id="category-select" required />
                                      <div
                                        class="product-existing-category-status"
                                        id="selected-category-carousel"
                                        aria-label="Categories available for this seller Business Type"
                                        hidden
                                      >
                                        <button
                                          type="button"
                                          class="product-category-carousel__control product-category-carousel__control--previous"
                                          data-product-category-scroll="previous"
                                          aria-label="Show previous selected categories"
                                          title="Previous categories"
                                          hidden
                                        >
                                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                            <path d="m15 18-6-6 6-6"></path>
                                          </svg>
                                        </button>
                                        <div
                                          class="product-category-selected-chips"
                                          id="selected-category-chips"
                                          aria-live="polite"
                                          tabindex="0"
                                        ></div>
                                        <button
                                          type="button"
                                          class="product-category-carousel__control product-category-carousel__control--next"
                                          data-product-category-scroll="next"
                                          aria-label="Show next selected categories"
                                          title="Next categories"
                                          hidden
                                        >
                                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                            <path d="m9 18 6-6-6-6"></path>
                                          </svg>
                                        </button>
                                      </div>
                                      <div class="form-grid product-details-name-category-grid product-details-name-only-grid">
                                        <label>
                                          Listing Name 
                                          <input type="text" name="name" placeholder="Enter listing name" required />
                                        </label>
                                      </div>
                                      <div class="form-grid form-grid--quad product-details-metrics-grid">
                                        <label>
                                          Original Price
                                          <input type="number" name="originalPrice" min="0" step="0.01" placeholder="0.00" required />
                                        </label>
                                        <label>
                                          Sales Price
                                          <input type="number" name="salesPrice" min="0" step="0.01" placeholder="0.00" />
                                        </label>
                                        <label>
                                          Stock Quantity
                                          <input type="number" name="stock" min="0" step="1" placeholder="0" required />
                                        </label>
                                        <label class="product-expiry-date-field">
                                          <span>Expiry Date</span>
                                          <span class="product-expiry-date-picker" id="product-expiry-date-picker">
                                            <input
                                              type="date"
                                              name="expiryDate"
                                              id="product-expiry-date-input"
                                              class="product-expiry-date-picker__native"
                                              tabindex="-1"
                                              aria-hidden="true"
                                            />
                                            <button
                                              type="button"
                                              class="product-expiry-date-picker__trigger"
                                              id="product-expiry-date-trigger"
                                              aria-haspopup="dialog"
                                              aria-expanded="false"
                                              aria-controls="product-expiry-date-calendar"
                                            >
                                              <svg class="product-expiry-date-picker__calendar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M8 2v4"></path>
                                                <path d="M16 2v4"></path>
                                                <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                                <path d="M3 10h18"></path>
                                                <path d="M8 14h.01"></path>
                                                <path d="M12 14h.01"></path>
                                                <path d="M16 14h.01"></path>
                                                <path d="M8 18h.01"></path>
                                                <path d="M12 18h.01"></path>
                                              </svg>

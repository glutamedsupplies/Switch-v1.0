/* Login page-specific styles */

.admin-banned-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 520;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: rgba(15, 23, 42, 0.34);
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease;
}

.admin-banned-modal-overlay[hidden] {
  display: none !important;
}

.admin-banned-modal-overlay.is-open {
  opacity: 1;
  pointer-events: auto;
}

.admin-banned-modal {
  width: min(100%, 390px);
  padding: 36px 28px 24px;
  position: relative;
  border-radius: 10px;
  border: 1px solid rgba(226, 232, 240, 0.88);
  background: #ffffff;
  box-shadow: 0 28px 70px rgba(15, 23, 42, 0.2);
  text-align: left;
  color: #111827;
  opacity: 0;
  transform: translateY(18px) scale(0.96);
  transition: opacity 180ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.admin-banned-modal:focus {
  outline: none;
}

.admin-banned-modal-overlay.is-open .admin-banned-modal {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.admin-banned-modal__icon {
  width: 92px;
  height: 92px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 18px;
  border-radius: 999px;
  background: #ffe4e8;
  color: #ef233c;
}

.admin-banned-modal__icon svg {
  width: 48px;
  height: 48px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.admin-banned-modal h2 {
  margin: 0;
  color: #111827;
  font-size: 24px;
  font-weight: 500;
  line-height: 1.2;
}

.admin-banned-modal__copy-wrap,
.admin-banned-modal__note {
  margin: 10px 0 0;
  max-width: none;
}

.admin-banned-modal__copy,
.admin-banned-modal__note {
  margin: 0;
  color: #6b7280;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.45;
}

.admin-banned-modal__copy-wrap {
  position: relative;
}

.admin-banned-modal__copy {
  padding-right: 48px;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.admin-banned-modal.is-description-expanded .admin-banned-modal__copy {
  padding-right: 0;
  display: block;
  -webkit-line-clamp: unset;
}

.admin-banned-modal__more {
  position: absolute;
  right: 0;
  bottom: 1px;
  width: fit-content;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #111827;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.2;
  text-decoration: underline;
  cursor: pointer;
}

.admin-banned-modal.is-description-expanded .admin-banned-modal__more {
  position: static;
  margin-top: 6px;
}

.admin-banned-modal__reason {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  width: 100%;
  margin: 22px 0 0;
  padding: 12px 14px 16px;
  margin-bottom: 20px;
  border-radius: 4px;
  background: #fff1f2;
  color: #111827;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;
  text-align: left;
}

.admin-banned-modal__reason strong {
  color: #ef233c;
  font-weight: 800;
}

.admin-banned-modal__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 28px;
  padding-top: 18px;
  border-top: 1px solid rgba(226, 232, 240, 0.9);
}

.admin-banned-modal__button {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  border: 1px solid transparent;
  font: inherit;
  font-size: 13px;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.admin-banned-modal__button--secondary {
  background: #ffffff;
  border-color: rgba(226, 232, 240, 0.95);
  color: #111827;
}

.admin-banned-modal__button--primary {
  background: #ef233c;
  border-color: #ef233c;
  color: #ffffff;
}

.admin-banned-modal__button:hover,
.admin-banned-modal__button:focus-visible {
  transform: translateY(-1px);
}

.admin-banned-modal__button--secondary:hover,
.admin-banned-modal__button--secondary:focus-visible {
  background: #f8fafc;
  border-color: rgba(203, 213, 225, 1);
}

.admin-banned-modal__button--primary:hover,
.admin-banned-modal__button--primary:focus-visible {
  background: #dc1f35;
  border-color: #dc1f35;
}

/* Root-login-style portal card */
body.login-page {
  --login-accent: var(--accent, rgb(37, 99, 235));
  --login-accent-rgb: var(--accent-rgb, 37, 99, 235);
  --login-accent-text: var(--accent-text, var(--login-accent));
  --login-accent-contrast: var(--accent-contrast, #ffffff);
  --login-accent-button-bg: var(--accent-button-bg, var(--login-accent));
  --login-accent-button-hover-bg: var(--accent-button-hover-bg, var(--login-accent));
  min-height: 100vh;
  min-height: 100dvh;
  margin: 0;
  color: #0f1f3d;
  background: #f2f2f2;
  font-family: "Poppins", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.login-page-shell--neutral.login-page-shell--aether {
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  padding: 24px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.login-page-shell--neutral.login-page-shell--aether::before {
  background: #f2f2f2;
}

.login-page-shell--aether::after {
  content: none;
  display: none;
}

.login-page-shell--aether .login-layout {
  position: relative;
  width: min(100%, 560px);
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  justify-items: center;
}

.login-page-shell--aether .login-layout::before {
  content: none;
  display: none;
}

.login-page-shell--aether .login-layout::after {
  content: none;
  display: none;
}

.login-page-shell--aether .login-hero {
  display: none;
}

.login-page-shell--aether .login-panel {
  width: min(100%, 560px);
  margin: 0;
  padding: clamp(46px, 7vh, 76px) clamp(42px, 5vw, 62px);
  display: grid;
  gap: 24px;
  align-content: start;
  justify-self: center;
  border: 0 !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
}

.login-card-brand {
  display: inline-flex;
  align-items: center;
  justify-self: center;
  gap: 12px;
  color: #0f172a;
  font-size: 18px;
  font-weight: 500;
}

.login-card-brand__mark {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--login-accent);
}

.login-card-brand__mark svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-card-brand span:last-child {
  display: inline-flex;
  align-items: baseline;
  color: #0f172a;
  font-style: normal;
}

.login-card-brand strong {
  font-weight: 500;
}

.login-card-brand em {
  color: var(--login-accent);
  font-style: normal;
  font-weight: 500;
}

.login-page-shell--aether .login-panel-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  row-gap: 10px;
  align-items: center;
  margin: 0;
  text-align: left;
}

.login-page-shell--aether .login-panel-header {
  gap: 8px;
  justify-items: start;
}

.login-page-shell--aether .login-panel h2 {
  margin: 0;
  color: #0d1c37;
  font-size: 26px;
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: 0;
}

.login-page-shell--aether .login-panel-heading p {
  grid-column: 1 / -1;
  max-width: none;
  margin: 0;
  color: #687b9f;
  font-size: 14px;
  line-height: 1.55;
}

.login-page-shell--aether .login-role-tabs {
  display: none;
}

.login-page-shell--aether .login-role-tab {
  min-height: 40px;
  padding: 0 12px;
  border: 0 !important;
  border-radius: 12px;
  background: transparent;
  box-shadow: none;
  color: #687793;
  font-size: 14px;
  font-weight: 700;
}

.login-page-shell--aether .login-role-tab.is-active {
  background: #ffffff;
  color: var(--login-accent-text);
  box-shadow: 0 8px 22px rgba(var(--login-accent-rgb), 0.16);
}

.login-page-shell--aether .login-form {
  margin-top: 0;
  gap: 17px;
}

.login-page-shell--aether .login-form > * + * {
  margin-top: 0;
}

.login-page-shell--aether .login-password-gate {
  max-height: 92px;
  overflow: hidden;
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  transition:
    max-height 300ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 200ms ease,
    transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
    visibility 0ms linear 0ms;
}

.login-page-shell--aether .login-password-gate.is-hidden {
  max-height: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-8px);
  transition:
    max-height 220ms ease,
    opacity 160ms ease,
    transform 220ms ease,
    visibility 0ms linear 220ms;
}

.login-page-shell--aether .login-password-gate.is-hidden .password-field {
  visibility: hidden;
}

.login-field {
  display: grid;
  gap: 7px;
  color: #152744;
  font-size: 13px;
  font-weight: 500;
}

.login-field__label {
  line-height: 1.2;
}

.login-field__control {
  position: relative;
  display: block;
}

.login-field-message {
  display: none;
  margin: -1px 0 0 1px;
  color: #ef4444;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;
}

.login-field.has-validation-error .login-field-message {
  display: block;
}

.login-field__icon {
  position: absolute;
  left: 15px;
  top: 50%;
  z-index: 1;
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  color: #7183a3;
  transform: translateY(-50%);
  pointer-events: none;
}

.login-field__icon svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-page-shell--aether .login-form.is-admin-login #login-identifier-input,
.login-page-shell--aether .login-form.is-employee-login #login-identifier-input,
.login-page-shell--aether .login-form #login-password-input {
  height: 52px;
  min-height: 52px;
  max-height: 52px;
  padding: 0 50px 0 50px !important;
  border: 1px solid #cbd6e7 !important;
  border-radius: 8px;
  background: #ffffff !important;
  color: #11213d !important;
  font-size: 14px;
  font-weight: 500;
  box-shadow: none !important;
}

.login-page-shell--aether .login-form #login-password-input {
  padding-right: 62px !important;
}

.login-page-shell--aether .login-field__control--identifier #login-identifier-input {
  padding-right: 62px !important;
}

.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input,
.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input:not(.login-employee-id-valid):not(.login-employee-id-invalid),
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input:not(.login-employee-id-valid):not(.login-employee-id-invalid) {
  border-color: #cbd6e7 !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
}

.login-page-shell--aether .login-form input::placeholder {
  color: #8797b3;
  opacity: 1;
}

.login-page-shell--aether .login-form.is-admin-login #login-identifier-input:focus,
.login-page-shell--aether .login-form.is-admin-login #login-identifier-input:focus-visible,
.login-page-shell--aether .login-form.is-employee-login #login-identifier-input:focus,
.login-page-shell--aether .login-form.is-employee-login #login-identifier-input:focus-visible,
.login-page-shell--aether .login-form #login-password-input:focus,
.login-page-shell--aether .login-form #login-password-input:focus-visible {
  border-color: var(--login-accent) !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
  box-shadow: inset 0 0 0 1px rgba(var(--login-accent-rgb), 0.2), 0 4px 14px rgba(var(--login-accent-rgb), 0.08) !important;
}

.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input:not(.login-employee-id-valid):not(.login-employee-id-invalid):focus,
.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input:not(.login-employee-id-valid):not(.login-employee-id-invalid):focus-visible,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input:not(.login-employee-id-valid):not(.login-employee-id-invalid):focus,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input:not(.login-employee-id-valid):not(.login-employee-id-invalid):focus-visible {
  border-color: var(--login-accent) !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
  box-shadow: inset 0 0 0 1px rgba(var(--login-accent-rgb), 0.2), 0 4px 14px rgba(var(--login-accent-rgb), 0.08) !important;
}

.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-valid,
.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-valid:focus,
.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-valid:focus-visible,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-valid,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-valid:focus,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-valid:focus-visible {
  border-color: #22c55e !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
  box-shadow: inset 0 0 0 1px rgba(34, 197, 94, 0.2), 0 4px 14px rgba(34, 197, 94, 0.08) !important;
}

.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-invalid,
.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-invalid:focus,
.login-page-shell--aether
  .login-form.is-admin-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-invalid:focus-visible,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-invalid,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-invalid:focus,
.login-page-shell--aether
  .login-form.is-employee-login
  .login-field__control--identifier
  #login-identifier-input.login-employee-id-invalid:focus-visible {
  border-color: #ef4444 !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
  box-shadow: inset 0 0 0 1px rgba(239, 68, 68, 0.2), 0 4px 14px rgba(239, 68, 68, 0.08) !important;
}

.login-page-shell--aether .login-form #login-password-input.login-password-invalid,
.login-page-shell--aether .login-form #login-password-input.login-password-invalid:focus,
.login-page-shell--aether .login-form #login-password-input.login-password-invalid:focus-visible {
  border-color: #ef4444 !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
  box-shadow: inset 0 0 0 1px rgba(239, 68, 68, 0.2), 0 4px 14px rgba(239, 68, 68, 0.08) !important;
}

.login-page-shell--aether .password-field__toggle {
  right: 0;
  width: 42px;
  height: 50px;
  color: #7183a3;
}

.login-page-shell--aether .password-field__toggle:hover,
.login-page-shell--aether .password-field__toggle:focus-visible,
.login-page-shell--aether .password-field__toggle:active {
  color: var(--login-accent-text);
}

.login-page-shell--aether .login-employee-id-status {
  right: 0;
  top: 50%;
  bottom: auto;
  width: 42px;
  height: 50px;
  transform: translateY(-50%);
}

.login-page-shell--aether .login-employee-id-status.is-valid,
.login-page-shell--aether .login-employee-id-status.is-invalid,
.login-page-shell--aether .login-employee-id-status.is-checking {
  color: #22c55e;
}

.login-validation-lottie,
.login-validation-fallback {
  position: absolute;
  inset: 50% auto auto 50%;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.82);
  pointer-events: none;
}

.login-validation-lottie {
  width: 34px;
  height: 34px;
}

.login-validation-fallback {
  width: 24px;
  height: 24px;
}

.login-validation-lottie svg {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

.login-validation-fallback svg {
  display: block;
  width: 100%;
  height: 100%;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-employee-id-status.is-valid .login-validation-lottie,
.login-employee-id-status.is-valid .login-validation-fallback {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.login-employee-id-status.is-valid.has-lottie .login-validation-fallback {
  opacity: 0;
}

.login-employee-id-status.is-valid .login-validation-fallback::before {
  content: "";
  position: absolute;
  inset: 4px;
  border: 2px solid #22c55e;
  border-radius: 999px;
  animation: login-check-ring 460ms ease both;
}

.login-employee-id-status.is-valid .login-validation-fallback::after {
  content: "";
  position: absolute;
  left: 8px;
  top: 11px;
  width: 8px;
  height: 5px;
  border-left: 2px solid #22c55e;
  border-bottom: 2px solid #22c55e;
  transform: rotate(-45deg);
  animation: login-check-mark 420ms 90ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.login-employee-id-status.is-invalid .login-validation-fallback {
  width: 19px;
  height: 19px;
  opacity: 1;
  display: grid;
  place-items: center;
  color: #ef4444;
  transform: translate(-50%, -50%) scale(1);
}

.login-employee-id-status.is-checking .login-validation-fallback {
  opacity: 1;
  border: 2px solid rgba(var(--login-accent-rgb), 0.16);
  border-top-color: var(--login-accent);
  border-radius: 999px;
  transform: translate(-50%, -50%) scale(0.72);
  animation: login-checking-spin 760ms linear infinite;
}

@keyframes login-check-ring {
  from {
    opacity: 0;
    transform: scale(0.72);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes login-check-mark {
  from {
    opacity: 0;
    transform: rotate(-45deg) scale(0.72);
  }
  to {
    opacity: 1;
    transform: rotate(-45deg) scale(1);
  }
}

@keyframes login-checking-spin {
  to {
    transform: translate(-50%, -50%) scale(0.72) rotate(360deg);
  }
}

.login-page-shell--aether .login-meta {
  display: none;
}

.login-page-shell--aether .checkbox-field {
  color: #697690;
  font-size: 16px;
  font-weight: 500;
}

.login-page-shell--aether .checkbox-field input {
  width: 20px;
  height: 20px;
  accent-color: var(--login-accent);
}

.login-page-shell--aether .text-link {
  color: var(--login-accent-text) !important;
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
}

.login-page-shell--aether .login-submit {
  min-height: 52px;
  margin-top: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: 1px solid var(--login-accent);
  border-radius: 8px !important;
  background: var(--login-accent-button-bg) !important;
  color: var(--login-accent-contrast) !important;
  font-size: 15px;
  font-weight: 700;
  box-shadow: 0 10px 20px rgba(var(--login-accent-rgb), 0.18) !important;
}

.login-submit__icon {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-seller-button {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid #cbd6e7;
  border-radius: 8px;
  color: #687b9f;
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  text-decoration: none;
  box-shadow: none;
  transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
}

.login-seller-button:hover,
.login-seller-button:focus-visible {
  border-color: rgba(var(--login-accent-rgb), 0.44);
  color: var(--login-accent-text);
  outline: none;
  transform: translateY(-1px);
}

.login-seller-button__icon {
  width: 18px;
  height: 18px;
  display: inline-flex;
  flex: 0 0 18px;
  align-items: center;
  justify-content: center;
}

.login-seller-button__icon svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-page-shell--aether .login-submit:hover:not(:disabled),
.login-page-shell--aether .login-submit:focus-visible:not(:disabled) {
  background: var(--login-accent-button-hover-bg) !important;
  transform: translateY(-1px);
  box-shadow: 0 16px 28px rgba(var(--login-accent-rgb), 0.28) !important;
}

.login-page-shell--aether .login-submit:disabled,
.login-page-shell--aether .login-submit:disabled:hover,
.login-page-shell--aether .login-submit:disabled:focus-visible,
.login-page-shell--aether .login-submit:disabled:active {
  border-color: #cbd5e1 !important;
  background: #e5e7eb !important;
  color: #94a3b8 !important;
  cursor: not-allowed;
  opacity: 1;
  box-shadow: none !important;
}

.login-page-shell--aether .login-submit.is-login-ready {
  background: var(--login-accent-button-bg) !important;
  color: var(--login-accent-contrast) !important;
}

.login-page-shell--aether .feedback-note {
  min-height: 20px;
  margin: -4px 0 0;
  text-align: center;
}

.login-security-note {
  margin: -2px 0 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #7183a3;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.45;
}

.login-security-note span {
  width: 16px;
  height: 16px;
  display: inline-flex;
  flex: 0 0 16px;
  align-items: center;
  justify-content: center;
}

.login-security-note svg {
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-social-divider {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 14px;
  color: #737f98;
  font-size: 12px;
  font-style: normal;
}

.login-social-divider span {
  height: 1px;
  background: rgba(var(--login-accent-rgb), 0.16);
}

.login-social-divider em {
  font-style: normal;
  font-weight: 500;
  white-space: nowrap;
}

.login-social-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.login-social-button {
  min-width: 0;
  min-height: 48px;
  padding: 0 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid #d8e1ef !important;
  border-radius: 8px !important;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: none;
  color: #15213a;
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease, color 160ms ease, transform 160ms ease;
}

.login-social-button:hover,
.login-social-button:focus-visible {
  background: #ffffff;
  border-color: rgba(var(--login-accent-rgb), 0.42);
  box-shadow: 0 8px 18px rgba(var(--login-accent-rgb), 0.12);
  transform: translateY(-1px);
}

.login-social-button__icon {
  width: 19px;
  height: 19px;
  display: inline-grid;
  place-items: center;
  flex: 0 0 19px;
  margin-right: 0;
  font-weight: 800;
  line-height: 1;
}

.login-social-button__icon svg {
  width: 100%;
  height: 100%;
  display: block;
  stroke: none;
}

.login-social-button__icon--phone {
  color: var(--login-accent-text);
}

.login-social-button__icon--phone svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-social-button__label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.login-signup-copy {
  display: none;
  margin: 8px 0 0;
  color: #6f7a93;
  font-size: 17px;
  text-align: center;
}

.login-signup-copy a {
  margin-left: 10px;
  color: var(--login-accent-text);
  font-weight: 800;
  text-decoration: none;
}

@media (max-width: 720px) {
  .login-page-shell--neutral.login-page-shell--aether {
    padding: 20px 12px;
  }

  .login-page-shell--aether .login-panel {
    padding: 34px 20px 28px;
    border-radius: 0 !important;
  }

  .login-page-shell--aether .login-panel h2 {
    font-size: 24px;
  }

  .login-page-shell--aether .login-panel-heading p {
    font-size: 13px;
  }

  .login-social-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .login-page-shell--aether .login-meta {
    align-items: flex-start;
    flex-direction: column;
  }
}

  function liveChatEmptyThreadsCopy() {
    if (normalizeText(liveChatRedesignState.search)) {
      return "No conversations match your search.";
    }
    if (liveChatRedesignState.filter !== "all") {
      return "Try another conversation filter.";
    }
    return "";

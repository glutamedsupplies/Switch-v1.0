              <div class="lcx-order-product"><span class="lcx-order-product__thumb">${product.image ? `<img src="${liveChatEscape(product.image)}" alt="" onerror="this.remove()" />` : liveChatIcon("package", 22)}</span><span><strong>${liveChatEscape(product.name)}</strong><small>Qty: ${liveChatEscape(order.quantity || 1)}</small></span><strong>${liveChatFormatMoney(orderProductAmount)}</strong></div>

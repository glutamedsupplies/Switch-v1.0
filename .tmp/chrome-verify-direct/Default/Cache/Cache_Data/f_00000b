  window.requestAnimationFrame(() => {
    const inlineEditorInput = savedCategoryList?.querySelector(".category-chip.is-editing .category-chip__input");
    if (!(inlineEditorInput instanceof HTMLInputElement)) {
      return;
    }

    syncCategoryInputCasing(inlineEditorInput);
    inlineEditorInput.focus();
    inlineEditorInput.select();

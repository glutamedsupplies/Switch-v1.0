function setProductPanelSuccessFlash(payload) {
  try {
    window.sessionStorage?.setItem(
      PRODUCT_PANEL_SUCCESS_FLASH_KEY,
      JSON.stringify({
        title: String(payload?.title ?? "Success").trim() || "Success",
        copy: String(payload?.copy ?? "").trim(),
      }),
    );
  } catch (_) {

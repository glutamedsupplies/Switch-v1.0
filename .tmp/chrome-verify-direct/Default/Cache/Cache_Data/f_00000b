function syncCategoryInputCasing(inputElement) {
  if (!(inputElement instanceof HTMLInputElement)) {
    return;
  }

  const previousValue = inputElement.value;
  const normalizedValue = formatCategoryInputValue(previousValue, {
    preserveTrailingSpace: document.activeElement === inputElement,
  });
  const nextWidthCategoryNames =
    inputElement === categoryNameInput || inputElement.classList.contains("category-chip__input")
      ? [...availableCategories, normalizedValue]
      : availableCategories;

  if (previousValue === normalizedValue) {
    syncCategoryManagerPanelWidth(nextWidthCategoryNames);
    return;
  }

  const selectionStart = inputElement.selectionStart ?? previousValue.length;
  const selectionEnd = inputElement.selectionEnd ?? previousValue.length;
  inputElement.value = normalizedValue;

  if (document.activeElement === inputElement) {
    const nextSelectionStart = Math.min(selectionStart, normalizedValue.length);
    const nextSelectionEnd = Math.min(selectionEnd, normalizedValue.length);
    inputElement.setSelectionRange(nextSelectionStart, nextSelectionEnd);
  }

  syncCategoryManagerPanelWidth(nextWidthCategoryNames);
}

function syncCategoryNameInputCasing() {
  syncCategoryInputCasing(categoryNameInput);
}

function startCategoryEdit(categoryName) {

  let cropGuideAspectRatio = PRODUCT_CARD_IMAGE_ASPECT_RATIO;
  let isStagePanning = false;
  let stagePanStartX = 0;
  let stagePanStartY = 0;
  let currentPanX = 0;
  let currentPanY = 0;
  let stagePanOriginX = 0;

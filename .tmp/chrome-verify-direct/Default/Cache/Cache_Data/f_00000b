  const fileSignature = pendingImageFile
    ? [
        pendingImageFile.name || "",
        pendingImageFile.size || 0,
        pendingImageFile.lastModified || 0,
      ].join(":")
    : "";

  return (
    [normalizedExistingImageUrl, previewObjectUrl, fileSignature]
      .map((value) => String(value || "").trim())
      .filter(Boolean)
      .join("|")
    || `slot-${slotIndex}`
  );

function captureProductImagePreviewRects() {
  const rects = new Map();
  if (!productImageInputList) {
    return rects;
  }

  productImageInputList
    .querySelectorAll(".product-image-input-row__preview--filename-only")
    .forEach((preview) => {
      const animationKey = String(preview.dataset.animationKey ?? "").trim();
      if (!animationKey) {
        return;
      }

      rects.set(animationKey, preview.getBoundingClientRect());
    });

  return rects;
}

function animateProductImagePreviewReorder(previousRects) {
  if (!productImageInputList || !(previousRects instanceof Map) || !previousRects.size) {
    return;
  }

  const previews = Array.from(
    productImageInputList.querySelectorAll(".product-image-input-row__preview--filename-only"),
  );
  if (!previews.length) {
    return;
  }

  window.requestAnimationFrame(() => {
    previews.forEach((preview) => {
      const animationKey = String(preview.dataset.animationKey ?? "").trim();
      if (!animationKey || !previousRects.has(animationKey)) {
        return;
      }

      const previousRect = previousRects.get(animationKey);
      const nextRect = preview.getBoundingClientRect();
      const deltaX = previousRect.left - nextRect.left;
      const deltaY = previousRect.top - nextRect.top;

      if (Math.abs(deltaX) < 1 && Math.abs(deltaY) < 1) {
        return;
      }

      preview.style.transition = "none";
      preview.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
      preview.style.zIndex = "3";

      window.requestAnimationFrame(() => {
        preview.style.transition =
          "transform 320ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease";
        preview.style.transform = "translate(0px, 0px)";

        const cleanup = () => {
          preview.style.removeProperty("transition");
          preview.style.removeProperty("transform");
          preview.style.removeProperty("z-index");
          preview.removeEventListener("transitionend", cleanup);
        };

        preview.addEventListener("transitionend", cleanup);
      });
    });
  });
}

function clearProductImageDragState() {
  draggedProductImageSlotIndex = -1;
  if (!productImageInputList) {
    return;

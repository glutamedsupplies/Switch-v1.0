  let secondaryGalleryActionLabel = "";
  let secondaryGalleryActionMediaType = "";
  let closeBeforePrimaryAction = false;
  let closeBeforeSecondaryAction = false;
  let currentZoomPercent = 0;
  const ZOOM_MIN = 0;
  const ZOOM_MAX = 500;
  const ZOOM_BUTTON_STEP = 25;

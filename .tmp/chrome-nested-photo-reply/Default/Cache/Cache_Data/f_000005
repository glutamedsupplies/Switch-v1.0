  margin-top: 1px;
}

.product-status-shell .product-card__highlight-badge {
  min-height: 18px;
  padding: 3px 6px;
  border-radius: 999px !important;
  font-size: 10px;
  font-weight: 600;
  line-height: 1;
}

.product-status-shell .product-card__batch-note,
.product-status-shell .product-card__pending-note,
.product-status-shell .product-card__body--add-product .product-meta {
  overflow: hidden;
  color: #64748b;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.35;
}

.product-status-shell .product-card__footer {
  display: grid;
  width: 100%;
  margin-top: auto !important;
  padding: 9px 3px 0 !important;
  border-top: 1px solid #eef0f3 !important;
  background: transparent !important;
}

.product-status-shell .product-card--expired-batch .product-card__footer {
  background: transparent !important;
}

.product-status-shell .product-actions {

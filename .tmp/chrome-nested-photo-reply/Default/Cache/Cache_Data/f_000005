/* Product Listing styles moved from product-panel.css. */

/* Product panel only overrides.
   Loaded after styles.css so these rules win without affecting other pages. */

.product-status-shell .product-panel-grid__inventory {
  gap: 12px !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
}

.product-status-shell .product-panel-grid__inventory-tools {
  grid-template-columns: minmax(220px, 1fr) minmax(180px, 240px) !important;
  gap: 12px !important;
  margin-bottom: 6px !important;
}

.product-status-shell .dashboard-content > .hero--product-list {
  position: sticky !important;
  top: var(--admin-heading-sticky-top, 4px) !important;
  z-index: 220;
  background: var(--dashboard-page-background, #f3f4f6);
}

.product-status-shell .product-list {
  display: grid !important;
  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  grid-auto-flow: row;
  gap: 12px !important;
  align-items: stretch;
  overflow: visible;
}

.product-status-shell .product-list.is-loading {
  pointer-events: none;
}

.product-status-shell .product-listing-skeleton-card {
  position: relative;
  display: grid;
  gap: 8px;
  min-width: 0;
  padding: 8px;
  overflow: hidden;
  border: 1px solid #eef2f7;
  border-radius: 6px;
  background: #ffffff;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
}

.product-status-shell .product-listing-skeleton-card::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-125%);
  background: linear-gradient(
    105deg,
    transparent 0%,
    transparent 34%,
    rgba(255, 255, 255, 0.72) 50%,
    transparent 66%,
    transparent 100%
  );
  animation: seller-product-listing-skeleton-shimmer 1.2s ease-in-out infinite;
}

.product-status-shell .product-listing-skeleton-card__media,
.product-status-shell .product-listing-skeleton-card__line {
  display: block;
  min-width: 0;
  border-radius: 4px;
  background: linear-gradient(90deg, #d7d7d7 0%, #eeeeee 56%, #d8d8d8 100%);
}

.product-status-shell .product-listing-skeleton-card__media {
  width: 100%;
  aspect-ratio: 1 / 1;
}

.product-status-shell .product-listing-skeleton-card__line {
  height: 8px;
}

.product-status-shell .product-listing-skeleton-card__line--strong {
  width: 78%;
}

.product-status-shell .product-listing-skeleton-card__line--short {
  width: 58%;
  margin-bottom: 2px;
}

@keyframes seller-product-listing-skeleton-shimmer {
  100% {
    transform: translateX(125%);
  }
}

.seller-product-listing-footer {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) auto minmax(180px, 1fr);
  align-items: center;
  gap: 16px;
  padding: 2px 2px 0;
}

.seller-product-listing-footer[hidden] {
  display: none !important;
}

.seller-product-listing-footer__meta {
  color: #64748b;
  font-size: 10px;
  line-height: 1.3;
}

.seller-product-listing-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.seller-product-listing-pagination button {
  display: inline-grid;
  width: 32px;
  min-width: 32px;
  height: 32px;
  min-height: 32px;
  place-items: center;
  padding: 0;
  border-radius: 5px;
  background: #ffffff;
  color: #4b5563;
  box-shadow: none;
  font-size: 10px;
  font-weight: 700;
  transform: none;
}

.seller-product-listing-pagination button svg {
  width: 15px;
  height: 15px;
}

.seller-product-listing-pagination button:hover:not(:disabled),
.seller-product-listing-pagination button:focus-visible:not(:disabled),
.seller-product-listing-pagination button.is-active {
  border-color: var(--accent);
  background: var(--accent-button-gradient-bg, var(--accent));
  color: var(--accent-contrast, #ffffff);
  box-shadow: none;
  outline: none;
  transform: none;
}

.seller-product-listing-pagination button:disabled {
  cursor: default;
  opacity: 0.4;
}

.seller-product-listing-page-size {
  display: inline-flex;
  width: 104px;
  min-height: 34px;
  align-items: center;
  justify-content: center;
  justify-self: end;
  padding: 0 10px;
  border: 1px solid #e5e7eb;
  border-radius: 5px;
  background: #ffffff;
  color: #4b5563;
  font-size: 10px;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

@media (max-width: 760px) {
  .seller-product-listing-footer {
    grid-template-columns: 1fr auto;
  }

  .seller-product-listing-pagination {
    grid-column: 1 / -1;
    grid-row: 1;
  }
}

@media (max-width: 500px) {
  .seller-product-listing-footer {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  .seller-product-listing-footer__meta,
  .seller-product-listing-page-size {
    justify-self: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .product-status-shell .product-listing-skeleton-card::after {
    animation: none;
  }
}


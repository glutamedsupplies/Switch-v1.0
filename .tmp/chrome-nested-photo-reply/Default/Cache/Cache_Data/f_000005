    opacity: 1;
    pointer-events: auto;
  }
}

/* Shared feedback for the listing editor, including the missing-AI-API state. */
.product-editor-snackbar {
  position: fixed;
  z-index: 12020;
  right: max(18px, env(safe-area-inset-right));
  bottom: max(18px, env(safe-area-inset-bottom));
  display: grid;
  width: min(430px, calc(100vw - 36px));
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: start;
  gap: 12px;
  padding: 14px 14px 16px 15px;
  border: 0;
  border-radius: 8px;
  background: #ffffff;
  color: #0f172a;
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
  opacity: 0;
  transform: translateY(14px);
  pointer-events: none;
  overflow: hidden;
  transition:
    opacity 170ms ease,
    transform 170ms ease;
}

.product-editor-snackbar[hidden] {
  display: none !important;
}

.product-editor-snackbar.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.product-editor-snackbar.is-error,
.product-editor-snackbar.is-success {
  border: 0;
  background: #ffffff;
  color: #0f172a;
}

.product-editor-snackbar__icon {
  display: inline-grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 0;
  background: transparent;
  color: #64748b;
}

.product-editor-snackbar__icon svg {
  width: 18px;
  height: 18px;
  color: #64748b;
}

.product-editor-snackbar__copy {
  display: flex;
  min-width: 0;
  max-width: 100%;
  align-items: center;
  gap: 6px;
  overflow: hidden;
  line-height: 1.35;
  white-space: nowrap;
}

.product-editor-snackbar__copy strong {
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
  white-space: nowrap;
}

.product-editor-snackbar__copy > span {
  min-width: 0;
  overflow: hidden;
  font-size: 13px;
  color: #0f172a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-editor-snackbar__copy > span:empty {
  display: none;
}

.product-editor-snackbar.is-error .product-editor-snackbar__icon,
.product-editor-snackbar.is-error .product-editor-snackbar__icon svg {
  color: #dc2626;
}

.product-editor-snackbar.is-error .product-editor-snackbar__copy strong {
  color: #dc2626;
  font-weight: 500;
}

.product-editor-snackbar.is-error .product-editor-snackbar__copy > span,
.product-editor-snackbar.is-success .product-editor-snackbar__copy > span {
  color: #0f172a;
}

.product-editor-snackbar__close,
.product-editor-snackbar__close:hover,
.product-editor-snackbar__close:active,
.product-editor-snackbar__close:focus {
  display: inline-grid;
  width: 28px;
  height: 28px;
  min-width: 28px;
  min-height: 28px;
  place-items: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  outline: none;
  transform: none;
}

.product-editor-snackbar__close:hover {
  background: rgba(15, 23, 42, 0.08);
}

.product-editor-snackbar__close:focus-visible {
  box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.16);
}

.product-editor-snackbar__close svg {
  width: 16px;
  height: 16px;
}

.product-editor-snackbar__timer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 3px;
  pointer-events: none;
}

.product-editor-snackbar__timer-bar {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(1);
  transform-origin: left center;
  background: #159778;
  opacity: 0.72;
}

.product-editor-snackbar__timer-bar.is-running {
  animation: product-snackbar-timer-shrink 15s linear forwards;
}

.product-editor-snackbar.is-error .product-editor-snackbar__timer-bar {
  background: #dc2626;
  opacity: 0.85;
}

.product-editor-snackbar.is-success .product-editor-snackbar__timer-bar {
  background: #159778;
  opacity: 0.72;
}

@keyframes product-snackbar-timer-shrink {
  from {
    transform: scaleX(1);
  }

  to {
    transform: scaleX(0);
  }
}

@media (max-width: 560px) {
  .product-editor-snackbar {
    right: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    width: max-content;
    max-width: calc(100vw - 24px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .product-editor-snackbar__timer-bar.is-running {
    animation: none;
  }
}


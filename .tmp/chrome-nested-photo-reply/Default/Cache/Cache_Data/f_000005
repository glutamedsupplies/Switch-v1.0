}

.product-status-shell .product-card--expired-batch:hover {
  box-shadow: 0 12px 26px rgba(220, 38, 38, 0.16) !important;
}

.product-status-shell .product-card--pending-request,
.product-status-shell .product-card--pending-request:hover,
.product-status-shell .product-card--pending-request.is-inactive,
.product-status-shell .product-card--pending-request.is-inactive:hover {
  border-color: #f59e0b !important;
  background: #ffffff !important;
  outline: none !important;
}

.product-status-shell .product-card--pending-request:hover {
  box-shadow: 0 12px 26px rgba(245, 158, 11, 0.18) !important;
}

.product-status-shell .product-card--needs-revision,
.product-status-shell .product-card--needs-revision:hover,
.product-status-shell .product-card--needs-revision.is-inactive,
.product-status-shell .product-card--needs-revision.is-inactive:hover {
  border-color: #ef4444 !important;
  background: #ffffff !important;
  outline: none !important;
}

.product-status-shell .product-card--needs-revision:hover {
  box-shadow: 0 12px 26px rgba(239, 68, 68, 0.16) !important;
}

.product-status-shell .product-image,
.product-status-shell .product-image--add-product,
.product-status-shell .product-card__photo-button {
  display: grid !important;
  width: 100% !important;
  height: auto !important;
  aspect-ratio: 1 / 1;
  flex: 0 0 auto;
  place-items: center;
  overflow: hidden !important;
  border-radius: 5px !important;
  background: #f3f4f6 !important;
  color: #94a3b8;
}

.product-status-shell .product-card__photo-button {
  padding: 0 !important;
  border: 0 !important;
  box-shadow: none !important;
  cursor: pointer !important;
}

.product-status-shell .product-card__photo-button:hover,
.product-status-shell .product-card__photo-button:active,
.product-status-shell .product-card__photo-button:focus-visible {
  background: #f3f4f6 !important;
  box-shadow: none !important;
  outline: none !important;
  transform: none !important;
}

.product-status-shell .product-image img {
  display: block;
  width: 100%;
  height: 100%;

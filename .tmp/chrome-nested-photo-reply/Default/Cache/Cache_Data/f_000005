}

.product-status-shell .product-card--pending-request .product-card__badge--status {
  border-color: #ffffff;
  background: #f59e0b;
  color: transparent;
  box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.28);
}

.product-status-shell .product-card--needs-revision .product-card__badge--status {
  border-color: #ffffff;
  background: #ef4444;
  color: transparent;
  box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.28);
}

.product-status-shell .product-card--expired-batch .product-card__badge--status {
  border-color: #ffffff;
  background: #dc2626;
  color: transparent;
  box-shadow: 0 0 0 1px rgba(220, 38, 38, 0.24);
}

.product-status-shell .product-card__visibility-toggle {
  min-height: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  pointer-events: auto;
}

.product-status-shell .product-card__visibility-toggle:hover,
.product-status-shell .product-card__visibility-toggle:focus-visible,
.product-status-shell .product-card__visibility-toggle:active {
  background: transparent;
  box-shadow: none;
  outline: none;
  transform: none;
}

.product-status-shell .product-card__visibility-toggle-track {
  width: 34px;
  height: 22px;
  padding: 3px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.66);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  transition: background 220ms cubic-bezier(0.22, 1, 0.36, 1) !important;
}

.product-status-shell .product-card__visibility-toggle-thumb {
  width: 16px;
  height: 16px;
  box-shadow: none;
}

.product-status-shell .product-card__visibility-toggle.is-active .product-card__visibility-toggle-track {
  background-color: var(--accent) !important;
  background-image: var(--accent-button-gradient-bg) !important;
  background-size: 100% 100% !important;
  background-repeat: no-repeat !important;
}

.product-status-shell .product-card__visibility-toggle.is-active .product-card__visibility-toggle-thumb {
  transform: translateX(12px);
}

.product-status-shell .product-card__body {
  display: grid;
  min-width: 0;
  min-height: 0;
  align-content: start;
  flex: none !important;
  gap: 5px;
  padding: 10px 3px 8px !important;
}

.product-status-shell .product-card__body--add-product {

/* Listing command and Add Product workspace modal. */
.product-status-shell .product-panel-grid__inventory-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-width: 0;
  padding: 2px 0 4px;
}

.product-status-shell .product-panel-grid__inventory-heading .section-label {
  margin: 0 0 2px;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

.product-status-shell .product-panel-grid__inventory-heading h2 {
  margin: 0;
  color: #111827;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0;

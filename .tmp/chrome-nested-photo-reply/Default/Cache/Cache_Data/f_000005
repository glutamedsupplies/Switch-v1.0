  padding: 2px 6px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status-shell .product-card__price-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 6px;
  overflow: hidden;
  white-space: nowrap;
}

.product-status-shell .product-card__price {
  flex: 0 0 auto;
  overflow: hidden;
  color: #1f2937;
  font-size: 14px;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
}

.product-status-shell .product-card__original-price {
  min-width: 0;
  overflow: hidden;

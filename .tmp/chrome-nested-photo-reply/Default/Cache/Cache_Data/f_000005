  outline-offset: 2px;
}

.product-status-shell .product-actions .icon-action-button {
  display: inline-grid;
  width: 32px;
  min-width: 32px;
  min-height: 32px;
  height: 32px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: 5px;
  background: transparent;
  box-shadow: none;
  color: #475569;
  transform: none !important;
  transition: background 140ms ease, color 140ms ease, border-color 140ms ease !important;
}

.product-status-shell .product-actions .product-card__overview-button {
  display: inline-flex;
  justify-content: center;
  width: 100%;
  min-width: 0;
  padding: 0 8px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: var(--accent-text, var(--accent));
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-actions .product-card__overview-button i {
  display: none;
}

.product-status-shell .product-actions .product-card__overview-button span {
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-status-shell .product-actions .icon-action-button:hover,
.product-status-shell .product-actions .icon-action-button:focus-visible {
  background: rgba(var(--accent-rgb), 0.06);
  color: var(--accent-text, var(--accent));
  box-shadow: none;
  outline: none;
  transform: none !important;
}

.product-status-shell .product-actions .delete-button,
.product-status-shell .product-actions .icon-action-button--danger {
  color: #df4d58;
}

.product-status-shell .product-actions .delete-button:hover,
.product-status-shell .product-actions .delete-button:focus-visible,
.product-status-shell .product-actions .icon-action-button--danger:hover,
.product-status-shell .product-actions .icon-action-button--danger:focus-visible {

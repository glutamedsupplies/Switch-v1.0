}

.product-status-shell .product-image__count {
  box-sizing: border-box;
  min-width: 30px;
  min-height: 22px;
  gap: 6px;
  padding: 4px 7px;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 999px !important;
  background: rgba(17, 24, 39, 0.86) !important;
  color: #ffffff;
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
  font-size: 10px;
  font-weight: 500;
  line-height: 1;
  cursor: pointer !important;
  transform: none !important;
  transition: background 140ms ease !important;
}

.product-status-shell .product-image__count:hover {
  background: rgba(15, 23, 42, 0.94) !important;
  transform: none !important;
}

.product-status-shell .product-image__count i,
.product-status-shell .product-image__count svg {
  width: 12px;
  height: 12px;
  flex: 0 0 12px;
  font-size: 12px;
}

.product-status-shell .product-card__status-row {
  position: absolute;
  top: 15px;
  left: 15px;
  right: 15px;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  pointer-events: none;
}

.product-status-shell .product-card__badge--status {
  display: inline-flex;
  align-items: center;
  width: 10px;
  min-width: 10px;
  max-width: 10px;
  height: 10px;
  min-height: 10px;
  padding: 0;
  border-radius: 999px;
  background: #22c55e;
  color: transparent;

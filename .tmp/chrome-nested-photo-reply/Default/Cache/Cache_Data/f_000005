  opacity: 0.48;
  transform: none !important;
}

.product-status-shell .product-actions .icon-action-button i,
.product-status-shell .product-actions .icon-action-button svg {
  display: block;
  width: 22px;
  height: 22px;
  font-size: 18px;
  line-height: 1;
}

.product-status-shell .product-actions .product-card__edit-button,
.product-status-shell .product-actions .product-card__edit-button.icon-action-button {
  position: relative;
  display: inline-flex;
  width: 100%;
  min-width: 0;
  height: auto;
  min-height: 32px;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 8px;
  overflow: visible !important;
  background: #f8fafc;
  color: var(--accent-text, var(--accent));
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.product-status-shell .product-actions .product-card__edit-button i,
.product-status-shell .product-actions .product-card__edit-button svg {
  width: 22px;
  height: 22px;
  font-size: 13px;
}

.product-status-shell .product-actions .product-card__edit-icon {
  position: relative;
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.product-status-shell .product-actions .product-card__edit-button > span:not(.product-card__edit-icon) {
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-status-shell .product-actions .product-card__edit-button.has-revision-dot .product-card__edit-icon::after {
  content: "";

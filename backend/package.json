{
  "name": "switch-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal local backend for Switch products",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "sharp": "^0.33.5"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:smoke": "bash scripts/ci-health-smoke.sh",
    "test:super-admin-auth": "node --test test/superAdminAuth.test.js",
    "test:session-tenancy": "node --test test/appSessionAuth.test.js",
    "test:password-auth": "node --test test/passwordHashOnly.test.js test/superAdminAuth.test.js",
    "test:security-p0": "node --test test/securityP0.test.js",
    "passwords:migrate-json": "node scripts/migrate-json-passwords-to-bcrypt.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate-users": "node scripts/migrate-accounts-json-to-postgres.js",
    "gmail:connect": "node scripts/gmail-oauth-setup.js",
    "gmail:test": "node scripts/test-gmail-otp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1"
  }
}

# AI provider credentials stay on the server. Super Admin > AI Integration >
# Sync Models discovers these providers and refreshes their current model lists.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CHAT_AI_MODEL=gpt-4o-mini
CHAT_AI_API_URL=https://api.openai.com/v1/chat/completions
CHAT_AI_AUTO_REPLY_RATE_WINDOW_MS=600000
CHAT_AI_AUTO_REPLY_MAX_PER_ADMIN_WINDOW=120
CHAT_AI_AUTO_REPLY_MAX_PER_THREAD_WINDOW=10

# Super-admin authentication has no built-in defaults. These three values are
# required in production and whenever REQUIRE_SECRETS=1. SUPER_ADMIN_PASSWORD
# must contain a bcrypt hash ($2a$/$2b$/$2y$); plaintext is always rejected.
# The retired default credential pair is always rejected.
# Use a separate random value of at least 32 bytes for the session signing secret.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
ADMIN_API_SESSION_SECRET=

# Signed super-admin session lifetime in seconds (default: 28800 / 8 hours).
SUPER_ADMIN_SESSION_TTL_SECONDS=28800

# HMAC secret for buyer, seller, and employee sessions. Use a separate random
# value of at least 32 bytes. When omitted, ADMIN_API_SESSION_SECRET is reused
# with domain-separated signing; no insecure default is generated.
APP_SESSION_SECRET=

# Signed app session lifetime in seconds (default: 86400 / 24 hours; max 30 days).
APP_SESSION_TTL_SECONDS=86400

# Set to 1 to enforce required secrets outside NODE_ENV=production as well.
REQUIRE_SECRETS=0
PORT=8080

# Listen address. Default is loopback only. Set 0.0.0.0 to bind all NICs
# (needed for a phone on LAN). Flutter on the same machine uses 127.0.0.1.
BIND_HOST=127.0.0.1

# Extra CORS origins beyond the built-in localhost Flutter/admin allowlist
# (http(s)://localhost, 127.0.0.1, [::1] — any port). Never uses `*`.
# CORS_ALLOWED_ORIGINS=https://admin.internal.example

# Login brute-force lockout (per IP + identifier) and endpoint rate limits.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_IP_MAX=40
LOGIN_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=600000
VISUAL_SEARCH_RATE_LIMIT_MAX=30
VISUAL_SEARCH_RATE_LIMIT_WINDOW_MS=600000
SEARCH_EVENTS_RATE_LIMIT_MAX=90
SEARCH_EVENTS_RATE_LIMIT_WINDOW_MS=60000
ANALYTICS_RATE_LIMIT_MAX=120
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000

# Google OAuth Web client (Sign-In for customers/sellers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Maps Platform key (Places Autocomplete + Geocoding + Routes).
# Restrict to Places API + Geocoding API + Routes API. Without this key, Philippines
# address search falls back to OpenStreetMap Nominatim and Switch Rider live
# tracking draws straight-line routes instead of road routes.
GOOGLE_MAPS_API_KEY=

# Optional separate server key for Switch Rider live routes (Routes API).
# Falls back to GOOGLE_MAPS_API_KEY when unset.
GOOGLE_MAPS_ROUTES_API_KEY=

# Optional browser-restricted key for Maps JavaScript / Embed on main_dart.
# Falls back to GOOGLE_MAPS_API_KEY when unset. Restrict by HTTP referrer.
GOOGLE_MAPS_BROWSER_KEY=

# Real SMS OTP (Semaphore — recommended for PH)
SMS_PROVIDER=semaphore
SMS_ENABLED=true
SMS_APP_NAME=Switch
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# false = do not expose OTP in API responses (use real SMS)
VERIFICATION_DEBUG=false

# Email OTP (Gmail API sender — recipients can be anyone)
EMAIL_ENABLED=true
EMAIL_PROVIDER=gmail
EMAIL_FROM=Switch <you@gmail.com>
GMAIL_REFRESH_TOKEN=
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Connect once: npm run gmail:connect (OAuth Testing + test user = sender only)

# Optional providers (not required):
# BREVO_API_KEY=
# RESEND_API_KEY=

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# When set, accounts, products, store types/categories, orders, analytics,
# and chat use PostgreSQL as the source of truth after `npm run db:migrate`.
DATABASE_URL=postgresql://switch_app:switch_local_dev_2026@127.0.0.1:5432/switch_db
BCRYPT_ROUNDS=10
PG_POOL_MAX=10

# Upload storage for photos, videos, and 3D files (documents stay on the server).
# local = backend/public/uploads (default). s3 = any S3-compatible bucket.
# The database keeps `/uploads/<file>` URLs; the server redirects them to
# STORAGE_PUBLIC_BASE_URL when the file is not on local disk.
# Copy existing files with: npm run uploads:migrate-cloud -- --apply
STORAGE_DRIVER=local
# Cloudflare R2 example:
# STORAGE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=switch-media
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=https://media.yourdomain.com
# AWS S3 example (leave STORAGE_S3_ENDPOINT empty):
# STORAGE_S3_BUCKET=switch-media
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net
# Optional: object key prefix (default uploads/) and path-style URLs.
# STORAGE_KEY_PREFIX=uploads/
# STORAGE_S3_FORCE_PATH_STYLE=true

# Dual-write JSON backups for catalog/orders while Postgres is source of truth.
# Set to 0 to skip writing backend/data/products.json, orders.json, and
# store_types.json after a successful Postgres write.
CATALOG_JSON_BACKUP=1

# Dual-write JSON backup for chat while Postgres is source of truth.
CHAT_JSON_BACKUP=1

# PayMongo: seller-plan + buyer order hosted checkout.
# Webhooks: /api/payments/paymongo/seller-webhook and .../buyer-webhook
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=

# Courier adapter: manual (default) or lalamove. Lalamove fails closed when
# credentials, pickup details, or delivery coordinates are missing.
# COURIER_PROVIDER=manual
# LALAMOVE_ENVIRONMENT=sandbox
# LALAMOVE_API_KEY=
# LALAMOVE_API_SECRET=
# Optional separate verifier secret; defaults to LALAMOVE_API_SECRET.
# LALAMOVE_WEBHOOK_SECRET=
# LALAMOVE_WEBHOOK_PATH=/api/couriers/lalamove/webhook
# LALAMOVE_MARKET=PH
# LALAMOVE_LANGUAGE=en_PH
# LALAMOVE_SERVICE_TYPE=MOTORCYCLE
# LALAMOVE_PICKUP_NAME=
# LALAMOVE_PICKUP_PHONE=+63
# LALAMOVE_PICKUP_ADDRESS=
# LALAMOVE_PICKUP_LAT=
# LALAMOVE_PICKUP_LNG=

# Switch Rider (first-party delivery). Needs DATABASE_URL + `npm run db:migrate`.
# Signs checkout quotes and derives pickup/delivery/return PINs. Falls back to
# APP_SESSION_SECRET when empty; set a dedicated value in production and never
# rotate it while deliveries are open (active PINs would change).
# SWITCH_RIDER_SECRET=
# Shown on the rider app Safety/Support screens (Switch support, not emergency services).
# SWITCH_RIDER_SUPPORT_HOTLINE=
# SWITCH_RIDER_SUPPORT_EMAIL=
# Rider KYC documents and delivery proof photos. Default: backend/data/private_uploads.
# For cloud use a SEPARATE, NON-PUBLIC bucket (never the public media bucket).
# PRIVATE_STORAGE_DRIVER=local
# PRIVATE_STORAGE_S3_ENDPOINT=
# PRIVATE_STORAGE_S3_BUCKET=
# PRIVATE_STORAGE_S3_REGION=auto
# PRIVATE_STORAGE_S3_ACCESS_KEY_ID=
# PRIVATE_STORAGE_S3_SECRET_ACCESS_KEY=
# PRIVATE_STORAGE_KEY_PREFIX=switch-rider-private/

YOLO_INSPECTION_ENDPOINT=http://127.0.0.1:8091/inspect
YOLO_INSPECTION_TOKEN=
YOLO_INSPECTION_MODEL=yolo-product-inspection
YOLO_INSPECTION_PUBLIC_BASE_URL=http://127.0.0.1:8080
YOLO_INSPECTION_TIMEOUT_MS=20000
# Distinct buyers who must report a company before Super Admin sees
# "this company needs warning". One report never auto-punishes.
COMPANY_REPORT_WARNING_THRESHOLD=3

# Gallery vs main-image fingerprint floor (below = mixed-media revision)
PRODUCT_MIXED_MEDIA_VISUAL_MIN_SCORE=0.62

# Legacy fallback only. Once AI Integration is saved in Super Admin, the
# server-side provider, key, models, capabilities, and launch state there win.
OPENAI_API_KEY=your_openai_api_key_here
CHAT_AI_MODEL=gpt-4o-mini
CHAT_AI_API_URL=https://api.openai.com/v1/chat/completions
CHAT_AI_AUTO_REPLY_RATE_WINDOW_MS=600000
CHAT_AI_AUTO_REPLY_MAX_PER_ADMIN_WINDOW=120
CHAT_AI_AUTO_REPLY_MAX_PER_THREAD_WINDOW=10

# Super-admin authentication has no built-in defaults. These three values are
# required in production and whenever REQUIRE_SECRETS=1. SUPER_ADMIN_PASSWORD
# must contain a bcrypt hash ($2a$/$2b$/$2y$); plaintext is always rejected.
# The retired default credential pair is always rejected.
# Use a separate random value of at least 32 bytes for the session signing secret.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
ADMIN_API_SESSION_SECRET=

# Signed super-admin session lifetime in seconds (default: 28800 / 8 hours).
SUPER_ADMIN_SESSION_TTL_SECONDS=28800

# HMAC secret for buyer, seller, and employee sessions. Use a separate random
# value of at least 32 bytes. When omitted, ADMIN_API_SESSION_SECRET is reused
# with domain-separated signing; no insecure default is generated.
APP_SESSION_SECRET=

# Signed app session lifetime in seconds (default: 86400 / 24 hours; max 30 days).
APP_SESSION_TTL_SECONDS=86400

# Set to 1 to enforce required secrets outside NODE_ENV=production as well.
REQUIRE_SECRETS=0
PORT=8080

# Listen address. Default is loopback only. Set 0.0.0.0 to bind all NICs
# (needed for a phone on LAN). Flutter on the same machine uses 127.0.0.1.
BIND_HOST=127.0.0.1

# Extra CORS origins beyond the built-in localhost Flutter/admin allowlist
# (http(s)://localhost, 127.0.0.1, [::1] — any port). Never uses `*`.
# CORS_ALLOWED_ORIGINS=https://admin.internal.example

# Login brute-force lockout (per IP + identifier) and endpoint rate limits.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_IP_MAX=40
LOGIN_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=600000
VISUAL_SEARCH_RATE_LIMIT_MAX=30
VISUAL_SEARCH_RATE_LIMIT_WINDOW_MS=600000

# PayMongo seller checkout. Webhook requests are rejected unless this shared
# secret is set and the PayMongo signature header verifies.
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=

# Google OAuth Web client (Sign-In for customers/sellers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Maps Platform key (Places Autocomplete + Geocoding).
# Restrict to Places API + Geocoding API. Without this key, Philippines
# address search falls back to OpenStreetMap Nominatim.
GOOGLE_MAPS_API_KEY=

# Optional browser-restricted key for Maps JavaScript / Embed on main_dart.
# Falls back to GOOGLE_MAPS_API_KEY when unset. Restrict by HTTP referrer.
GOOGLE_MAPS_BROWSER_KEY=

# Real SMS OTP (Semaphore — recommended for PH)
SMS_PROVIDER=semaphore
SMS_ENABLED=true
SMS_APP_NAME=Switch
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# false = do not expose OTP in API responses (use real SMS)
VERIFICATION_DEBUG=false

# Email OTP (Gmail API sender — recipients can be anyone)
EMAIL_ENABLED=true
EMAIL_PROVIDER=gmail
EMAIL_FROM=Switch <you@gmail.com>
GMAIL_REFRESH_TOKEN=
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Connect once: npm run gmail:connect (OAuth Testing + test user = sender only)

# Optional providers (not required):
# BREVO_API_KEY=
# RESEND_API_KEY=

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# When set, accounts, products, store types/categories, and orders use
# PostgreSQL as the source of truth after `npm run db:migrate`.
# Chat remains JSON-only (Phase B).
DATABASE_URL=postgresql://switch_app:switch_local_dev_2026@127.0.0.1:5432/switch_db
BCRYPT_ROUNDS=10
PG_POOL_MAX=10

# Dual-write JSON backups for catalog/orders while Postgres is source of truth.
# Set to 0 to skip writing backend/data/products.json, orders.json, and
# store_types.json after a successful Postgres write.
CATALOG_JSON_BACKUP=1

YOLO_INSPECTION_ENDPOINT=http://127.0.0.1:8091/inspect
YOLO_INSPECTION_TOKEN=
YOLO_INSPECTION_MODEL=yolo-product-inspection
YOLO_INSPECTION_PUBLIC_BASE_URL=http://127.0.0.1:8080
YOLO_INSPECTION_TIMEOUT_MS=20000
